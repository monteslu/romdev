{
  "name": "romdev-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for romdev (npx romdev) + its romdev-* core & toolchain packages. Not published — see packages/* for the published packages.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "publish-all": "node publish-all.mjs",
    "publish-all:dry": "node publish-all.mjs --dry-run"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0"
  }
}
