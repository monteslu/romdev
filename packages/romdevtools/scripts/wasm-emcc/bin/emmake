#!/usr/bin/env node
// emmake (Python-free): run a build command with CC/CXX/AR/... pointing at wasm-emcc.
import { spawnSync } from "node:child_process";
import { buildingEnv } from "../env.mjs";
const args = process.argv.slice(2);
if (!args.length) { process.stderr.write("usage: emmake <command> [args...]\n"); process.exit(1); }
const env = buildingEnv();
if ("emmake" === "emconfigure") env.EMMAKEN_JUST_CONFIGURE = "1";
process.stderr.write(`emmake: "${args.join(" ")}" in "${process.cwd()}"\n`);
const r = spawnSync(args[0], args.slice(1), { stdio: "inherit", env });
process.exit(r.status ?? 1);
