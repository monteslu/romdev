# romdev patch — see README.md in this directory for full justification.
# Exposes this core's internal memory regions (VRAM/OAM/palette/registers/etc.)
# via retro_get_memory_data so romdev's inspect*/getCPUState/etc. tools can read
# them. Upstream exposes only SAVE_RAM/SYSTEM_RAM. WITHOUT this patch the build
# still succeeds but those tools return empty data (silent runtime failure).
#
# Also adds, all on the 6510 (C64 main CPU = vice/src/maincpu.c, included via
# c64/c64cpu.c; the per-instruction interpreter is vice/src/6510core.c):
#  * WRITE WATCHPOINT — the STORE macro records reg_pc when a watched address is
#    written; libretro-core.c exports romdev_watchpoint_set/get (findWriter).
#  * READ WATCHPOINT — the LOAD macro records reg_pc + value when a watched
#    address is read; exports romdev_readwatch_set/get (runUntilRead).
#  * EXECUTION (PC) BREAKPOINT + SINGLE-STEP — 6510core.c compares reg_pc to the
#    armed address just before the opcode fetch (gated by ROMDEV_PCBREAK, defined
#    only around maincpu.c's libretro per-call mainloop include so the drive CPU
#    that also includes 6510core.c is unaffected). On a hit the CPU freezes at
#    that instruction (returns un-executed) and clears retro_renderloop so
#    retro_run's `while (retro_renderloop) maincpu_mainloop();` frame loop ends
#    (otherwise it would spin forever). Single-step uses a per-instruction
#    countdown so the PC advances. Exports romdev_pcbreak_set/get
#    (runUntilPC / stepInstruction).
# git apply ignores everything above the first 'diff --git' line.
#
#
# RE primitives round 2: register read/write (romdev_setreg/getreg onto the
# file-scope 6510 register globals romdev_reg_a/x/y/p/sp + reg_pc; reg-ids 0=A
# 1=X 2=Y 3=P 4=SP 16=PC), a RANGE WATCH logging every {pc,addr,value} in [lo,hi]
# (hooks in the STORE/LOAD macros, maincpu.c; exports romdev_range_set/get), and
# a PC COVERAGE log of distinct in-window PCs (hook in 6510core.c at
# SET_LAST_ADDR(reg_pc), gated by ROMDEV_PCBREAK so it only compiles in the main-
# CPU mainloop; exports romdev_cov_set/get). Ring-buffer state defined in
# maincpu.c before 6510core.c is #included. Patch is pure-LF on ADDED lines.
# git apply ignores everything above the first 'diff --git' line.
#
#
# C64 DISK IMAGE READ/WRITE (round 3): exposes the LIVE mounted 1541 disk image
# for host-side save/restore, since the libretro VICE WASM build takes content
# in-memory (no fullpath FS write-back) and exposes no disk memory region. Adds
# to libretro/libretro-core.c (after the romdev_cov_* block, before
# retro_load_game_special):
#   * romdev_disk_export(unit,drive)  — flushes the vdrive BAM/dir, then reads
#     every sector of the live disk_image_t into a static buffer; returns the
#     .d64 length. romdev_disk_ptr() returns the buffer.
#   * romdev_disk_import(data,len,unit,drive) — writes a flat .d64 back into the
#     live image, sector by sector (disk_image_write_sector).
#   * romdev_disk_putfile(unit,name,data,len) — writes ONE PRG file into the live
#     image via the vdrive (vdrive_iec_open/write/close), bypassing the C64
#     KERNAL/serial bus (whose multi-byte disk WRITE does not complete in this
#     WASM build). This is the host-side "inject a save" primitive.
#   * needs #include "vdrive-iec.h" + "vdrive-bam.h" (added near "vdrive.h").
# Only the standard 35-track 1541 .d64 (174848 bytes) round-trips. Build exports:
# add _romdev_disk_export/_ptr/_import/_putfile to EXPORTED_FUNCTIONS in
# scripts/build-vice.sh. git apply ignores everything above the first
# 'diff --git' line.
#
diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index 82bd2fb..cfdbc49 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -19,6 +19,8 @@
 #include "diskimage.h"
 #include "fsdevice.h"
 #include "vdrive.h"
+#include "vdrive-iec.h"
+#include "vdrive-bam.h"
 #include "vdrive-internal.h"
 #include "charset.h"
 #include "attach.h"
@@ -8639,6 +8641,333 @@ unsigned retro_get_region(void)
    }
 }
 
+/* romdev instruction-level write watchpoint (6510) — records reg_pc when a
+ * watched address is written (hook in the STORE macro in maincpu.c). State
+ * defined there. */
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_wp_enabled;
+   out5[1] = romdev_wp_addr;
+   out5[2] = romdev_wp_last_pc;
+   out5[3] = (unsigned int)romdev_wp_last_val;
+   out5[4] = romdev_wp_hits;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev instruction-level READ watchpoint (6510) — records reg_pc + the value
+ * when a watched address is read (hook in the LOAD macro in maincpu.c). State
+ * defined there. Exported for the host runUntilRead tool. */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev EXECUTION (PC) BREAKPOINT + SINGLE-STEP (6510). The compare lives in
+ * 6510core.c (gated by ROMDEV_PCBREAK in maincpu.c's libretro mainloop). On a
+ * hit the CPU freezes at reg_pc and retro_renderloop is cleared so retro_run's
+ * frame loop returns. The host polls romdev_pcbreak_get after each frame, stops
+ * stepping once hit is set, then reads getCPUState. `step` arms a one-
+ * instruction single-step (ignores addr). State defined in maincpu.c. */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+/* romdev INSTRUCTION WATCHDOG (6510): force-stop after a budget of instructions
+ * so a runaway routine returns control with the final PC instead of hanging the
+ * WASM. State defined in maincpu.c; the hook lives in 6510core.c. */
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern volatile int  romdev_pc_watchdog;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+   romdev_pc_watchdog = 0;
+   romdev_pc_wd_count = 0;
+}
+
+/* Fills out6: [enabled, addr, hit, lastPC, hits, watchdogTripped]. clearHit re-arms. */
+void romdev_pcbreak_get(unsigned int *out6, int clearHit)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_pc_enabled;
+   out6[1] = romdev_pc_addr;
+   out6[2] = (unsigned int)romdev_pc_hit;
+   out6[3] = romdev_pc_last_pc;
+   out6[4] = romdev_pc_hits;
+   out6[5] = (unsigned int)romdev_pc_watchdog;
+   if (clearHit) { romdev_pc_hit = 0; romdev_pc_watchdog = 0; romdev_pc_wd_count = 0; }
+}
+
+/* Arms the instruction watchdog: force-stop after `limit` instructions (limit
+ * 0 = disable). The host sets this before driving callSubroutine so a runaway
+ * codec returns control instead of hanging. */
+void romdev_watchdog_set(unsigned int limit)
+{
+   romdev_pc_wd_limit = limit;
+   romdev_pc_wd_count = 0;
+   romdev_pc_watchdog = 0;
+}
+
+/* ─── romdev RE primitives round 2 (C64 6510) ─────────────────────────────────
+ * Register read/write (inverse of getCPUState — powers setRegister /
+ * callSubroutine) onto the file-scope 6510 register globals lifted out of the
+ * mainloop statics (romdev_reg_a/x/y/p/sp + reg_pc), a RANGE WATCH logging every
+ * {pc,addr,value} touching [lo,hi] (hooks in the STORE/LOAD macros in maincpu.c),
+ * and a PC COVERAGE log of distinct in-window PCs (hook in 6510core.c at the
+ * SET_LAST_ADDR(reg_pc) point, gated by ROMDEV_PCBREAK). 6510 reg-id convention
+ * (STABLE): 0=A 1=X 2=Y 3=P(status) 4=SP 16=PC. State lives in maincpu.c. */
+extern uint8_t romdev_reg_a, romdev_reg_x, romdev_reg_y, romdev_reg_p, romdev_reg_sp;
+extern unsigned int reg_pc;
+
+int romdev_setreg(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  romdev_reg_a  = (uint8_t)value;        return 0;  /* A */
+      case 1:  romdev_reg_x  = (uint8_t)value;        return 0;  /* X */
+      case 2:  romdev_reg_y  = (uint8_t)value;        return 0;  /* Y */
+      case 3:  romdev_reg_p  = (uint8_t)value;        return 0;  /* P (status) */
+      case 4:  romdev_reg_sp = (uint8_t)value;        return 0;  /* SP */
+      case 16: reg_pc        = (unsigned int)(value & 0xFFFF); return 0;  /* PC */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   switch (regId) {
+      case 0:  return (unsigned int)romdev_reg_a;
+      case 1:  return (unsigned int)romdev_reg_x;
+      case 2:  return (unsigned int)romdev_reg_y;
+      case 3:  return (unsigned int)romdev_reg_p;
+      case 4:  return (unsigned int)romdev_reg_sp;
+      case 16: return (unsigned int)(reg_pc & 0xFFFF);
+      default: return 0;
+   }
+}
+
+/* RANGE watch + PC COVERAGE: state + ring buffers live in maincpu.c (defined
+ * before 6510core.c is #included so the STORE/LOAD macros + the cov hook see
+ * them). The exports below are thin wrappers over that state. */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern unsigned int  romdev_range_pc[], romdev_range_addr[];
+extern unsigned char romdev_range_val[];
+extern unsigned int  romdev_range_count, romdev_range_stored;
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+   romdev_range_lo = lo; romdev_range_hi = hi;
+   romdev_range_mode = mode ? mode : 3;
+   romdev_range_enabled = enabled ? 1 : 0;
+   romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...].
+ * out2 (size 2) gets [totalSeen, stored]. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_range_stored;
+   if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_range_pc[i];
+      out[i*3 + 1] = romdev_range_addr[i];
+      out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+   }
+   return n;
+}
+
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern unsigned int  romdev_cov_pcs[], romdev_cov_count, romdev_cov_total;
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_cov_lo = lo; romdev_cov_hi = hi;
+   romdev_cov_enabled = enabled ? 1 : 0;
+   romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+/* Copy up to `max` distinct PCs into out[]. out2 (size 2) gets [distinct,total]. */
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_cov_count;
+   if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+   return n;
+}
+
+/* ===================== romdev C64 disk image read/write ====================
+ * The libretro VICE core takes content in-memory (need_fullpath but no FS write-
+ * back) and exposes no disk memory region, so romdev reads/writes the LIVE
+ * mounted disk_image_t directly. These are the host-side disk-save primitives
+ * (snapshot a disk; inject a save/disk), the C64 analogue of SRAM export/import.
+ *   romdev_disk_export(unit,drive)  → flat .d64 into romdev_disk_buf; returns len
+ *   romdev_disk_ptr()               → pointer to that buffer
+ *   romdev_disk_import(data,len,..) → write a flat .d64 back into the disk
+ *   romdev_disk_putfile(unit,name,data,len) → write ONE PRG file into the disk
+ * Only the standard 35-track 1541 .d64 (174848 bytes) round-trips through here. */
+#define ROMDEV_DISK_MAXLEN (174848u)
+static unsigned char romdev_disk_buf[ROMDEV_DISK_MAXLEN];
+
+/* Resolve the live disk image for a unit: prefer the GCR drive's image (what the
+ * running C64 uses with True Drive Emulation), else the vdrive's. */
+static disk_image_t *romdev_live_image(unsigned int unit)
+{
+   disk_image_t *image = NULL;
+   if (unit >= 8 && (unit - 8) < NUM_DISK_UNITS && diskunit_context[unit - 8]) {
+      drive_t *drv = diskunit_context[unit - 8]->drives[0];
+      if (drv && drv->image) image = drv->image;
+   }
+   if (image == NULL) image = file_system_get_image(unit, 0);
+   return image;
+}
+
+unsigned int romdev_disk_export(unsigned int unit, unsigned int drive)
+{
+   disk_image_t *image;
+   vdrive_t *vdrive;
+   disk_addr_t dadr;
+   unsigned int track, sector, spt, off = 0;
+   (void)drive;
+
+   /* Commit the vdrive's cached BAM/directory to the image before reading. */
+   vdrive = file_system_get_vdrive(unit);
+   if (vdrive && vdrive->image) {
+      vdrive_close_all_channels(vdrive);
+      vdrive_flush(unit);
+   }
+
+   image = romdev_live_image(unit);
+   if (image == NULL || image->media.fsimage == NULL) return 0;
+   if (image->type != DISK_IMAGE_TYPE_D64) return 0;
+
+   for (track = 1; track <= image->tracks; track++) {
+      spt = disk_image_sector_per_track(image->type, track);
+      for (sector = 0; sector < spt; sector++) {
+         if (off + 256u > ROMDEV_DISK_MAXLEN) return off;
+         dadr.track = track; dadr.sector = sector;
+         if (disk_image_read_sector(image, romdev_disk_buf + off, &dadr) < 0)
+            memset(romdev_disk_buf + off, 0, 256);
+         off += 256u;
+      }
+   }
+   return off;
+}
+
+const unsigned char *romdev_disk_ptr(void) { return romdev_disk_buf; }
+
+unsigned int romdev_disk_import(const unsigned char *data, unsigned int len,
+                                unsigned int unit, unsigned int drive)
+{
+   disk_image_t *image;
+   disk_addr_t dadr;
+   unsigned int track, sector, spt, off = 0;
+   (void)drive;
+   if (data == NULL || len == 0) return 0;
+   image = romdev_live_image(unit);
+   if (image == NULL || image->media.fsimage == NULL) return 0;
+   if (image->type != DISK_IMAGE_TYPE_D64 || image->read_only) return 0;
+   for (track = 1; track <= image->tracks; track++) {
+      spt = disk_image_sector_per_track(image->type, track);
+      for (sector = 0; sector < spt; sector++) {
+         if (off + 256u > len) return off;
+         dadr.track = track; dadr.sector = sector;
+         if (disk_image_write_sector(image, data + off, &dadr) < 0) return off;
+         off += 256u;
+      }
+   }
+   return off;
+}
+
+/* Write ONE PRG-type file (name + bytes incl. its 2-byte load address) straight
+ * into the live disk via the vdrive, bypassing the C64 KERNAL/serial bus. The
+ * host-side "inject a save" primitive. Returns 0 ok, negative on error. */
+int romdev_disk_putfile(unsigned int unit, const char *fname,
+                        const unsigned char *data, unsigned int len)
+{
+   vdrive_t *vdrive;
+   disk_image_t *image;
+   char namebuf[40];
+   int n, st;
+   unsigned int i;
+   if (unit < 8 || unit >= 8 + NUM_DISK_UNITS || !fname || !data) return -1;
+   vdrive = file_system_get_vdrive(unit);
+   if (!vdrive) return -2;
+   image = romdev_live_image(unit);
+   if (!image) return -3;
+   if (vdrive->image != image)
+      vdrive_attach_image(image, unit, 0, vdrive);
+   if (!vdrive->image) return -4;
+
+   n = 0;
+   for (i = 0; fname[i] && n < 28; i++) namebuf[n++] = fname[i];
+   namebuf[n++] = ','; namebuf[n++] = 'P'; namebuf[n++] = ','; namebuf[n++] = 'W';
+   namebuf[n] = 0;
+
+   st = vdrive_iec_open(vdrive, (const uint8_t *)namebuf, (unsigned int)n, 2, NULL);
+   if (st != SERIAL_OK) return -100 - st;
+   for (i = 0; i < len; i++) {
+      st = vdrive_iec_write(vdrive, data[i], 2);
+      if (st != SERIAL_OK && st != SERIAL_EOF) { vdrive_iec_close(vdrive, 2); return -200 - (st & 0x7f); }
+   }
+   vdrive_iec_close(vdrive, 2);
+   vdrive_flush(unit);
+   return 0;
+}
+
 bool retro_load_game_special(unsigned type, const struct retro_game_info *info, size_t num)
 {
    (void)type;
@@ -8810,17 +9139,105 @@ bool retro_unserialize(const void *data_, size_t size)
    return false;
