+/* ---------------------------------------------------------------------------
+ * romdev: C64 keyboard + joyport injection for headless automation.
+ *
+ * Many C64 games (and cracktros) need KEYBOARD input — F1 to pick 1 player,
+ * RUN/STOP, SPACE/RETURN at setup screens — before joystick gameplay begins;
+ * joystick-only input can't get past them. These export an automation path
+ * the romdev host calls directly (no on-screen virtual keyboard, no host
+ * keymap): drive the C64 8x8 key matrix, feed a string into the kernal
+ * keyboard buffer, and pick the active joystick port.
+ *
+ *   romdev_key_matrix(row, col, pressed) -> assert/release one matrix cell.
+ *       (row,col) are C64 keyboard-matrix coords; e.g. RETURN=(0,1),
+ *       SPACE=(7,4), F1=(0,4), F3=(0,5), F5=(0,6), F7=(0,3), RUN/STOP=(7,7).
+ *       The romdev host owns the key-name -> (row,col) table.
+ *   romdev_kbdbuf_feed(s) -> queue a PETSCII string into the kernal keyboard
+ *       buffer (for typing LOAD/RUN/filenames). Returns kbdbuf_feed()'s result.
+ *   romdev_joyport_get() / romdev_joyport_set(port) -> the active C64 joystick
+ *       port the RetroPad drives (1 or 2). Default is 2 (most games). Setting
+ *       it locks the port so a core-option/hotkey doesn't override automation.
+ * ------------------------------------------------------------------------- */
+void romdev_key_matrix(int row, int col, int pressed)
+{
+   if (row < 0 || row > 7 || col < 0 || col > 7)
+      return;
+   keyboard_set_keyarr(row, col, pressed ? 1 : 0);
+}
+
+int romdev_kbdbuf_feed(const char *s)
+{
+   if (!s)
+      return -1;
+   return kbdbuf_feed(s);
+}
+
+int romdev_joyport_get(void)
+{
+   return (int)cur_port;
+}
+
+void romdev_joyport_set(int port)
+{
+   if (port != 1 && port != 2)
+      return;
+   cur_port = (unsigned int)port;
+   cur_port_locked = true;
+}
