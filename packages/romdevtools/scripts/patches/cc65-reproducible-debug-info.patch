@@ -147,6 +150,42 @@ static int HT_Compare (const void* Key1, const void* Key2)
 
 
 
+static unsigned NormalizedNameId (const StrBuf* Name)
+/* Intern a file name into the string pool, stripped down to its basename, and
+** return its id. The file names stored in the object file's FILE table (and
+** referenced by debug line info) are only used by a debugger to identify a
+** source and never affect generated code, but the leading directory path makes
+** the object depend on WHERE the source was assembled from. That breaks
+** byte-for-byte reproducibility, most visibly between a native build (real host
+** paths) and the WASM build of ca65 (whose virtual FS stages inputs under
+** "/work/..."). Stripping to the basename - which is what a debugger matches on
+** anyway - removes that dependency. Both AddFile and GetFileIndex funnel
+** through here so the FILE table and the .dbg line references stay consistent.
+*/
+{
+    const char* Buf = SB_GetConstBuf (Name);
+    unsigned    Len = SB_GetLen (Name);
+    StrBuf      Base = STATIC_STRBUF_INITIALIZER;
+    unsigned    Id;
+    unsigned    Start = Len;
+
+    /* Find the start of the basename: the char after the last path separator,
+    ** scanning only within the known length (the StrBuf need not be NUL
+    ** terminated).
+    */
+    while (Start > 0 && Buf[Start-1] != '/' && Buf[Start-1] != '\\') {
+        --Start;
+    }
+
+    /* Intern the basename slice */
+    SB_AppendBuf (&Base, Buf + Start, Len - Start);
+    Id = GetStrBufId (&Base);
+    SB_Done (&Base);
+    return Id;
+}
+
+
