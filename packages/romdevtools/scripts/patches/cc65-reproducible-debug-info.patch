     const FileEntry* F = HT_Find (&HashTab, &NameIdx);
@@ -226,8 +267,24 @@ unsigned AddFile (const StrBuf* Name, FileType Type,
 ** the table.
 */
 {
-    /* Create a new file entry and insert it into the tables */
-    FileEntry* F = NewFileEntry (GetStrBufId (Name), Type, Size, MTime);
+    /* Pin the modification time for reproducible objects: SOURCE_DATE_EPOCH if
+    ** set, otherwise 0. Like the file name, the mtime here is only used by a
+    ** debugger to decide whether a source changed since assembly - it never
+    ** affects generated code - so a fixed value keeps the object identical
+    ** regardless of when/where the input files were written (the WASM build
+    ** stamps every staged input with a single virtual-FS write time).
+    */
+    int SdePresent = 0;
+    unsigned long NormMTime = (unsigned long) GetSourceDateEpoch (&SdePresent);
+    if (!SdePresent) {
+        NormMTime = 0;
+    }
+    (void) MTime;
+
+    /* Create a new file entry and insert it into the tables, keyed on the
+    ** basename-normalized name so the object is path independent.
+    */
+    FileEntry* F = NewFileEntry (NormalizedNameId (Name), Type, Size, NormMTime);
 
     /* Return the index */
     return F->Index;
