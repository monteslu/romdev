diff --git a/src/common/filetime.c b/src/common/filetime.c
index 8bdf44f3f..0646c5a7e 100644
--- a/src/common/filetime.c
+++ b/src/common/filetime.c
@@ -42,8 +42,11 @@
 
 
 
+#include <stdlib.h>
+#include <limits.h>
+#include <errno.h>
+
 #if defined(_WIN32)
-#  include <errno.h>
 #  include <windows.h>
 #else
 #  include <sys/types.h>                          /* FreeBSD needs this */
@@ -56,6 +59,31 @@
 
 
 
+time_t GetSourceDateEpoch (int* Present)
+/* Return the reproducible-build time stamp. See filetime.h for details. */
+{
+    const char* Env = getenv ("SOURCE_DATE_EPOCH");
+    if (Env != 0 && Env[0] != '\0') {
+        char* End;
+        unsigned long V;
+        errno = 0;
+        V = strtoul (Env, &End, 10);
+        /* Accept only a clean, fully-consumed, non-overflowing value */
+        if (End != Env && *End == '\0' && !(V == ULONG_MAX && errno == ERANGE)) {
+            if (Present != 0) {
+                *Present = 1;
+            }
+            return (time_t) V;
+        }
+    }
+    if (Present != 0) {
+        *Present = 0;
+    }
+    return time (0);
+}
+
+
+
 /*****************************************************************************/
 /*                                   Code                                    */
 /*****************************************************************************/
