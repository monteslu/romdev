@@ -63,6 +63,17 @@ int SetFileTimes (const char* Path, time_t T);
 ** workarounds for all others (which in fact means "WINDOWS").
 */
 
+time_t GetSourceDateEpoch (int* Present);
+/* Return the reproducible-build time stamp. If the SOURCE_DATE_EPOCH
+** environment variable is set to a valid non-negative integer, that value is
+** returned and, if Present is non-NULL, *Present is set to 1. Otherwise the
+** current wall-clock time (time(0)) is returned and *Present is set to 0.
+** This lets timestamps that get baked into object files (the ca65 OPT_DATETIME
+** stamp, source-file modification times in debug info) be pinned to a fixed
+** value so builds are byte-for-byte reproducible regardless of when or where
+** they run. See https://reproducible-builds.org/docs/source-date-epoch/ .
+*/
+
 
 
