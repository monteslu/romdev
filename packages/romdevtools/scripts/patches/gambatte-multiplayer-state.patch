  *
@@ -475,3 +476,23 @@
 #endif
 }
 
+
+/* Pointer-free fixed-width causal resampler state; coefficient bank is pinned. */
+size_t blipper_state_size(const blipper_t *b) { return 24 + b->output_buffer_samples * 4; }
+int blipper_state_write(const blipper_t *b, unsigned char *out, size_t size) {
+ unsigned i;
+ if (size != blipper_state_size(b)) return 0;
+ mp_w32(out,b->output_buffer_samples); mp_w32(out+4,b->output_avail);
+ mp_w32(out+8,b->phase); mp_w32(out+12,(uint32_t)b->integrator);
+ mp_w32(out+16,(uint32_t)(int32_t)b->last_sample); mp_w32(out+20,b->taps);
+ for(i=0;i<b->output_buffer_samples;i++)mp_w32(out+24+i*4,(uint32_t)b->output_buffer[i]);
+ return 1;
+}
+int blipper_state_read(blipper_t *b, const unsigned char *in, size_t size) {
+ unsigned i;
+ if (size != blipper_state_size(b) || mp_r32(in)!=b->output_buffer_samples || mp_r32(in+20)!=b->taps || mp_r32(in+4)>b->output_buffer_samples-b->taps || (int32_t)mp_r32(in+8)<-(int32_t)b->phases || (int64_t)(int32_t)mp_r32(in+8)>(int64_t)mp_r32(in+4)*b->phases) return 0;
+ b->output_avail=mp_r32(in+4); b->phase=mp_r32(in+8);
+ b->integrator=(int32_t)mp_r32(in+12);b->last_sample=(int16_t)mp_r32(in+16);
+ for(i=0;i<b->output_buffer_samples;i++)b->output_buffer[i]=(int32_t)mp_r32(in+24+i*4);
+ return 1;
+}
