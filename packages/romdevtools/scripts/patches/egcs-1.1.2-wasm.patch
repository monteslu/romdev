-extern rtx (*const insn_gen_function[]) PROTO ((rtx, ...));
+#ifdef __EMSCRIPTEN__
+/* romdev: WebAssembly passes variadic arguments in memory, so a call through
+   an `(rtx, ...)' pointer to the (non-variadic) gen_* expanders loses every
+   argument after the first. Call them through an unprototyped pointer, as the
+   K&R callers of the day did.  */
+#define GEN_FCN_PROTO ()
+#else
+#define GEN_FCN_PROTO PROTO ((rtx, ...))
+#endif
+extern rtx (*const insn_gen_function[]) GEN_FCN_PROTO;
 
 extern optab add_optab;
 extern optab sub_optab;
