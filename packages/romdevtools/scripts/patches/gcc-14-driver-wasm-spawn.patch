+/* romdev: WASM host. WebAssembly has no fork/exec: each subprogram (cc1, as,
+   collect2) runs to completion synchronously as a sibling module through a JS
+   spawn hook, with its stdin/stdout/stderr wired to the fds the driver hands
+   over here, and pex_wait returns the recorded exit status.  */
+#include <emscripten.h>
+
+EM_JS(int, romdev_spawn_fds, (const char *file, char *const *argv, int argc, int fd_in, int fd_out, int fd_err), {
+  const args = [];
+  for (let i = 0; i < argc; i++) args.push(UTF8ToString(HEAPU32[(argv >> 2) + i]));
+  if (!Module["romdevSpawn"]) {
+    err("romdev: no spawn handler installed; cannot run " + UTF8ToString(file));
+    return 127 << 8;
+  }
+  return Module["romdevSpawn"](UTF8ToString(file), args, Module, { inFd: fd_in, outFd: fd_out, errFd: fd_err });
+});
+
+static pid_t romdev_next_pid = 4200;
+static pid_t romdev_done_pid[64];
+static int romdev_done_status[64];
+static int romdev_done_count;
+
+static pid_t
+pex_wait (struct pex_obj *obj ATTRIBUTE_UNUSED, pid_t pid, int *status,
+	  struct pex_time *time)
+{
+  int i;
+  if (time != NULL)
+    memset (time, 0, sizeof (struct pex_time));
+  for (i = 0; i < romdev_done_count; i++)
+    if (romdev_done_pid[i] == pid)
+      {
+	*status = romdev_done_status[i];
+	romdev_done_count--;
+	memmove (romdev_done_pid + i, romdev_done_pid + i + 1, (romdev_done_count - i) * sizeof (pid_t));
+	memmove (romdev_done_status + i, romdev_done_status + i + 1, (romdev_done_count - i) * sizeof (int));
+	return pid;
+      }
+  errno = ECHILD;
+  return -1;
+}
+
