diff --git a/bsnes/sfc/coprocessor/icd/icd.cpp b/bsnes/sfc/coprocessor/icd/icd.cpp
index 1b5199c..5837620 100644
--- a/bsnes/sfc/coprocessor/icd/icd.cpp
+++ b/bsnes/sfc/coprocessor/icd/icd.cpp
@@ -78,16 +78,30 @@ auto ICD::clockFrequency() const -> uint {
   return Frequency ? Frequency : system.cpuFrequency();
 }
 
+//romdev: a firmware file the cart needs (sfc/cartridge/load.cpp)
+extern char romdev_load_error[512];
+
 auto ICD::load() -> bool {
   information = {};
 
+  //romdev: the Super Game Boy boot ROM is the user's (romdev does not ship
+  //it), sgb_boot.bin / sgb2_boot.bin from the system directory
+  const char* romdevBoot = Frequency == 0 ? "sgb_boot.bin" : "sgb2_boot.bin";
+  uint8_t romdevBootROM[256];
+  auto romdevFp = platform->open(ID::SuperFamicom, romdevBoot, File::Read);
+  if(!romdevFp || romdevFp->size() != 256) {
+    snprintf(romdev_load_error, 512, "romdev: the Super Game Boy needs its boot ROM, which romdev does not ship: put the user's copy in the system directory as %s (256 bytes)\n", romdevBoot);
+    return false;
+  }
+  romdevFp->read(romdevBootROM, 256);
+
   GB_random_set_enabled(configuration.hacks.entropy != "None");
   if(Frequency == 0) {
     GB_init(&sameboy, GB_MODEL_SGB_NO_SFC);
-    GB_load_boot_rom_from_buffer(&sameboy, (const unsigned char*)&SGB1BootROM[0], 256);
+    GB_load_boot_rom_from_buffer(&sameboy, romdevBootROM, 256);
   } else {
     GB_init(&sameboy, GB_MODEL_SGB2_NO_SFC);
-    GB_load_boot_rom_from_buffer(&sameboy, (const unsigned char*)&SGB2BootROM[0], 256);
+    GB_load_boot_rom_from_buffer(&sameboy, romdevBootROM, 256);
   }
   GB_set_sample_rate_by_clocks(&sameboy, 256);
   GB_set_highpass_filter_mode(&sameboy, GB_HIGHPASS_ACCURATE);
diff --git a/bsnes/target-libretro/program.cpp b/bsnes/target-libretro/program.cpp
index 187cfee..80e4d7e 100644
--- a/bsnes/target-libretro/program.cpp
+++ b/bsnes/target-libretro/program.cpp
@@ -250,6 +250,16 @@ auto Program::open(uint id, string name, vfs::file::mode mode, bool required) ->
 		result = vfs::memory::file::open(iplrom, sizeof(iplrom));
 	}
 
+	//romdev: the Super Game Boy boot ROM from the system directory (sfc/coprocessor/icd/icd.cpp)
+	if ((name == "sgb_boot.bin" || name == "sgb2_boot.bin") && mode == vfs::file::mode::read) {
+		const char *system_dir = nullptr;
+		if (environ_cb && environ_cb(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &system_dir) && system_dir) {
+			auto boot = file::read(string{string(system_dir).transform("\\", "/"), "/", name});
+			if (boot.size() == 256) return vfs::memory::file::open(boot.data(), boot.size());
+		}
+		return {};
+	}
+
 	if (name == "boards.bml" && mode == vfs::file::mode::read) {
 		result = vfs::memory::file::open(Boards, sizeof(Boards));
 	}
