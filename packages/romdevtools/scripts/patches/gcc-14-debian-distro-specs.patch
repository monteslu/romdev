+#ifndef BIND_NOW_SPEC
+# if defined(DIST_DEFAULT_BIND_NOW) && !defined(ACCEL_COMPILER)
+#  define BIND_NOW_SPEC " -z now"
+# else
+#  define BIND_NOW_SPEC ""
