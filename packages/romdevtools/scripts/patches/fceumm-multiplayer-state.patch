+/* Ordinary on-disk states keep the pinned core's original fields and sizes.
+ * Rollback alone needs every FIR history and the fractional resampling index. */
+SFORMAT *romdev_sound_stateinfo(void) {
+ size_t i, n = sizeof(FCEUSND_STATEINFO) / sizeof(FCEUSND_STATEINFO[0]);
+ static SFORMAT complete[sizeof(FCEUSND_STATEINFO) / sizeof(FCEUSND_STATEINFO[0]) + 2];
+ SFORMAT index = { &mrindex, sizeof(mrindex) | FCEUSTATE_RLSB, "MRIX" };
+ if (!romdev_clock_enabled) return FCEUSND_STATEINFO;
+ complete[0] = index;
+ for (i = 0; i < n; i++) {
+  complete[i + 1] = FCEUSND_STATEINFO[i];
+#ifndef MSB_FIRST
+  if (!strcmp(complete[i + 1].desc, "WAVE")) complete[i + 1].s = sizeof(Wave);
+#endif
+ }
+#ifndef MSB_FIRST
+ {
+  SFORMAT high = { &WaveHi, sizeof(WaveHi), "WVHI" };
+  complete[n] = high;
+  complete[n + 1] = FCEUSND_STATEINFO[n - 1];
+ }
+#endif
+ return complete;
+}
