+
+uint32_t romdev_clock_enabled=0, romdev_clock_epoch=0;
+uint64_t romdev_clock_ticks=0;
+unsigned romdev_deterministic_boot(unsigned epoch) {
+ if(epoch>0x7fffffffU)return 0;
+ romdev_clock_enabled=1;romdev_clock_epoch=epoch;serialize_size=0;return 1;
+}
+void romdev_deterministic_disable(void) { romdev_clock_enabled=0;serialize_size=0; }
+unsigned romdev_state_schema(void) { return 0x4e450101; }
+size_t retro_serialize_size(void) { return mp_nes_core_size() + (romdev_clock_enabled?40:0); }
+bool retro_serialize(void *data, size_t size) {
+ unsigned i;unsigned char *p=(unsigned char *)data;
+ if(!data || size!=retro_serialize_size())return false;
+ if(!romdev_clock_enabled)return mp_nes_core_write(data,size);
+ memset(p,0,40);mp_w32(p,0x31534e4d);mp_w32(p+4,size-40);mp_w32(p+8,romdev_clock_epoch);mp_w32(p+12,romdev_state_schema());
+ for(i=0;i<5;i++)mp_w32(p+16+i*4,nes_input.type[i]);
+ return mp_nes_core_write(p+40,size-40);
+}
+bool retro_unserialize(const void *data, size_t size) {
+ unsigned i;const unsigned char *p=(const unsigned char *)data;
+ if(!data || size!=retro_serialize_size())return false;
+ if(!romdev_clock_enabled)return mp_nes_core_read(data,size);
+ if(mp_r32(p)!=0x31534e4d || mp_r32(p+4)!=size-40 || mp_r32(p+8)!=romdev_clock_epoch || mp_r32(p+12)!=romdev_state_schema())return false;
+ for(i=0;i<5;i++)if(mp_r32(p+16+i*4)!=nes_input.type[i])return false;
+ return mp_nes_core_read(p+40,size-40);
+}
+unsigned romdev_state_digest(unsigned char *out, unsigned len) {
+ size_t size=retro_serialize_size();unsigned char *p;bool ok;
+ if(!out || !romdev_clock_enabled || len!=32 || !size || size>1048576 || current_stereo_filter!=STEREO_FILTER_NULL)return 0;
+ p=(unsigned char *)malloc(size);if(!p)return 0;
+ ok=retro_serialize(p,size);if(ok)mp_sha256(p,size,out);free(p);return ok;
+}
