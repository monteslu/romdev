diff --git a/src/platform/libretro/libretro.c b/src/platform/libretro/libretro.c
index 4b05a42..30fd8f3 100644
--- a/src/platform/libretro/libretro.c
+++ b/src/platform/libretro/libretro.c
@@ -2269,6 +2269,65 @@ unsigned retro_get_region(void) {
 	return RETRO_REGION_NTSC; // TODO: This isn't strictly true
 }
 
+/* romdev (0.80.0): the watch/pcbreak/watchdog/regsnap/readwatch/range/coverage/
+ * irqblock machinery + exports live in the shared romdev_debug.c. libretro.c keeps
+ * the ARM7 setReg/getReg wrappers + the memory regions. */
+#include "romdev_debug.h"
+
+/* romdev register read/write (GBA ARM7) — the inverse of getCPUState, used by the
+ * host's setRegister / callSubroutine (set a reg / PC, push a sentinel return,
+ * run to it, capture the output). The actual register access + the PC pipeline
+ * reload live in src/arm/arm.c (romdev_arm_setreg/getreg) where ARM_PC and the
+ * ARMWritePC/ThumbWritePC inlines are in scope; here we just thread the loaded
+ * GBA's ARM core through. romdev ARM reg-id convention (STABLE): 0..15 = r0..r15
+ * (13=SP, 14=LR, 15=PC), 16 = CPSR. setreg PC (id 15) reloads the prefetch
+ * pipeline so the set PC actually executes. Returns 0 on success, -1 on an
+ * unknown id or when no GBA core is loaded; getreg returns the value (0 for an
+ * unknown id / no core). */
+extern int          romdev_arm_setreg(struct ARMCore* cpu, int regId, unsigned int value);
+extern unsigned int romdev_arm_getreg(struct ARMCore* cpu, int regId);
+
+int romdev_setreg(int regId, unsigned int value) {
+	if (!core || !core->cpu || core->platform(core) != mPLATFORM_GBA) return -1;
+	return romdev_arm_setreg((struct ARMCore*) core->cpu, regId, value);
+}
+
+unsigned int romdev_getreg(int regId) {
+	if (!core || !core->cpu || core->platform(core) != mPLATFORM_GBA) return 0;
+	return romdev_arm_getreg((struct ARMCore*) core->cpu, regId);
+}
+
+/* romdev custom debug regions (GBA). High IDs so they never collide with the
+ * libretro RETRO_MEMORY_* enum. Each is exposed through retro_get_memory_data /
+ * _size below. CPU regs are assembled into a static snapshot buffer (the ARM
+ * register file is contiguous but cpsr/spsr/mode are separate fields); palette,
+ * OAM and the IO page are already contiguous in the GBA struct so we point at
+ * them directly. The IO page ($4000000-$40003FF) carries BOTH the LCD/video
+ * registers (DISPCNT, BGxCNT, scroll, window, blend) AND the audio registers
+ * (SOUNDxCNT, SOUNDCNT, SOUNDBIAS, WAVE_RAM), so one region serves both. */
+#define ROMDEV_REGION_GBA_CPU_REGS 0x180u /* 20 u32: gprs[0..15], cpsr, spsr, execMode, privMode */
+#define ROMDEV_REGION_GBA_IO_REGS  0x181u /* 0x400 bytes: io[512] — video + audio regs */
+#define ROMDEV_REGION_GBA_PALETTE  0x182u /* 0x400 bytes: palette[512] 15-bit BGR (256 BG + 256 OBJ) */
+#define ROMDEV_REGION_GBA_OAM      0x183u /* 0x400 bytes: oam.raw[512] — 128 sprites x 8 bytes */
+
+#ifdef M_CORE_GBA
+/* Assemble the ARM7 register snapshot. Layout (all little-endian u32):
+ *   [0..15] gprs r0..r15 (r13=SP, r14=LR, r15=PC, pipeline-prefetched)
+ *   [16] cpsr.packed  [17] spsr.packed  [18] executionMode (0=ARM,1=THUMB)
+ *   [19] privilegeMode */
+static unsigned int romdev_gba_cpu_snapshot[20];
+static void* romdev_gba_fill_cpu_snapshot(void) {
+	struct ARMCore* cpu = (struct ARMCore*) core->cpu;
+	int i;
+	for (i = 0; i < 16; ++i) romdev_gba_cpu_snapshot[i] = (unsigned int) cpu->gprs[i];
+	romdev_gba_cpu_snapshot[16] = (unsigned int) cpu->cpsr.packed;
+	romdev_gba_cpu_snapshot[17] = (unsigned int) cpu->spsr.packed;
+	romdev_gba_cpu_snapshot[18] = (unsigned int) cpu->executionMode;
+	romdev_gba_cpu_snapshot[19] = (unsigned int) cpu->privilegeMode;
+	return romdev_gba_cpu_snapshot;
+}
+#endif
+
 void retro_set_controller_port_device(unsigned port, unsigned device) {
 	UNUSED(port);
 	UNUSED(device);
