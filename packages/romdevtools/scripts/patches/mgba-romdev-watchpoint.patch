@@ -18,6 +18,29 @@
 #include <mgba-util/memory.h>
 #include <mgba-util/vfs.h>
 
+#include "romdev_debug.h"
+/* romdev (0.80.0): the watch/range/coverage machinery + state live in the shared
+ * romdev_debug.c. gba/memory.c keeps the GBA load/store hook macros (which call
+ * romdev_on_write/on_read) + the ARM snapshot externs. The hooks report the
+ * EXECUTING instruction's pipeline PC (romdev_arm_instr_pc, latched at dispatch in
+ * arm.c). `cc` is the cycleCounter — NULL for internal helper accesses (skipped so
+ * an internal helper read doesn't double-fire). GBA is a flat 32-bit space. */
+extern unsigned int romdev_arm_instr_pc;
+extern void romdev_arm_snap(struct ARMCore* cpu, int kind);
+#define ROMDEV_WP_GBA(cpu, addr, val) do { \
+		unsigned char romdev_oldv = romdev_wp_wants_old() ? ({ int romdev_ws_ = 0; (unsigned char)(cpu)->memory.load8((cpu), (addr), &romdev_ws_); }) : 0; \
+		if (romdev_on_write((unsigned int)(addr), romdev_oldv, (unsigned char)(val), romdev_arm_instr_pc, 0xFFFFFFFFu)) \
+			romdev_arm_snap((cpu), 3); \
+	} while (0)
+#define ROMDEV_RD_GBA(cpu, addr, val, cc) do { \
+		if ((cc) && romdev_on_read((unsigned int)(addr), (unsigned char)(val), romdev_arm_instr_pc)) \
+			romdev_arm_snap((cpu), 4); \
+	} while (0)
+/* RANGE is folded into on_write/on_read now → no-op (kept so call sites need no edit).
+ * NOTE: the read/range hooks were gated on `cc`; the write hook was unconditional, so
+ * ROMDEV_WP_GBA stays unconditional too (matching the original). */
+#define ROMDEV_RANGE_GBA(cpu, a, v, w, cc) do { (void)(cpu); (void)(a); (void)(v); (void)(w); (void)(cc); } while (0)
+
 #define IDLE_LOOP_THRESHOLD 10000
 
 mLOG_DEFINE_CATEGORY(GBA_MEM, "GBA Memory", "gba.memory");
