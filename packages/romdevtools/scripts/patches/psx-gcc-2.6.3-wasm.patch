+#ifdef __EMSCRIPTEN__
+/* romdev: WASM host. musl (emscripten's libc) has no sys_errlist/sys_nerr
+   (glibc dropped them too); the driver's error messages index them. Build the
+   table once from strerror, which yields the same texts.  */
+#include <string.h>
+#define ROMDEV_NERR 256
+static int sys_nerr;
+static const char *sys_errlist[ROMDEV_NERR];
+__attribute__((constructor)) static void
+romdev_init_sys_errlist (void)
+{
+  int i;
+  for (i = 0; i < ROMDEV_NERR; i++)
+    sys_errlist[i] = strerror (i);
+  sys_nerr = ROMDEV_NERR;
+}
+#else
 extern int sys_nerr;
 #if defined(bsd4_4) || defined(__NetBSD__)
 extern const char *const sys_errlist[];
 #else
 extern char *sys_errlist[];
 #endif
+#endif
 
 extern int execv (), execvp ();
 
