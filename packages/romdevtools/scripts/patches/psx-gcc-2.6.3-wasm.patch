-#if !defined(__MSDOS__) && !defined(OS2) && !defined(WINNT)
+#if defined(__EMSCRIPTEN__)
+/* romdev: WASM host. There is no fork/exec in WebAssembly: each subprogram
+   (cpp, cc1, as) runs to completion synchronously as a sibling module through
+   a JS spawn hook, and wait() hands back the recorded exit statuses. A pipe
+   (-pipe) between two stages is carried by the host as a byte buffer.  */
+#include <emscripten.h>
+
+EM_JS(int, romdev_spawn_pipe, (const char *file, char **argv, int argc, int pipe_in, int pipe_out), {
+  const args = [];
+  for (let i = 0; i < argc; i++) args.push(UTF8ToString(HEAPU32[(argv >> 2) + i]));
+  if (!Module["romdevSpawn"]) {
+    err("romdev: no spawn handler installed; cannot run " + UTF8ToString(file));
+    return 127 << 8;
+  }
+  return Module["romdevSpawn"](UTF8ToString(file), args, Module, { pipeIn: !!pipe_in, pipeOut: !!pipe_out });
+});
+
+static int romdev_next_pid = 4200;
+static int romdev_done_pid[64];
+static int romdev_done_status[64];
+static int romdev_done_count;
+static int romdev_pipe_pending;
+
+static int
+pexecute (search_flag, program, argv, not_last)
+     int search_flag;
+     char *program;
+     char *argv[];
+     int not_last;
+{
+  int argc = 0;
+  int status;
+  while (argv[argc])
+    argc++;
+  status = romdev_spawn_pipe (program, argv, argc, romdev_pipe_pending, not_last);
+  romdev_pipe_pending = not_last;
+  if (romdev_done_count < 64)
+    {
+      romdev_done_pid[romdev_done_count] = ++romdev_next_pid;
+      romdev_done_status[romdev_done_count] = status;
+      romdev_done_count++;
+    }
+  return romdev_next_pid;
+}
+
+static int
+romdev_wait (statusp)
+     int *statusp;
+{
+  int i;
+  if (romdev_done_count == 0)
+    return -1;
+  *statusp = romdev_done_status[0];
+  i = romdev_done_pid[0];
+  romdev_done_count--;
+  memmove (romdev_done_pid, romdev_done_pid + 1, romdev_done_count * sizeof (int));
+  memmove (romdev_done_status, romdev_done_status + 1, romdev_done_count * sizeof (int));
+  return i;
+}
+#define wait(s) romdev_wait (s)
+
+#elif !defined(__MSDOS__) && !defined(OS2) && !defined(WINNT)
 
 static int
 pexecute (search_flag, program, argv, not_last)
