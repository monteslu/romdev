 #include "libc_impl.h"
 #include "helpers.h"
 
+#ifdef __EMSCRIPTEN__
+// romdev: WASM host. There is no fork/exec in WebAssembly, so cc's passes run
+// as separate WASM modules through a JS spawn hook (romdev_spawn), and fork is
+// emulated vfork-style: the recompiled fork site (rewritten to ROMDEV_FORK by
+// build-ido.sh) takes the child path first under a setjmp, the child's
+// execvp runs the pass to completion, then the parent resumes at the fork
+// with its registers, its stack and its file descriptors restored.
+#include <emscripten.h>
+#include <setjmp.h>
+jmp_buf romdev_fork_jmp;
+volatile uint32_t romdev_fork_regs[32];
+static int romdev_in_child;
+static int romdev_child_pid = 4200;
+static int romdev_child_status;
+static int romdev_have_child;
+static int romdev_saved_std[3];
+static uint8_t romdev_open_at_fork[256];
+#define ROMDEV_STACK_SNAPSHOT (1024 * 1024)
+static uint8_t romdev_stack_copy[ROMDEV_STACK_SNAPSHOT];
+static uint32_t romdev_stack_lo;
+
+EM_JS(int, romdev_spawn, (const char* file, char** argv, int argc), {
+    const args = [];
+    for (let i = 0; i < argc; i++) args.push(UTF8ToString(HEAPU32[(argv >> 2) + i]));
+    if (!Module["romdevSpawn"]) {
+        err("romdev: no spawn handler installed; cannot run " + UTF8ToString(file));
+        return 127 << 8;
+    }
+    return Module["romdevSpawn"](UTF8ToString(file), args, Module);
+});
+
+int romdev_fork_child(uint8_t* mem, uint32_t sp) {
+    for (int i = 0; i < 3; i++) {
+        romdev_saved_std[i] = dup(i);
+    }
+    for (int fd = 0; fd < 256; fd++) {
+        romdev_open_at_fork[fd] = fcntl(fd, F_GETFD) != -1;
+    }
+    romdev_stack_lo = sp;
+    memcpy(romdev_stack_copy, mem + sp, ROMDEV_STACK_SNAPSHOT);
+    romdev_child_pid++;
+    romdev_in_child = 1;
+    return 0;
+}
+
+int romdev_fork_parent(uint8_t* mem) {
+    return romdev_child_pid;
+}
+
+static void romdev_child_done(uint8_t* mem, int status) {
+    fflush(NULL);
+    for (int fd = 0; fd < 256; fd++) {
+        if (!romdev_open_at_fork[fd] && fcntl(fd, F_GETFD) != -1) {
+            close(fd);
+        }
+    }
+    for (int i = 0; i < 3; i++) {
+        if (romdev_saved_std[i] >= 0) {
+            dup2(romdev_saved_std[i], i);
+            close(romdev_saved_std[i]);
+        }
+    }
+    memcpy(mem + romdev_stack_lo, romdev_stack_copy, ROMDEV_STACK_SNAPSHOT);
+    romdev_child_status = status;
+    romdev_have_child = 1;
+    romdev_in_child = 0;
+    longjmp(romdev_fork_jmp, 1);
+}
+#endif /* __EMSCRIPTEN__ */
+
 #define MIN(a, b) ((a) < (b) ? (a) : (b))
