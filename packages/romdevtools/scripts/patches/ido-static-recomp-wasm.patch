+#ifdef __EMSCRIPTEN__
+// glibc's tempnam, which the native builds get: $TMPDIR wins over the dir
+// argument, the prefix defaults to "file" and is cut to 5 characters, and six
+// random characters follow it directly. musl's would ignore TMPDIR and, for an
+// empty dir, name a file in "/".
+static int romdev_is_dir(const char* d) {
+    struct stat st;
+    return d != NULL && *d != '\0' && stat(d, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static char* romdev_tempnam(const char* dir, const char* pfx) {
+    static const char letters[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    static unsigned int counter;
+    const char* d = getenv("TMPDIR");
+    if (!romdev_is_dir(d)) {
+        d = romdev_is_dir(dir) ? dir : "/tmp";
+    }
+    if (pfx == NULL || *pfx == '\0') {
+        pfx = "file";
+    }
+    char buf[PATH_MAX];
+    for (int tries = 0; tries < 10000; tries++) {
+        unsigned int v = (unsigned int)getpid() * 2654435761u + (++counter) * 40503u + (unsigned int)time(NULL);
+        char suffix[7];
+        for (int i = 0; i < 6; i++) {
+            suffix[i] = letters[v % 62];
+            v = v / 62 + (unsigned int)(i + 1) * 7919u;
+        }
+        suffix[6] = '\0';
+        if (snprintf(buf, sizeof(buf), "%s/%.5s%s", d, pfx, suffix) >= (int)sizeof(buf)) {
+            errno = ENAMETOOLONG;
+            return NULL;
+        }
+        if (access(buf, F_OK) != 0) {
+            return strdup(buf);
+        }
+    }
+    errno = EEXIST;
+    return NULL;
+}
+#endif
