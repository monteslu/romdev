--- a/header.h
+++ b/header.h
@@ -8,6 +8,34 @@
 #include "libc_impl.h"
 #include "helpers.h"
 
+#ifdef __EMSCRIPTEN__
+// romdev: vfork-style fork emulation (see libc_impl.c). build-ido.sh rewrites
+// each recompiled `v0 = wrapper_fork(mem);` to ROMDEV_FORK(v0). The child path
+// runs first; when its execvp finishes, longjmp lands here and every register
+// local is restored to its value at the fork before the parent path runs.
+#include <setjmp.h>
+#define ROMDEV_FORK_NREGS 32
+extern jmp_buf romdev_fork_jmp;
+extern volatile uint32_t romdev_fork_regs[ROMDEV_FORK_NREGS];
+int romdev_fork_child(uint8_t* mem, uint32_t sp);
+int romdev_fork_parent(uint8_t* mem);
+#define ROMDEV_FORK_REGS(X) X(0, at) X(1, v1) X(2, t0) X(3, t1) X(4, t2) X(5, t3) X(6, t4) X(7, t5) \
+    X(8, t6) X(9, t7) X(10, s0) X(11, s1) X(12, s2) X(13, s3) X(14, s4) X(15, s5) X(16, s6) X(17, s7) \
+    X(18, t8) X(19, t9) X(20, gp) X(21, fp) X(22, s8) X(23, ra) X(24, lo) X(25, hi) X(26, a0) X(27, a1) \
+    X(28, a2) X(29, a3) X(30, sp) X(31, v0)
+#define ROMDEV_SAVE_REG(i, r) romdev_fork_regs[i] = (r);
+#define ROMDEV_LOAD_REG(i, r) (r) = romdev_fork_regs[i];
+#define ROMDEV_FORK(dst) do { \
+        ROMDEV_FORK_REGS(ROMDEV_SAVE_REG) \
+        if (setjmp(romdev_fork_jmp) == 0) { \
+            (dst) = romdev_fork_child(mem, sp); \
+        } else { \
+            ROMDEV_FORK_REGS(ROMDEV_LOAD_REG) \
+            (dst) = romdev_fork_parent(mem); \
+        } \
+    } while (0)
+#endif
+
 #define RM_RN 0
 #define RM_RZ 1
 #define RM_RP 2
