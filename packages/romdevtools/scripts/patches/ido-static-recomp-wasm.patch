 static uint8_t* memory_map(size_t length) {
+#ifdef __EMSCRIPTEN__
+    // wasm32 load/store offsets are added WITHOUT wrapping, so the guest base
+    // (region - MEM_REGION_START) must not wrap either: the region has to start
+    // at or above MEM_REGION_START in linear memory. The padding below it is
+    // never touched, and fresh linear memory is already zero (no memset: that
+    // would commit every page of the 512MB region).
+    uint8_t* raw = malloc(MEM_REGION_START + length + 0x10000);
+    if (raw == NULL) {
+        fprintf(stderr, "romdev: cannot reserve the IDO guest memory region\n");
+        exit(1);
+    }
+    uintptr_t base = ((uintptr_t)raw + 0xffff) & ~(uintptr_t)0xffff;
+    if (base < MEM_REGION_START) {
+        base = MEM_REGION_START;
+    }
+    return (uint8_t*)base;
+#endif
 #ifdef __CYGWIN__
     uint8_t* mem = mmap(0, length, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
 #else
