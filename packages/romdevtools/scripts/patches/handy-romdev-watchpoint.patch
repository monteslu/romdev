+/* romdev instruction-level write watchpoint (Lynx 65C02). State defined here
+ * with C linkage; the CPU_POKE hook in lynx/c65c02.h records mPC when a watched
+ * address is written. Exported for the host. */
+extern "C" {
+/* romdev at-hit register snapshot — see c65c02.h for layout. The snap is a
+ * FUNCTION (not a macro) so the hooks can call it from expression contexts. */
+/* romdev (0.80.0): the watch/pcbreak/watchdog/range/coverage/irqblock STATE + the
+ * romdev_*_set/get exports all live in the shared romdev_debug.c now. libretro.cpp keeps
+ * only the genuinely-per-core surface: the 65C02 value-based register snapshot (the
+ * dispatch + CPU_PEEK/POKE hooks in c65c02.h call it), the shared snap-buffer fill, and
+ * setReg/getReg (which go through the C65C02 register file, not the shared buffer). */
+unsigned int  romdev_65c02_instr_pc = 0xFFFFFFFF;
+/* romdev 65C02 register snapshot — fills the SHARED romdev_snap_regs[]/romdev_snap_kind
+ * (declared in romdev_debug.h) at a hit. Layout matches the host's getRegSnapshot:
+ * [0]=A [1]=X [2]=Y [3]=P [4]=SP [16]=PC. A FUNCTION (not a macro) so the c65c02.h hooks
+ * can call it from expression contexts. */
+unsigned int  romdev_65c02_snap(unsigned int a, unsigned int x, unsigned int y, unsigned int ps, unsigned int sp, int kind)
+{
+   int i;
+   for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+   romdev_snap_regs[0]  = a;
+   romdev_snap_regs[1]  = x;
+   romdev_snap_regs[2]  = y;
+   romdev_snap_regs[3]  = ps;
+   romdev_snap_regs[4]  = sp;
+   romdev_snap_regs[16] = romdev_65c02_instr_pc;
+   romdev_snap_regs[18] = sp;
+   romdev_snap_kind = kind;
+   return 0;
+}
+
+int romdev_setreg(int regId, unsigned int value)
+{
+   if (!lynx) return -1;
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   switch (regId) {
+      case 0:  r.A  = (int)(value & 0xFF);   break;  /* A */
+      case 1:  r.X  = (int)(value & 0xFF);   break;  /* X */
+      case 2:  r.Y  = (int)(value & 0xFF);   break;  /* Y */
+      case 3:  r.PS = (int)(value & 0xFF);   break;  /* P (status) */
+      case 4:  r.SP = (int)(value & 0xFF);   break;  /* SP */
+      case 16: r.PC = (int)(value & 0xFFFF); break;  /* PC */
+      default: return -1;
+   }
+   lynx->SetRegs(r);
+   return 0;
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   if (!lynx) return 0;
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   switch (regId) {
+      case 0:  return (unsigned int)(r.A  & 0xFF);
+      case 1:  return (unsigned int)(r.X  & 0xFF);
+      case 2:  return (unsigned int)(r.Y  & 0xFF);
+      case 3:  return (unsigned int)(r.PS & 0xFF);
+      case 4:  return (unsigned int)(r.SP & 0xFF);
+      case 16: return (unsigned int)(r.PC & 0xFFFF);
+      default: return 0;
+   }
+}
+}
+
+/* romdev debug state regions (Lynx). High IDs so they never collide with the
+ * libretro RETRO_MEMORY_* enum; honored only by this patched core.
+ *   0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
+ *          assembled from the public CSystem::GetRegs(C6502_REGS&).
+ *   0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes),
+ *          read through the public Peek_CPU memory-map path. This is Suzy
+ *          ($FC00-$FCFF: sprite engine regs) + Mikey ($FD00-$FDFF: LCD control,
+ *          audio at $FD20-$FD3F, palette at $FDA0-$FDBF). The CPU registers and
+ *          this HW window are SYNTHESIZED into static buffers per call because
+ *          the chips' fields are private — Peek is the sanctioned public read
+ *          path and is side-effect-free for these register addresses.
+ * Lynx sprites have NO fixed OAM — they are SCB linked lists walked from a RAM
+ * address — so there is no sprite region; inspectSprites must walk SCBs over the
+ * already-exported SYSTEM_RAM. */
+#define ROMDEV_REGION_LYNX_CPU_REGS 0x190u
+#define ROMDEV_REGION_LYNX_HW_REGS  0x191u
+
+static unsigned char romdev_lynx_cpu_buf[8];
+static unsigned char romdev_lynx_hw_buf[0x200]; /* $FC00-$FDFF */
+
+static void *romdev_lynx_fill_cpu(void)
+{
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   romdev_lynx_cpu_buf[0] = (unsigned char)(r.PC & 0xff);
+   romdev_lynx_cpu_buf[1] = (unsigned char)((r.PC >> 8) & 0xff);
+   romdev_lynx_cpu_buf[2] = (unsigned char)(r.A & 0xff);
+   romdev_lynx_cpu_buf[3] = (unsigned char)(r.X & 0xff);
+   romdev_lynx_cpu_buf[4] = (unsigned char)(r.Y & 0xff);
+   romdev_lynx_cpu_buf[5] = (unsigned char)(r.SP & 0xff);
+   romdev_lynx_cpu_buf[6] = (unsigned char)(r.PS & 0xff);
+   romdev_lynx_cpu_buf[7] = (unsigned char)((r.NMI ? 0x80 : 0) | (r.IRQ ? 0x40 : 0) | (r.WAIT ? 0x20 : 0));
+   return romdev_lynx_cpu_buf;
+}
+
+static void *romdev_lynx_fill_hw(void)
+{
+   for (unsigned i = 0; i < 0x200; ++i)
+      romdev_lynx_hw_buf[i] = lynx->Peek_CPU(0xFC00 + i);
+   return romdev_lynx_hw_buf;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
-   if (lynx && type == RETRO_MEMORY_SYSTEM_RAM)
-      return lynx->GetRamPointer();
+   if (!lynx) return NULL;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return lynx->GetRamPointer();
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return romdev_lynx_fill_cpu();
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return romdev_lynx_fill_hw();
    return NULL;
 }
 
 size_t retro_get_memory_size(unsigned type)
 {
-   if (type == RETRO_MEMORY_SYSTEM_RAM)
-      return 1024 * 64;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return 1024 * 64;
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return sizeof(romdev_lynx_cpu_buf);
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return sizeof(romdev_lynx_hw_buf);
    return 0;
 }
diff --git a/lynx/c65c02.h b/lynx/c65c02.h
index 0fdea74..116fc7a 100644
--- a/lynx/c65c02.h
+++ b/lynx/c65c02.h
@@ -65,9 +65,42 @@
 //#define CPU_PEEKW(m)			(mSystem.PeekW_CPU(m))
 //#define CPU_POKE(m1,m2)			(mSystem.Poke_CPU(m1,m2))
 
-#define CPU_PEEK(m)				(((m<0xfc00)?mRamPointer[m]:mSystem.Peek_CPU(m)))
+/* romdev instruction-level write watchpoint (Lynx 65C02). The CPU_POKE macro is
+ * the central write path; mPC is the live program counter. Records the writing
+ * PC when a watched address is written. State has C linkage so libretro.cpp can
+ * extern + export it. (The 65C02 addresses a flat 64KB space — no ROM banking
+ * to disambiguate — so PC alone is unambiguous; no bank field.) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* romdev (0.80.0): the watch/pcbreak/watchdog/range/coverage/irqblock machinery +
+ * state live in the shared romdev_debug.c. c65c02.h keeps the 65C02 value-based
+ * register snapshot (defined in libretro.cpp) + the CPU_PEEK/CPU_POKE hook macros
+ * (which call romdev_on_read/on_write) + the dispatch hook. */
+#include "romdev_debug.h"
+extern unsigned int  romdev_65c02_instr_pc;
+extern unsigned int  romdev_65c02_snap(unsigned int a, unsigned int x, unsigned int y, unsigned int ps, unsigned int sp, int kind);
+#ifdef __cplusplus
+}
+#endif
+
+/* romdev read-watch helper: records a read of romdev_rd_addr, then yields v.
+ * Written as an expression (comma operator) because CPU_PEEK is used in
+ * expression context (e.g. mOperand=CPU_PEEK(...)). */
+#define ROMDEV_65C02_SNAP(kind_) romdev_65c02_snap((unsigned int)(mA & 0xFF), (unsigned int)(mX & 0xFF), (unsigned int)(mY & 0xFF), (unsigned int)(PS() & 0xFF), (unsigned int)(mSP & 0xFF), (kind_))
+/* romdev (0.80.0): the READ hook → shared on_read. CRITICAL — the underlying read
+ * (mSystem.Peek_CPU on a HARDWARE register at m>=0xfc00) can have SIDE EFFECTS (clears
+ * a status bit / advances a FIFO), so it MUST be evaluated EXACTLY ONCE. A GCC
+ * statement-expression reads it into a temp, passes that to on_read, and yields it —
+ * no double-read. (The first cut re-evaluated the read 2-3× via the comma-operator
+ * form, which silently corrupted I/O state and derailed the CPU — the Lynx never
+ * reached its main loop.) */
+#define ROMDEV_RD_HOOK(m,rd)	({ unsigned int romdev_m=(unsigned int)(m); unsigned char romdev_v=(unsigned char)(rd); if(romdev_on_read(romdev_m, romdev_v, romdev_65c02_instr_pc)) ROMDEV_65C02_SNAP(4); romdev_v; })
+
+#define CPU_PEEK(m)				ROMDEV_RD_HOOK((m), (((m)<0xfc00)?mRamPointer[(m)]:mSystem.Peek_CPU((m))))
 #define CPU_PEEKW(m)			(((m<0xfc00)?(mRamPointer[m]+(mRamPointer[m+1]<<8)):mSystem.PeekW_CPU(m)))
-#define CPU_POKE(m1,m2)			{if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
+/* romdev (0.80.0): the WRITE hook → shared on_write (watchpoint + range-write). */
+#define CPU_POKE(m1,m2)			{ unsigned char romdev_oldv = (romdev_wp_wants_old() && (m1)<0xfc00) ? mRamPointer[m1] : 0; if(romdev_on_write((unsigned int)(m1), romdev_oldv, (unsigned char)(m2), romdev_65c02_instr_pc, 0xFFFFFFFFu)){ ROMDEV_65C02_SNAP(3); } if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
 
 
 enum
@@ -216,7 +249,7 @@ class C65C02
 
          //    fprintf(stderr, "cpu update\n");
 
-         if(gSystemIRQ && !mI)
+         if(gSystemIRQ && !mI && !romdev_irq_block)
          {
             // IRQ signal clearance is handled by CMikie::Update() as this
             // is the only source of interrupts
@@ -248,6 +281,25 @@ class C65C02
          //
          if(gSystemCPUSleep) return;
 
+         /* romdev (0.80.0): keep this CPU frozen across re-entry after a hit (the
+          * system loop re-enters Update() until the frame ends; the host clears the
+          * hit to resume). */
+         if(romdev_is_frozen()) return;
+
+         /* mPC is the first byte of the instruction about to dispatch — latch it for
+          * the CPU_POKE / ROMDEV_RD_HOOK watch hooks, then ask the shared lib whether
+          * to FREEZE (coverage + watchdog + pc-break/single-step live in romdev_debug.c).
+          * On a freeze: snapshot (kind 2=watchdog else 1=pc-break/step) and RETURN
+          * WITHOUT executing — mPC left un-incremented; the libretro frame loop sees
