# romdev patch for handy (Atari Lynx) libretro core — see README.md here.
#
# FOUR additions (all 65C02, flat 64KB space — PC is unambiguous, no banking):
# 1) Instruction-level WRITE WATCHPOINT: the CPU_POKE macro in lynx/c65c02.h
#    records mPC when a watched address is written; libretro.cpp exports
#    romdev_watchpoint_set/get (findWriter).
# 2) Instruction-level READ WATCHPOINT: the CPU_PEEK macro records mPC + the
#    value when a watched address is read; libretro.cpp exports
#    romdev_readwatch_set/get (runUntilRead). Mirror of the write watch.
# 3) EXECUTION (PC) BREAKPOINT + SINGLE-STEP: C65C02::Update() compares mPC to
#    the armed address just before the opcode fetch and, on a hit, freezes the
#    CPU at that instruction (returns un-executed) so the host can read live
#    regs; retro_run's frame loop then consumes the remaining cycle budget so
#    the frame still completes (otherwise the loop spins forever). Single-step
#    uses a per-instruction countdown so the PC actually advances. libretro.cpp
#    exports romdev_pcbreak_set/get (runUntilPC / stepInstruction).
# 4) DEBUG STATE REGIONS via retro_get_memory_data/_size custom IDs:
#    - 0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
#      from the public CSystem::GetRegs(C6502_REGS&), for getCPUState.
#    - 0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes)
#      read through the public Peek_CPU memory path — Suzy sprite regs ($FCxx) +
#      Mikey LCD control / audio ($FD20-$FD3F) / palette ($FDA0-$FDBF). Used by
#      getAudioState (Mikey) and inspectPalette/getRenderingContext (Lynx).
#    Both synthesized into static buffers per call (the chip fields are private;
#    Peek/GetRegs are the sanctioned public reads, side-effect-free here).
#    Lynx sprites are SCB linked lists (no fixed OAM) so there is no sprite
#    region — inspectSprites walks SCBs over the exported SYSTEM_RAM instead.
#
# git apply ignores everything above the first 'diff --git' line.
#
#
# RE primitives round 2: register read/write (romdev_setreg/getreg via the public
# CSystem GetRegs/SetRegs round-trip; 65C02 reg-ids 0=A 1=X 2=Y 3=P(=PS) 4=SP
# 16=PC), a RANGE WATCH logging every {pc,addr,value} in [lo,hi] (hooks in the
# CPU_PEEK / CPU_POKE macros, c65c02.h; exports romdev_range_set/get), and a PC
# COVERAGE log of distinct in-window PCs (hook in C65C02::Update before the
# opcode fetch; exports romdev_cov_set/get). Ring-buffer state lives in libretro.cpp.
#
diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index ad4efd7..e886c00 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -995,6 +995,10 @@ void retro_get_system_av_info(struct retro_system_av_info *info)
    info->geometry.aspect_ratio = (float)lynx_width / (float)lynx_height;
 }
 
+/* romdev PC breakpoint hit flag (defined with C linkage further below). Forward-
+ * declared here so retro_run's frame loop can end the frame on a hit. */
+extern "C" volatile int romdev_pc_hit;
+
 void retro_run(void)
 {
    unsigned i, res = 0;
@@ -1083,6 +1087,17 @@ void retro_run(void)
    while (gSystemCycleCount - gLastRunCycleCount < retro_cycles_per_frame) {
       lynx->Update();
 
+      /* romdev PC breakpoint hit: the CPU is frozen at the breakpoint (its
+       * Update() returned WITHOUT executing/advancing). We must still END this
+       * frame or the while loop spins forever (the CPU no longer advances
+       * cycles). Consume the remaining frame-cycle budget and break so
+       * retro_run returns; the host then polls romdev_pcbreak_get, disarms, and
+       * reads the live registers. */
+      if (romdev_pc_hit) {
+         gSystemCycleCount = gLastRunCycleCount + retro_cycles_per_frame;
+         break;
+      }
+
       for (int lcv = 1; lcv < retro_overclock; lcv++)
          lynx->Overclock();
    }
@@ -1292,16 +1307,346 @@ unsigned retro_get_region(void)
    return RETRO_REGION_NTSC;
 }
 
+/* romdev instruction-level write watchpoint (Lynx 65C02). State defined here
+ * with C linkage; the CPU_POKE hook in lynx/c65c02.h records mPC when a watched
+ * address is written. Exported for the host. */
+extern "C" {
+/* romdev at-hit register snapshot — see c65c02.h for layout. The snap is a
+ * FUNCTION (not a macro) so the hooks can call it from expression contexts. */
+unsigned int  romdev_snap_regs[19];
+int           romdev_snap_kind = 0;
+unsigned int  romdev_65c02_instr_pc = 0xFFFFFFFF;
+/* romdev interrupt block (pure-call primitive — gates the IRQ dispatch in
+ * lynx/c65c02.h's Update()). */
+int           romdev_irq_block = 0;
+void romdev_irqblock_set(int on)
+{
+   romdev_irq_block = on ? 1 : 0;
+}
+unsigned int  romdev_65c02_snap(unsigned int a, unsigned int x, unsigned int y, unsigned int ps, unsigned int sp, int kind)
+{
+   int i;
+   for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+   romdev_snap_regs[0]  = a;
+   romdev_snap_regs[1]  = x;
+   romdev_snap_regs[2]  = y;
+   romdev_snap_regs[3]  = ps;
+   romdev_snap_regs[4]  = sp;
+   romdev_snap_regs[16] = romdev_65c02_instr_pc;
+   romdev_snap_regs[18] = sp;
+   romdev_snap_kind = kind;
+   return 0;
+}
+void romdev_regsnap_get(unsigned int *out, int clear)
+{
+   int i;
+   if (!out) return;
+   out[0] = (unsigned int)romdev_snap_kind;
+   out[1] = 19;
+   for (i = 0; i < 19; i++) out[2 + i] = romdev_snap_regs[i];
+   if (clear) romdev_snap_kind = 0;
+}
+
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (unsigned int)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = 0xFFFFFFFF; /* Lynx 65C02 is flat 64KB — no ROM bank to report */
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev instruction-level READ watchpoint (Lynx 65C02) — symmetric to the
+ * write watch above. The CPU_PEEK hook in lynx/c65c02.h records mPC + the value
+ * when a watched address is READ. Exported via romdev_readwatch_* for the host
+ * runUntilRead tool. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (Lynx 65C02). The compare lives in C65C02::Update()
+ * (lynx/c65c02.h) just before the opcode fetch, freezing mPC at the breakpoint.
+ * The host polls romdev_pcbreak_get after each retro_run frame, stops stepping
+ * once hit is set, then reads the registers via getCPUState. `step` arms a
+ * one-instruction single-step (ignores addr). Flat 64KB — PC is unambiguous. */
+unsigned int  romdev_pc_addr     = 0;
+int           romdev_pc_enabled  = 0;
+int           romdev_pc_step     = 0;        /* per-instruction countdown when single-stepping */
+volatile int  romdev_pc_hit      = 0;        /* set by the execute hook, cleared by the host */
+unsigned int  romdev_pc_last_pc  = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits     = 0;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a slightly-wrong A) can loop FOREVER
+ * inside a single retro_run frame, so the host's per-FRAME cap never gets a turn
+ * and the whole WASM hangs. This counts dispatched instructions and force-stops
+ * (sets romdev_pc_hit + romdev_pc_watchdog) when the budget is exceeded — so a
+ * runaway returns control with the final PC intact instead of hanging. The check
+ * lives in C65C02::Update() at the SAME spot as the pc-break, placed FIRST.
+ * romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;        /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;        /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;        /* set when the watchdog tripped */
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+   romdev_pc_watchdog = 0;
+   romdev_pc_wd_count = 0;
+}
+
+/* Fills out6: [enabled, addr, hit, lastPC, hits, watchdogTripped]. clearHit re-arms. */
+void romdev_pcbreak_get(unsigned int *out6, int clearHit)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_pc_enabled;
+   out6[1] = romdev_pc_addr;
+   out6[2] = (unsigned int)romdev_pc_hit;
+   out6[3] = romdev_pc_last_pc;
+   out6[4] = romdev_pc_hits;
+   out6[5] = (unsigned int)romdev_pc_watchdog;
+   if (clearHit) { romdev_pc_hit = 0; romdev_pc_watchdog = 0; romdev_pc_wd_count = 0; }
+}
+
+/* Arm the instruction watchdog (force-stop a runaway after `limit` instructions;
+ * 0 = disable). The host sets this before driving callSubroutine so a runaway
+ * routine returns control instead of hanging the whole WASM. */
+void romdev_watchdog_set(unsigned int limit)
+{
+   romdev_pc_wd_limit = limit;
+   romdev_pc_wd_count = 0;
+   romdev_pc_watchdog = 0;
+}
+
+/* ─── romdev RE primitives round 2 (Lynx 65C02) ───────────────────────────────
+ * Register read/write (inverse of getCPUState — powers setRegister /
+ * callSubroutine) via the public CSystem GetRegs/SetRegs round-trip, a RANGE
+ * WATCH logging every {pc,addr,value} touching [lo,hi] (hooks in the CPU_PEEK /
+ * CPU_POKE macros, c65c02.h), and a PC COVERAGE log of distinct in-window PCs
+ * (hook in C65C02::Update before the opcode fetch). 6502/65C02 reg-id convention
+ * (STABLE): 0=A 1=X 2=Y 3=P(status=PS) 4=SP 16=PC. Flat 64KB — PC unambiguous. */
+
+int romdev_setreg(int regId, unsigned int value)
+{
+   if (!lynx) return -1;
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   switch (regId) {
+      case 0:  r.A  = (int)(value & 0xFF);   break;  /* A */
+      case 1:  r.X  = (int)(value & 0xFF);   break;  /* X */
+      case 2:  r.Y  = (int)(value & 0xFF);   break;  /* Y */
+      case 3:  r.PS = (int)(value & 0xFF);   break;  /* P (status) */
+      case 4:  r.SP = (int)(value & 0xFF);   break;  /* SP */
+      case 16: r.PC = (int)(value & 0xFFFF); break;  /* PC */
+      default: return -1;
+   }
+   lynx->SetRegs(r);
+   return 0;
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   if (!lynx) return 0;
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   switch (regId) {
+      case 0:  return (unsigned int)(r.A  & 0xFF);
+      case 1:  return (unsigned int)(r.X  & 0xFF);
+      case 2:  return (unsigned int)(r.Y  & 0xFF);
+      case 3:  return (unsigned int)(r.PS & 0xFF);
+      case 4:  return (unsigned int)(r.SP & 0xFF);
+      case 16: return (unsigned int)(r.PC & 0xFFFF);
+      default: return 0;
+   }
+}
+
+/* RANGE watch state + ring buffer (CAP 4096). mode 1=read 2=write 3=both. The
+ * CPU_PEEK / CPU_POKE hooks (c65c02.h) call romdev_range_log; recorded pc is mPC
+ * (the executing instruction). */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;
+unsigned int  romdev_range_stored  = 0;
+
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+   romdev_range_count++;
+   if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+      romdev_range_pc  [romdev_range_stored] = pc;
+      romdev_range_addr[romdev_range_stored] = addr;
+      romdev_range_val [romdev_range_stored] = val;
+      romdev_range_stored++;
+   }
+}
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+   romdev_range_lo = lo; romdev_range_hi = hi;
+   romdev_range_mode = mode ? mode : 3;
+   romdev_range_enabled = enabled ? 1 : 0;
+   romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...].
+ * out2 (size 2) gets [totalSeen, stored]. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_range_stored;
+   if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_range_pc[i];
+      out[i*3 + 1] = romdev_range_addr[i];
+      out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+   }
+   return n;
+}
+
+/* PC COVERAGE state + linear-dedup buffer (CAP 8192). Hook in C65C02::Update. */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;
+unsigned int  romdev_cov_total   = 0;
+
+void romdev_cov_log(unsigned int pc)
+{
+   unsigned int i;
+   romdev_cov_total++;
+   for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+   if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_cov_lo = lo; romdev_cov_hi = hi;
+   romdev_cov_enabled = enabled ? 1 : 0;
+   romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_cov_count;
+   if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+   return n;
+}
+}
+
+/* romdev debug state regions (Lynx). High IDs so they never collide with the
+ * libretro RETRO_MEMORY_* enum; honored only by this patched core.
+ *   0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
+ *          assembled from the public CSystem::GetRegs(C6502_REGS&).
+ *   0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes),
+ *          read through the public Peek_CPU memory-map path. This is Suzy
+ *          ($FC00-$FCFF: sprite engine regs) + Mikey ($FD00-$FDFF: LCD control,
+ *          audio at $FD20-$FD3F, palette at $FDA0-$FDBF). The CPU registers and
+ *          this HW window are SYNTHESIZED into static buffers per call because
+ *          the chips' fields are private — Peek is the sanctioned public read
+ *          path and is side-effect-free for these register addresses.
+ * Lynx sprites have NO fixed OAM — they are SCB linked lists walked from a RAM
+ * address — so there is no sprite region; inspectSprites must walk SCBs over the
+ * already-exported SYSTEM_RAM. */
+#define ROMDEV_REGION_LYNX_CPU_REGS 0x190u
+#define ROMDEV_REGION_LYNX_HW_REGS  0x191u
+
+static unsigned char romdev_lynx_cpu_buf[8];
+static unsigned char romdev_lynx_hw_buf[0x200]; /* $FC00-$FDFF */
+
+static void *romdev_lynx_fill_cpu(void)
+{
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   romdev_lynx_cpu_buf[0] = (unsigned char)(r.PC & 0xff);
+   romdev_lynx_cpu_buf[1] = (unsigned char)((r.PC >> 8) & 0xff);
+   romdev_lynx_cpu_buf[2] = (unsigned char)(r.A & 0xff);
+   romdev_lynx_cpu_buf[3] = (unsigned char)(r.X & 0xff);
+   romdev_lynx_cpu_buf[4] = (unsigned char)(r.Y & 0xff);
+   romdev_lynx_cpu_buf[5] = (unsigned char)(r.SP & 0xff);
+   romdev_lynx_cpu_buf[6] = (unsigned char)(r.PS & 0xff);
+   romdev_lynx_cpu_buf[7] = (unsigned char)((r.NMI ? 0x80 : 0) | (r.IRQ ? 0x40 : 0) | (r.WAIT ? 0x20 : 0));
+   return romdev_lynx_cpu_buf;
+}
+
+static void *romdev_lynx_fill_hw(void)
+{
+   for (unsigned i = 0; i < 0x200; ++i)
+      romdev_lynx_hw_buf[i] = lynx->Peek_CPU(0xFC00 + i);
+   return romdev_lynx_hw_buf;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
-   if (lynx && type == RETRO_MEMORY_SYSTEM_RAM)
-      return lynx->GetRamPointer();
+   if (!lynx) return NULL;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return lynx->GetRamPointer();
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return romdev_lynx_fill_cpu();
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return romdev_lynx_fill_hw();
    return NULL;
 }
 
 size_t retro_get_memory_size(unsigned type)
 {
-   if (type == RETRO_MEMORY_SYSTEM_RAM)
-      return 1024 * 64;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return 1024 * 64;
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return sizeof(romdev_lynx_cpu_buf);
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return sizeof(romdev_lynx_hw_buf);
    return 0;
 }
diff --git a/lynx/c65c02.h b/lynx/c65c02.h
index 0fdea74..2ee8bc3 100644
--- a/lynx/c65c02.h
+++ b/lynx/c65c02.h
@@ -65,9 +65,100 @@
 //#define CPU_PEEKW(m)			(mSystem.PeekW_CPU(m))
 //#define CPU_POKE(m1,m2)			(mSystem.Poke_CPU(m1,m2))
 
-#define CPU_PEEK(m)				(((m<0xfc00)?mRamPointer[m]:mSystem.Peek_CPU(m)))
+/* romdev instruction-level write watchpoint (Lynx 65C02). The CPU_POKE macro is
+ * the central write path; mPC is the live program counter. Records the writing
+ * PC when a watched address is written. State has C linkage so libretro.cpp can
+ * extern + export it. (The 65C02 addresses a flat 64KB space — no ROM banking
+ * to disambiguate — so PC alone is unambiguous; no bank field.) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+/* romdev instruction-level READ watchpoint (Lynx 65C02) — mirror of the write
+ * watch above. The CPU_PEEK macro is the central read path (used for both
+ * operand/data reads and the opcode fetch). When enabled, any read of a watched
+ * address records the reading PC (mPC), the value, and a hit count. State has C
+ * linkage so libretro.cpp can extern + export it via romdev_readwatch_*. */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+/* romdev at-hit register snapshot (defined in libretro.cpp). Layout = the
+ * romdev_getreg regId order: [0]=A [1]=X [2]=Y [3]=PS [4]=SP [16]=PC of the
+ * EXECUTING instruction's first byte [18]=SP. kind: 1=pc-break/step,
+ * 2=watchdog, 3=write-watch, 4=read-watch. romdev_65c02_instr_pc is latched at
+ * dispatch in Update() — mPC advances past operands mid-instruction, so the
+ * write/read hooks must report the latch, not the live mPC. */
+extern unsigned int  romdev_snap_regs[19];
+extern int           romdev_snap_kind;
+extern unsigned int  romdev_65c02_instr_pc;
+extern unsigned int  romdev_65c02_snap(unsigned int a, unsigned int x, unsigned int y, unsigned int ps, unsigned int sp, int kind);
+/* romdev INTERRUPT BLOCK — the pure-call primitive: while set, IRQ delivery
+ * is suppressed (Mikie keeps the line pending), so a callSubroutine-driven
+ * routine cannot be hijacked by the game's timer/video handlers. */
+extern int           romdev_irq_block;
+
+/* romdev PC BREAKPOINT (Lynx 65C02). Compared in C65C02::Update() just before
+ * the opcode fetch, where mPC == the address of the instruction about to
+ * execute. On a hit (or single-step countdown), romdev_pc_hit is set and mPC is
+ * left un-incremented so the CPU is frozen exactly at the breakpoint; the
