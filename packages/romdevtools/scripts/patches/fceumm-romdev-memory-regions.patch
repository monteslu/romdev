+/* romdev (0.80.0): the watchpoint/readwatch/range/coverage/pcbreak/watchdog state +
+ * machinery now live in the shared romdev_debug.c. x6502.c keeps only the 6502-specific
+ * bits: the instruction-PC latch, the at-hit register snapshot (6502 layout), the NES
+ * VRAM-port copy trace, and the PRG-offset helper (romdev_6502_romoff, below). */
+#include "romdev_debug.h"
+
+/* First-byte address of the instruction being executed, latched at dispatch in
+ * X6502_Run — X.PC is only synced at loop boundaries, so mid-instruction hooks
+ * must report THIS. */
+uint32_t      romdev_6502_instr_pc = 0xFFFFFFFF;
+
+/* romdev VRAM-port COPY TRACE (the source-trace primitive for port-based
+ * video memory): log every CPU write that lands in a watched VRAM address
+ * window, with the EXECUTING instruction's PC — answers "which routine
+ * uploads this tile/nametable region?" the way watch({on:'dma'}) does on
+ * Genesis. Hooked in ppu.c's $2007 data-port handler; the vaddr is the PPU
+ * address (RefreshAddr), not a CPU address. Ring buffer; host drains it. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+unsigned int  romdev_vw_addr[ROMDEV_VW_CAP];
+unsigned int  romdev_vw_pc  [ROMDEV_VW_CAP];
+unsigned char romdev_vw_val [ROMDEV_VW_CAP];
+unsigned int  romdev_vw_count   = 0;
+unsigned int  romdev_vw_stored  = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+	romdev_vw_count++;
+	if (romdev_vw_stored < ROMDEV_VW_CAP) {
+		romdev_vw_addr[romdev_vw_stored] = vaddr;
+		romdev_vw_pc  [romdev_vw_stored] = pc;
+		romdev_vw_val [romdev_vw_stored] = val;
+		romdev_vw_stored++;
+	}
+}
