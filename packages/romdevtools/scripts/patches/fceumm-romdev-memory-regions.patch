+             * reachable here. MMC5's 1KB ExRAM at $5C00-$5FFF is a separate
+             * on-chip block and is likewise outside this window. */
+            for (i = 1; i < 4 && contiguous; i++) {
+               uint32_t base = 0x6000 + i * 0x800;
+               if (Page[base >> 11] != p0) contiguous = 0;
+            }
+            if (contiguous) {
