+/* rom-dev-mcp extension: custom memory region IDs above libretro standard.
+ * Lets the host inspect NES PPU + APU state for agent-driven dev workflows.
+ * IDs mirror those used by snes9x/gpgx patches (same project). */
+#define ROMDEV_MEMORY_NES_NAMETABLES 0x100  /* 2KB NTARAM (CIRAM) */
+#define ROMDEV_MEMORY_NES_PALETTE    0x101  /* 32B PALRAM */
+#define ROMDEV_MEMORY_NES_OAM        0x102  /* 256B SPRAM */
+#define ROMDEV_MEMORY_NES_CHR        0x103  /* 8KB CHR via VPage[0..7] */
+#define ROMDEV_MEMORY_NES_APU_REGS   0x104  /* 24B synthesized APU register snapshot ($4000-$4017) */
+#define ROMDEV_MEMORY_NES_CPU_REGS   0x105  /* sizeof(X6502) — live 6502 CPU struct snapshot */
+#define ROMDEV_MEMORY_NES_PPU_REGS   0x106  /* 4B PPU latch — PPUCTRL/PPUMASK/PPUSTATUS/OAMADDR */
+#define ROMDEV_MEMORY_NES_CART_RAM   0x107  /* 8KB cart WRAM at CPU $6000-$7FFF */
+#define ROMDEV_MEMORY_NES_SCROLL     0x108  /* 8B scroll: v[x,y,nt,pad] then t[x,y,nt,pad] */
+/* PER-SCANLINE scroll: 240 entries x [x, y, ntSelect, pad].
+ * A frame-boundary snapshot CANNOT reconstruct a mid-frame scroll change --
+ * games rewrite both v AND t during the frame, so by vblank the value the top
+ * of the screen actually rendered with is simply gone. This table records the
+ * effective scroll AS EACH SCANLINE IS REACHED, which is the only way to
+ * reproduce a raster split (status bars, parallax, Zanac's HUD). */
+#define ROMDEV_MEMORY_NES_SCROLL_LINES 0x109
+/* PER-SCANLINE background CHR: 240 lines x 4KB of pattern data.
+ * MMC2/MMC4 swap a CHR bank when tile $FD/$FE is FETCHED, so the same tile
+ * index legitimately means different pixels in different parts of one frame.
+ * A single 8KB snapshot cannot express that. Only the 4KB half the background
+ * is using is recorded (PPUCTRL bit4 picks it), which keeps this to 960KB. */
+#define ROMDEV_MEMORY_NES_CHR_LINES  0x10A
+/* PER-TILE background pattern bytes: 240 scanlines x 34 tile columns x 2
+ * bitplane bytes. Captured AT FETCH TIME, which is the only point that is
+ * correct for MMC2/MMC4: their CHR latch fires when tile $FD/$FE is FETCHED,
+ * i.e. many times per scanline, so ANY per-scanline snapshot returns
+ * byte-identical data for lines that provably render from different banks.
+ * Storing the fetched bytes themselves sidesteps bank tracking entirely. */
+#define ROMDEV_MEMORY_NES_BGFETCH    0x10B
+/* PER-SCANLINE evaluated SPRITES: 240 lines x 8 slots x 4 bytes
+ * [patternLo, patternHi, attr, x] -- the layout of fceumm's SPRB struct.
+ * Captured inside the PPU's own sprite
+ * evaluation, which is the only point that is correct when a game rewrites OAM
+ * mid-frame (many titles reuse the same 64 slots repeatedly per frame, so at vblank
+ * almost every slot reads y=244 "offscreen" while the screen is full of them).
+ * Already post-flip, post-bank and post-8-per-line cutoff. */
+#define ROMDEV_MEMORY_NES_SPRLINES   0x10C
+/* Which PHYSICAL 1KB page each of the four logical nametables resolves to:
+ * 4 bytes, values 0..1 (an index into the 2KB CIRAM). This is the mapper's own
+ * `vnapage` table, i.e. the mirroring as WIRED RIGHT NOW -- the iNES header is
+ * only a power-on default and any mapper with a mirroring register changes it.
+ * The renderer indexes it directly (vnapage[(v >> 10) & 3]) and does no
+ * mirroring arithmetic of its own; reconstructing that guess-wise is what made
+ * a game fetch its ATTRIBUTE bytes from the wrong half, giving pixel-perfect
+ * tiles in pixel-perfect positions with the wrong sub-palette. */
+#define ROMDEV_MEMORY_NES_NTMAP      0x10D
+/* PER-SCANLINE palette: 240 lines x 32 bytes, captured as each line renders.
+ * Games change PALRAM mid-frame (Kirby recolours a 32-line band), so a single
+ * frame-end read misses colours that are on screen for part of the frame --
+ * they show up as colours present in the core's output and ENTIRELY ABSENT
+ * from a reconstruction. */
+#define ROMDEV_MEMORY_NES_PALLINES   0x10E
+/* PER-SCANLINE PPUMASK: 240 bytes, captured as each line renders. Games toggle
+ * background/sprite enable and the left-column clip MID-FRAME (Kirby disables
+ * sprites for part of the frame, so a frame-end read says "sprites off" while
+ * the screen is full of them). A single frame-end sample makes a renderer skip
+ * layers that are genuinely visible. */
+#define ROMDEV_MEMORY_NES_MASKLINES  0x10F
+/* PER-SCANLINE nametable map: 240 lines x 4 bytes. A mapper can change the
+ * mirroring MID-FRAME (AxROM flips its one-screen selection, so Cobra Triangle
+ * renders some lines from CIRAM page 0 and others from page 1). A single
+ * frame-end vnapage read then attributes the whole screen to one page and every
+ * attribute byte comes from the wrong half. */
+#define ROMDEV_MEMORY_NES_NTMAPLINES 0x110
+/* PER-PIXEL background palette INDEX: 240 lines x 256 px, one byte each
+ * (0-15, already combining the 2 pattern bits with the 2 attribute bits).
+ * This is what pputile.h computes and writes to the framebuffer, captured at
+ * the point it is emitted -- so it is immune to every reconstruction hazard at
+ * once: prefetch pipelining, mid-scanline CHR latches, attribute quadrant math
+ * and nametable mirroring. Reconstructing those from separate captures kept
+ * producing 1-tile and 1-line offsets. */
+#define ROMDEV_MEMORY_NES_BGPIX      0x111
+/* PER-SCANLINE backdrop (palette entry 0): 240 bytes, sampled where the PPU
+ * COMMITS to it -- inside the two blank paths that fill a line with Pal[0].
+ * The DoLine-entry pallines snapshot is a different moment: a game writing
+ * $3F00 partway down a line has the change land in the NEXT line's slot, so
+ * the row that actually used the new colour keeps the old one. */
+#define ROMDEV_MEMORY_NES_BACKDROP   0x112
+#define ROMDEV_MEMORY_NES_SPRDRAWN   0x113
+/* PER-PIXEL resolved background palette VALUE (240 x 256), recorded where
+ * pputile.h does P[n] = PALRAM[index]. pallines is sampled at line entry and
+ * misses a mid-line $3F00-$3F1F write, so the row that used the new colour
+ * keeps the old one (Lion King III flips pal[5] $07 -> $08 mid-line 194). */
+#define ROMDEV_MEMORY_NES_BGVAL      0x114
+/* PER-PIXEL PPUMASK (240 x 256). Emphasis (bits 5-7) and greyscale (bit 0) are
+ * applied per pixel downstream, and games flip them partway down a line. */
+#define ROMDEV_MEMORY_NES_MASKPIX    0x115
+/* The FINAL emitted planes, captured after greyscale and emphasis are applied.
+ * 0x116 is XBuf for the visible 240 lines (palette value per pixel, low 6 bits
+ * significant); 0x117 is one emphasis byte per line from XDBuf. Together with
+ * retro_palette[256 + (deemp & 7) * 64 + (pix & 0x3F)] they reproduce the
+ * framebuffer exactly, including mid-line mask writes that retroactively
+ * re-colour pixels emitted earlier in the same line. */
+#define ROMDEV_MEMORY_NES_LINEPIX    0x116
+#define ROMDEV_MEMORY_NES_LINEDEEMP  0x117
+/* The ACTIVE 64-entry PPU palette as RGB triples. VS System carts select
+ * rp2c03/rp2c04 variants instead of the standard NTSC table, so a baked-in
+ * table renders them entirely wrong. */
+#define ROMDEV_MEMORY_NES_PALRGB     0x118
+
+static uint8_t romdev_chr_buf[8192];
+static uint8_t romdev_apu_buf[24];
+static uint8_t romdev_cpu_buf[sizeof(X6502)];
+static uint8_t romdev_cartram_buf[8192];
+static uint8_t romdev_scroll_buf[8];
+extern uint8_t romdev_scroll_lines[240 * 4];
+extern uint8_t romdev_chr_lines[240 * 4096];
+extern uint8_t romdev_bgfetch[240 * 34 * 2];
+extern uint8_t romdev_sprlines[240 * 8 * 4];
+extern uint8_t romdev_ntmap[4];
+extern uint8_t romdev_pallines[240 * 32];
+extern uint8_t romdev_masklines[240];
+extern uint8_t romdev_ntmaplines[240 * 4];
+extern uint8_t romdev_bgpix[240 * 256];
+extern uint8_t romdev_bgval[240 * 256];
+extern uint8_t romdev_maskpix[240 * 256];
+extern uint8_t romdev_linepix[240 * 256];
+extern uint8_t romdev_linedeemp[240];
+extern uint8_t romdev_palrgb[64 * 3];
+extern uint8_t romdev_backdrop[240 * 256];
+extern uint8_t romdev_sprdrawn[240 * 256];
+extern void romdev_ntmap_update(void);
+extern void romdev_ppu_scroll(uint8_t *out);   /* decodes loopy v; lives in ppu.c */
+
+/* Synthesize the 24-byte APU register file from fceumm's scattered
+ * register-holder vars. Layout matches the NES APU register map at
+ * CPU $4000-$4017. */
+static void romdev_apu_snapshot(uint8_t *buf) {
+   int i;
+   for (i = 0; i < 16; i++) buf[i] = PSG[i];
+   buf[0x10] = DMCFormat;
+   buf[0x11] = RawDALatch;
+   buf[0x12] = DMCAddressLatch;
+   buf[0x13] = DMCSizeLatch;
+   buf[0x14] = 0;
+   buf[0x15] = EnabledChannels;
+   buf[0x16] = 0;
+   buf[0x17] = IRQFrameMode;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
    uint8_t* data;
@@ -3965,6 +4188,189 @@ void *retro_get_memory_data(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          data = RAM;
          break;
+      case ROMDEV_MEMORY_NES_NAMETABLES:
+         data = NTARAM;
+         break;
+      case ROMDEV_MEMORY_NES_PALETTE:
+         data = PALRAM;
+         break;
+      case ROMDEV_MEMORY_NES_OAM:
+         data = SPRAM;
+         break;
+      case ROMDEV_MEMORY_NES_CHR:
+         {
+            int i;
+            /* R61: VPage[i] is the PPU's lookup pointer for the i-th
+             * 1KB slot of pattern memory ($0000-$1FFF). To get the
+             * actual bytes at PPU address `i*$400 .. i*$400+$3FF`,
+             * you index it AS the PPU does: VPage[i] + (i * $400).
+             *
+             * Why: fceumm stores VPage[i] differently depending on the
+             * mapper. setchr8 (NROM, full 8KB single bank): all eight
+             * VPage[i] point to the same 8KB base — reading `VPage[i]+0`
+             * gives the first 1KB regardless of i. setchr1 (per-1KB
+             * mappers like MMC3): VPage[i] = `bank_start - i*$400` so
+             * that PPU reads `VPage[i][ppu_addr]` resolve correctly,
+             * but reading `VPage[i]+0` is a pointer BEFORE valid
+             * memory. Either way, `VPage[i] + i*$400` is what the PPU
+             * itself dereferences for that slot's pattern data.
+             *
+             * R59 attempted to "fix" this by removing the `+ i*$400`,
+             * which collapsed NROM's 8KB readback into 8 copies of the
+             * first 1KB (so `readMemory(nes_chr, $1010)` returned the
+             * same bytes as `$0010`) and read garbage from setchr1
+             * mappers. R61 restores the original PPU-index math. */
+            for (i = 0; i < 8; i++) {
+               if (VPage[i]) memcpy(romdev_chr_buf + i * 1024, VPage[i] + i * 1024, 1024);
+               else memset(romdev_chr_buf + i * 1024, 0, 1024);
+            }
+            data = romdev_chr_buf;
+         }
+         break;
+      case ROMDEV_MEMORY_NES_APU_REGS:
+         romdev_apu_snapshot(romdev_apu_buf);
+         data = romdev_apu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_CPU_REGS:
+         memcpy(romdev_cpu_buf, &X, sizeof(X6502));
+         data = romdev_cpu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_PPU_REGS:
+         data = PPU;
+         break;
+      case ROMDEV_MEMORY_NES_SCROLL:
+         {
+            /* The PPU's LATCHED scroll, decoded from the loopy v register.
+             *
