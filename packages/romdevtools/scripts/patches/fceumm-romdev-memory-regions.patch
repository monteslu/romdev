+/* romdev (0.80.0): the watchpoint/readwatch/range/coverage/pcbreak/watchdog/regsnap/
+ * irqblock exports now come from the shared romdev_debug.c (built into the core). Only
+ * the NES-specific VRAM-port watch + the 6502 romdev_setReg/getReg + the memory-region
+ * accessors stay here. The 6502 register SNAPSHOT (romdev_6502_snap) lives in x6502.c. */
+#include "romdev_debug.h"
+
+/* romdev VRAM-port copy trace (state in x6502.c, hook in ppu.c's $2007
+ * handler). set(lo,hi,enabled) arms a window of PPU addresses and clears the
+ * ring; get drains up to max events as [vaddr,pc,val] triples, out2 =
+ * [totalSeen, stored]. */
+extern unsigned int  romdev_vw_lo, romdev_vw_hi;
+extern int           romdev_vw_enabled;
+extern unsigned int  romdev_vw_addr[], romdev_vw_pc[];
+extern unsigned char romdev_vw_val[];
+extern unsigned int  romdev_vw_count, romdev_vw_stored;
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addr[i];
+      out[i*3 + 1] = romdev_vw_pc[i];
+      out[i*3 + 2] = romdev_vw_val[i];
+   }
+   return n;
+}
+
+/* romdev register read/write — the inverse of getCPUState, used by the host's
+ * callSubroutine / setRegister (set A/X/Y/PC, push a sentinel return, run to it,
+ * capture the output). romdev 6502 reg-id convention (STABLE across all cores so
+ * the host passes the same ids): 0=A, 1=X, 2=Y, 3=P(status), 4=SP, 16=PC. Maps
+ * onto fceumm's X6502 struct (X.A/X.X/X.Y/X.P/X.S/X.PC). Returns 0 on success,
+ * -1 on an unknown id from setreg; getreg returns the value (0 for unknown). The
+ * NES PC is a flat 16-bit address (no bank arg) — fine for RE; the write-watch
+ * reports prgOffset separately if the bank matters. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  X.A  = (uint8_t)value;  return 0;  /* A */
+      case 1:  X.X  = (uint8_t)value;  return 0;  /* X */
+      case 2:  X.Y  = (uint8_t)value;  return 0;  /* Y */
+      case 3:  X.P  = (uint8_t)value;  return 0;  /* P (status) */
+      case 4:  X.S  = (uint8_t)value;  return 0;  /* SP */
+      case 16: X.PC = (uint16_t)value; return 0;  /* PC */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   switch (regId) {
+      case 0:  return (unsigned int)X.A;
+      case 1:  return (unsigned int)X.X;
+      case 2:  return (unsigned int)X.Y;
+      case 3:  return (unsigned int)X.P;
+      case 4:  return (unsigned int)X.S;
+      case 16: return (unsigned int)X.PC;
+      default: return 0;
+   }
+}
