+             * register file to read a scroll position back from. Consumers that
+             * need it (a bezel re-rendering the scene from PPU state) otherwise
+             * have to reverse-engineer whichever zero-page address a particular
+             * GAME happens to keep its own copy in -- which is per-cartridge
+             * work, and worse, is read a frame late: the game updates its copy
+             * during logic AFTER the PPU latched the value for the frame being
+             * displayed, so it is 1-2px stale whenever the camera is moving.
+             *
+             * v layout (loopy):  yyy NN YYYYY XXXXX
+             *   bits 0-4   coarse X (tile column)
+             *   bits 5-9   coarse Y (tile row)
+             *   bits 10-11 nametable select
+             *   bits 12-14 fine Y
+             * Fine X lives separately in XOffset. Exposed DECODED -- byte 0 is
+             * the full 0-255 X scroll (coarse*8 | fine), byte 1 the full 0-239
+             * Y scroll, byte 2 the nametable select -- so a consumer does not
+             * have to know the loopy bit layout at all. */
+            romdev_ppu_scroll(romdev_scroll_buf);
+            data = romdev_scroll_buf;
+         }
+         break;
+      case ROMDEV_MEMORY_NES_CHR_LINES:
+         data = romdev_chr_lines;
+         break;
+      case ROMDEV_MEMORY_NES_BGFETCH:
+         data = romdev_bgfetch;
+         break;
+      case ROMDEV_MEMORY_NES_SPRLINES:
+         data = romdev_sprlines;
+         break;
+      case ROMDEV_MEMORY_NES_NTMAP:
+         romdev_ntmap_update();
+         data = romdev_ntmap;
+         break;
+      case ROMDEV_MEMORY_NES_PALLINES:
+         data = romdev_pallines;
+         break;
+      case ROMDEV_MEMORY_NES_MASKLINES:
+         data = romdev_masklines;
+         break;
+      case ROMDEV_MEMORY_NES_NTMAPLINES:
+         data = romdev_ntmaplines;
+         break;
+      case ROMDEV_MEMORY_NES_BGPIX:
+         data = romdev_bgpix;
+         break;
+      case ROMDEV_MEMORY_NES_BACKDROP:
+         data = romdev_backdrop;
+         break;
+      case ROMDEV_MEMORY_NES_SPRDRAWN:
+         data = romdev_sprdrawn;
+         break;
+      case ROMDEV_MEMORY_NES_BGVAL:
+         data = romdev_bgval;
+         break;
+      case ROMDEV_MEMORY_NES_MASKPIX:
+         data = romdev_maskpix;
+         break;
+      case ROMDEV_MEMORY_NES_LINEPIX:
+         data = romdev_linepix;
+         break;
+      case ROMDEV_MEMORY_NES_LINEDEEMP:
+         data = romdev_linedeemp;
+         break;
+      case ROMDEV_MEMORY_NES_PALRGB:
+         data = romdev_palrgb;
+         break;
+      case ROMDEV_MEMORY_NES_SCROLL_LINES:
+         {
+            data = romdev_scroll_lines;
+         }
+         break;
+      case ROMDEV_MEMORY_NES_CART_RAM:
+         {
+            /* Cart WRAM at CPU $6000-$7FFF (8KB), regardless of the battery
+             * flag. RETRO_MEMORY_SAVE_RAM deliberately returns NULL for a
+             * non-battery cart -- its contract is "bytes to persist to .srm",
