+uint32_t      romdev_pc_snap_x  = 0xFFFFFFFF;
+uint32_t      romdev_pc_snap_y  = 0xFFFFFFFF;
+uint32_t      romdev_pc_snap_p  = 0xFFFFFFFF;
+uint32_t      romdev_pc_snap_s  = 0xFFFFFFFF;
