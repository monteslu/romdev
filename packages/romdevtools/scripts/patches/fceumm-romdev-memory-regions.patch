+/* romdev at-hit register snapshot (6502 layout — per-core). Fills the shared
+ * romdev_snap_regs[] in the romdev_getReg regId order ([0]=A [1]=X [2]=Y [3]=P
+ * [4]=S [16]=PC-of-executing-instruction [18]=S) + the kind. The hooks call this
+ * when the shared lib reports a hit. */
+static void romdev_6502_snap(int kind) {
+	int i;
+	for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+	romdev_snap_regs[0]  = (uint32_t)X.A;
+	romdev_snap_regs[1]  = (uint32_t)X.X;
+	romdev_snap_regs[2]  = (uint32_t)X.Y;
+	romdev_snap_regs[3]  = (uint32_t)X.P;
+	romdev_snap_regs[4]  = (uint32_t)X.S;
+	romdev_snap_regs[16] = romdev_6502_instr_pc;
+	romdev_snap_regs[18] = (uint32_t)X.S;
+	romdev_snap_kind = kind;
+}
+
+#include "cart.h"
+static unsigned romdev_6502_romoff(uint32_t pc) {
+	uint8_t *p;
+	int c;
+	if (pc < 0x8000) return 0xFFFFFFFFu;
+	p = Page[(pc >> 11) & 31] + pc;
+	for (c = 0; c < 32; c++) {
+		if (PRGptr[c] && PRGsize[c]) {
+			ptrdiff_t d = p - PRGptr[c];
+			if (d >= 0 && (uint32_t)d < PRGsize[c]) return (unsigned)d;
+		}
+	}
+	return 0xFFFFFFFFu;
+}
 
