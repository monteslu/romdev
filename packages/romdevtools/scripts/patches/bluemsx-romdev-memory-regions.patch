diff --git a/Src/VideoChips/VDP.c b/Src/VideoChips/VDP.c
index 8e5400d..120d425 100644
--- a/Src/VideoChips/VDP.c
+++ b/Src/VideoChips/VDP.c
@@ -397,6 +397,361 @@ struct VDP {
     FrameBufferData* frameBuffer;
 };
 
+/* ---- romdev memory-region accessors (see VDP.h) --------------------- */
+/* Placed after the full `struct VDP` definition so the field accesses below
+ * see a complete type (the typedef earlier in the file is only a forward decl). */
+unsigned char* vdpRomdevGetVram(void) {
+    return theVdp ? theVdp->vram : (unsigned char*)0;
+}
+int vdpRomdevGetVramSize(void) {
+    return theVdp ? theVdp->vramSize : 0;
+}
+unsigned char* vdpRomdevGetRegs(void) {
+    return theVdp ? theVdp->vdpRegs : (unsigned char*)0;
+}
+unsigned char* vdpRomdevGetStatus(void) {
+    return theVdp ? theVdp->vdpStatus : (unsigned char*)0;
+}
+unsigned char* vdpRomdevGetPalette(void) {
+    return theVdp ? (unsigned char*)theVdp->paletteReg : (unsigned char*)0;
+}
+
+/* ---- romdev per-scanline VDP state capture (region msx_vdp_reglines) ----
+ *
+ * WHY THIS EXISTS. A reconstruction that reads the VDP registers ONCE per frame
+ * cannot describe a frame the game changed partway down the screen: raster
+ * splits (a status bar in a different SCREEN mode), mid-screen palette swaps,
+ * per-line scroll. The framebuffer then holds TWO states while the snapshot
+ * holds one, and the mismatch reads as a renderer bug. Measured on this core:
+ * Dragon Slayer 4 draws rows 30..130 with SCREEN 8 colours while the registers
+ * left at vblank say SCREEN 5, and C-So! splits at rows 48..111.
+ *
+ * The record is what the line renderer ACTUALLY USED, captured at the top of
+ * the line, not re-derived afterwards -- per the standing rule to capture the
+ * resolved value from the core rather than recompute it.
+ *
+ * `valid` distinguishes "this line rendered this frame" from a stale record;
+ * without it a consumer reads register 0 on an unrendered line, and 0 is a
+ * LEGAL value, so the error is silent. Same class of bug the PCE profile hit
+ * with pce_vdc_reglines.
+ */
+#define ROMDEV_MSX_REGLINES 256   /* lastLine is 262 (NTSC) / 313 (PAL); the
+                                   * drawn window is <= SCREEN_HEIGHT (240) plus
+                                   * displayOffest (27 on PAL) = 267 worst case,
+                                   * but only lines inside the framebuffer are
+                                   * ever refreshed, so 256 covers every drawn
+                                   * line and keeps the region a round 24 KB. */
+#pragma pack(push, 1)
+struct romdev_msx_regline {
+    unsigned char  regs[64];      /* the 64 VDP control registers */
+    unsigned short palette[16];   /* paletteReg[] -- games swap it mid-frame */
+    unsigned char  status2;       /* vdpStatus[2]: bit1 feeds vdpIsOddPage */
+    unsigned char  valid;         /* 0 = this line did not render this frame */
+    unsigned short line;          /* the VDP scanline, echoed for validation */
+    unsigned short firstLine;     /* resolved display start for THIS line */
+    unsigned short activeLines;   /* 192 or 212, resolved for THIS line */
+    unsigned char  displayOffest; /* 27 on PAL, 0 on NTSC */
+    unsigned char  pad;
+};
+#pragma pack(pop)
+static struct romdev_msx_regline romdev_msx_reglines[ROMDEV_MSX_REGLINES];
+
+unsigned char* vdpRomdevGetReglines(void) {
+    return (unsigned char*)romdev_msx_reglines;
+}
+int vdpRomdevGetReglinesSize(void) {
+    return (int)sizeof(romdev_msx_reglines);
+}
+int vdpRomdevGetReglineStride(void) {
+    return (int)sizeof(struct romdev_msx_regline);
+}
+
+/* Called from vdp_sync at the top of every line handed to RefreshLine. */
+static void romdev_msx_regline_record(VDP* vdp, int line)
+{
+    struct romdev_msx_regline* d;
+    int i;
+    if (line < 0 || line >= ROMDEV_MSX_REGLINES)
+        return;
+    d = &romdev_msx_reglines[line];
+    for (i = 0; i < 64; i++)
+        d->regs[i] = vdp->vdpRegs[i];
+    for (i = 0; i < 16; i++)
+        d->palette[i] = vdp->paletteReg[i];
+    d->status2       = vdp->vdpStatus[2];
+    d->valid         = 1;
+    d->line          = (unsigned short)line;
+    d->firstLine     = (unsigned short)vdp->firstLine;
+    /* R9 bit7 selects 212 lines; resolved here so a consumer never has to
+     * guess which R9 was live for this particular line. */
+    d->activeLines   = (unsigned short)((vdp->vdpRegs[9] & 0x80) ? 212 : 192);
+    d->displayOffest = (unsigned char)vdp->displayOffest;
+}
+
+/* Invalidate the whole record at the start of a frame. Done on the frame-start
+ * path rather than in retro_run because retro_run can return mid-frame on a
+ * romdev breakpoint, which would leave a half-written record looking valid. */
+static void romdev_msx_reglines_reset(void)
+{
+    memset(romdev_msx_reglines, 0, sizeof(romdev_msx_reglines));
+}
+
+/* ---- romdev per-frame VRAM delta log (region msx_vram_deltas) -----------
+ *
+ * WHY. Per-scanline REGISTER records fixed the raster-split class, but 13 of
+ * the remaining imperfect frames showed NO per-line register or palette
+ * variation at all: the game rewrites VRAM while the beam runs (Car Fighter:
+ * 158 bytes/frame with completely constant registers), so the end-of-frame
+ * VRAM snapshot differs from what earlier lines were rendered from.
+ *
+ * WHAT. Every VRAM write that lands during a frame is logged as
+ * {line, oldValue, newValue, addr}. BOTH values are required: a consumer holds
+ * the END-of-frame snapshot, so it must UNDO the whole log (restore oldv,
+ * reverse order) to recover the frame-START state, then REDO entries (apply
+ * newv, forward order) up to each line as it renders. A new-value-only log
+ * cannot reconstruct any earlier state, which is why the entry is 8 bytes and
+ * not 6.
+ *
+ * The cap makes overflow VISIBLE, never silently wrong: once full, `truncated`
+ * is set and a consumer must fall back to the plain snapshot -- a partial log
+ * would rebuild a frame-start state that never existed. Writes where
+ * oldv == newv are skipped; they have no visual effect and only burn cap.
+ *
+ * Two write paths feed it:
+ *   1. the CPU port write (write() below) -- write() runs vdp_sync first, so
+ *      vdp->curLine is exact at that moment;
+ *   2. the V9938 command engine (V9938.c setPixelLow + the block-copy site),
+ *      which advances its OWN clock -- those writes pass vdpCmd->systemTime
+ *      and the line is derived from it here, NOT from boardSystemTime(),
+ *      because vdpCmdExecute batches work spanning many lines per call.
+ */
+#define ROMDEV_MSX_VDELTA_CAP 8192
+/* addr's top two bits carry the WRITE KIND; the low 30 bits are the address
+ * (VRAM linear offset, VDP register number, or palette register index). */
+#define ROMDEV_MSX_VDELTA_KIND_VRAM (0u << 30)
+#define ROMDEV_MSX_VDELTA_KIND_REG  (1u << 30)
+#define ROMDEV_MSX_VDELTA_KIND_PAL  (2u << 30)
+#pragma pack(push, 1)
+struct romdev_msx_vdelta {
+    unsigned short line;     /* the LAST line rendered with the OLD value */
+    /* The horizontal position, in the VDP's OWN rendering unit: vdp_sync's
+     * lineOffset, one unit = one 8-pixel block of the display area (0..33).
+     * The core renders lines in these blocks, so a mid-line change takes
+     * effect exactly at a block boundary -- recording the block is EXACT, not
+     * an approximation. 0xFF = "not applicable / whole line". */
+    unsigned short dot;
+    unsigned int   addr;     /* kind in bits 31:30, address in bits 29:0 */
+    unsigned short oldv;     /* u16: palette registers are 9-bit values */
+    unsigned short newv;
+};
+struct romdev_msx_vdelta_region {
+    unsigned short count;
+    unsigned char  truncated;   /* 1 = log overflowed; consumer must fall back */
+    unsigned char  pad;
+    /* FRAME-END CUT: where rendering stopped when the previous frame wrapped.
+     * The presented framebuffer's pixels AT AND BEYOND this position were not
+     * re-rendered by the frame the log describes -- they are retained from an
+     * earlier frame (DS4's fossil tail: 15/15 pixels identical to the prior
+     * frame). Captured at the frame-start reset, i.e. it is the PREVIOUS
+     * frame's end position; on a deterministic steady state that equals the
+     * current frame's, which the must-fail control verifies empirically.
+     * cutLine 0xFFFF = not yet known (first frame). */
+    unsigned short cutLine;
+    short          cutOffset;
+    struct romdev_msx_vdelta e[ROMDEV_MSX_VDELTA_CAP];
+};
+#pragma pack(pop)
+static struct romdev_msx_vdelta_region romdev_msx_vdeltas;
+
+unsigned char* vdpRomdevGetVramDeltas(void) {
+    return (unsigned char*)&romdev_msx_vdeltas;
+}
+int vdpRomdevGetVramDeltasSize(void) {
+    return (int)sizeof(romdev_msx_vdeltas);
+}
+
+void romdev_msx_vdelta_log(int line, int dot, unsigned int addr,
+                           unsigned short oldv, unsigned short newv)
+{
+    struct romdev_msx_vdelta* d;
+    if (oldv == newv)
+        return;
+    if (romdev_msx_vdeltas.count >= ROMDEV_MSX_VDELTA_CAP) {
+        romdev_msx_vdeltas.truncated = 1;
+        return;
+    }
+    d = &romdev_msx_vdeltas.e[romdev_msx_vdeltas.count++];
+    d->line = (unsigned short)(line < 0 ? 0 : line);
+    d->dot  = (unsigned short)(dot < 0 ? 0xFFFF : dot);
+    d->oldv = oldv;
+    d->newv = newv;
+    d->addr = addr;
+}
+
+/* Attribution: the entry's `line` means "the LAST line rendered with the OLD
+ * value" -- a consumer applies the write before rendering any line > it.
+ *
+ * The boundary matters: a write landing on line Y BEFORE Y has drawn any
+ * pixels (lineOffset <= 0 in vdp_sync's terms) means Y itself already renders
+ * the NEW value, so the entry must say Y-1. Attributing it to Y made the
+ * replay one line late and REGRESSED a snapshot-perfect frame (Magical Kid
+ * Wiz: 100% -> 99.994%) -- the log must never make a frame worse. A write
+ * landing mid-line is genuinely sub-line and keeps Y (the per-line floor). */
+static int romdev_msx_vdelta_line_for(UInt32 systemTime, int* out_dot)
+{
+    int frameTime, line, lineTime, lineOffset;
+    if (out_dot) *out_dot = 0xFFFF;
+    if (!theVdp)
+        return 0;
+    frameTime  = (int)(systemTime - theVdp->frameStartTime);
+    line       = frameTime / HPERIOD;
+    lineTime   = frameTime % HPERIOD - (theVdp->leftBorder - 20);
+    lineOffset = (lineTime + 32) / 32 - 1;
+    if (lineOffset <= 0) {
+        /* Line has not drawn anything yet: the whole line sees the NEW value,
+         * so the entry belongs to the previous line with no dot split. */
+        return line - 1;
+    }
+    if (out_dot) *out_dot = (lineOffset > 33) ? 0xFFFF : lineOffset;
+    return line;
+}
+
+/* Command-engine entry point.
+ *
+ * NOT the engine's clock: vdp_sync calls vdpCmdExecute BEFORE the render
+ * catch-up, so every block rendered in the same sync already sees the writes
+ * the engine just made -- a write stamped with the engine's own systemTime
+ * looks LATER than it is visible (Livingstone's screen wipe: bytes stamped at
+ * dot 25 were visible to blocks the renderer only drew afterwards in that
+ * same call). The correct visibility boundary is the RENDER position at the
+ * moment of the write: vdp->curLine / vdp->lineOffset, which still hold the
+ * pre-catch-up position while the engine runs. */
+void romdev_msx_vdelta_log_at(UInt32 systemTime, unsigned int addr,
+                              unsigned char oldv, unsigned char newv)
+{
+    int line = 0, dot = 0xFFFF;
+    (void)systemTime;
+    if (theVdp) {
+        line = theVdp->curLine;
+        if (theVdp->lineOffset < 0)
+            line -= 1;                    /* line not started: whole-line entry */
+        else if (theVdp->lineOffset <= 33)
