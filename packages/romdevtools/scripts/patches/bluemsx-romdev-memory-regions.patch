+/* ---- romdev memory-region exposure (MSX / MSX2) --------------------- */
+#include "VDP.h"
+#include "AY8910.h"
+#define ROMDEV_MEMORY_MSX_VRAM       0x1C0
+#define ROMDEV_MEMORY_MSX_VDP_REGS   0x1C1
+#define ROMDEV_MEMORY_MSX_VDP_STATUS 0x1C2
+#define ROMDEV_MEMORY_MSX_PALETTE    0x1C3
+#define ROMDEV_MEMORY_MSX_CPU_REGS   0x1C4
+#define ROMDEV_MEMORY_MSX_PSG_REGS   0x1C5
+
+/* Z80/R800 register snapshot. R800's active bank `regs` holds RegisterPair
+ * unions (.W = UInt16); pack into a flat little-endian struct so getCPUState
+ * decodes a stable layout regardless of the core's internal union endianness. */
+#pragma pack(push, 1)
+struct romdev_msx_cpu_snap {
+    unsigned short af, bc, de, hl, ix, iy, pc, sp;
+    unsigned short af1, bc1, de1, hl1;
+    unsigned char  i, r, iff1, iff2, im, halt;
+};
+#pragma pack(pop)
+static struct romdev_msx_cpu_snap romdev_msx_cpu;
+
+static void* romdev_msx_cpu_data(void)
+{
+    R800* cpu = (R800*)boardInfo.cpuRef;
+    if (!cpu) return (void*)0;
+    romdev_msx_cpu.af  = cpu->regs.AF.W;
+    romdev_msx_cpu.bc  = cpu->regs.BC.W;
+    romdev_msx_cpu.de  = cpu->regs.DE.W;
+    romdev_msx_cpu.hl  = cpu->regs.HL.W;
+    romdev_msx_cpu.ix  = cpu->regs.IX.W;
+    romdev_msx_cpu.iy  = cpu->regs.IY.W;
+    romdev_msx_cpu.pc  = cpu->regs.PC.W;
+    romdev_msx_cpu.sp  = cpu->regs.SP.W;
+    romdev_msx_cpu.af1 = cpu->regs.AF1.W;
+    romdev_msx_cpu.bc1 = cpu->regs.BC1.W;
+    romdev_msx_cpu.de1 = cpu->regs.DE1.W;
+    romdev_msx_cpu.hl1 = cpu->regs.HL1.W;
+    romdev_msx_cpu.i    = cpu->regs.I;
+    romdev_msx_cpu.r    = cpu->regs.R;
+    romdev_msx_cpu.iff1 = cpu->regs.iff1;
+    romdev_msx_cpu.iff2 = cpu->regs.iff2;
+    romdev_msx_cpu.im   = cpu->regs.im;
+    romdev_msx_cpu.halt = cpu->regs.halt;
+    return &romdev_msx_cpu;
+}
+
+/* ---- romdev breakpoint / watchpoint exports (Z80 / R800) ------------- */
+/* State + hooks live in Src/Z80/R800.c. These thin setters/getters are the
+ * C-linkage surface the host calls (runUntilPC / runUntilRead / findWriter /
+ * stepInstruction). Layout matches the gpgx m68k template so the core-agnostic
+ * host code reads the same [out5] arrays. */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern volatile int  romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern int           romdev_pc_watchdog;
+
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+/* PC BREAKPOINT. `step` arms a one-instruction single-step (ignores addr). */
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+   romdev_pc_watchdog = 0;
+   romdev_pc_wd_count = 0;
+}
+
+/* Fills out6: [enabled, addr, hit, lastPC, hits, watchdogTripped]. clearHit re-arms. */
+void romdev_pcbreak_get(unsigned int *out6, int clearHit)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_pc_enabled;
+   out6[1] = romdev_pc_addr;
+   out6[2] = (unsigned int)romdev_pc_hit;
+   out6[3] = romdev_pc_last_pc;
+   out6[4] = romdev_pc_hits;
+   out6[5] = (unsigned int)romdev_pc_watchdog;
+   if (clearHit) { romdev_pc_hit = 0; romdev_pc_watchdog = 0; romdev_pc_wd_count = 0; }
+}
+
+/* Arm the instruction watchdog (force-stop a runaway after `limit` instructions;
+ * 0 = disable). The host sets this before driving callSubroutine so a runaway
+ * routine returns control instead of hanging. State + hook live in Src/Z80/R800.c. */
+void romdev_watchdog_set(unsigned int limit)
+{
+   romdev_pc_wd_limit = limit;
+   romdev_pc_wd_count = 0;
+   romdev_pc_watchdog = 0;
+}
+
+/* romdev at-hit register snapshot (defined in R800.c; captured at the instant
+ * a pc-break / watchdog / write-watch / read-watch fires). out[0]=kind (0=none
+ * 1=pc-break/step 2=watchdog 3=write-watch 4=read-watch), out[1]=count(19),
+ * out[2..20]=regs in the romdev Z80 regId order ([0]=A [1]=F [2]=B [3]=C
+ * [4]=D [5]=E [6]=H [7]=L [8]=IX [9]=IY [16]=PC-of-executing-instruction
+ * [18]=SP). `clear` resets the kind. */
+/* romdev interrupt block (pure-call primitive — gates INT/NMI acceptance in
+ * R800.c's run loops). */
+extern int romdev_irq_block;
+void romdev_irqblock_set(int on)
+{
+   romdev_irq_block = on ? 1 : 0;
+}
+
+/* romdev VRAM-port copy trace (hook in VDP.c's data-port write path).
+ * set(lo,hi,enabled) arms a VRAM address window + clears the ring; get
+ * drains [vaddr,pc,val] triples, out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addrs[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs  [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals [ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addrs[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs  [romdev_vw_stored] = pc;
+      romdev_vw_vals [romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addrs[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+extern unsigned int romdev_snap_regs[19];
+extern int          romdev_snap_kind;
+void romdev_regsnap_get(unsigned int *out, int clear)
+{
+   int i;
+   if (!out) return;
+   out[0] = (unsigned int)romdev_snap_kind;
+   out[1] = 19;
+   for (i = 0; i < 19; i++) out[2 + i] = romdev_snap_regs[i];
+   if (clear) romdev_snap_kind = 0;
+}
+
+/* READ watchpoint. */
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* WRITE watchpoint (findWriter). */
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+/* Fills out6: [enabled, addr, lastPC, lastVal, hits, prgOffset]. prgOffset is
+ * always 0xFFFFFFFF for MSX (no sega-style bank resolution here; the host only
+ * needs lastPC). out6[5] kept for layout-compat with the gpgx getter. */
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (unsigned int)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = 0xFFFFFFFF;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* ---- romdev RE primitives round 2 (Z80 / R800) ---------------------- */
+/* register read/write — the inverse of getCPUState, used by the host's
+ * callSubroutine / decompressWith (set args + PC=entry, push a sentinel return,
+ * run to it, capture the output). Z80 reg-id convention (STABLE across all cores
+ * so the host passes the same ids): 0=A 1=F 2=B 3=C 4=D 5=E 6=H 7=L 8=IX 9=IY
+ * 16=PC 18=SP. Maps onto the R800 active register bank (cpu->regs). Returns 0 on
+ * success, -1 on an unknown id. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   R800* cpu = (R800*)boardInfo.cpuRef;
+   if (!cpu) return -1;
+   switch (regId) {
+      case 0:  cpu->regs.AF.B.h = (unsigned char)value; return 0;  /* A */
+      case 1:  cpu->regs.AF.B.l = (unsigned char)value; return 0;  /* F */
+      case 2:  cpu->regs.BC.B.h = (unsigned char)value; return 0;  /* B */
+      case 3:  cpu->regs.BC.B.l = (unsigned char)value; return 0;  /* C */
+      case 4:  cpu->regs.DE.B.h = (unsigned char)value; return 0;  /* D */
+      case 5:  cpu->regs.DE.B.l = (unsigned char)value; return 0;  /* E */
+      case 6:  cpu->regs.HL.B.h = (unsigned char)value; return 0;  /* H */
+      case 7:  cpu->regs.HL.B.l = (unsigned char)value; return 0;  /* L */
+      case 8:  cpu->regs.IX.W = (unsigned short)value;  return 0;  /* IX */
+      case 9:  cpu->regs.IY.W = (unsigned short)value;  return 0;  /* IY */
+      case 16: cpu->regs.PC.W = (unsigned short)value;  return 0;  /* PC */
+      case 18: cpu->regs.SP.W = (unsigned short)value;  return 0;  /* SP */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   R800* cpu = (R800*)boardInfo.cpuRef;
+   if (!cpu) return 0;
+   switch (regId) {
+      case 0:  return cpu->regs.AF.B.h;  /* A */
+      case 1:  return cpu->regs.AF.B.l;  /* F */
+      case 2:  return cpu->regs.BC.B.h;  /* B */
+      case 3:  return cpu->regs.BC.B.l;  /* C */
+      case 4:  return cpu->regs.DE.B.h;  /* D */
+      case 5:  return cpu->regs.DE.B.l;  /* E */
+      case 6:  return cpu->regs.HL.B.h;  /* H */
+      case 7:  return cpu->regs.HL.B.l;  /* L */
+      case 8:  return cpu->regs.IX.W;    /* IX */
+      case 9:  return cpu->regs.IY.W;    /* IY */
+      case 16: return cpu->regs.PC.W;    /* PC */
+      case 18: return cpu->regs.SP.W;    /* SP */
+      default: return 0;
+   }
+}
+
+/* RANGE watch (discovery) — log every read/write in [lo,hi]. mode: 1=read
+ * 2=write 3=both. Arm clears the buffer. State + hooks live in Src/Z80/R800.c. */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern unsigned int  romdev_range_pc[], romdev_range_addr[];
+extern unsigned char romdev_range_val[];
+extern unsigned int  romdev_range_count, romdev_range_stored;
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+   romdev_range_lo = lo; romdev_range_hi = hi;
+   romdev_range_mode = mode ? mode : 3;
+   romdev_range_enabled = enabled ? 1 : 0;
+   romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...] (val
+ * in the low byte of its uint32 slot). Returns events written. out2 (size 2)
+ * gets [totalSeen, stored] so the caller knows if the ring overflowed. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_range_stored;
+   if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_range_pc[i];
+      out[i*3 + 1] = romdev_range_addr[i];
+      out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+   }
+   return n;
+}
+
+/* PC COVERAGE log (discovery) — distinct in-window PCs over a run. */
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern unsigned int  romdev_cov_pcs[], romdev_cov_count, romdev_cov_total;
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_cov_lo = lo; romdev_cov_hi = hi;
+   romdev_cov_enabled = enabled ? 1 : 0;
+   romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+/* Copy up to `max` distinct PCs into out[]. out2 (size 2) gets [distinct,total]. */
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_cov_count;
+   if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+   return n;
+}
+
 void *retro_get_memory_data(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRam;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVram();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return vdpRomdevGetRegs();
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return vdpRomdevGetStatus();
+      case ROMDEV_MEMORY_MSX_PALETTE:    return vdpRomdevGetPalette();
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return romdev_msx_cpu_data();
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return ay8910RomdevGetRegs();
+      default: break;
+   }
    return NULL;
 }
 size_t retro_get_memory_size(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRamSize;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVramSize();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return 64;
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return 16;
+      case ROMDEV_MEMORY_MSX_PALETTE:    return 16 * 2;   /* paletteReg[16] UInt16 */
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return sizeof(romdev_msx_cpu);
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return 16; /* AY8910 regs[16] */
+      default: break;
+   }
    return 0;
 }
 unsigned retro_api_version(void){return RETRO_API_VERSION;}
