 }
+/* ---- romdev memory-region exposure (MSX / MSX2) --------------------- */
+#include "VDP.h"
+#include "AY8910.h"
+#define ROMDEV_MEMORY_MSX_VRAM       0x1C0
+#define ROMDEV_MEMORY_MSX_VDP_REGS   0x1C1
+#define ROMDEV_MEMORY_MSX_VDP_STATUS 0x1C2
+#define ROMDEV_MEMORY_MSX_PALETTE    0x1C3
+#define ROMDEV_MEMORY_MSX_CPU_REGS   0x1C4
+#define ROMDEV_MEMORY_MSX_PSG_REGS   0x1C5
+
+/* Z80/R800 register snapshot. R800's active bank `regs` holds RegisterPair
+ * unions (.W = UInt16); pack into a flat little-endian struct so getCPUState
+ * decodes a stable layout regardless of the core's internal union endianness. */
+#pragma pack(push, 1)
+struct romdev_msx_cpu_snap {
+    unsigned short af, bc, de, hl, ix, iy, pc, sp;
+    unsigned short af1, bc1, de1, hl1;
+    unsigned char  i, r, iff1, iff2, im, halt;
+};
+#pragma pack(pop)
+static struct romdev_msx_cpu_snap romdev_msx_cpu;
+
+static void* romdev_msx_cpu_data(void)
+{
+    R800* cpu = (R800*)boardInfo.cpuRef;
+    if (!cpu) return (void*)0;
+    romdev_msx_cpu.af  = cpu->regs.AF.W;
+    romdev_msx_cpu.bc  = cpu->regs.BC.W;
+    romdev_msx_cpu.de  = cpu->regs.DE.W;
+    romdev_msx_cpu.hl  = cpu->regs.HL.W;
+    romdev_msx_cpu.ix  = cpu->regs.IX.W;
+    romdev_msx_cpu.iy  = cpu->regs.IY.W;
+    romdev_msx_cpu.pc  = cpu->regs.PC.W;
+    romdev_msx_cpu.sp  = cpu->regs.SP.W;
+    romdev_msx_cpu.af1 = cpu->regs.AF1.W;
+    romdev_msx_cpu.bc1 = cpu->regs.BC1.W;
+    romdev_msx_cpu.de1 = cpu->regs.DE1.W;
+    romdev_msx_cpu.hl1 = cpu->regs.HL1.W;
+    romdev_msx_cpu.i    = cpu->regs.I;
+    romdev_msx_cpu.r    = cpu->regs.R;
+    romdev_msx_cpu.iff1 = cpu->regs.iff1;
+    romdev_msx_cpu.iff2 = cpu->regs.iff2;
+    romdev_msx_cpu.im   = cpu->regs.im;
+    romdev_msx_cpu.halt = cpu->regs.halt;
+    return &romdev_msx_cpu;
+}
+
+/* romdev (0.80.0): the watch/pcbreak/watchdog/regsnap/readwatch/range/coverage/
+ * irqblock machinery + exports live in the shared romdev_debug.c. libretro.c keeps
+ * the MSX VRAM-port watch + setReg/getReg + the memory regions. */
+#include "romdev_debug.h"
+
+/* romdev VRAM-port copy trace (hook in VDP.c's data-port write path).
+ * set(lo,hi,enabled) arms a VRAM address window + clears the ring; get
+ * drains [vaddr,pc,val] triples, out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addrs[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs  [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals [ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addrs[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs  [romdev_vw_stored] = pc;
+      romdev_vw_vals [romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addrs[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+/* register read/write — the inverse of getCPUState, used by the host's
+ * callSubroutine / decompressWith (set args + PC=entry, push a sentinel return,
+ * run to it, capture the output). Z80 reg-id convention (STABLE across all cores
+ * so the host passes the same ids): 0=A 1=F 2=B 3=C 4=D 5=E 6=H 7=L 8=IX 9=IY
+ * 16=PC 18=SP. Maps onto the R800 active register bank (cpu->regs). Returns 0 on
+ * success, -1 on an unknown id. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   R800* cpu = (R800*)boardInfo.cpuRef;
+   if (!cpu) return -1;
+   switch (regId) {
+      case 0:  cpu->regs.AF.B.h = (unsigned char)value; return 0;  /* A */
+      case 1:  cpu->regs.AF.B.l = (unsigned char)value; return 0;  /* F */
+      case 2:  cpu->regs.BC.B.h = (unsigned char)value; return 0;  /* B */
+      case 3:  cpu->regs.BC.B.l = (unsigned char)value; return 0;  /* C */
+      case 4:  cpu->regs.DE.B.h = (unsigned char)value; return 0;  /* D */
+      case 5:  cpu->regs.DE.B.l = (unsigned char)value; return 0;  /* E */
+      case 6:  cpu->regs.HL.B.h = (unsigned char)value; return 0;  /* H */
+      case 7:  cpu->regs.HL.B.l = (unsigned char)value; return 0;  /* L */
+      case 8:  cpu->regs.IX.W = (unsigned short)value;  return 0;  /* IX */
+      case 9:  cpu->regs.IY.W = (unsigned short)value;  return 0;  /* IY */
+      case 16: cpu->regs.PC.W = (unsigned short)value;  return 0;  /* PC */
+      case 18: cpu->regs.SP.W = (unsigned short)value;  return 0;  /* SP */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   R800* cpu = (R800*)boardInfo.cpuRef;
+   if (!cpu) return 0;
+   switch (regId) {
+      case 0:  return cpu->regs.AF.B.h;  /* A */
+      case 1:  return cpu->regs.AF.B.l;  /* F */
+      case 2:  return cpu->regs.BC.B.h;  /* B */
+      case 3:  return cpu->regs.BC.B.l;  /* C */
+      case 4:  return cpu->regs.DE.B.h;  /* D */
+      case 5:  return cpu->regs.DE.B.l;  /* E */
+      case 6:  return cpu->regs.HL.B.h;  /* H */
+      case 7:  return cpu->regs.HL.B.l;  /* L */
+      case 8:  return cpu->regs.IX.W;    /* IX */
+      case 9:  return cpu->regs.IY.W;    /* IY */
+      case 16: return cpu->regs.PC.W;    /* PC */
+      case 18: return cpu->regs.SP.W;    /* SP */
+      default: return 0;
+   }
+}
+
 void *retro_get_memory_data(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRam;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVram();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return vdpRomdevGetRegs();
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return vdpRomdevGetStatus();
+      case ROMDEV_MEMORY_MSX_PALETTE:    return vdpRomdevGetPalette();
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return romdev_msx_cpu_data();
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return ay8910RomdevGetRegs();
+      default: break;
+   }
    return NULL;
 }
 size_t retro_get_memory_size(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRamSize;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVramSize();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return 64;
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return 16;
+      case ROMDEV_MEMORY_MSX_PALETTE:    return 16 * 2;   /* paletteReg[16] UInt16 */
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return sizeof(romdev_msx_cpu);
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return 16; /* AY8910 regs[16] */
+      default: break;
+   }
    return 0;
 }
 unsigned retro_api_version(void){return RETRO_API_VERSION;}
