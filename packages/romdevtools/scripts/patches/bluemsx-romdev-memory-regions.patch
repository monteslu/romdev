+/* ====================================================================== */
+/* romdev breakpoint / watchpoint state (Z80 / R800).                      */
+/*                                                                         */
+/* These globals are consulted by the hooks in this file and driven by the */
+/* romdev_pcbreak_/romdev_readwatch_/romdev_watchpoint_ exports in          */
+/* libretro.c. The PC breakpoint hook lives in the r800Execute /            */
+/* r800ExecuteUntil run loops (PC compared BEFORE the next instruction is   */
+/* fetched). The read watch hooks readMem (data reads, NOT opcode fetch);   */
+/* the write watch hooks writeMem. All record the live Z80 PC.             */
+
+/* romdev (0.80.0): the pc-break/watchdog/readwatch/writewatch/range/coverage/
+ * irqblock machinery + state live in the shared romdev_debug.c. R800.c keeps only
+ * the Z80/R800 register snapshot + the dispatch hook (which calls romdev_on_dispatch)
+ * + the readMem/writeMem watch hooks. */
+#include "romdev_debug.h"
+
+/* romdev at-hit REGISTER SNAPSHOT (Z80/R800) — per-core. Fills the shared
+ * romdev_snap_regs[] in the romdev_getreg regId order (A,F,B,C,D,E,H,L,IX,IY,
+ * PC,SP). The dispatch + WP/RD hooks call this when the shared lib reports a hit. */
+unsigned int  romdev_z80_instr_pc = 0xFFFFFFFF;
+static void romdev_z80_snap(R800* r800, int kind) {
+    int i;
+    for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+    romdev_snap_regs[0]  = r800->regs.AF.B.h;
+    romdev_snap_regs[1]  = r800->regs.AF.B.l;
+    romdev_snap_regs[2]  = r800->regs.BC.B.h;
+    romdev_snap_regs[3]  = r800->regs.BC.B.l;
+    romdev_snap_regs[4]  = r800->regs.DE.B.h;
+    romdev_snap_regs[5]  = r800->regs.DE.B.l;
+    romdev_snap_regs[6]  = r800->regs.HL.B.h;
+    romdev_snap_regs[7]  = r800->regs.HL.B.l;
+    romdev_snap_regs[8]  = r800->regs.IX.W;
+    romdev_snap_regs[9]  = r800->regs.IY.W;
+    romdev_snap_regs[16] = romdev_z80_instr_pc;
+    romdev_snap_regs[18] = r800->regs.SP.W;
+    romdev_snap_kind = kind;
+}
+
+/* romdev (0.80.0): one dispatch hook replacing the cov/watchdog/pc-break checks.
+ * Latch the executing PC for the readMem/writeMem watch hooks, then ask the shared
+ * lib whether to FREEZE; on a hit, snapshot (kind 2=watchdog else 1=pc-break/step),
+ * set r800->terminate so r800Execute returns + retro_run completes the frame, and
+ * break out of the run loop with the PC left on the un-executed break instruction. */
+#define ROMDEV_DISPATCH(r800) do { \
+    romdev_z80_instr_pc = (unsigned int)(r800)->regs.PC.W; \
+    if (romdev_on_dispatch((unsigned int)(r800)->regs.PC.W)) { \
+        romdev_z80_snap((r800), romdev_pc_hit_kind() == 2 ? 2 : 1); \
+        (r800)->terminate = 1; \
+        break; \
+    } \
+} while (0)
+
 
