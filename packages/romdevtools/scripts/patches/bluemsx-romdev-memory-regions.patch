diff --git a/Src/Z80/R800.c b/Src/Z80/R800.c
index e3dd190..bf55bc8 100644
--- a/Src/Z80/R800.c
+++ b/Src/Z80/R800.c
@@ -42,6 +42,185 @@ static UInt8  ZSPXYTable[256];
 static UInt8  ZSPHTable[256];
 static UInt16 DAATable[0x800];
 
+/* ====================================================================== */
+/* romdev breakpoint / watchpoint state (Z80 / R800).                      */
+/*                                                                         */
+/* These globals are consulted by the hooks in this file and driven by the */
+/* romdev_pcbreak_/romdev_readwatch_/romdev_watchpoint_ exports in          */
+/* libretro.c. The PC breakpoint hook lives in the r800Execute /            */
+/* r800ExecuteUntil run loops (PC compared BEFORE the next instruction is   */
+/* fetched). The read watch hooks readMem (data reads, NOT opcode fetch);   */
+/* the write watch hooks writeMem. All record the live Z80 PC.             */
+
+/* PC breakpoint / single-step. */
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+volatile int  romdev_pc_step    = 0;        /* per-instruction countdown; >0 = single-step armed */
+volatile int  romdev_pc_hit     = 0;        /* set by the execute hook, cleared by the host */
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a slightly-wrong arg) can loop FOREVER
+ * inside a single r800Execute / retro_run frame, so the host's per-FRAME maxFrames
+ * never gets a turn and the whole WASM hangs. This counts dispatched instructions
+ * and force-stops (sets romdev_pc_hit + romdev_pc_watchdog) when the budget is
+ * exceeded — so a runaway returns control with the final PC intact instead of
+ * hanging. romdev_pc_wd_limit 0 = disabled. Checked in the SAME run-loop spot as
+ * the PC-break hook (ROMDEV_PCBREAK_CHECK), but FIRST. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
+/* READ watchpoint (data reads). */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+/* WRITE watchpoint (data writes) — used by findWriter. */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+/* romdev at-hit REGISTER SNAPSHOT (Z80/R800). The run loops re-enter after a
+ * hit, so the live register file drifts — the hooks freeze a copy at the hit
+ * instant. Layout = the romdev_getreg regId order: [0]=A [1]=F [2]=B [3]=C
+ * [4]=D [5]=E [6]=H [7]=L [8]=IX [9]=IY [16]=PC of the EXECUTING instruction's
+ * first byte [18]=SP. kind: 1=pc-break/step, 2=watchdog, 3=write-watch,
+ * 4=read-watch. */
+unsigned int  romdev_snap_regs[19];
+int           romdev_snap_kind = 0;
+unsigned int  romdev_z80_instr_pc = 0xFFFFFFFF;
+/* romdev INTERRUPT BLOCK — the pure-call primitive. While set, INT/NMI
+ * acceptance is suppressed (the lines stay pending), so a routine driven by
+ * callSubroutine cannot be hijacked by the BIOS KEYINT / game VBlank
+ * handlers — the frame logic that stomps output buffers. */
+int           romdev_irq_block = 0;
+static void romdev_z80_snap(R800* r800, int kind) {
+    int i;
+    for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+    romdev_snap_regs[0]  = r800->regs.AF.B.h;
+    romdev_snap_regs[1]  = r800->regs.AF.B.l;
+    romdev_snap_regs[2]  = r800->regs.BC.B.h;
+    romdev_snap_regs[3]  = r800->regs.BC.B.l;
+    romdev_snap_regs[4]  = r800->regs.DE.B.h;
+    romdev_snap_regs[5]  = r800->regs.DE.B.l;
+    romdev_snap_regs[6]  = r800->regs.HL.B.h;
+    romdev_snap_regs[7]  = r800->regs.HL.B.l;
+    romdev_snap_regs[8]  = r800->regs.IX.W;
+    romdev_snap_regs[9]  = r800->regs.IY.W;
+    romdev_snap_regs[16] = romdev_z80_instr_pc;
+    romdev_snap_regs[18] = r800->regs.SP.W;
+    romdev_snap_kind = kind;
+}
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+/* ---- romdev RE primitives round 2 (Z80 / R800) ---------------------- */
+/* RANGE watch (discovery): log EVERY {pc,addr,value} that reads or writes an
+ * address in [lo,hi] over a window — not stop-on-first. Hooked into the same
+ * readMem/writeMem data paths as the single-address watch (opcode fetches via
+ * readOpcode are deliberately NOT hooked). Ring buffer; host drains it. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* PC COVERAGE log (discovery): record DISTINCT Z80 PCs executed within an
+ * address window [lo,hi] over a run of frames — "what code runs here?". Linear
+ * de-dup against the stored set (cheap for the small windows this targets). */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-range dispatches seen */
+
+/* Append one range-watch event (called from the readMem/writeMem hooks). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+    romdev_range_count++;
+    if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+        romdev_range_pc  [romdev_range_stored] = pc;
+        romdev_range_addr[romdev_range_stored] = addr;
+        romdev_range_val [romdev_range_stored] = val;
+        romdev_range_stored++;
+    }
+}
+
+/* Record a distinct in-window PC for the coverage log. */
+void romdev_cov_log(unsigned int pc)
+{
+    unsigned int i;
+    romdev_cov_total++;
+    for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+    if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+/* romdev PC coverage check (discovery): record each DISTINCT in-window PC about
+ * to execute. Placed alongside the PC-break check at the top of the run loop so
+ * r800->regs.PC.W is the address about to dispatch. Cheap when disabled. */
+#define ROMDEV_COV_CHECK(r800) do { \
+    if (romdev_cov_enabled \
+        && (unsigned int)(r800)->regs.PC.W >= romdev_cov_lo \
+        && (unsigned int)(r800)->regs.PC.W <= romdev_cov_hi) \
+        romdev_cov_log((r800)->regs.PC.W); \
+} while (0)
+
+/* romdev INSTRUCTION WATCHDOG check: force-stop a runaway (the callSubroutine
+ * hang). Placed at the top of each run-loop iteration, BEFORE the PC-break check,
+ * so r800->regs.PC.W is the address about to dispatch. Counts dispatched
+ * instructions; on overflow it fires the breakpoint with the watchdog flag and
+ * ends the frame the SAME way the PC-break does (terminate=1; break) so the host
+ * gets the final PC instead of hanging. Cheap when disabled (one int test). */
+#define ROMDEV_WATCHDOG_CHECK(r800) do { \
+    if (romdev_pc_wd_limit && !romdev_pc_hit) { \
+        if (++romdev_pc_wd_count >= romdev_pc_wd_limit) { \
+            romdev_pc_last_pc = (r800)->regs.PC.W; \
+            romdev_z80_snap((r800), 2); \
+            romdev_pc_hit = 1; \
+            romdev_pc_watchdog = 1; \
+            (r800)->terminate = 1; \
+            break; \
+        } \
+    } \
+} while (0)
+
+/* romdev PC breakpoint / single-step check. Placed at the top of each run-loop
+ * iteration, BEFORE the next opcode is fetched, so r800->regs.PC.W is the
+ * address about to execute. On a hit it freezes the CPU at that PC (the
+ * instruction is NOT executed) and sets r800->terminate so the active run loop
+ * (r800Execute) returns and retro_run completes the frame — without consuming
+ * the rest of the frame the libretro loop would otherwise re-enter the CPU and
+ * step past the breakpoint (TRAP 2). The host polls romdev_pc_hit after
+ * retro_run and stops stepping once set. romdev_pc_step is a per-instruction
+ * countdown the host arms to 2 so ONE instruction executes before the stop
+ * fires (true single-step that advances the PC, not a re-stop on the same one). */
+#define ROMDEV_PCBREAK_CHECK(r800) do { \
+    if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit) { \
+        int romdev_stepFire = 0; \
+        if (romdev_pc_step) { if (--romdev_pc_step <= 0) romdev_stepFire = 1; } \
+        if (romdev_stepFire || ((romdev_pc_enabled && !romdev_pc_step) \
+                                && (unsigned int)(r800)->regs.PC.W == romdev_pc_addr)) { \
+            romdev_pc_last_pc = (r800)->regs.PC.W; \
+            romdev_z80_snap((r800), 1); \
+            romdev_pc_hit = 1; \
+            romdev_pc_hits++; \
+            romdev_pc_step = 0; \
+            (r800)->terminate = 1; \
+            break; \
+        } \
+    } \
+} while (0)
+
 
