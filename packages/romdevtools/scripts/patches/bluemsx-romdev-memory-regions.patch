+static void romdev_msx_vdeltas_reset(void)
+{
+    /* count+truncated only -- clearing the 64KB body every frame is waste. */
+    romdev_msx_vdeltas.count = 0;
+    romdev_msx_vdeltas.truncated = 0;
+    romdev_msx_vdeltas.cutLine   = 0xFFFF;
+    romdev_msx_vdeltas.cutOffset = -1;
+}
+
+/* ---- fossil-row snapshot (region msx_fb_tail) ---------------------------
+ *
+ * The rows at and beyond the frame-end cut are RETAINED FRAMEBUFFER MEMORY:
+ * the frame the log describes never re-rendered them, and their content is
+ * not a function of any current VDP state (it can be arbitrarily old). A
+ * consumer that renders from state alone cannot produce them.
+ *
+ * A stateful consumer retaining ITS OWN prior composite converges only if it
+ * composes every frame -- and Active Bezel ticks fire per COMPOSE, not per
+ * frame, so a harness that steps headless and composes once has no usable
+ * prior. Worse, substituting from a STALE composite corrupts any active rows
+ * below the cut (the wide-frame Blade Lords regression: rows 216..226 of a
+ * 212-line display swallowed by a minutes-old compose).
+ *
+ * So the core snapshots those rows itself, at the frame-start reset, while
+ * the framebuffer still holds the full previous presentation. This is
+ * cut-gated framebuffer memory -- the same class as the PCE core's linepix
+ * region: core-resolved pixels used because they are the ONLY exact source,
+ * with a must-fail control proving exactly which pixels come from it. */
+#define ROMDEV_MSX_FBTAIL_ROWS 32
+#define ROMDEV_MSX_FBTAIL_W    544
+#pragma pack(push, 1)
+struct romdev_msx_fbtail {
+    unsigned short cutLine;    /* first stale VDP line; 0xFFFF = none */
+    short          cutOffset;  /* block within that line */
+    unsigned short rows;       /* rows captured */
+    unsigned short width;      /* pixels per captured row (272 or 544) */
+    unsigned short firstRow;   /* framebuffer row index of pixels[0] */
+    unsigned short pad;
+    unsigned short pixels[ROMDEV_MSX_FBTAIL_ROWS * ROMDEV_MSX_FBTAIL_W];
+};
+#pragma pack(pop)
+static struct romdev_msx_fbtail romdev_msx_fbtail_snap;
+
+unsigned char* vdpRomdevGetFbTail(void) {
+    return (unsigned char*)&romdev_msx_fbtail_snap;
+}
+int vdpRomdevGetFbTailSize(void) {
+    return (int)sizeof(romdev_msx_fbtail_snap);
+}
+
+/* Called from retro_run AFTER emulation, BEFORE the OSK overlay / video_cb:
+ * at that moment romdev_msx_vdeltas still holds the JUST-COMPLETED frame's
+ * cut (every gate capture reads it there and sees the full log), and the
+ * single-buffered image_buffer holds that frame's presentation -- so rows at
+ * and beyond the cut are exactly the fossil pixels a consumer must retain.
+ * Capturing at the VDP frame-START instead is an off-by-one-frame bug: the
+ * struct would carry the PREVIOUS frame's cut when the consumer reads it. */
+void romdev_msx_fbtail_capture_now(void)
+{
+    VDP* vdp = theVdp;
+    FrameBuffer* fb;
+    int cut, fbrow0, nrows, w, r;
+    romdev_msx_fbtail_snap.cutLine = romdev_msx_vdeltas.cutLine;
+    romdev_msx_fbtail_snap.cutOffset = romdev_msx_vdeltas.cutOffset;
+    romdev_msx_fbtail_snap.rows = 0;
+    romdev_msx_fbtail_snap.width = 0;
+    romdev_msx_fbtail_snap.firstRow = 0;
+    if (vdp == NULL || romdev_msx_vdeltas.cutLine == 0xFFFF)
+        return;
+    fb = frameBufferGetDrawFrame();
+    if (fb == NULL)
+        return;
+    cut = (int)romdev_msx_vdeltas.cutLine;
+    fbrow0 = cut - vdp->displayOffest;
+    if (fbrow0 < 0) fbrow0 = 0;
+    nrows = 240 - fbrow0;
+    if (nrows <= 0) return;
+    if (nrows > ROMDEV_MSX_FBTAIL_ROWS) nrows = ROMDEV_MSX_FBTAIL_ROWS;
+    w = frameBufferGetDoubleWidth(fb, fbrow0) ? 544 : 272;
+    if (w > ROMDEV_MSX_FBTAIL_W) w = ROMDEV_MSX_FBTAIL_W;
+    for (r = 0; r < nrows; r++) {
+        Pixel* line = frameBufferGetLine(fb, fbrow0 + r);
+        int x;
+        if (line == NULL) { nrows = r; break; }
+        for (x = 0; x < w; x++)
+            romdev_msx_fbtail_snap.pixels[(size_t)r * ROMDEV_MSX_FBTAIL_W + x] =
+                (unsigned short)line[x];
+    }
+    romdev_msx_fbtail_snap.rows = (unsigned short)nrows;
+    romdev_msx_fbtail_snap.width = (unsigned short)w;
+    romdev_msx_fbtail_snap.firstRow = (unsigned short)fbrow0;
+}
+
+/* Render HIGH-WATER MARK: the furthest position RefreshLine actually reached
+ * this frame. The scanline counter keeps advancing past the presentation
+ * point while the draw-frame guard stops any rendering, so the counter's
+ * wrap position (262) says nothing about where pixels stopped being written.
+ * The stale tail of the PRESENTED frame begins exactly here. */
+static void romdev_msx_cut_update(int line, int x2)
+{
+    if (romdev_msx_vdeltas.cutLine == 0xFFFF ||
+        line > (int)romdev_msx_vdeltas.cutLine) {
+        romdev_msx_vdeltas.cutLine   = (unsigned short)line;
+        romdev_msx_vdeltas.cutOffset = (short)x2;
+    } else if (line == (int)romdev_msx_vdeltas.cutLine &&
+               x2 > (int)romdev_msx_vdeltas.cutOffset) {
+        romdev_msx_vdeltas.cutOffset = (short)x2;
+    }
+}
