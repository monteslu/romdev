+      struct retro_message_ext msg = {
+         "ROM size exceeds maximum permitted value",
+         3000,
+         3,
+         RETRO_LOG_ERROR,
+         RETRO_MESSAGE_TARGET_ALL,
+         RETRO_MESSAGE_TYPE_NOTIFICATION,
+         -1
+      };
+      environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, &msg);
+   }
+   else
+   {
+      struct retro_message msg = {
