-static void extract_name(char *buf, const char *path, size_t size)
-{
-   char *base = strrchr(path, '/');
-   if (!base)
-      base = strrchr(path, '\\');
-
-   if (base)
-   {
-      strlcpy(buf, base, size);
-      base = strrchr(buf, '.');
-      if (base)
-         *base = '\0';
-   }
-   else
-      buf[0] = '\0';
-}
-
-static void extract_directory(char *buf, const char *path, size_t size)
-{
-   char *base;
-   strncpy(buf, path, size - 1);
-   buf[size - 1] = '\0';
-
-   if (!(base = strrchr(buf, '/')))
-      base = strrchr(buf, '\\');
-
-   if (base)
-      *base = '\0';
-   else
-      buf[0] = '\0';
-}
