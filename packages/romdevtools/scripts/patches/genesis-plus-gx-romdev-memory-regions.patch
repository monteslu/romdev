  * Run until given cycle count 
  ****************************************************************************/
+/* Pure-CPU run for callSubroutine (mirror of romdev_m68k_run_pure in
+ * m68kcpu.c): step ONLY the Z80 — no VDP line processing or interrupt raising
+ * advances, so a driven routine can't be stomped by the game's frame logic.
+ * Cycle counter restored afterward; register/RAM effects kept. */
+void romdev_z80_run_pure(unsigned int budget_cycles)
+{
+  unsigned int save_cycles = Z80.cycles;
+  z80_run(Z80.cycles + budget_cycles);
+  Z80.cycles = save_cycles;
+}
+
 void z80_run(unsigned int cycles)
 {
+  /* romdev: once a breakpoint/watchdog hit has frozen this CPU, KEEP it frozen
+   * for the remainder of the frame (mirror of the m68k_run guard — the per-
+   * line scheduler re-enters z80_run and would otherwise drift the register
+   * file past the hit). The host clears the hit to resume. */
+  if (romdev_is_frozen())
+  {
+    Z80.cycles = cycles;
+    return;
+  }
+
   while( Z80.cycles < cycles )
   {
+    /* romdev (0.80.0): PC is the first byte of the instruction about to dispatch —
+     * latch it for the z80 mid-instruction R/W hooks, then ask the shared lib whether
+     * to FREEZE (coverage + watchdog + pc-break/single-step live in romdev_debug.c).
+     * On a freeze, take the z80 snapshot + consume the frame so z80_run returns and the
+     * per-line scheduler doesn't re-enter past the break (PC left at the break insn). */
+    romdev_z80_instr_pc = PC;
+
+    if (romdev_on_dispatch(PC))
+    {
+      romdev_z80_snap(romdev_pc_hit_kind() == 2 ? 2 : 1);
+      Z80.cycles = cycles;
+      break;
+    }
+
+
     /* check for IRQs before each instruction */
     if (Z80.irq_state && IFF1 && !Z80.after_ei)
     {
@@ -3432,7 +3515,7 @@ void z80_run(unsigned int cycles)
     R++;
     EXEC_INLINE(op,ROP());
   }
-} 
+}
 
