-
-      /* Plane A name table */
-      nt = (uint32 *)&vram[ntab + (((v_line >> 4) << pf_shift) & 0x1FC0)];
-
-      /* Pattern row index */
-      v_line = (v_line & 15) << 3;
-
-      atbuf = nt[index & pf_col_mask];
-      DRAW_COLUMN_IM2(atbuf, v_line)
-    }
-
-    /* Window width */
-    start = clip[1].left;
-    end   = clip[1].right;
-  }
-  else
-  {
-    /* Window width */
-    start = 0;
-    end   = width;
-  }
-
-  /* Window Plane */
-  if (w)
-  {
-    /* Background line buffer */
