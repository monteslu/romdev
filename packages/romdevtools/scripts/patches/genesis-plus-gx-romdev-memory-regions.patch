+      romdev_m68k_snap(3); \
+  } while (0)
+#define ROMDEV_RD_M68K(a, v) do { \
+    if (romdev_on_read((unsigned int)(a), (unsigned char)(v), romdev_m68k_instr_pc)) \
+      romdev_m68k_snap(4); \
+  } while (0)
+#define ROMDEV_RANGE_M68K(a, v, w) do { (void)(a); (void)(v); (void)(w); } while (0)
+
