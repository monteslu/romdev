+    PC -= 2;      \
+    CC(ex,0xb2);  \
+  }
+
+/***************************************************************
+ * OTIR
+ ***************************************************************/
+#define OTIR      \
+  OUTI;           \
+  if( B )         \
+  {               \
+    PC -= 2;      \
+    CC(ex,0xb3);  \
+  }
+
+/***************************************************************
+ * LDDR
+ ***************************************************************/
+#define LDDR            \
+  LDD;                  \
+  if( BC )              \
+  {                     \
+    PC -= 2;            \
