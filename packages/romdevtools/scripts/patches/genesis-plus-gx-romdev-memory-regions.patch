+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex);
+#define DRAW_COLUMN_IM2(ATTR, LINE) \
+  GET_MSB_TILE_IM2(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex); \
+  GET_LSB_TILE_IM2(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex);
+#endif
+#endif /* ALIGN_LONG */
