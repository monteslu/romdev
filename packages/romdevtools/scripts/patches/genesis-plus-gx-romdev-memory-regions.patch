+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex);
+#else
+#define DRAW_COLUMN(ATTR, LINE) \
+  GET_MSB_TILE(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex); \
