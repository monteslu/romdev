diff --git a/core/m68k/m68kcpu.c b/core/m68k/m68kcpu.c
index 36112a5..55ce1b8 100644
--- a/core/m68k/m68kcpu.c
+++ b/core/m68k/m68kcpu.c
@@ -31,6 +31,150 @@ static int irq_latency;
 
 m68ki_cpu_core m68k;
 
+/* romdev instruction-level write watchpoint state (see m68kcpu.h for the hook). */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+/* SMS/GG only: live host pointer of the Z80 PC's page at write time (the z80.c
+ * WM hook sets it). libretro.c resolves it to a ROM offset → bank, since the
+ * SMS sega mapper pages a 16-bit Z80 PC into switchable ROM. (Genesis m68k has
+ * a flat 24-bit PC, so it leaves this 0 and reports no bank.) */
+unsigned char *romdev_wp_last_pc_ptr = 0;
+
+/* romdev instruction-level READ watchpoint state (mirror of the write watch;
+ * hook in m68ki_read_8/16/32 in m68kcpu.h). Records REG_PC of the instruction
+ * that READ a watched address. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+/* romdev PC breakpoint (m68k execute hook in m68k_run below). When enabled and
+ * REG_PC reaches romdev_pc_addr at instruction dispatch, romdev_pc_hit is set
+ * and m68k_run breaks out of its loop so the CPU freezes exactly at that PC —
+ * the host then reads the full register file via getCPUState. romdev_pc_step
+ * forces a one-instruction stop regardless of address (single-step). */
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;        /* 1 = stop after exactly one instruction */
+volatile int  romdev_pc_hit     = 0;        /* set by the execute hook, cleared by the host */
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+/* captureBefore: when 1, the breakpoint fires BEFORE executing the target
+ * instruction (default) so getCPUState reads the ENTRY registers; the existing
+ * before-dispatch fire already does this for a plain address breakpoint, so this
+ * flag is informational/host-symmetry. (Single-step still advances one insn.) */
+int           romdev_pc_capture_before = 1;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a slightly-wrong A0) can loop FOREVER
+ * inside a single m68k_run / retro_run frame, so the host's per-FRAME maxFrames
+ * never gets a turn and the whole WASM hangs. This counts dispatched instructions
+ * and force-stops (sets romdev_pc_hit + romdev_pc_watchdog) when the budget is
+ * exceeded — so a runaway returns control with the final PC/regs intact instead
+ * of hanging. romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
+/* romdev RANGE watch (discovery): log EVERY {pc,addr,value} that reads or writes
+ * an address in [lo,hi] over a window — not stop-on-first. Hooked into the same
+ * read/write paths as the single-address watch. Ring buffer; host drains it. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* romdev PC COVERAGE log (discovery): record DISTINCT PCs executed within an
+ * address window [lo,hi] over a window of frames — "what code runs here?". Linear
+ * de-dup against the stored set (cheap for the small windows this targets). */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-range dispatches seen */
+
+/* Append one range-watch event (called from the read/write hooks via the macro
+ * in m68kcpu.h). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+   romdev_range_count++;
+   if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+      romdev_range_pc  [romdev_range_stored] = pc;
+      romdev_range_addr[romdev_range_stored] = addr;
+      romdev_range_val [romdev_range_stored] = val;
+      romdev_range_stored++;
+   }
+}
+
+/* Record a distinct in-window PC for the coverage log. */
+void romdev_cov_log(unsigned int pc)
+{
+   unsigned int i;
+   romdev_cov_total++;
+   for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+   if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+/* romdev at-hit REGISTER SNAPSHOT. gpgx schedules the CPUs per scanline, so by
+ * the time retro_run returns from a frame containing a breakpoint/watchpoint
+ * hit, the live register file is hundreds of instructions past the hit (the
+ * "register drift" that sent a real RE session chasing dead pointer values).
+ * These are frozen copies captured INSIDE the CPU hook at the hit instant.
+ * Layout = the romdev_setreg/getreg regId order: [0..7]=D0-D7, [8..15]=A0-A7,
+ * [16]=PC of the EXECUTING instruction's first byte (not the drifted prefetch
+ * PC), [17]=SR, [18]=SP. For the Z80 systems: A,F,B,C,D,E,H,L,IX,IY at 0-9,
+ * [16]=PC, [18]=SP (same ids romdev_getreg_z80 serves). kind: 0=none,
+ * 1=pc-break/step, 2=watchdog, 3=write-watch, 4=read-watch. */
+unsigned int  romdev_snap_regs[19];
+int           romdev_snap_kind = 0;
+/* First byte address of the instruction each CPU is currently executing —
+ * REG_PC/PC drift past operands during decode, so mid-instruction hooks (the
+ * write/read watchpoints) must report THIS, not the live PC. (Separate per CPU:
+ * on Genesis the sound Z80 runs concurrently with the m68k.) */
+unsigned int  romdev_m68k_instr_pc = 0xFFFFFFFF;
+unsigned int  romdev_z80_instr_pc  = 0xFFFFFFFF;
+
+void romdev_m68k_snap(int kind)
+{
+   int i;
+   for (i = 0; i < 16; i++) romdev_snap_regs[i] = m68ki_cpu.dar[i];
+   romdev_snap_regs[16] = romdev_m68k_instr_pc;
+   romdev_snap_regs[17] = m68ki_get_sr();
+   romdev_snap_regs[18] = m68ki_cpu.dar[15];   /* SP == A7 */
+   romdev_snap_kind = kind;
+}
+
+/* Pure-CPU run for callSubroutine: step ONLY the m68k — none of the per-frame
+ * system machinery (VDP line processing, Z80 co-scheduling, interrupt raising)
+ * advances, so a driven routine's output buffer can't be stomped by the game's
+ * own VBlank logic running "concurrently" (the cpu({op:'call'}) poisoning a
+ * real session diffed a CORRECT reimplementation against for hours). The cycle
+ * counters are restored afterward so normal frame scheduling is unaffected;
+ * register/RAM side effects of the executed instructions are kept. The armed
+ * pc-break sentinel / instruction watchdog still fire inside m68k_run. */
+void romdev_m68k_run_pure(unsigned int budget_cycles)
+{
+   unsigned int save_cycles  = m68k.cycles;
+   unsigned int save_end     = m68k.cycle_end;
+   unsigned int save_refresh = m68k.refresh_cycles;
+   m68k_run(m68k.cycles + budget_cycles);
+   m68k.cycles         = save_cycles;
+   m68k.cycle_end      = save_end;
+   m68k.refresh_cycles = save_refresh;
+}
+
 
 /* ======================================================================== */
 /* =============================== CALLBACKS ============================== */
@@ -262,6 +406,18 @@ void m68k_run(unsigned int cycles)
     return;
   }
 
+  /* romdev: once a breakpoint/watchdog hit has frozen this CPU, KEEP it frozen
+   * for the remainder of the frame. gpgx re-enters m68k_run once per scanline,
+   * so without this the 68k resumed on the next line and the "frozen" register
+   * file drifted hundreds of instructions past the hit before the host could
+   * read it. The host clears the hit (pcbreak_get clearHit / pcbreak_set) to
+   * resume. */
+  if (romdev_pc_hit)
+  {
+    m68k.cycles = cycles;
+    return;
+  }
+
   /* Check interrupt mask to process IRQ if needed */
   m68ki_check_interrupts();
 
@@ -284,6 +440,67 @@ void m68k_run(unsigned int cycles)
 
   while (m68k.cycles < cycles)
   {
+    /* romdev: REG_PC right now is the first byte of the instruction about to
+     * be dispatched — record it so mid-instruction hooks (write/read
+     * watchpoints, range log) can report the EXECUTING instruction instead of
+     * the drifted prefetch PC. */
+    romdev_m68k_instr_pc = REG_PC;
+
+    /* romdev instruction WATCHDOG: force-stop a runaway (the callSubroutine hang).
+     * Counts dispatched instructions; on overflow, fire the breakpoint with the
+     * watchdog flag so the host gets the final PC/regs instead of hanging. */
+    if (romdev_pc_wd_limit && !romdev_pc_hit)
+    {
+      if (++romdev_pc_wd_count >= romdev_pc_wd_limit)
+      {
+        romdev_pc_last_pc = REG_PC;
+        romdev_m68k_snap(2);     /* freeze the register file AT the stop */
+        romdev_pc_hit = 1;
+        romdev_pc_watchdog = 1;
+        m68k.cycles = cycles;
+        break;
+      }
+    }
+
+    /* romdev PC coverage log (discovery): record each DISTINCT in-window PC about
+     * to execute. Cheap when disabled (one int test). */
+    if (romdev_cov_enabled
+        && (unsigned int)REG_PC >= romdev_cov_lo
+        && (unsigned int)REG_PC <= romdev_cov_hi)
+      romdev_cov_log(REG_PC);
+
+    /* romdev PC breakpoint / single-step: check BEFORE dispatching the next
+     * instruction so REG_PC is the address about to execute. On a hit, freeze
+     * here (break out of the loop) — the CPU state is now exactly at the
+     * breakpoint and the host reads the registers. romdev_pc_step stops after
+     * exactly one instruction regardless of address. */
+    if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit)
+    {
+      /* Single-step (romdev_pc_step) is a countdown the host arms to 2 = "let
+       * ONE instruction execute, then stop at the next" — decremented once per
+       * dispatched instruction, fires at 1 so the PC actually ADVANCES (a
+       * before-dispatch fire would re-stop on the same instruction). A plain
+       * breakpoint (step==0) fires on address match. */
+      int stepFire = 0;
+      if (romdev_pc_step) { if (--romdev_pc_step <= 0) stepFire = 1; }
+      if (stepFire || ((romdev_pc_enabled && !romdev_pc_step)
+                       && (unsigned int)REG_PC == romdev_pc_addr))
+      {
+        romdev_pc_last_pc = REG_PC;
+        romdev_m68k_snap(1);    /* freeze the register file AT the hit */
+        romdev_pc_hit = 1;
+        romdev_pc_hits++;
+        romdev_pc_step = 0;     /* one-shot */
+        /* Mark the CPU "caught up" for this frame so the per-line scheduler in
+         * system.c doesn't immediately re-enter m68k_run and step past the
+         * breakpoint. REG_PC is left untouched, so the CPU is frozen exactly at
+         * the breakpoint; the rest of the frame runs with the 68k idle. The
+         * host sees romdev_pc_hit after retro_run and stops stepping. */
+        m68k.cycles = cycles;
+        break;                  /* leave the CPU frozen at this PC */
+      }
+    }
+
     /* Set tracing accodring to T1. */
     m68ki_trace_t1() /* auto-disable (see m68kcpu.h) */
 
diff --git a/core/m68k/m68kcpu.h b/core/m68k/m68kcpu.h
index b702173..5ed4e88 100644
--- a/core/m68k/m68kcpu.h
+++ b/core/m68k/m68kcpu.h
@@ -674,6 +674,57 @@ INLINE uint m68ki_read_16(uint address);
 INLINE uint m68ki_read_32(uint address);
 
 /* Write to the current data space */
+/* romdev instruction-level write watchpoint (m68k). Records the EXECUTING
+ * instruction's first-byte address (romdev_m68k_instr_pc, latched at dispatch
+ * in m68k_run) — NOT the live REG_PC, which has prefetched past the operands
+ * by write time and pointed a real session at the FOLLOWING instruction.
+ * Also freezes a full register snapshot at the hit (romdev_m68k_snap), since
+ * the live register file keeps running for the rest of the frame. Defined in
+ * m68kcpu.c; exported to the host via libretro.c. */
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+extern unsigned int  romdev_m68k_instr_pc;
+extern void          romdev_m68k_snap(int kind);
+#define ROMDEV_WP_M68K(a, v) do { \
+    if (romdev_wp_enabled && (unsigned int)(a) == romdev_wp_addr) { \
+      romdev_wp_last_pc = romdev_m68k_instr_pc; romdev_wp_last_val = (unsigned char)(v); romdev_wp_hits++; \
+      romdev_m68k_snap(3); \
+    } \
+  } while (0)
+
+/* romdev instruction-level READ watchpoint (m68k). Records REG_PC of the
+ * instruction that READ a watched address. Mirror of ROMDEV_WP_M68K, hooked
+ * into m68ki_read_8/16/32. Defined in m68kcpu.c; exported via libretro.c. */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+#define ROMDEV_RD_M68K(a, v) do { \
+    if (romdev_rd_enabled && (unsigned int)(a) == romdev_rd_addr) { \
+      romdev_rd_last_pc = romdev_m68k_instr_pc; romdev_rd_last_val = (unsigned char)(v); romdev_rd_hits++; \
+      romdev_m68k_snap(4); \
+    } \
+  } while (0)
+
+/* romdev RANGE watch (discovery): log every {pc,addr,val} touching [lo,hi].
+ * `w` is 1 for a write, 0 for a read; romdev_range_mode 1=read 2=write 3=both. */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern void          romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val);
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern void          romdev_cov_log(unsigned int pc);
+#define ROMDEV_RANGE_M68K(a, v, w) do { \
+    if (romdev_range_enabled && (romdev_range_mode & ((w) ? 2 : 1)) \
+        && (unsigned int)(a) >= romdev_range_lo && (unsigned int)(a) <= romdev_range_hi) { \
+      romdev_range_log(romdev_m68k_instr_pc, (unsigned int)(a), (unsigned char)(v)); \
+    } \
+  } while (0)
+
 INLINE void m68ki_write_8(uint address, uint value);
 INLINE void m68ki_write_16(uint address, uint value);
 INLINE void m68ki_write_32(uint address, uint value);
@@ -861,6 +912,9 @@ INLINE uint m68ki_read_8(uint address)
   if (temp->read8) val = (*temp->read8)(ADDRESS_68K(address));
   else val = READ_BYTE(temp->base, (address) & 0xffff);
 
+  ROMDEV_RD_M68K(address, val);
+  ROMDEV_RANGE_M68K(address, val, 0);
+
 #ifdef HOOK_CPU
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_R, 1, address, val);
@@ -881,6 +935,11 @@ INLINE uint m68ki_read_16(uint address)
   if (temp->read16) val = (*temp->read16)(ADDRESS_68K(address));
   else val = *(uint16 *)(temp->base + ((address) & 0xffff));
 
+  ROMDEV_RD_M68K(address, val >> 8);
+  ROMDEV_RD_M68K(address + 1, val);
+  ROMDEV_RANGE_M68K(address, val >> 8, 0);
+  ROMDEV_RANGE_M68K(address + 1, val, 0);
+
 #ifdef HOOK_CPU
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_R, 2, address, val);
@@ -905,6 +964,15 @@ INLINE uint m68ki_read_32(uint address)
   if (temp->read16) val |= (*temp->read16)(ADDRESS_68K(address+2));
   else val |= m68k_read_immediate_16(address+2);
 
+  ROMDEV_RD_M68K(address,     val >> 24);
+  ROMDEV_RD_M68K(address + 1, val >> 16);
+  ROMDEV_RD_M68K(address + 2, val >> 8);
+  ROMDEV_RD_M68K(address + 3, val);
+  ROMDEV_RANGE_M68K(address,     val >> 24, 0);
+  ROMDEV_RANGE_M68K(address + 1, val >> 16, 0);
+  ROMDEV_RANGE_M68K(address + 2, val >> 8,  0);
+  ROMDEV_RANGE_M68K(address + 3, val,       0);
+
 #ifdef HOOK_CPU
   if (UNLIKELY(cpu_hook))
     cpu_hook(HOOK_M68K_R, 4, address, val);
@@ -917,6 +985,8 @@ INLINE void m68ki_write_8(uint address, uint value)
 {
   cpu_memory_map *temp;
 
+  ROMDEV_WP_M68K(address, value);
+  ROMDEV_RANGE_M68K(address, value, 1);
   m68ki_set_fc(FLAG_S | FUNCTION_CODE_USER_DATA) /* auto-disable (see m68kcpu.h) */
 
 #ifdef HOOK_CPU
@@ -933,6 +1003,11 @@ INLINE void m68ki_write_16(uint address, uint value)
 {
   cpu_memory_map *temp;
 
+  /* word write covers address and address+1 */
+  ROMDEV_WP_M68K(address, value >> 8);
+  ROMDEV_WP_M68K(address + 1, value);
+  ROMDEV_RANGE_M68K(address, value >> 8, 1);
+  ROMDEV_RANGE_M68K(address + 1, value, 1);
   m68ki_set_fc(FLAG_S | FUNCTION_CODE_USER_DATA) /* auto-disable (see m68kcpu.h) */
   m68ki_check_address_error(address, MODE_WRITE, FLAG_S | FUNCTION_CODE_USER_DATA); /* auto-disable (see m68kcpu.h) */
 
@@ -950,6 +1025,15 @@ INLINE void m68ki_write_32(uint address, uint value)
 {
   cpu_memory_map *temp;
 
+  /* long write covers address..address+3 */
+  ROMDEV_WP_M68K(address,     value >> 24);
+  ROMDEV_WP_M68K(address + 1, value >> 16);
+  ROMDEV_WP_M68K(address + 2, value >> 8);
+  ROMDEV_WP_M68K(address + 3, value);
+  ROMDEV_RANGE_M68K(address,     value >> 24, 1);
+  ROMDEV_RANGE_M68K(address + 1, value >> 16, 1);
+  ROMDEV_RANGE_M68K(address + 2, value >> 8,  1);
+  ROMDEV_RANGE_M68K(address + 3, value,       1);
   m68ki_set_fc(FLAG_S | FUNCTION_CODE_USER_DATA) /* auto-disable (see m68kcpu.h) */
   m68ki_check_address_error(address, MODE_WRITE, FLAG_S | FUNCTION_CODE_USER_DATA) /* auto-disable (see m68kcpu.h) */
 
diff --git a/core/vdp_ctrl.c b/core/vdp_ctrl.c
index bd454f6..091b5e1 100644
--- a/core/vdp_ctrl.c
+++ b/core/vdp_ctrl.c
@@ -158,6 +158,34 @@ static int *fifo_timing;        /* FIFO slots timing table */
 static int hblank_start_cycle;  /* HBLANK flag set cycle */
 static int hblank_end_cycle;    /* HBLANK flag clear cycle */
 
+/* romdev VDP-DMA log (discovery): record every mem->VDP DMA as
+ * {vramDest, source, length, code}. The agent filters by VRAM dest to answer
+ * "which DMA wrote the tile at VRAM 0xNNNN and where from?" — the targeted
+ * version of traceVramSource. Genesis-only (VDP DMA is a Genesis concept).
+ * Ring buffer; host drains it. dma_code records the VDP code reg (low bits pick
+ * VRAM/CRAM/VSRAM) so the host can tell a VRAM upload from a palette DMA. */
+#define ROMDEV_DMA_CAP 1024
+unsigned int romdev_dma_enabled = 0;
+unsigned int romdev_dma_dest[ROMDEV_DMA_CAP];
+unsigned int romdev_dma_src [ROMDEV_DMA_CAP];
+unsigned int romdev_dma_len [ROMDEV_DMA_CAP];
+unsigned int romdev_dma_code[ROMDEV_DMA_CAP];
+unsigned int romdev_dma_count  = 0;   /* total DMAs seen */
+unsigned int romdev_dma_stored = 0;   /* stored (<= CAP) */
+
+static void romdev_dma_log(unsigned int dest, unsigned int src, unsigned int len, unsigned int codeReg)
+{
+  if (!romdev_dma_enabled) return;
+  romdev_dma_count++;
+  if (romdev_dma_stored < ROMDEV_DMA_CAP) {
+    romdev_dma_dest[romdev_dma_stored] = dest;
+    romdev_dma_src [romdev_dma_stored] = src;
+    romdev_dma_len [romdev_dma_stored] = len;
+    romdev_dma_code[romdev_dma_stored] = codeReg;
+    romdev_dma_stored++;
+  }
+}
+
  /* set Z80 or 68k interrupt lines */
 static void (*set_irq_line)(unsigned int level);
 static void (*set_irq_line_delay)(unsigned int level);
@@ -3089,6 +3117,10 @@ static void vdp_dma_68k_ext(unsigned int length)
   /* 68k bus source address */
   uint32 source = (reg[23] << 17) | (dma_src << 1);
 
+  /* romdev: log this mem->VDP DMA (dest VRAM/CRAM/VSRAM addr, ROM source byte
+   * addr, length in WORDS, VDP code reg). length is the word count; *2 = bytes. */
+  romdev_dma_log((unsigned int)addr, source, length, (unsigned int)code);
+
   do
   {
     /* Read data word from 68k bus */
@@ -3124,6 +3156,9 @@ static void vdp_dma_68k_ram(unsigned int length)
   /* 68k bus source address */
   uint32 source = (reg[23] << 17) | (dma_src << 1);
 
+  /* romdev: log work-RAM→VDP DMA too (SGDK font/tile uploads stage via RAM). */
+  romdev_dma_log((unsigned int)addr, source, length, (unsigned int)code);
+
   do
   {
     /* access Work-RAM by default  */
@@ -3152,6 +3187,9 @@ static void vdp_dma_68k_io(unsigned int length)
   /* 68k bus source address */
   uint32 source = (reg[23] << 17) | (dma_src << 1);
 
+  /* romdev: log I/O-area→VDP DMA too. */
+  romdev_dma_log((unsigned int)addr, source, length, (unsigned int)code);
+
   do
   {
     /* Z80 area */
diff --git a/core/z80/z80.c b/core/z80/z80.c
index 74d5053..30caf9b 100644
--- a/core/z80/z80.c
+++ b/core/z80/z80.c
@@ -220,6 +220,35 @@ unsigned char (*z80_readmem)(unsigned int address);
 void (*z80_writeport)(unsigned int port, unsigned char data);
 unsigned char (*z80_readport)(unsigned int port);
 
+/* romdev PC breakpoint — shared globals (defined in core/m68k/m68kcpu.c). For
+ * SMS/GG the Z80 is the active CPU; the execute hook in z80_run compares the
+ * live Z80 PC against romdev_pc_addr (or counts down a single-step) and, on a
+ * hit, freezes the CPU at that PC and ends the frame. Same globals the m68k
+ * path uses — only one CPU is active per platform, so sharing is fine. */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
