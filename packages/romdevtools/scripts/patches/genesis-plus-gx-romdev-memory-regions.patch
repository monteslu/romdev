+  /* romdev: log this mem->VDP DMA (dest VRAM/CRAM/VSRAM addr, ROM source byte
+   * addr, length in WORDS, VDP code reg). length is the word count; *2 = bytes. */
+  romdev_dma_log((unsigned int)addr, source, length, (unsigned int)code);
+
   do
   {
     /* Read data word from 68k bus */
@@ -3124,6 +3176,9 @@ static void vdp_dma_68k_ram(unsigned int length)
   /* 68k bus source address */
   uint32 source = (reg[23] << 17) | (dma_src << 1);
 
+  /* romdev: log work-RAM→VDP DMA too (SGDK font/tile uploads stage via RAM). */
+  romdev_dma_log((unsigned int)addr, source, length, (unsigned int)code);
+
   do
