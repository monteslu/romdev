+ * [16]=PC of the EXECUTING instruction, [18]=SP). Fills the shared romdev_snap_regs[].
+ * The read/write hooks (RM/WM) below feed the shared romdev_on_read/on_write and take
+ * this snapshot when the lib reports a hit. romdev_z80_instr_pc is in m68kcpu.c. */
+static void romdev_z80_snap(int kind)
+{
+  int i;
+  for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+  romdev_snap_regs[0]  = Z80.af.b.h;  romdev_snap_regs[1] = Z80.af.b.l;
+  romdev_snap_regs[2]  = Z80.bc.b.h;  romdev_snap_regs[3] = Z80.bc.b.l;
+  romdev_snap_regs[4]  = Z80.de.b.h;  romdev_snap_regs[5] = Z80.de.b.l;
+  romdev_snap_regs[6]  = Z80.hl.b.h;  romdev_snap_regs[7] = Z80.hl.b.l;
+  romdev_snap_regs[8]  = Z80.ix.w.l;  romdev_snap_regs[9] = Z80.iy.w.l;
+  romdev_snap_regs[16] = romdev_z80_instr_pc;
+  romdev_snap_regs[18] = Z80.sp.w.l;
+  romdev_snap_kind = kind;
+}
+
+#define RM(addr) romdev_z80_rm((addr))
+INLINE unsigned char romdev_z80_rm(unsigned int addr)
+{
+  unsigned char v = z80_readmem(addr);
+  if (romdev_on_read((unsigned int)addr, v, romdev_z80_instr_pc)) romdev_z80_snap(4);
