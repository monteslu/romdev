+
+/* romdev VRAM-port copy trace (hooks in vdp_ctrl.c's data-port write paths —
+ * the CPU-port complement of romdev_dmawatch). set(lo,hi,enabled) arms a VRAM
+ * byte-address window + clears the ring; get drains [vaddr,pc,val] triples,
+ * out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addrs[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs  [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals [ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addrs[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs  [romdev_vw_stored] = pc;
+      romdev_vw_vals [romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addrs[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+/* Pure-CPU run for callSubroutine: advance ONLY the active CPU by up to
+ * `budget_cycles` — no VDP line processing, no co-CPU, no interrupt sources.
+ * The armed pc-break sentinel / instruction watchdog still fire inside the
+ * run loop; the host polls romdev_pcbreak_get between chunks. Implemented in
+ * the CPU cores (cycle counters are restored there so frame scheduling is
+ * unaffected). */
+extern void romdev_m68k_run_pure(unsigned int budget_cycles);
+extern void romdev_z80_run_pure(unsigned int budget_cycles);
+void romdev_run_pure(unsigned int budget_cycles)
+{
+   if (ROMDEV_ACTIVE_IS_Z80())
+      romdev_z80_run_pure(budget_cycles);
+   else
+      romdev_m68k_run_pure(budget_cycles);
+}
+
+/* romdev VDP-DMA log (discovery, Genesis-only) — record every mem->VDP DMA
+ * {vramDest, romSource, lengthWords, vdpCode}; the host filters by VRAM dest. */
+extern unsigned int romdev_dma_enabled;
+extern unsigned int romdev_dma_dest[], romdev_dma_src[], romdev_dma_len[], romdev_dma_code[];
+extern unsigned int romdev_dma_count, romdev_dma_stored;
+
+void romdev_dmawatch_set(int enabled)
+{
+   romdev_dma_enabled = enabled ? 1 : 0;
+   romdev_dma_count = 0; romdev_dma_stored = 0;
+}
+
+/* Drain up to `max` DMAs as packed quads [dest,src,lenWords,code,...].
+ * out2 (size 2) gets [totalSeen, stored]. */
+unsigned int romdev_dmawatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_dma_stored;
+   if (out2) { out2[0] = romdev_dma_count; out2[1] = romdev_dma_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*4 + 0] = romdev_dma_dest[i];
+      out[i*4 + 1] = romdev_dma_src[i];
+      out[i*4 + 2] = romdev_dma_len[i];
+      out[i*4 + 3] = romdev_dma_code[i];
+   }
+   return n;
+}
