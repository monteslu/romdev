+/*--------------------------------------------------------------------------*/
+/* Pixel layer merging function                                             */
+/*--------------------------------------------------------------------------*/
+
+INLINE void merge(uint8 *srca, uint8 *srcb, uint8 *dst, uint8 *table, int width)
+{
+  do
+  {
+    *dst++ = table[(*srcb++ << 8) | (*srca++)];
+  }
+  while (--width);
+}
