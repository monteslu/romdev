+  dst++;
+#endif
+#else /* NOT ALIGNED */
+#ifdef LSB_FIRST
+#define DRAW_COLUMN(ATTR, LINE) \
+  GET_LSB_TILE(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex); \
+  GET_MSB_TILE(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex);
+#define DRAW_COLUMN_IM2(ATTR, LINE) \
+  GET_LSB_TILE_IM2(ATTR, LINE) \
+  *dst++ = (src[0] | atex); \
+  *dst++ = (src[1] | atex); \
