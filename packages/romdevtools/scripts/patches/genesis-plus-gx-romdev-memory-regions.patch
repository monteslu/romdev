+/* Pattern attribute (priority + palette bits) expansion table */
+static const uint32 atex_table[] =
+{
+  0x00000000,
+  0x10101010,
+  0x20202020,
+  0x30303030,
+  0x40404040,
+  0x50505050,
+  0x60606060,
+  0x70707070
+};
