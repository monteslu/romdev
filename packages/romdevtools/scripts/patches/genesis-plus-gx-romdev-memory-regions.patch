-      /* Merge background & sprite layers */
-      merge(&linebuf[1][0x20], &linebuf[0][0x20], &linebuf[0][0x20], lut[4], bitmap.viewport.w);
-
-      /* Stop sprite rendering */
-      return;
-    }
-
-    /* Next sprite entry */
-    object_info++;
-  }
-
-  /* Clear sprite masking for next line */
-  spr_ovr = 0;
-
-  /* Merge background & sprite layers */
-  merge(&linebuf[1][0x20], &linebuf[0][0x20], &linebuf[0][0x20], lut[4], bitmap.viewport.w);
-}
