+static void osd_input_update_internal(void)
+{
+   int i, player = 0;
+   unsigned int temp;
+
+   for (i = 0; i < MAX_INPUTS; i++)
+   {
+      temp = 0;
+      switch (input.dev[i])
+      {
+         case DEVICE_PAD6B:
+            if (input_state_cb(player, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_L))
+               temp |= INPUT_X;
