+extern unsigned int  romdev_m68k_instr_pc;
+extern void          romdev_m68k_snap(int kind);
+#define ROMDEV_WP_M68K(a, v) do { \
+    unsigned char romdev_oldv = romdev_wp_wants_old() ? (unsigned char)m68ki_read_8((a)) : 0; \
