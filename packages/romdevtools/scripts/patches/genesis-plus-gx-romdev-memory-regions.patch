+/***************************************************************
+ * LDI
+ ***************************************************************/
+#define LDI {                                           \
+  UINT8 io = RM(HL);                                    \
+  WM( DE, io );                                         \
+  F &= SF | ZF | CF;                                    \
+  if( (A + io) & 0x02 ) F |= YF; /* bit 1 -> flag 5 */  \
+  if( (A + io) & 0x08 ) F |= XF; /* bit 3 -> flag 3 */  \
+  HL++; DE++; BC--;                                     \
+  if( BC ) F |= VF;                                     \
+}
+
+/***************************************************************
+ * CPI
+ ***************************************************************/
+#define CPI {                                                 \
+  UINT8 val = RM(HL);                                         \
+  UINT8 res = A - val;                                        \
+  WZ++;                                                       \
+  HL++; BC--;                                                 \
+  F = (F & CF) | (SZ[res]&~(YF|XF)) | ((A^val^res)&HF) | NF;  \
+  if( F & HF ) res -= 1;                                      \
+  if( res & 0x02 ) F |= YF; /* bit 1 -> flag 5 */             \
+  if( res & 0x08 ) F |= XF; /* bit 3 -> flag 3 */             \
+  if( BC ) F |= VF;                                           \
+}
+
+/***************************************************************
+ * INI
+ ***************************************************************/
+#define INI {                                           \
+  unsigned t;                                           \
+  UINT8 io = IN(BC);                                    \
+  WZ = BC + 1;                                          \
+  CC(ex,0xa2);                                          \
+  B--;                                                  \
+  WM( HL, io );                                         \
+  HL++;                                                 \
+  F = SZ[B];                                            \
+  t = (unsigned)((C + 1) & 0xff) + (unsigned)io;        \
+  if( io & SF ) F |= NF;                                \
+  if( t & 0x100 ) F |= HF | CF;                         \
+  F |= SZP[(UINT8)(t & 0x07) ^ B] & PF;                 \
+}
+
+/***************************************************************
+ * OUTI
+ ***************************************************************/
+#define OUTI {                                          \
+  unsigned t;                                           \
+  UINT8 io = RM(HL);                                    \
+  B--;                                                  \
+  WZ = BC + 1;                                          \
+  OUT( BC, io );                                        \
+  HL++;                                                 \
+  F = SZ[B];                                            \
+  t = (unsigned)L + (unsigned)io;                       \
+  if( io & SF ) F |= NF;                                \
+  if( t & 0x100 ) F |= HF | CF;                         \
+  F |= SZP[(UINT8)(t & 0x07) ^ B] & PF;                 \
+}
+
+/***************************************************************
+ * LDD
+ ***************************************************************/
+#define LDD {                                           \
+  UINT8 io = RM(HL);                                    \
+  WM( DE, io );                                         \
+  F &= SF | ZF | CF;                                    \
+  if( (A + io) & 0x02 ) F |= YF; /* bit 1 -> flag 5 */  \
+  if( (A + io) & 0x08 ) F |= XF; /* bit 3 -> flag 3 */  \
+  HL--; DE--; BC--;                                     \
+  if( BC ) F |= VF;                                     \
+}
+
+/***************************************************************
+ * CPD
+ ***************************************************************/
+#define CPD {                                                 \
+  UINT8 val = RM(HL);                                         \
+  UINT8 res = A - val;                                        \
+  WZ--;                                                       \
+  HL--; BC--;                                                 \
+  F = (F & CF) | (SZ[res]&~(YF|XF)) | ((A^val^res)&HF) | NF;  \
+  if( F & HF ) res -= 1;                                      \
+  if( res & 0x02 ) F |= YF; /* bit 1 -> flag 5 */             \
+  if( res & 0x08 ) F |= XF; /* bit 3 -> flag 3 */             \
+  if( BC ) F |= VF;                                           \
