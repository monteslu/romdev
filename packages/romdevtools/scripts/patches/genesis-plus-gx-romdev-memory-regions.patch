+/***************************************************************
+ * LDIR
+ ***************************************************************/
+#define LDIR            \
+  LDI;                  \
+  if( BC )              \
+  {                     \
+    PC -= 2;            \
+    WZ = PC + 1;        \
+    CC(ex,0xb0);        \
+  }
+
+/***************************************************************
+ * CPIR
+ ***************************************************************/
+#define CPIR            \
+  CPI;                  \
+  if( BC && !(F & ZF) ) \
+  {                     \
+    PC -= 2;            \
+   WZ = PC + 1;         \
+    CC(ex,0xb1);        \
+  }
+
+/***************************************************************
+ * INIR
+ ***************************************************************/
+#define INIR      \
+  INI;            \
+  if( B )         \
