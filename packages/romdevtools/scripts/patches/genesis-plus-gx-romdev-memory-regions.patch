+static void init_bitmap(void)
+{
+   memset(&bitmap, 0, sizeof(bitmap));
+   bitmap.width      = 720;
+   bitmap.height     = 576;
+   bitmap.pitch      = 720 * 2;
+   bitmap.data       = (uint8_t *)bitmap_data_;
+}
