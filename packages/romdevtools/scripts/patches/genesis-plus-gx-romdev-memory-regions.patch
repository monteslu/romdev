-extern int8 fast_savestates;
-
-bool get_fast_savestates(void)
-{
-   int result = -1;
-   bool okay = false;
-   okay = environ_cb(RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE, &result);
-   if (okay)
