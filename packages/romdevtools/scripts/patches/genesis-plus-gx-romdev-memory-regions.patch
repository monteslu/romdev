+void retro_unload_game(void) 
+{
+	/* Clear disk interface */
+   int i;
+   disk_count = 0;
+   disk_index = 0;
+   for (i=0; i<MAX_DISKS; i++)
+   {
+      if (disk_info[i] != NULL)
+      {
+         free(disk_info[i]);
+         disk_info[i] = NULL;
+      }
+   }
+
+   if (system_hw == SYSTEM_MCD)
+      bram_save();
+
+   audio_shutdown();
+
+   if (md_ntsc)
+      free(md_ntsc);
+   md_ntsc   = NULL;
+   if (sms_ntsc)
+      free(sms_ntsc);
+   sms_ntsc  = NULL;
+
+   system_hw = 0;
+}
+
+unsigned retro_get_region(void) { return vdp_pal ? RETRO_REGION_PAL : RETRO_REGION_NTSC; }
+
+/* romdev (0.80.0): the watchpoint/readwatch/range/coverage/pcbreak/watchdog/regsnap/
+ * irqblock exports now come from the shared romdev_debug.c. Only the m68k+z80
+ * romdev_setReg/getReg (the per-platform register dispatcher) + the memory regions
+ * stay here. The m68k snapshot is in m68kcpu.c, the z80 snapshot in z80.c. */
+#include "romdev_debug.h"
+
+/* romdev register read/write — the inverse of getCPUState, used by the host's
+ * callSubroutine / decompressWith (set args + PC=entry, push a sentinel return,
+ * run to it, capture the output). gpgx emulates TWO CPUs: the m68k (Genesis) and
+ * the Z80 (SMS/GG/Mark III). We dispatch on the loaded system: `system_hw`
+ * (declared in system.h via shared.h) carries SYSTEM_MD/SYSTEM_PBC for Genesis
+ * and SYSTEM_SMS/SYSTEM_GG/etc for the 8-bit machines. The idiom used throughout
+ * this file is `(system_hw & SYSTEM_PBC) == SYSTEM_MD` for "this is a Genesis/MD"
+ * — its negation selects the Z80 systems (same dispatch getCPUState mirrors when
+ * it reads SMS_Z80_REGS vs GENESIS_M68K).
+ *
+ * reg-id conventions (STABLE per CPU, the host passes the same ids per platform):
+ *   m68k:  0..7 = D0..D7, 8..15 = A0..A7, 16 = PC, 17 = SR, 18 = SP.
+ *   Z80:   0=A 1=F 2=B 3=C 4=D 5=E 6=H 7=L 8=IX 9=IY 16=PC 18=SP.
+ * Returns 0 on success, -1 on an unknown id. The Z80 register file is the live
+ * `Z80` global (Z80_Regs; PAIR unions — .b.h/.b.l byte access, .w.l word). */
+extern void m68k_set_reg(m68k_register_t reg, unsigned int value);
+extern unsigned int m68k_get_reg(m68k_register_t reg);
+
+/* true when the active system runs the Z80 (SMS / GG / Mark III), not the m68k. */
+#define ROMDEV_ACTIVE_IS_Z80() (((system_hw) & SYSTEM_PBC) != SYSTEM_MD)
+
+static int romdev_setreg_z80(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  Z80.af.b.h = (unsigned char)value; return 0;  /* A */
+      case 1:  Z80.af.b.l = (unsigned char)value; return 0;  /* F */
+      case 2:  Z80.bc.b.h = (unsigned char)value; return 0;  /* B */
+      case 3:  Z80.bc.b.l = (unsigned char)value; return 0;  /* C */
+      case 4:  Z80.de.b.h = (unsigned char)value; return 0;  /* D */
+      case 5:  Z80.de.b.l = (unsigned char)value; return 0;  /* E */
+      case 6:  Z80.hl.b.h = (unsigned char)value; return 0;  /* H */
+      case 7:  Z80.hl.b.l = (unsigned char)value; return 0;  /* L */
+      case 8:  Z80.ix.w.l = (unsigned short)value; return 0; /* IX */
+      case 9:  Z80.iy.w.l = (unsigned short)value; return 0; /* IY */
+      case 16: Z80.pc.w.l = (unsigned short)value; return 0; /* PC */
+      case 18: Z80.sp.w.l = (unsigned short)value; return 0; /* SP */
+      default: return -1;
+   }
+}
+
+static unsigned int romdev_getreg_z80(int regId)
+{
+   switch (regId) {
+      case 0:  return Z80.af.b.h;  /* A */
+      case 1:  return Z80.af.b.l;  /* F */
+      case 2:  return Z80.bc.b.h;  /* B */
+      case 3:  return Z80.bc.b.l;  /* C */
+      case 4:  return Z80.de.b.h;  /* D */
+      case 5:  return Z80.de.b.l;  /* E */
+      case 6:  return Z80.hl.b.h;  /* H */
+      case 7:  return Z80.hl.b.l;  /* L */
+      case 8:  return Z80.ix.w.l;  /* IX */
+      case 9:  return Z80.iy.w.l;  /* IY */
+      case 16: return Z80.pc.w.l;  /* PC */
+      case 18: return Z80.sp.w.l;  /* SP */
+      default: return 0;
+   }
+}
+
+int romdev_setreg(int regId, unsigned int value)
+{
+   if (ROMDEV_ACTIVE_IS_Z80())
+      return romdev_setreg_z80(regId, value);
+   if (regId >= 0 && regId <= 7)        { m68k_set_reg((m68k_register_t)(M68K_REG_D0 + regId),        value); return 0; }
+   if (regId >= 8 && regId <= 15)       { m68k_set_reg((m68k_register_t)(M68K_REG_A0 + (regId - 8)),  value); return 0; }
+   if (regId == 16)                     { m68k_set_reg(M68K_REG_PC, value); return 0; }
+   if (regId == 17)                     { m68k_set_reg(M68K_REG_SR, value); return 0; }
+   if (regId == 18)                     { m68k_set_reg(M68K_REG_SP, value); return 0; }
+   return -1;
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   if (ROMDEV_ACTIVE_IS_Z80())
+      return romdev_getreg_z80(regId);
+   if (regId >= 0 && regId <= 7)        return m68k_get_reg((m68k_register_t)(M68K_REG_D0 + regId));
+   if (regId >= 8 && regId <= 15)       return m68k_get_reg((m68k_register_t)(M68K_REG_A0 + (regId - 8)));
+   if (regId == 16)                     return m68k_get_reg(M68K_REG_PC);
+   if (regId == 17)                     return m68k_get_reg(M68K_REG_SR);
+   if (regId == 18)                     return m68k_get_reg(M68K_REG_SP);
+   return 0;
+}
+
+
+/* romdev VRAM-port copy trace (hooks in vdp_ctrl.c's data-port write paths —
+ * the CPU-port complement of romdev_dmawatch). set(lo,hi,enabled) arms a VRAM
+ * byte-address window + clears the ring; get drains [vaddr,pc,val] triples,
+ * out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addrs[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs  [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals [ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addrs[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs  [romdev_vw_stored] = pc;
+      romdev_vw_vals [romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addrs[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+/* Pure-CPU run for callSubroutine: advance ONLY the active CPU by up to
+ * `budget_cycles` — no VDP line processing, no co-CPU, no interrupt sources.
+ * The armed pc-break sentinel / instruction watchdog still fire inside the
+ * run loop; the host polls romdev_pcbreak_get between chunks. Implemented in
+ * the CPU cores (cycle counters are restored there so frame scheduling is
+ * unaffected). */
+extern void romdev_m68k_run_pure(unsigned int budget_cycles);
+extern void romdev_z80_run_pure(unsigned int budget_cycles);
+void romdev_run_pure(unsigned int budget_cycles)
+{
+   if (ROMDEV_ACTIVE_IS_Z80())
+      romdev_z80_run_pure(budget_cycles);
+   else
+      romdev_m68k_run_pure(budget_cycles);
+}
+
+/* romdev VDP-DMA log (discovery, Genesis-only) — record every mem->VDP DMA
+ * {vramDest, romSource, lengthWords, vdpCode}; the host filters by VRAM dest. */
+extern unsigned int romdev_dma_enabled;
+extern unsigned int romdev_dma_dest[], romdev_dma_src[], romdev_dma_len[], romdev_dma_code[];
+extern unsigned int romdev_dma_count, romdev_dma_stored;
+
+void romdev_dmawatch_set(int enabled)
+{
+   romdev_dma_enabled = enabled ? 1 : 0;
+   romdev_dma_count = 0; romdev_dma_stored = 0;
+}
+
+/* Drain up to `max` DMAs as packed quads [dest,src,lenWords,code,...].
+ * out2 (size 2) gets [totalSeen, stored]. */
+unsigned int romdev_dmawatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_dma_stored;
+   if (out2) { out2[0] = romdev_dma_count; out2[1] = romdev_dma_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*4 + 0] = romdev_dma_dest[i];
+      out[i*4 + 1] = romdev_dma_src[i];
+      out[i*4 + 2] = romdev_dma_len[i];
+      out[i*4 + 3] = romdev_dma_code[i];
+   }
+   return n;
+}
+
+/* rom-dev-mcp extension: custom memory region IDs above libretro standard.
+ * Mirrors fceumm + snes9x patches. Exposes Genesis sound/video chip state
+ * so inspectSprites / inspectPalette / getCPUState / etc. can read live
+ * data instead of parsing the savestate blob.
+ *
+ * Sound chip state (YM2612, PSG) is `static` in gpgx; we expose binary
+ * snapshots via psg_context_save / YM2612SaveContext into a per-process
+ * scratch buffer that callers read on demand. Decoders parse the known
+ * format on the JS side. */
+#define ROMDEV_MEMORY_GENESIS_CRAM     0x120
+#define ROMDEV_MEMORY_GENESIS_VSRAM    0x121
+#define ROMDEV_MEMORY_GENESIS_VDP_REGS 0x122
+#define ROMDEV_MEMORY_GENESIS_Z80_RAM  0x123
+#define ROMDEV_MEMORY_GENESIS_M68K     0x124
+#define ROMDEV_MEMORY_GENESIS_YM2612   0x125
+#define ROMDEV_MEMORY_GENESIS_PSG      0x126
+
+/* Resolved-layer capture (vdp_render.c, romdev_md_* buffers). One capture
+ * serves Genesis, SMS and GG: the line renderer is shared, so the host may
+ * register these same IDs under per-platform names. See the buffer block in
+ * vdp_render.c for byte semantics. */
+#define ROMDEV_MEMORY_MD_LINEPIX   0x127  /* 240*320 B, final composed code */
+#define ROMDEV_MEMORY_MD_BGPIX     0x128  /* 240*320 B, BG-only composed code */
+#define ROMDEV_MEMORY_MD_OBJPIX    0x129  /* 240*320 u16 LE, presence<<8|code */
+#define ROMDEV_MEMORY_MD_PIXRGB    0x12A  /* pixel[] table, size/0x100 = entry width */
+#define ROMDEV_MEMORY_MD_LINESTATE 0x12B  /* 240*16 B per-line reg snapshot */
+#define ROMDEV_MEMORY_MD_PIXLINES  0x12C  /* 240*512 B per-line pixel[] table */
+
+/* SMS / Game Gear region IDs. Same gpgx globals (vram/cram/reg) are
+ * shared across all systems gpgx emulates, but with different sizes:
+ *   SMS:  VRAM 16KB, CRAM 32B (16 entries × 6-bit BGR), VDP regs 11
+ *   GG:   VRAM 16KB, CRAM 64B (32 entries × 12-bit BGR), VDP regs 11
+ * Expose with SMS-correct sizes so callers don't need to know the
+ * Genesis-shaped backing buffer is 64KB / 128B / 32B. */
+#define ROMDEV_MEMORY_SMS_VRAM     0x130
+#define ROMDEV_MEMORY_SMS_CRAM     0x131
+#define ROMDEV_MEMORY_SMS_VDP_REGS 0x132
+#define ROMDEV_MEMORY_SMS_Z80_REGS 0x133
+#define ROMDEV_MEMORY_GG_VRAM      0x134
+#define ROMDEV_MEMORY_GG_CRAM      0x135
+
+/* shared.h already brings in genesis.h / vdp_ctrl.h / m68k.h. Sound
+ * headers aren't in shared.h; add them. Header paths are relative to
+ * the core/ include dir (Makefile.libretro adds it with -I). */
+#include "sound/ym2612.h"
+#include "sound/psg.h"
+#include "z80/z80.h"
+
+static unsigned char romdev_ym2612_snap[4096];
+static unsigned char romdev_psg_snap[1024];
+static unsigned char romdev_z80_snap[sizeof(Z80_Regs)];
+
+/* vdp_render.c resolved-layer capture buffers */
+extern uint8    romdev_md_linepix[240 * 320];
+extern uint8    romdev_md_bgpix[240 * 320];
+extern uint16   romdev_md_objpix[240 * 320];
+extern uint8    romdev_md_linestate[240 * 16];
+extern uint8    romdev_md_pixlines[240 * 512];
+extern void    *romdev_md_pixrgb_data(void);
+extern unsigned romdev_md_pixrgb_size(void);
+
+
+void *retro_get_memory_data(unsigned id)
+{
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+         return sram.on ? sram.sram : NULL;
+      case RETRO_MEMORY_SYSTEM_RAM:
+         return work_ram;
+      case RETRO_MEMORY_VIDEO_RAM:
+         return vram;
+      case ROMDEV_MEMORY_GENESIS_CRAM:
+         return cram;
+      case ROMDEV_MEMORY_GENESIS_VSRAM:
+         return vsram;
+      case ROMDEV_MEMORY_GENESIS_VDP_REGS:
+         return reg;
+      case ROMDEV_MEMORY_GENESIS_Z80_RAM:
+         return zram;
+      case ROMDEV_MEMORY_GENESIS_M68K:
+         return &m68k;
+      case ROMDEV_MEMORY_GENESIS_YM2612:
+         YM2612SaveContext(romdev_ym2612_snap);
+         return romdev_ym2612_snap;
+      case ROMDEV_MEMORY_GENESIS_PSG:
+         psg_context_save(romdev_psg_snap);
+         return romdev_psg_snap;
+      case ROMDEV_MEMORY_MD_LINEPIX:
+         return romdev_md_linepix;
+      case ROMDEV_MEMORY_MD_BGPIX:
+         return romdev_md_bgpix;
+      case ROMDEV_MEMORY_MD_OBJPIX:
+         return romdev_md_objpix;
+      case ROMDEV_MEMORY_MD_PIXRGB:
+         return romdev_md_pixrgb_data();
+      case ROMDEV_MEMORY_MD_LINESTATE:
+         return romdev_md_linestate;
+      case ROMDEV_MEMORY_MD_PIXLINES:
+         return romdev_md_pixlines;
+      case ROMDEV_MEMORY_SMS_VRAM:
+      case ROMDEV_MEMORY_GG_VRAM:
+         return vram;
+      case ROMDEV_MEMORY_SMS_CRAM:
+      case ROMDEV_MEMORY_GG_CRAM:
+         return cram;
+      case ROMDEV_MEMORY_SMS_VDP_REGS:
+         return reg;
+      case ROMDEV_MEMORY_SMS_Z80_REGS:
+         memcpy(romdev_z80_snap, &Z80, sizeof(Z80_Regs));
+         return romdev_z80_snap;
+      default:
+         return NULL;
+   }
+}
+
+size_t retro_get_memory_size(unsigned id)
+{
+   int i;
+
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+      {
+         /* return 0 if SRAM is disabled */
+         if (!sram.on)
+            return 0;
+
+         /* if emulation is not running, we assume the frontend is requesting SRAM size for loading so max supported size is returned */
+         if (!is_running)
+            return 0x10000;
+
+         /* otherwise, we assume this is for saving and we return the size of SRAM data that has actually been modified */
+         /* this is obviously not %100 safe since the frontend could still be trying to load SRAM while emulation is running */
+         /* a better solution would be that the frontend itself checks if data has been modified before writing it to a file */
+         for (i=0xffff; i>=0; i--)
+            if (sram.sram[i] != 0xff)
+               return (i+1);
+
+         /* return 0 if SRAM is not modified */
+         return 0;
+      }
+
+      case RETRO_MEMORY_SYSTEM_RAM:
+      {
+         /* 16-bit hardware */
+         if ((system_hw & SYSTEM_PBC) == SYSTEM_MD)
+            return 0x10000; /* 64KB internal RAM */
+
+         /* get 8-bit cartrige on-board RAM size */
+         i = sms_cart_ram_size();
+
+         if (i > 0)
+            return i + 0x2000; /* on-board RAM size + max 8KB internal RAM */
+         else if (system_hw == SYSTEM_SGII)
+            return 0x0800; /* 2KB internal RAM */
+         else if (system_hw == SYSTEM_SG)
+            return 0x0400; /* 1KB internal RAM */
+         else
+            return 0x2000; /* 8KB internal RAM */
+      }
+
+      case RETRO_MEMORY_VIDEO_RAM:        return 0x10000;
+      case ROMDEV_MEMORY_GENESIS_CRAM:     return 0x80;
+      case ROMDEV_MEMORY_GENESIS_VSRAM:    return 0x80;
+      case ROMDEV_MEMORY_GENESIS_VDP_REGS: return 0x20;
+      case ROMDEV_MEMORY_GENESIS_Z80_RAM:  return 0x2000;
+      case ROMDEV_MEMORY_GENESIS_M68K:     return sizeof(m68ki_cpu_core);
+      case ROMDEV_MEMORY_GENESIS_YM2612:   return sizeof(romdev_ym2612_snap);
+      case ROMDEV_MEMORY_GENESIS_PSG:      return sizeof(romdev_psg_snap);
+      case ROMDEV_MEMORY_MD_LINEPIX:       return 240 * 320;
+      case ROMDEV_MEMORY_MD_BGPIX:         return 240 * 320;
+      case ROMDEV_MEMORY_MD_OBJPIX:        return 240 * 320 * 2;
+      case ROMDEV_MEMORY_MD_PIXRGB:        return romdev_md_pixrgb_size();
+      case ROMDEV_MEMORY_MD_LINESTATE:     return 240 * 16;
+      case ROMDEV_MEMORY_MD_PIXLINES:      return 240 * 512;
+      case ROMDEV_MEMORY_SMS_VRAM:         return 0x4000;   /* SMS VRAM = 16 KB */
+      case ROMDEV_MEMORY_GG_VRAM:          return 0x4000;   /* GG VRAM  = 16 KB */
+      case ROMDEV_MEMORY_SMS_CRAM:         return 0x20;     /* SMS CRAM = 32 B  */
+      case ROMDEV_MEMORY_GG_CRAM:          return 0x40;     /* GG CRAM  = 64 B  */
+      case ROMDEV_MEMORY_SMS_VDP_REGS:     return 0x10;     /* SMS uses lower 16 of the 32-byte reg file */
+      case ROMDEV_MEMORY_SMS_Z80_REGS:     return sizeof(romdev_z80_snap);
+
+      default:
+        return 0;
+   }
+}
+
+static void check_system_specs(void)
+{
+   unsigned level = 7;
+   environ_cb(RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL, &level);
+}
+
+void retro_init(void)
+{
+   struct retro_log_callback log;
+   unsigned level                = 1;
+   uint64_t serialization_quirks = RETRO_SERIALIZATION_QUIRK_PLATFORM_DEPENDENT;
+
+   environ_cb(RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL, &level);
+
+   if (environ_cb(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log))
+      log_cb = log.log;
+   else
+      log_cb = NULL;
+
+   if (environ_cb(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL))
+      libretro_supports_bitmasks = true;
+
+   check_system_specs();
+
+   environ_cb(RETRO_ENVIRONMENT_SET_SERIALIZATION_QUIRKS, &serialization_quirks);
+   environ_cb(RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE, &disk_ctrl);
+
+   frameskip_type             = 0;
+   frameskip_threshold        = 0;
+   frameskip_counter          = 0;
+   retro_audio_buff_active    = false;
+   retro_audio_buff_occupancy = 0;
+   retro_audio_buff_underrun  = false;
+   audio_latency              = 0;
+   update_audio_latency       = false;
+}
+
+void retro_deinit(void)
+{
+   libretro_supports_option_categories = false;
+   libretro_supports_bitmasks          = false;
+
+   g_rom_data = NULL;
+   g_rom_size = 0;
+}
+
+void retro_reset(void)
+{
+#ifdef HAVE_OVERCLOCK
+   overclock_delay = OVERCLOCK_FRAME_DELAY;
+   update_overclock();
+#endif
+   gen_reset(0);
+}
+
+extern int8 audio_hard_disable;
+
+extern void sound_update_fm_function_pointers(void);
+
+void retro_run(void) 
+{
+   bool okay = false;
+   int result = -1;
+   int do_skip = 0;
+   bool updated = false;
+   int soundbuffer_size = 0;
+
+   is_running = true;
+
+#ifdef HAVE_OVERCLOCK
+  /* update overclock delay */
+  if (overclock_delay && --overclock_delay == 0)
+      update_overclock();
+#endif
+
+   environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated);
+   if (updated)
+   {
+      check_variables(false);
+      if (restart_eq)
+      {
+         audio_set_equalizer();
+         restart_eq = false;
+      }
+   }
+
+   okay = environ_cb(RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE, &result);
+   if (okay)
+   {
+      bool audioEnabled = 0 != (result & 2);
+      bool videoEnabled = 0 != (result & 1);
+      bool hardDisableAudio = 0 != (result & 8);
+      do_skip = !videoEnabled;
+      if (audio_hard_disable != hardDisableAudio)
+      {
+        audio_hard_disable = hardDisableAudio;
+        sound_update_fm_function_pointers();
+      }
+   }
+   else
+   {
+      do_skip = false;
+      audio_hard_disable = false;
+   }
+
+  /* Check whether current frame should
+  * be skipped */
+  if ((frameskip_type > 0) &&
+      retro_audio_buff_active &&
+      !do_skip)
+  {
+    switch (frameskip_type)
+    {
+      case 1: /* auto */
+        do_skip = retro_audio_buff_underrun ? 1 : 0;
+        break;
+      case 2: /* manual */
+        do_skip = (retro_audio_buff_occupancy < frameskip_threshold) ? 1 : 0;
+        break;
+      default:
+        do_skip = 0;
+        break;
+    }
+
+    if (!do_skip || (frameskip_counter >= FRAMESKIP_MAX))
+    {
+      do_skip           = 0;
+      frameskip_counter = 0;
+    }
+    else
+      frameskip_counter++;
+  }
+
+  /* If frameskip settings have changed, update
+  * frontend audio latency */
+  if (update_audio_latency)
+  {
+    environ_cb(RETRO_ENVIRONMENT_SET_MINIMUM_AUDIO_LATENCY,
+        &audio_latency);
+    update_audio_latency = false;
+  }
+
+   if (system_hw == SYSTEM_MCD)
+   {
+      system_frame_scd(do_skip);
+   }
+   else if ((system_hw & SYSTEM_PBC) == SYSTEM_MD)
+   {
+      system_frame_gen(do_skip);
+   }
+   else
+   {
+      system_frame_sms(do_skip);
+   }
+
+   soundbuffer_size = audio_update(soundbuffer);
+
+   /* Force viewport update when SMS border changes after startup undetected */
+   if (     ((system_hw == SYSTEM_MARKIII) || (system_hw & SYSTEM_SMS) || (system_hw == SYSTEM_PBC))
+         && reg[0] != reg0_prev)
+      bitmap.viewport.changed = 9;
+
+   reg0_prev = reg[0];
+
+   if (bitmap.viewport.changed & 9)
+   {
+      bool geometry_updated = update_viewport();
+      bitmap.viewport.changed &= ~1;
+      bitmap.viewport.changed &= ~8;
+      if (geometry_updated)
+         update_geometry();
+   }
+
+   if (config.gun_cursor)
+   {
+      if (input.system[0] == SYSTEM_LIGHTPHASER)
+      {
+         draw_cursor(input.analog[0][0], input.analog[0][1], 0x001f);
+      }
+      else if (input.dev[4] == DEVICE_LIGHTGUN)
+      {
+         draw_cursor(input.analog[4][0], input.analog[4][1], 0x001f);
+      }
+
+      if (input.system[1] == SYSTEM_LIGHTPHASER)
+      {
+         draw_cursor(input.analog[4][0], input.analog[4][1], 0xf800);
+      }
+      else if (input.dev[5] == DEVICE_LIGHTGUN)
+      {
+         draw_cursor(input.analog[5][0], input.analog[5][1], 0xf800);
+      }
+   }
+
+   /* LED interface */
+   if (led_state_cb)
+      retro_led_interface();
+
+   if (!do_skip)
+      video_cb(bitmap.data + bmdoffset, vwidth - vwoffset, vheight, 720 * 2);
+   else
+      video_cb(NULL, vwidth - vwoffset, vheight, 720 * 2);
+
+   audio_cb(soundbuffer, soundbuffer_size);
+}
+
+#undef  CHUNKSIZE
