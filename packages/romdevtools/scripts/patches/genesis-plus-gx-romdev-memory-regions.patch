-/* Graphics I */
-void render_bg_m0(int line)
-{
-  uint8 color, name, pattern;
-
-  uint8 *lb = &linebuf[0][0x20];
-  uint8 *nt = &vram[((reg[2] << 10) & 0x3C00) + ((line & 0xF8) << 2)];
