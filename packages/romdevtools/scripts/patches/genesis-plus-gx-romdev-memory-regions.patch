+}
 
 /***************************************************************
  * Write a byte to given memory location
  ***************************************************************/
-#define WM(addr,value) z80_writemem(addr,value)
+/* WM must be a FUNCTION, not a macro: many call sites pass side-effecting args
+ * (e.g. WM(HL, RLC(RM(HL))) — the value reads memory AND mutates the carry flag),
+ * so a macro that names `value` twice would double-evaluate them and corrupt the
+ * z80 (this exact bug stuck the SMS/GG crt0 gsinit loop). The romdev write hook
+ * lives inside so the addr/value are each evaluated exactly once at the call. */
+#define WM(addr,value) romdev_z80_wm((unsigned int)(addr), (unsigned char)(value))
+INLINE void romdev_z80_wm(unsigned int addr, unsigned char value)
+{
+  unsigned char romdev_oldv = romdev_wp_wants_old() ? romdev_z80_rm(addr) : 0;
+  if (romdev_on_write(addr, romdev_oldv, value, romdev_z80_instr_pc, 0xFFFFFFFFu))
