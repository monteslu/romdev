-#else
-    v_line = (line + vs[column]) & pf_row_mask;
-#endif
-
-    /* Plane B name table */
-    nt = (uint32 *)&vram[ntbb + (((v_line >> 4) << pf_shift) & 0x1FC0)];
-
-    /* Pattern row index */
-    v_line = (v_line & 15) << 3;
-
-    atbuf = nt[index & pf_col_mask];
