+#define DRAW_SPRITE_TILE(WIDTH,ATTR,TABLE)  \
+  for (i=0;i<WIDTH;i++) \
+  { \
+    temp = *src++; \
+    if (temp & 0x0f) \
+    { \
+      temp |= (lb[i] << 8); \
+      lb[i] = TABLE[temp | ATTR]; \
+      { unsigned romdev_oi = (unsigned)(lb - linebuf[0]) + (unsigned)i; \
+        if (romdev_oi < sizeof(romdev_md_objline)) romdev_md_objline[romdev_oi] = 1; } \
+      status |= ((temp & 0x8000) >> 10); \
+    } \
+  }
+
+#define DRAW_SPRITE_TILE_ACCURATE(WIDTH,ATTR,TABLE)  \
+  for (i=0;i<WIDTH;i++) \
+  { \
+    temp = *src++; \
+    if (temp & 0x0f) \
+    { \
+      temp |= (lb[i] << 8); \
+      lb[i] = TABLE[temp | ATTR]; \
+      { unsigned romdev_oi = (unsigned)(lb - linebuf[0]) + (unsigned)i; \
+        if (romdev_oi < sizeof(romdev_md_objline)) romdev_md_objline[romdev_oi] = 1; } \
+      if ((temp & 0x8000) && !(status & 0x20)) \
+      { \
+        spr_col = (v_counter << 8) | ((xpos + i + 13) >> 1); \
+        status |= 0x20; \
+      } \
+    } \
+  }
+
+#define DRAW_SPRITE_TILE_ACCURATE_2X(WIDTH,ATTR,TABLE)  \
+  for (i=0;i<WIDTH;i+=2) \
+  { \
+    temp = *src++; \
+    if (temp & 0x0f) \
+    { \
+      temp |= (lb[i] << 8); \
+      lb[i] = TABLE[temp | ATTR]; \
+      { unsigned romdev_oi = (unsigned)(lb - linebuf[0]) + (unsigned)i; \
+        if (romdev_oi < sizeof(romdev_md_objline)) romdev_md_objline[romdev_oi] = 1; } \
+      if ((temp & 0x8000) && !(status & 0x20)) \
+      { \
+        spr_col = (v_counter << 8) | ((xpos + i + 13) >> 1); \
+        status |= 0x20; \
+      } \
+      temp &= 0x00FF; \
+      temp |= (lb[i+1] << 8); \
+      lb[i+1] = TABLE[temp | ATTR]; \
+      { unsigned romdev_oi = (unsigned)(lb - linebuf[0]) + (unsigned)i + 1u; \
+        if (romdev_oi < sizeof(romdev_md_objline)) romdev_md_objline[romdev_oi] = 1; } \
+      if ((temp & 0x8000) && !(status & 0x20)) \
+      { \
+        spr_col = (v_counter << 8) | ((xpos + i + 1 + 13) >> 1); \
+        status |= 0x20; \
+      } \
+    } \
+  }
