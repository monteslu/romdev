+
+/***************************************************************
+ * IND
+ ***************************************************************/
+#define IND {                                           \
+  unsigned t;                                           \
+  UINT8 io = IN(BC);                                    \
+  WZ = BC - 1;                                          \
+  CC(ex,0xaa);                                          \
+  B--;                                                  \
+  WM( HL, io );                                         \
+  HL--;                                                 \
+  F = SZ[B];                                            \
+  t = ((unsigned)(C - 1) & 0xff) + (unsigned)io;        \
+  if( io & SF ) F |= NF;                                \
+  if( t & 0x100 ) F |= HF | CF;                         \
+  F |= SZP[(UINT8)(t & 0x07) ^ B] & PF;                 \
+}
+
+/***************************************************************
+ * OUTD
+ ***************************************************************/
+#define OUTD {                                          \
+  unsigned t;                                           \
+  UINT8 io = RM(HL);                                    \
+  B--;                                                  \
+  WZ = BC - 1;                                          \
+  OUT( BC, io );                                        \
+  HL--;                                                 \
+  F = SZ[B];                                            \
+  t = (unsigned)L + (unsigned)io;                       \
+  if( io & SF ) F |= NF;                                \
+  if( t & 0x100 ) F |= HF | CF;                         \
+  F |= SZP[(UINT8)(t & 0x07) ^ B] & PF;                 \
