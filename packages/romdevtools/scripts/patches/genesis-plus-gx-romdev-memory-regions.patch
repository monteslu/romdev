-  /* 32 x 8 pixels */
-  int width = 32;
-
-  do
-  {
-    name = *nt++;
-    color = ct[name >> 3];
-    pattern = pg[name << 3];
-
-    *lb++ = 0x10 | ((color >> (((pattern >> 7) & 1) << 2)) & 0x0F);
-    *lb++ = 0x10 | ((color >> (((pattern >> 6) & 1) << 2)) & 0x0F);
-    *lb++ = 0x10 | ((color >> (((pattern >> 5) & 1) << 2)) & 0x0F);
-    *lb++ = 0x10 | ((color >> (((pattern >> 4) & 1) << 2)) & 0x0F);
