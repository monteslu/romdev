+void retro_unload_game(void) 
+{
+	/* Clear disk interface */
+   int i;
+   disk_count = 0;
+   disk_index = 0;
+   for (i=0; i<MAX_DISKS; i++)
+   {
+      if (disk_info[i] != NULL)
+      {
+         free(disk_info[i]);
+         disk_info[i] = NULL;
+      }
+   }
+
+   if (system_hw == SYSTEM_MCD)
+      bram_save();
+
+   audio_shutdown();
+
+   if (md_ntsc)
+      free(md_ntsc);
+   md_ntsc   = NULL;
+   if (sms_ntsc)
+      free(sms_ntsc);
+   sms_ntsc  = NULL;
+
+   system_hw = 0;
+}
