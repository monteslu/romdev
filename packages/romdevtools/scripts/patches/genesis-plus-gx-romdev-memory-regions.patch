 static void vdp_z80_data_w_gg(unsigned int data);
 static void vdp_z80_data_w_sg(unsigned int data);
 static void vdp_bus_w(unsigned int data);
+
+/* romdev VRAM-port COPY TRACE (state + exports in libretro.c): log every
+ * data-port write landing in a watched VRAM address window with the EXECUTING
+ * instruction's PC — the CPU-port complement of the existing DMA watch. The
+ * active CPU decides which latched PC applies (m68k on MD, Z80 on SMS/GG). */
+extern unsigned int romdev_vw_lo, romdev_vw_hi;
+extern int          romdev_vw_enabled;
+extern void         romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val);
+extern unsigned int romdev_m68k_instr_pc;
+extern unsigned int romdev_z80_instr_pc;
+static unsigned int romdev_vw_cpu_pc(void)
+{
+  return ((system_hw & SYSTEM_PBC) == SYSTEM_MD) ? romdev_m68k_instr_pc : romdev_z80_instr_pc;
+}
 static void vdp_reg_w(unsigned int r, unsigned int d, unsigned int cycles);
 static void vdp_dma_68k_ext(unsigned int length);
 static void vdp_dma_68k_ram(unsigned int length);
@@ -158,6 +172,34 @@ static int *fifo_timing;        /* FIFO slots timing table */
 static int hblank_start_cycle;  /* HBLANK flag set cycle */
 static int hblank_end_cycle;    /* HBLANK flag clear cycle */
 
+/* romdev VDP-DMA log (discovery): record every mem->VDP DMA as
+ * {vramDest, source, length, code}. The agent filters by VRAM dest to answer
+ * "which DMA wrote the tile at VRAM 0xNNNN and where from?" — the targeted
+ * version of traceVramSource. Genesis-only (VDP DMA is a Genesis concept).
+ * Ring buffer; host drains it. dma_code records the VDP code reg (low bits pick
+ * VRAM/CRAM/VSRAM) so the host can tell a VRAM upload from a palette DMA. */
+#define ROMDEV_DMA_CAP 1024
+unsigned int romdev_dma_enabled = 0;
+unsigned int romdev_dma_dest[ROMDEV_DMA_CAP];
+unsigned int romdev_dma_src [ROMDEV_DMA_CAP];
+unsigned int romdev_dma_len [ROMDEV_DMA_CAP];
+unsigned int romdev_dma_code[ROMDEV_DMA_CAP];
+unsigned int romdev_dma_count  = 0;   /* total DMAs seen */
+unsigned int romdev_dma_stored = 0;   /* stored (<= CAP) */
+
+static void romdev_dma_log(unsigned int dest, unsigned int src, unsigned int len, unsigned int codeReg)
+{
+  if (!romdev_dma_enabled) return;
+  romdev_dma_count++;
+  if (romdev_dma_stored < ROMDEV_DMA_CAP) {
+    romdev_dma_dest[romdev_dma_stored] = dest;
+    romdev_dma_src [romdev_dma_stored] = src;
+    romdev_dma_len [romdev_dma_stored] = len;
+    romdev_dma_code[romdev_dma_stored] = codeReg;
+    romdev_dma_stored++;
+  }
+}
+
  /* set Z80 or 68k interrupt lines */
 static void (*set_irq_line)(unsigned int level);
 static void (*set_irq_line_delay)(unsigned int level);
@@ -2246,6 +2288,9 @@ static void vdp_bus_w(unsigned int data)
       /* Pointer to VRAM */
       uint16 *p = (uint16 *)&vram[index];
 
+      if (romdev_vw_enabled && (unsigned int)index >= romdev_vw_lo && (unsigned int)index <= romdev_vw_hi)
+        romdev_vw_log((unsigned int)index, romdev_vw_cpu_pc(), (unsigned char)(data & 0xFF));
+
