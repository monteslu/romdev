-#ifdef Z80_OVERCLOCK_SHIFT
-      if ((system_hw & SYSTEM_PBC) != SYSTEM_MD)
-        z80_cycle_ratio = (100 << Z80_OVERCLOCK_SHIFT) / config.overclock;
-#endif
-    }
-}
