+/* romdev: resolved-layer capture (md-redraw CAPTURE_SPEC.md).
+ *
+ * The redraw projects (NES 1229/1229, GB 1396/1396 pixel-exact) work on one
+ * principle: publish the value the core RESOLVED, at the point it commits
+ * it, and let the consumer re-derive nothing. These buffers are that seam
+ * for this core's line renderer (Mode 5 = Genesis, Mode 4 = SMS/GG -- the
+ * same capture points serve all three platforms).
+ *
+ *  - romdev_md_linepix: the FINAL composed line-buffer code per pixel,
+ *    copied at remap_line() entry (the commit point; covers blank_line and
+ *    display-off fills too). Code semantics = this core's own line-buffer
+ *    bytes: the pixel[] table index (colour + priority/shadow/highlight
+ *    state bits) exactly as remap_line consumes it.
+ *  - romdev_md_bgpix: the background-only composed code per pixel, copied
+ *    in render_line() after render_bg() and BEFORE render_obj(). On
+ *    display-off lines it holds the blank fill (0x40 backdrop), same as
+ *    the hardware emits.
+ *  - romdev_md_objpix: the sprite layer, 2 bytes per pixel little-endian:
+ *    low byte = the composed line-buffer code at that pixel AFTER the
+ *    sprite write (priority already resolved by the lut), high byte = 1
+ *    where a non-transparent sprite pixel was drawn, 0 elsewhere. A
+ *    presence flag is needed because every 8-bit code value is legal, so
+ *    no in-band sentinel exists (the NES core's 0x80 trick does not port).
+ *    Captured via a one-line mark in the DRAW_SPRITE_TILE* macros, which
+ *    are shared by the m5 AND m4 sprite renderers.
+ *  - romdev_md_linestate: 16 bytes per line at remap_line() entry:
+ *    [0]=reg0 [1]=reg1 [2]=reg7 [3]=reg12 [4]=reg17 [5]=reg18
+ *    [6]=viewport.w low [7]=viewport.w high [8]=viewport.x
+ *    [9]=system_hw low byte, [10..15] reserved zero.
+ *  - the pixel[] output table is exposed whole via romdev_md_pixrgb_*()
+ *    (libretro.c); entry width = get_memory_size / 0x100. The consumer
+ *    widens with THIS table, never its own colour math.
+ *
+ * Buffers are indexed [line * 320 + x], x over bitmap.viewport.w (256/320
+ * for MD, 256 SMS, 160 GG); lines 0..239. Capture is unconditional; the
+ * fceumm precedent showed per-line memcpy cost is noise. */
+uint8  romdev_md_linepix[240 * 320];
+uint8  romdev_md_bgpix[240 * 320];
+uint16 romdev_md_objpix[240 * 320];
+uint8  romdev_md_linestate[240 * 16];
+/* Per-LINE copy of the pixel[] output table, captured at remap_line: raster
+ * palette effects (the Genesis gradient-sky idiom) rewrite CRAM mid-frame,
+ * so a frame-end table renders every band flat. Same lesson as fceumm's
+ * pallines. 512 B per line (256 entries * PIXEL_OUT_T=2). */
+uint8  romdev_md_pixlines[240 * 512];
+static uint8 romdev_md_objline[0x200];
+
+void *romdev_md_pixrgb_data(void) { return pixel; }
+unsigned romdev_md_pixrgb_size(void) { return sizeof(pixel); }
