+/* romdev at-hit REGISTER SNAPSHOT (Sally 6502) — per-core. Fills the shared
+ * romdev_snap_regs[] in the romdev_getreg regId order: [0]=A [1]=X [2]=Y [3]=P
+ * [4]=S [16]=PC of the EXECUTING instruction [18]=S. The memory_Read/Write watch
+ * hooks (Memory.c) + the dispatch hook call this when the shared lib reports a hit. */
+unsigned int romdev_sally_instr_pc = 0xFFFFFFFF;
+void romdev_sally_snap(int kind)
+{
+   int i;
+   for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+   romdev_snap_regs[0]  = (unsigned int)sally_a;
+   romdev_snap_regs[1]  = (unsigned int)sally_x;
+   romdev_snap_regs[2]  = (unsigned int)sally_y;
+   romdev_snap_regs[3]  = (unsigned int)sally_p;
+   romdev_snap_regs[4]  = (unsigned int)sally_s;
+   romdev_snap_regs[16] = romdev_sally_instr_pc;
+   romdev_snap_regs[18] = (unsigned int)sally_s;
+   romdev_snap_kind = kind;
+}
+
