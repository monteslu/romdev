+/* romdev (0.80.0): the watch/pcbreak/watchdog/regsnap/irqblock/range/coverage
+ * machinery + exports live in the shared romdev_debug.c. libretro.c keeps the
+ * 6502 setReg/getReg + the memory regions (below). */
+#include "romdev_debug.h"
+
+int romdev_setreg(int regId, unsigned int value)
+{
+    switch (regId) {
+        case 0:  sally_a   = (uint8_t)value;        return 0;  /* A */
+        case 1:  sally_x   = (uint8_t)value;        return 0;  /* X */
+        case 2:  sally_y   = (uint8_t)value;        return 0;  /* Y */
+        case 3:  sally_p   = (uint8_t)value;        return 0;  /* P (status) */
+        case 4:  sally_s   = (uint8_t)value;        return 0;  /* SP */
+        case 16: sally_pc.w = (uint16_t)value;      return 0;  /* PC */
+        default: return -1;
+    }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+    switch (regId) {
+        case 0:  return (unsigned int)sally_a;
+        case 1:  return (unsigned int)sally_x;
+        case 2:  return (unsigned int)sally_y;
+        case 3:  return (unsigned int)sally_p;
+        case 4:  return (unsigned int)sally_s;
+        case 16: return (unsigned int)sally_pc.w;
+        default: return 0;
+    }
+}
