+
+   /* sally_pc.w is the first byte of the instruction about to dispatch — latch it
+    * for the Sally memory_Read/Write watch hooks, then ask the shared lib whether
+    * to FREEZE (coverage + watchdog + pc-break/single-step live in romdev_debug.c).
+    * On a freeze: snapshot (kind 2=watchdog else 1=pc-break/step) and return 0 cycles
+    * WITHOUT executing — PC left un-advanced; the per-frame loop drains its budget on
+    * the hit flag so retro_run still returns. */
+   romdev_sally_instr_pc = (unsigned int)sally_pc.w;
+
+   if (romdev_on_dispatch((unsigned int)sally_pc.w))
+   {
+      romdev_sally_snap(romdev_pc_hit_kind() == 2 ? 2 : 1);
+      return 0;
+   }
+
    sally_opcode = memory_Read(sally_pc.w++);
    sally_cycles = SALLY_CYCLES[sally_opcode];
 
