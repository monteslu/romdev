+#include <stdlib.h>
+#include "Memory.h"
+#include "Equates.h"
+#include "Bios.h"
+#include "Cartridge.h"
+#include "Tia.h"
+#include "Riot.h"
+#include "Sally.h"   /* for sally_pc (the 6502 PC) — romdev watchpoint */
+
+/* romdev instruction-level write watchpoint state (hook in memory_Write). */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+/* at-hit snapshot helpers — defined in Sally.c (see comment there) */
+extern unsigned int romdev_sally_instr_pc;
+extern void         romdev_sally_snap(int kind);
+unsigned char romdev_wp_last_val = 0;
+unsigned char romdev_wp_last_old = 0;
+int           romdev_wp_cond     = 0;
+unsigned char romdev_wp_cond_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+static int romdev_wp_cond_ok(unsigned char oldv, unsigned char v) {
+   switch (romdev_wp_cond) {
+      case 1:  return v > oldv;
+      case 2:  return v < oldv;
+      case 3:  return v == romdev_wp_cond_val;
+      default: return 1;
+   }
+}
+
+/* romdev instruction-level READ watchpoint state (mirror of the write watch;
+ * hook at the tail of memory_Read). Records the 6502 PC (sally_pc.w) of the
+ * instruction that READ a watched address, the value read, and a hit count.
+ * Exported via romdev_readwatch_* in libretro.c. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+/* ─── romdev RE primitives round 2 (range-watch + PC-coverage) ─────────────
+ * RANGE watch (discovery): log EVERY {pc,addr,value} that reads or writes an
+ * address in [lo,hi] over a window — not stop-on-first. Hooked into the same
+ * memory_Read / memory_Write paths as the single-address watch above. Ring
+ * buffer; the host drains it via romdev_range_get (defined in libretro.c). The
+ * pc recorded is sally_pc.w, the executing instruction. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* PC COVERAGE log (discovery): record DISTINCT PCs executed within an address
+ * window [lo,hi] over a run — "what code runs here?". Linear de-dup against the
+ * stored set (cheap for the small windows this targets). The execute-loop hook
+ * lives in core/Sally.c. */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-range dispatches seen */
+
+/* Append one range-watch event (called from the read/write hooks below). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+   romdev_range_count++;
+   if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+      romdev_range_pc  [romdev_range_stored] = pc;
+      romdev_range_addr[romdev_range_stored] = addr;
+      romdev_range_val [romdev_range_stored] = val;
+      romdev_range_stored++;
+   }
+}
+
+/* Record a distinct in-window PC for the coverage log. */
+void romdev_cov_log(unsigned int pc)
+{
+   unsigned int i;
+   romdev_cov_total++;
+   for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+   if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+/* romdev RANGE watch hook macro for the 6502 read/write paths. `iswr` is 1 for a
+ * write, 0 for a read; romdev_range_mode 1=read 2=write 3=both. pc is sally_pc.w,
+ * the executing instruction. (Param is named `iswr` not `w` so it doesn't collide
+ * with the `.w` member of the sally_pc pair.) Cheap when disabled (one int test). */
+#define ROMDEV_RANGE_6502(a, v, iswr) do { \
+   if (romdev_range_enabled && (romdev_range_mode & ((iswr) ? 2 : 1)) \
+       && (unsigned int)(a) >= romdev_range_lo && (unsigned int)(a) <= romdev_range_hi) { \
+      romdev_range_log(sally_pc.w, (unsigned int)(a), (unsigned char)(v)); \
+   } \
+} while (0)
+
+uint8_t memory_ram[MEMORY_SIZE] = {0};
+uint8_t memory_rom[MEMORY_SIZE] = {0};
+uint8_t memory_souper_ram[MEMORY_SOUPER_EXRAM_SIZE] = {0};
+
+void memory_Reset(void)
+{
+   uint32_t index;
+   for(index = 0; index < MEMORY_SIZE; index++)
+   {
+      memory_ram[index] = 0;
+      memory_rom[index] = 1;
+   }
+   for(index = 0; index < 16384; index++)
+      memory_rom[index] = 0;
+}
+
+uint16_t memory_souper_GetRamAddress(uint16_t address)
+{
+  uint8_t page = (address - 0x4000) >> 12;
+  if((cartridge_souper_mode & CARTRIDGE_SOUPER_MODE_EXS) != 0)
+  {
+    if(address >= 0x6000 && address < 0x7000)
+      page = cartridge_souper_ram_page_bank[0];
+    else if(address >= 0x7000 && address < 0x8000)
+      page = cartridge_souper_ram_page_bank[1];
+  }
+  return (address & 0x0fff) | ((uint16_t)page << 12);
+}
+
+uint8_t memory_Read(uint16_t address)
+{
+   uint8_t romdev_rd_value;
+   switch ( address )
+   {
+      case INTIM:
+      case INTIM | 0x2:
+         memory_ram[INTFLG] &= 0x7f;
+         romdev_rd_value = memory_ram[INTIM];
+         goto romdev_rd_done;
+      case INTFLG:
+      case INTFLG | 0x2:
+         memory_ram[INTFLG] &= 0x7f;
+         romdev_rd_value = memory_ram[INTFLG];
+         goto romdev_rd_done;
+      default:
+         if(cartridge_type == CARTRIDGE_TYPE_SOUPER && address >= 0x4000 && address < 0x8000)
+         {
+            romdev_rd_value = memory_souper_ram[memory_souper_GetRamAddress(address)];
+            goto romdev_rd_done;
+         }
+         break;
+   }
+
+   romdev_rd_value = memory_ram[address];
+
+romdev_rd_done:
+   if (romdev_rd_enabled && (unsigned int)address == romdev_rd_addr) {
+      romdev_rd_last_pc = romdev_sally_instr_pc; romdev_rd_last_val = romdev_rd_value; romdev_rd_hits++;
+      romdev_sally_snap(4);
+   }
+   ROMDEV_RANGE_6502(address, romdev_rd_value, 0);
+   return romdev_rd_value;
+}
+
+void memory_Write(uint16_t address, uint8_t data)
+{
+   if (romdev_wp_enabled && (unsigned int)address == romdev_wp_addr) {
+      unsigned char romdev_oldv = romdev_wp_cond ? memory_ram[address] : 0;
+      if (romdev_wp_cond_ok(romdev_oldv, data)) {
+         romdev_wp_last_pc = romdev_sally_instr_pc; romdev_wp_last_val = data; romdev_wp_last_old = romdev_oldv; romdev_wp_hits++;
+         romdev_sally_snap(3);
+      }
+   }
+   ROMDEV_RANGE_6502(address, data, 1);
+   if(!memory_rom[address])
+   {
+      switch(address)
+      {
+         case WSYNC:
+            if(!(cartridge_flags & 128))
+               memory_ram[WSYNC] = true;
+            break;
+         case INPTCTRL:
+            if(data == 22 && cartridge_IsLoaded()) 
+               cartridge_Store(); 
+            else if(data == 2 && bios_enabled)
+               bios_Store();
+            break;
+         case INPT0:
+         case INPT1:
+         case INPT2:
+         case INPT3:
+         case INPT4:
+         case INPT5:
+            break;
+         case AUDC0:
+            tia_SetRegister(AUDC0, data);
+            break;
+         case AUDC1:
+            tia_SetRegister(AUDC1, data);
+            break;
+         case AUDF0:
+            tia_SetRegister(AUDF0, data);
+            break;
+         case AUDF1:
+            tia_SetRegister(AUDF1, data);
+            break;
+         case AUDV0:
+            tia_SetRegister(AUDV0, data);
+            break;
+         case AUDV1:
+            tia_SetRegister(AUDV1, data);
+            break;
+         case SWCHA:	/*gdement:  Writing here actually writes to DRA inside the RIOT chip.
+                       This value only indirectly affects output of SWCHA.  Ditto for SWCHB.*/
+            riot_SetDRA(data);
+            break;
+         case SWCHB:
+            riot_SetDRB(data);
+            break;
+         case TIM1T:
+         case TIM1T | 0x8:
+            riot_SetTimer(TIM1T, data);
+            break;
+         case TIM8T:
+         case TIM8T | 0x8:
+            riot_SetTimer(TIM8T, data);
+            break;
+         case TIM64T:
+         case TIM64T | 0x8:
+            riot_SetTimer(TIM64T, data);
+            break;
+         case T1024T:
+         case T1024T | 0x8:
+            riot_SetTimer(T1024T, data);
+            break;
+         default:
+            if(cartridge_type == CARTRIDGE_TYPE_SOUPER && address >= 0x4000 && address < 0x8000)
+            {
+               memory_souper_ram[memory_souper_GetRamAddress(address)] = data;
+               break;
+            }
+            memory_ram[address] = data;
+            if(address >= 8256 && address <= 8447)
+               memory_ram[address - 8192] = data;
+            else if(address >= 8512 && address <= 8702)
+               memory_ram[address - 8192] = data;
+            else if(address >= 64 && address <= 255)
+               memory_ram[address + 8192] = data;
+            else if(address >= 320 && address <= 511)
+               memory_ram[address + 8192] = data;
+            break;
+            /*TODO: gdement:  test here for debug port.  Don't put it in the switch because that will change behavior.*/
+      }
+   }
+   else
+      cartridge_Write(address, data);
+}
+
+void memory_WriteROM(uint16_t address, uint16_t size, const uint8_t* data)
+{
+   uint32_t index;
+
+   if((address + size) <= MEMORY_SIZE && data != NULL)
+   {
+      for(index = 0; index < size; index++)
+      {
+         memory_ram[address + index] = data[index];
+         memory_rom[address + index] = 1;
+      }
+   }
+}
+
+void memory_ClearROM(uint16_t address, uint16_t size)
+{
+   uint32_t index;
+
+   if((address + size) <= MEMORY_SIZE)
+   {
+      for(index = 0; index < size; index++)
+      {
+         memory_ram[address + index] = 0;
+         memory_rom[address + index] = 0;
+      }
+   }
+}
diff --git a/core/ProSystem.c b/core/ProSystem.c
index 753035e..e43551e 100644
--- a/core/ProSystem.c
+++ b/core/ProSystem.c
@@ -42,6 +42,13 @@ static uint32_t prosystem_cycles = 0;
 uint16_t prosystem_frequency     = 60;
 uint16_t prosystem_scanlines     = 262;
 
+/* romdev PC breakpoint hit flag — set by the execute hook in core/Sally.c when
+ * the CPU reaches the breakpoint PC. On a hit sally_ExecuteInstruction returns
+ * WITHOUT advancing PC or consuming cycles, so the per-frame cycle loops below
+ * would spin forever; we must drain the budget and break out so retro_run still
+ * returns this frame (leaving it incomplete = infinite hang). */
+extern volatile int romdev_pc_hit;
+
 void prosystem_Reset(void)
 {
    if(!cartridge_IsLoaded())
@@ -87,6 +94,7 @@ void prosystem_ExecuteFrame(const uint8_t* input)
       while(prosystem_cycles < 28)
       {
          cycles = sally_ExecuteInstruction();
+         if(romdev_pc_hit) { prosystem_cycles = 456; break; }
          prosystem_cycles += (cycles << 2);
 
          if(riot_timing)
@@ -99,6 +107,7 @@ void prosystem_ExecuteFrame(const uint8_t* input)
             break;
          }
       }
+      if(romdev_pc_hit) break;
 
       cycles = maria_RenderScanline();
       if(cartridge_flags & CARTRIDGE_CYCLE_STEALING_MASK)
@@ -107,6 +116,7 @@ void prosystem_ExecuteFrame(const uint8_t* input)
       while(prosystem_cycles < 456)
       {
          cycles = sally_ExecuteInstruction();
+         if(romdev_pc_hit) { prosystem_cycles = 456; break; }
          prosystem_cycles += (cycles << 2);
          if(riot_timing)
             riot_UpdateTimer(cycles);
@@ -118,6 +128,7 @@ void prosystem_ExecuteFrame(const uint8_t* input)
             break;
          }
       }
+      if(romdev_pc_hit) break;
       tia_Process(2);
       if(cartridge_pokey)
          pokey_Process(2);
diff --git a/core/Sally.c b/core/Sally.c
index dede0ca..cc8fe6d 100644
--- a/core/Sally.c
+++ b/core/Sally.c
@@ -34,6 +34,36 @@ uint8_t sally_p = 0;
 uint8_t sally_s = 0;
 pair sally_pc = {0};
 
+/* romdev PC BREAKPOINT / single-step (6502 execute hook in
+ * sally_ExecuteInstruction below). When enabled and the 6502 PC about to
+ * execute (sally_pc.w, BEFORE the opcode fetch) equals romdev_pc_addr, the hook
+ * sets romdev_pc_hit and returns WITHOUT executing — the CPU is frozen exactly
+ * at that PC. prosystem_ExecuteFrame (core/ProSystem.c) sees the hit flag after
+ * each instruction and drains the remaining per-frame cycle budget so retro_run
+ * finishes (leaving the frame incomplete = infinite hang). The host polls
+ * romdev_pcbreak_get after each retro_run frame, stops stepping once hit is set,
+ * then reads the register file via getCPUState. romdev_pc_step arms a
+ * per-instruction countdown (host arms to 2 = "let ONE instruction execute,
+ * then stop") so single-step ADVANCES the PC instead of re-stopping on the
+ * current un-executed instruction. Exported via romdev_pcbreak_* in libretro.c. */
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;
+volatile int  romdev_pc_hit     = 0;
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a slightly-wrong pointer) can loop
+ * FOREVER inside a single prosystem_ExecuteFrame / retro_run frame, so the host's
+ * per-FRAME maxFrames never gets a turn and the whole WASM hangs. This counts
+ * dispatched instructions and force-stops (sets romdev_pc_hit + romdev_pc_watchdog)
+ * when the budget is exceeded — so a runaway returns control with the final PC
+ * intact instead of hanging. romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
 static uint8_t sally_opcode;
 static pair sally_address;
 static uint32_t sally_cycles;
@@ -752,8 +782,97 @@ void sally_Reset(void)
    sally_pc.w = 0;
 }
 
+/* romdev PC COVERAGE log (round 2): state lives in core/Memory.c; the execute
+ * loop below records each DISTINCT in-window PC about to run. */
+extern int          romdev_cov_enabled;
+extern unsigned int romdev_cov_lo, romdev_cov_hi;
