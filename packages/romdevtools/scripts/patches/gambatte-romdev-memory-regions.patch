+/* romdev PC BREAKPOINT (sm83 execute hook in cpu.cpp:CPU::process). The core
+ * freezes at the breakpoint PC; the host polls romdev_pcbreak_get after each
+ * retro_run frame and stops stepping once `hit` is set, then reads the registers
+ * via getCPUState. `step` arms a one-instruction single-step (ignores addr). */
+extern "C" {
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern volatile int  romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern volatile int  romdev_pc_watchdog;
+
+void romdev_pcbreak_set(unsigned addr, int enabled, int step) {
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a countdown decremented once per dispatched instruction; arm it to
+    * 2 so ONE instruction executes before the stop fires (true single-step that
+    * advances the PC). See the hook in cpu.cpp. */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+   romdev_pc_watchdog = 0;
