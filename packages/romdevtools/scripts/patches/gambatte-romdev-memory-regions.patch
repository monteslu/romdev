 CPU::CPU()
@@ -130,6 +237,57 @@ void CPU::loadState(SaveState const &state) {
 	skip_ = state.cpu.skip;
 }
 
+#ifdef __LIBRETRO__
+/* rom-dev-mcp RE round 2 — register read/write by romdev reg-id. SM83 convention
+ * (STABLE across cores): 0=A 1=F 2=B 3=C 4=D 5=E 6=H 7=L 16=PC 18=SP.
+ *
+ * The setreg-of-PC GOTCHA: CPU::process() copies pc_ into a LOCAL `pc` at the top
+ * of its outer loop and only writes it back to pc_ on exit. So to make a setreg of
+ * PC actually take on the NEXT process() call, we must write pc_ (the field
+ * process loads), NOT a stale local — which is what we do here. A (a_) is the same
+ * shape: process copies a_ into a local `a` at entry and writes it back on exit, so
+ * we write a_. sp/b/c/d/e/h/l are plain members read directly each instruction.
+ * The flags live split across hf1/hf2/zf/cf; we synthesize F with the file-local
+ * toF() (read) and decompose with zfFromF/hf2FromF/cfFromF (write), exactly like
+ * saveState/loadState — so a getReg after a setReg of F round-trips. */
+int CPU::romdev_setReg(int regId, unsigned value) {
+	switch (regId) {
+	case 0:  a_ = value & 0xFF; return 0;                 /* A  → a_ (process loads this at entry) */
+	case 1:                                               /* F  → split flag fields */
+		zf  =  zfFromF(value & 0xFF);
+		hf2 = hf2FromF(value & 0xFF);
+		hf1 = 0;                                          /* keep hf1 neutral; hf2 carries the H bit */
+		cf  =  cfFromF(value & 0xFF);
+		return 0;
+	case 2:  b = value & 0xFF; return 0;
+	case 3:  c = value & 0xFF; return 0;
+	case 4:  d = value & 0xFF; return 0;
+	case 5:  e = value & 0xFF; return 0;
+	case 6:  h = value & 0xFF; return 0;
+	case 7:  l = value & 0xFF; return 0;
+	case 16: pc_ = value & 0xFFFF; return 0;              /* PC → pc_ (process loads this each outer iter) */
+	case 18: sp = value & 0xFFFF; return 0;               /* SP → sp member */
+	default: return -1;
+	}
+}
+
+unsigned CPU::romdev_getReg(int regId) const {
+	switch (regId) {
+	case 0:  return a_;
+	case 1:  return toF(hf2, cf, zf) & 0xFF;
+	case 2:  return b;
+	case 3:  return c;
+	case 4:  return d;
+	case 5:  return e;
+	case 6:  return h;
+	case 7:  return l;
+	case 16: return pc_;
+	case 18: return sp;
+	default: return 0;
+	}
+}
+#endif
