diff --git a/libgambatte/src/cpu.cpp b/libgambatte/src/cpu.cpp
index 0fb6199..b490f0a 100644
--- a/libgambatte/src/cpu.cpp
+++ b/libgambatte/src/cpu.cpp
@@ -20,6 +20,113 @@
 #include "gambatte-memory.h"
 #include "savestate.h"
 
+/* romdev instruction-level write watchpoint (see the fceumm patch for the NES
+ * equivalent). The WRITE macros below stamp the live `pc` (the address of the
+ * currently-executing instruction) when a watched address is written, so the
+ * captured PC is the true writer — correct even for interrupt-driven writes.
+ * C linkage so the libretro layer can extern + export these. */
+extern "C" {
+unsigned long romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned long romdev_wp_last_pc  = 0xFFFFFFFF;
+/* romdev at-hit REGISTER SNAPSHOT (sm83). The CPU state lives in LOCALS inside
+ * CPU::process and the host can only read the members after writeback — by
+ * which time more frames may have run. Snapshot at the hit instant instead.
+ * Layout = the romdev_getReg regId order: [0]=A [1]=F [2]=B [3]=C [4]=D [5]=E
+ * [6]=H [7]=L [16]=PC of the EXECUTING instruction's first byte [18]=SP.
+ * kind: 1=pc-break/step, 2=watchdog, 3=write-watch, 4=read-watch. */
+unsigned      romdev_snap_regs[19];
+int           romdev_snap_kind = 0;
+unsigned      romdev_gb_instr_pc = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned long romdev_wp_hits     = 0;
+unsigned long romdev_wp_last_rom_off = 0xFFFFFFFF; /* ROM offset of the writing PC (active bank) */
+
+/* romdev instruction-level READ watchpoint (mirror of the write watch above;
+ * hooked into the READ/FF_READ data-read macros, NOT PC_READ — instruction and
+ * operand fetches aren't data accesses). Records the live `pc` of the reading
+ * instruction + the value read. Same shape as the Genesis m68k read watch. */
+unsigned long romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned long romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned long romdev_rd_hits     = 0;
+
+/* romdev PC BREAKPOINT / single-step (sm83 execute hook in CPU::process below).
+ * When enabled and the live `pc` reaches romdev_pc_addr BEFORE an instruction is
+ * fetched, the interpreter records the PC and breaks out of its run loop so the
+ * CPU freezes EXACTLY at that PC (the instruction is NOT executed; process()
+ * writes the breakpoint pc back to pc_). romdev_pc_step forces a one-instruction
+ * stop regardless of address (single-step). The host polls romdev_pc_hit after
+ * each retro_run and stops stepping once it's set, then reads the registers. */
+unsigned int  romdev_pc_addr     = 0;
+int           romdev_pc_enabled  = 0;
+volatile int  romdev_pc_step     = 0;        /* 1 = stop after exactly one instruction */
+volatile int  romdev_pc_hit      = 0;        /* set by the execute hook, cleared by the host */
+unsigned int  romdev_pc_last_pc  = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits     = 0;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a wrong pointer) can loop FOREVER
+ * inside a single CPU::process / retro_run frame, so the host's per-FRAME
+ * maxFrames never gets a turn and the WASM hangs. The hook in CPU::process counts
+ * dispatched instructions and force-stops (sets romdev_pc_hit + the watchdog
+ * flag) when the budget is exceeded — so a runaway returns control with the final
+ * PC intact instead of hanging. romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
+/* romdev RE round 2 — RANGE watch (discovery): log EVERY {pc,addr,value} that
+ * reads or writes an address in [lo,hi] over a window — not stop-on-first. Hooked
+ * into the same READ/FF_READ/WRITE/FF_WRITE macros as the single-address watch,
+ * with the live sm83 `pc`. Ring buffer; the host drains it. Mirror of the
+ * Genesis m68k range watch. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* romdev RE round 2 — PC COVERAGE log (discovery): record DISTINCT PCs executed
+ * within an address window [lo,hi] over a run of frames — "what code runs here?".
+ * Linear de-dup against the stored set (cheap for the small windows this targets).
+ * Hooked into CPU::process at the pc-break check spot (before opcode fetch). */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-window dispatches seen */
+
+/* Append one range-watch event (called from the READ/WRITE macros). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+   romdev_range_count++;
+   if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+      romdev_range_pc  [romdev_range_stored] = pc;
+      romdev_range_addr[romdev_range_stored] = addr;
+      romdev_range_val [romdev_range_stored] = val;
+      romdev_range_stored++;
+   }
+}
+
+/* Record a distinct in-window PC for the coverage log. */
+void romdev_cov_log(unsigned int pc)
+{
+   unsigned int i;
+   romdev_cov_total++;
+   for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+   if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+}
