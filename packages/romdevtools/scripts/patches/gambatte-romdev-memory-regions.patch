+/* romdev register read/write — the inverse of getCPUState (callSubroutine /
+ * setRegister). SM83 reg-id convention (STABLE across cores): 0=A 1=F 2=B 3=C
+ * 4=D 5=E 6=H 7=L 16=PC 18=SP. Returns 0 on success, -1 on an unknown id.
+ * The setreg of PC writes pc_ (the field CPU::process loads into its `pc` local),
+ * so it takes effect on the next run — see CPU::romdev_setReg for the gotcha. */
+int romdev_setreg(int regId, unsigned value) {
+   return gb.romdev_setReg(regId, value);
+}
+
+unsigned romdev_getreg(int regId) {
