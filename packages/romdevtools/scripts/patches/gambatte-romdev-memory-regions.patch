+	switch (regId) {
+	case 0:  return a_;
+	case 1:  return toF(hf2, cf, zf) & 0xFF;
+	case 2:  return b;
+	case 3:  return c;
+	case 4:  return d;
+	case 5:  return e;
+	case 6:  return h;
+	case 7:  return l;
+	case 16: return pc_;
+	case 18: return sp;
+	default: return 0;
