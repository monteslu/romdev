index 72a9d7c..1406365 100644
--- a/librz/cons/cons.c
+++ b/librz/cons/cons.c
@@ -148,6 +148,19 @@ static void __break_signal(int sig) {
 }
 
 static inline void __cons_write_ll(const char *buf, int len) {
+#ifdef __EMSCRIPTEN__
+	/* Honor rizin's own file-descriptor redirection (`cmd > file` sets
+	 * I.fdout to the file's fd). Only divert to stdout when fdout is the
+	 * console (1 or unset). write(1,...) under emscripten is line-buffered,
+	 * so partial flushes at the 64KB cons boundary don't inject a stray
+	 * newline mid-token — which a per-chunk Module.print would. */
+	if (I.fdout > 1) {
+		rz_xwrite(I.fdout, buf, len);
+	} else {
+		rz_xwrite(1, buf, len);
+	}
+	return;
+#endif
 #if __WINDOWS__
 	if (I.vtmode != RZ_VIRT_TERM_MODE_DISABLE) {
 		rz_xwrite(I.fdout, buf, len);
diff --git a/librz/include/rz_emscripten_thread_stubs.h b/librz/include/rz_emscripten_thread_stubs.h
new file mode 100644
index 0000000..a2c70a4
--- /dev/null
+++ b/librz/include/rz_emscripten_thread_stubs.h
@@ -0,0 +1,33 @@
+/**
+ * @file rz_emscripten_thread_stubs.h
+ * @brief Type stubs for single-threaded WASM builds
+ */
+
+#ifndef RZ_EMSCRIPTEN_THREAD_STUBS_H
+#define RZ_EMSCRIPTEN_THREAD_STUBS_H
+
+#ifdef __EMSCRIPTEN__
+
+#include <stdbool.h>
+
+typedef int RZ_TH_TID;
+typedef int RZ_TH_LOCK_T;
+typedef int RZ_TH_COND_T;
+typedef int RZ_TH_SEM_T;
+typedef void* RZ_TH_RET_T;
+#define RZ_TH_LOCAL
+
+typedef void *(*RzThreadFunction)(void *user);
+
+struct rz_th_t {
+	RZ_TH_TID tid;
+	RzThreadFunction function;
+	void *user;
+	void *retv;
+	bool breaked;
+	bool terminated;
+};
+
+#endif
+
+#endif
