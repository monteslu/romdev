+ * regsnap/irqblock machinery + state live in the shared romdev_debug.c. libretro.cpp
+ * keeps only the per-core SNES pieces: the VRAM-port copy trace, the 65816
+ * setReg/getReg, and the memory regions (below). */
+extern "C" {
+#include "romdev_debug.h"
+
+/* romdev VRAM-port copy trace (hooks in ppu.h's REGISTER_2118/2119 family —
+ * CPU port writes AND the DMA path both land there). set(lo,hi,enabled) arms
+ * a VRAM byte-address window + clears the ring; get drains [vaddr,pc,val]
+ * triples, out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addr[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val) {
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addr[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs [romdev_vw_stored] = pc;
+      romdev_vw_vals[romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled) {
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2) {
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addr[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+/* ── romdev register read/write (65816) ──────────────────────────────────────
+ * The inverse of getCPUState, used by the host's callSubroutine / decompressWith
+ * (set A/X/Y/PC, push a sentinel return, run to it, capture the output). romdev
+ * 65816 reg-id convention (STABLE across all cores so the host passes the same
+ * ids): 0=A 1=X 2=Y 3=P(status) 4=SP(S) 5=DB(data bank) 6=D(direct page)
+ * 16=PC (24-bit PBPC: low 16 = program counter, high byte = program bank).
+ * Returns 0 on success, -1 on an unknown id.
+ *
+ * IMPORTANT (PC): the 65816 main loop fetches opcodes via CPU.PCBase[PCw], so a
+ * bare Registers.PBPC = value would NOT redirect execution — the stale fetch
+ * pointer would keep running the old code. S9xSetPCBase(addr) sets PBPC AND
+ * ShiftedPB/MemSpeed AND recomputes CPU.PCBase, so a set PC actually executes
+ * (this is what callSubroutine relies on). Same call cpu.cpp / snapshot.cpp use
+ * after restoring PBPC. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  Registers.A.W  = (uint16)value; return 0;   /* A  */
+      case 1:  Registers.X.W  = (uint16)value; return 0;   /* X  */
+      case 2:  Registers.Y.W  = (uint16)value; return 0;   /* Y  */
+      case 3:  Registers.P.W  = (uint16)value; return 0;   /* P (status) */
+      case 4:  Registers.S.W  = (uint16)value; return 0;   /* SP (S) */
+      case 5:  Registers.DB   = (uint8)value;  return 0;   /* data bank  */
+      case 6:  Registers.D.W  = (uint16)value; return 0;   /* direct page */
+      case 16: S9xSetPCBase(value & 0xffffff); return 0;   /* PC (refresh fetch ptr!) */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   switch (regId) {
+      case 0:  return Registers.A.W;
+      case 1:  return Registers.X.W;
+      case 2:  return Registers.Y.W;
+      case 3:  return Registers.P.W;
+      case 4:  return Registers.S.W;
+      case 5:  return Registers.DB;
+      case 6:  return Registers.D.W;
+      case 16: return Registers.PBPC & 0xffffff;
+      default: return 0;
+   }
+}
