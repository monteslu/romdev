+ * out[0] = kind (0=none 1=pc-break/step 2=watchdog 3=write-watch
+ * 4=read-watch), out[1] = count (19), out[2..20] = registers in the
+ * romdev_setreg/getreg regId order ([0]=A [1]=X [2]=Y [3]=P [4]=S [5]=DB
+ * [6]=D [16]=PBPC-of-executing-instruction [18]=S). `clear` resets the kind. */
+/* romdev interrupt block (pure-call primitive): while set, NMI/IRQ delivery
+ * is suppressed in S9xMainLoop so a callSubroutine-driven routine cannot be
+ * hijacked by the game's own handlers. */
+int romdev_irq_block = 0;
+void romdev_irqblock_set(int on) {
+   romdev_irq_block = on ? 1 : 0;
+}
+
+/* romdev VRAM-port copy trace (hooks in ppu.h's REGISTER_2118/2119 family —
+ * CPU port writes AND the DMA path both land there). set(lo,hi,enabled) arms
+ * a VRAM byte-address window + clears the ring; get drains [vaddr,pc,val]
+ * triples, out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int  romdev_vw_lo      = 0;
+unsigned int  romdev_vw_hi      = 0;
+int           romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addr[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val) {
+   romdev_vw_count++;
+   if (romdev_vw_stored < ROMDEV_VW_CAP) {
+      romdev_vw_addr[romdev_vw_stored] = vaddr;
+      romdev_vw_pcs [romdev_vw_stored] = pc;
+      romdev_vw_vals[romdev_vw_stored] = val;
+      romdev_vw_stored++;
+   }
+}
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled) {
+   romdev_vw_lo = lo; romdev_vw_hi = hi;
+   romdev_vw_enabled = enabled ? 1 : 0;
+   romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2) {
+   unsigned int i, n = romdev_vw_stored;
+   if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_vw_addr[i];
+      out[i*3 + 1] = romdev_vw_pcs[i];
+      out[i*3 + 2] = romdev_vw_vals[i];
+   }
+   return n;
+}
+
+extern unsigned int romdev_snap_regs[19];
+extern int          romdev_snap_kind;
+void romdev_regsnap_get(unsigned int *out, int clear) {
+   int i;
+   if (!out) return;
+   out[0] = (unsigned int)romdev_snap_kind;
+   out[1] = 19;
+   for (i = 0; i < 19; i++) out[2 + i] = romdev_snap_regs[i];
+   if (clear) romdev_snap_kind = 0;
+}
+
+/* ── romdev register read/write (65816) ──────────────────────────────────────
+ * The inverse of getCPUState, used by the host's callSubroutine / decompressWith
+ * (set A/X/Y/PC, push a sentinel return, run to it, capture the output). romdev
+ * 65816 reg-id convention (STABLE across all cores so the host passes the same
+ * ids): 0=A 1=X 2=Y 3=P(status) 4=SP(S) 5=DB(data bank) 6=D(direct page)
+ * 16=PC (24-bit PBPC: low 16 = program counter, high byte = program bank).
+ * Returns 0 on success, -1 on an unknown id.
+ *
+ * IMPORTANT (PC): the 65816 main loop fetches opcodes via CPU.PCBase[PCw], so a
+ * bare Registers.PBPC = value would NOT redirect execution — the stale fetch
+ * pointer would keep running the old code. S9xSetPCBase(addr) sets PBPC AND
+ * ShiftedPB/MemSpeed AND recomputes CPU.PCBase, so a set PC actually executes
+ * (this is what callSubroutine relies on). Same call cpu.cpp / snapshot.cpp use
+ * after restoring PBPC. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  Registers.A.W  = (uint16)value; return 0;   /* A  */
+      case 1:  Registers.X.W  = (uint16)value; return 0;   /* X  */
+      case 2:  Registers.Y.W  = (uint16)value; return 0;   /* Y  */
+      case 3:  Registers.P.W  = (uint16)value; return 0;   /* P (status) */
+      case 4:  Registers.S.W  = (uint16)value; return 0;   /* SP (S) */
+      case 5:  Registers.DB   = (uint8)value;  return 0;   /* data bank  */
+      case 6:  Registers.D.W  = (uint16)value; return 0;   /* direct page */
+      case 16: S9xSetPCBase(value & 0xffffff); return 0;   /* PC (refresh fetch ptr!) */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   switch (regId) {
+      case 0:  return Registers.A.W;
+      case 1:  return Registers.X.W;
+      case 2:  return Registers.Y.W;
+      case 3:  return Registers.P.W;
+      case 4:  return Registers.S.W;
+      case 5:  return Registers.DB;
+      case 6:  return Registers.D.W;
+      case 16: return Registers.PBPC & 0xffffff;
+      default: return 0;
+   }
+}
+
+/* ── romdev RANGE watch (discovery) ──────────────────────────────────────────
+ * Log every {pc,addr,val} touching [lo,hi] over a window — not stop-on-first.
+ * The read/write hooks (getset.h) call romdev_range_log; here is the state, the
+ * de-dup-free ring buffer, and the set/get exports. mode: 1=read 2=write 3=both.
+ * Arm (romdev_range_set with enabled=1) clears the buffer. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* Append one range-watch event (called from the getset.h read/write hooks). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+   romdev_range_count++;
+   if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+      romdev_range_pc  [romdev_range_stored] = pc;
+      romdev_range_addr[romdev_range_stored] = addr;
+      romdev_range_val [romdev_range_stored] = val;
+      romdev_range_stored++;
+   }
+}
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+   romdev_range_lo = lo; romdev_range_hi = hi;
+   romdev_range_mode = mode ? mode : 3;
+   romdev_range_enabled = enabled ? 1 : 0;
+   romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...]
+ * (val in the low byte of its uint32 slot). Returns events written. out2 (size 2)
+ * gets [totalSeen, stored] so the caller knows if the ring overflowed. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_range_stored;
+   if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_range_pc[i];
+      out[i*3 + 1] = romdev_range_addr[i];
+      out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+   }
+   return n;
+}
+
+/* ── romdev PC COVERAGE log (discovery) ──────────────────────────────────────
+ * Record DISTINCT PCs executed within [lo,hi] over a run — "what code runs
+ * here?". The hook in cpuexec.cpp:S9xMainLoop calls romdev_cov_log at dispatch.
+ * Linear de-dup against the stored set (cheap for the small windows this
+ * targets). */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-range dispatches seen */
+
+void romdev_cov_log(unsigned int pc)
+{
+   unsigned int i;
+   romdev_cov_total++;
+   for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+   if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_cov_lo = lo; romdev_cov_hi = hi;
+   romdev_cov_enabled = enabled ? 1 : 0;
+   romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+/* Copy up to `max` distinct PCs into out[]. out2 (size 2) gets [distinct,total]. */
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_cov_count;
+   if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+   return n;
+}
+}
