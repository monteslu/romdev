+			memcpy(&romdev_snes_m7lines[l * 16], &LineMatrixData[l], 16);
+			/* Layer-resolution depth: which layer won each pixel. OBJ
+			 * depths are distinct, so this is an exact sprite mask over
+			 * linepix for HD-substitution renderers. */
+			{
