+		if (romdev_on_write(_ca, romdev_oldv, (unsigned char)(val), romdev_snes_instr_pc, 0xFFFFFFFFu)) \
+			romdev_snes_snap(3); \
+	} while (0)
+#define ROMDEV_RD_SNES(addr, val) do { \
+		if (romdev_on_read(romdev_wp_canon(addr), (unsigned char)(val), romdev_snes_instr_pc)) \
+			romdev_snes_snap(4); \
+	} while (0)
