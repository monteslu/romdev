+			ls[0] = Memory.FillRAM[0x2100];   /* INIDISP */
+			ls[1] = Memory.FillRAM[0x2105];   /* BGMODE */
+			ls[2] = Memory.FillRAM[0x212c];   /* TM */
+			ls[3] = Memory.FillRAM[0x212d];   /* TS */
+			ls[4] = Memory.FillRAM[0x2130];   /* CGWSEL */
+			ls[5] = Memory.FillRAM[0x2131];   /* CGADSUB */
+			ls[6] = Memory.FillRAM[0x2106];   /* MOSAIC */
