+/* Canonicalize a SNES bus address: the low 8 KB of WRAM is MIRRORED into banks
+ * $00-$3F and $80-$BF at $0000-$1FFF, so the CPU issues a stack/zero-page access
+ * as e.g. $00:0039 while the "real" WRAM address is $7E0039 — match both. The
+ * shared lib compares raw addresses, so we canonicalize BEFORE calling it (both
+ * the watched address (set by the host as $7Exxxx) and the live access). */
+static inline unsigned int romdev_wp_canon(unsigned int a)
+{
+	a &= 0xffffff;
+	unsigned int bank = a >> 16, off = a & 0xffff;
+	if (off < 0x2000 && (bank <= 0x3f || (bank >= 0x80 && bank <= 0xbf)))
+		return 0x7e0000u | off;
+	return a;
+}
+/* The hooks record the EXECUTING instruction's first byte (romdev_snes_instr_pc,
+ * latched at dispatch in S9xMainLoop) — NOT the live PBPC, which has advanced past
+ * the operands by write time — and the shared lib reports a hit (return 1) so we
+ * freeze a full register snapshot (the live file keeps moving afterward).
+ * Call sites pass only pure expressions (Address, Byte, word>>8), so naming the
+ * macro args twice is safe (no double-eval side effects, unlike the gpgx z80). */
+extern "C" unsigned int romdev_snes_instr_pc;
+extern "C" void romdev_snes_snap (int kind);
+#define ROMDEV_WP_SNES(addr, val) do { \
