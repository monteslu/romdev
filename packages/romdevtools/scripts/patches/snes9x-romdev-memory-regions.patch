+		extern unsigned char romdev_snes_m7lines[240 * 16];
+		extern unsigned char romdev_snes_linedepth[240 * 512];
+		extern unsigned char romdev_snes_cliplines[240 * 16];
+		uint32 w = IPPU.RenderedScreenWidth;
