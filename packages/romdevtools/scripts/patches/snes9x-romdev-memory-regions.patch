+				const struct ClipData *cd = &IPPU.Clip[0][0];
+				int cn = cd->Count > 3 ? 3 : cd->Count;
+				cl[0] = (unsigned char) cn;
+				cl[1] = 0;
+				for (int ci = 0; ci < 3; ci++)
+				{
+					unsigned char *e = &cl[2 + ci * 5];
+					if (ci < cn)
+					{
+						e[0] = cd->Left[ci] & 0xFF;
+						e[1] = (cd->Left[ci] >> 8) & 0xFF;
+						e[2] = cd->Right[ci] & 0xFF;
+						e[3] = (cd->Right[ci] >> 8) & 0xFF;
+						e[4] = cd->DrawMode[ci];
+					}
