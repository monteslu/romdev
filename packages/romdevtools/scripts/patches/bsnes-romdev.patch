+//romdev: a coprocessor's firmware (program and data ROM), which the cartridge
+//loader asks for by architecture. Taken from the end of the ROM image when it
+//is appended there (heuristics.firmwareRomSize), else from the system
+//directory: <identifier>.rom (program then data, as the dumps are
+//distributed; e.g. st011.rom, st018.rom) or <identifier>.program.rom /
+//<identifier>.data.rom. Without it the cartridge falls back to bsnes's HLE
+//where it has one (DSP-1/2/4, ST010, Cx4) and to nothing for the ST011/ST018.
+auto Program::romdevFirmware(string name) -> shared_pointer<vfs::file>
+{
+	struct Chip { const char* arch; uint programSize; uint dataSize; };
+	static const Chip chips[] = {
+		{ "uPD7725", 0x1800, 0x800 },
+		{ "uPD96050", 0xc000, 0x1000 },
+		{ "ARM6", 0x20000, 0x8000 },
+		{ "HG51BS169", 0, 0xc00 },
+	};
+	for(auto& chip : chips) {
+		string arch = chip.arch;
+		bool program = name == string{arch.downcase(), ".program.rom"};
+		bool data = name == string{arch.downcase(), ".data.rom"};
+		if(!program && !data) continue;
+		string content = program ? "Program" : "Data";
+		auto memory = superFamicom.document[string{"game/board/memory(type=ROM,content=", content, ",architecture=", chip.arch, ")"}];
+		if(!memory) return {};
+		uint offset = program ? 0 : chip.programSize;
+		uint size = program ? chip.programSize : chip.dataSize;
+		uint total = chip.programSize + chip.dataSize;
+		if(superFamicom.firmware.size() == total) {
+			return vfs::memory::file::open(superFamicom.firmware.data() + offset, size);
+		}
+		const char *system_dir = nullptr;
+		if(!environ_cb || !environ_cb(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &system_dir) || !system_dir) return {};
+		string id = memory["identifier"].text().downcase();
+		string dir = string(system_dir).transform("\\", "/");
+		auto combined = file::read(string{dir, "/", id, ".rom"});
+		if(combined.size() == total) return vfs::memory::file::open(combined.data() + offset, size);
+		auto part = file::read(string{dir, "/", id, ".", content.downcase(), ".rom"});
+		if(part.size() == size) return vfs::memory::file::open(part.data(), size);
+		return {};
+	}
 	return {};
 }
 
