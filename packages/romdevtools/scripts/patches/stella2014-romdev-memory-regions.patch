+/* romdev (0.80.0): the pc-break/watchdog/coverage state lives in the shared
+ * romdev_debug.c; the execute() dispatch hook below calls romdev_on_dispatch and,
+ * on a freeze, sets StopExecutionBit so M6502::execute returns and the frame ends
+ * EXACTLY at the break PC (the same mechanism stella's own debugger uses to break
+ * mid-frame — TIA::update leaves myPartialFrameFlag true + endFrame() runs, so
+ * retro_run returns instead of hanging). */
+
 bool M6502::execute(uInt32 number)
 {
   // Clear all of the execution status bits except for the fatal error bit
@@ -153,6 +189,28 @@ bool M6502::execute(uInt32 number)
       uInt16 operandAddress = 0, intermediateAddress = 0;
       uInt8 operand = 0;
 
+      // romdev (0.80.0): keep this CPU frozen across re-entry after a hit (the TIA
+      // loop re-enters execute() within the frame; the host clears the hit to resume).
+      if (romdev_is_frozen())
+      {
+        myExecutionStatus |= StopExecutionBit;
+        break;
+      }
+
+      // PC is the first byte of the instruction about to dispatch — latch it for the
+      // peek/poke watch hooks, then ask the shared lib whether to FREEZE (coverage +
+      // watchdog + pc-break/single-step live in romdev_debug.c). On a freeze: snapshot
+      // (kind 2=watchdog else 1=pc-break/step) + set StopExecutionBit so the frame
+      // ends cleanly with PC left on the un-executed break instruction.
+      romdev_6507_instr_pc = (unsigned int)PC;
+
+      if (romdev_on_dispatch((unsigned int)PC))
+      {
+        ROMDEV_6507_SNAP(romdev_pc_hit_kind() == 2 ? 2 : 1);
+        myExecutionStatus |= StopExecutionBit;
+        break;
+      }
+
       // Reset the peek/poke address pointers
       myLastPeekAddress = myLastPokeAddress = myDataAddressForPoke = 0;
 
diff --git a/stella/src/emucore/M6502.hxx b/stella/src/emucore/M6502.hxx
index 79b50ee..f9460d3 100644
--- a/stella/src/emucore/M6502.hxx
+++ b/stella/src/emucore/M6502.hxx
@@ -114,6 +114,46 @@ class M6502 : public Serializable
     */
     uInt16 getPC() const { return PC; }
 
+    /* rom-dev-mcp: 7-byte 6502 snapshot for getCPUState.
+     * Layout (little-endian): pc_lo, pc_hi, a, x, y, p, sp. */
+    void snapshot(uInt8* out) const {
+      out[0] = PC & 0xFF;
+      out[1] = (PC >> 8) & 0xFF;
+      out[2] = A;
+      out[3] = X;
+      out[4] = Y;
+      out[5] = PS();
+      out[6] = SP;
+    }
+
+    /* rom-dev-mcp RE round 2: register read/write (the inverse of snapshot —
+     * powers setRegister / callSubroutine). 6502 reg-id convention (STABLE across
+     * all cores): 0=A, 1=X, 2=Y, 3=P(status), 4=SP, 16=PC. PS()/PS(uInt8) are the
+     * status get/set; A/X/Y/SP/PC are private so this method (a class member)
+     * does the access. setreg returns 0 ok / -1 unknown. */
+    int romdevSetReg(int regId, unsigned int value) {
+      switch (regId) {
+        case 0:  A  = (uInt8)value;          return 0;  /* A */
+        case 1:  X  = (uInt8)value;          return 0;  /* X */
+        case 2:  Y  = (uInt8)value;          return 0;  /* Y */
+        case 3:  PS((uInt8)value);           return 0;  /* P (status) */
+        case 4:  SP = (uInt8)value;          return 0;  /* SP */
+        case 16: PC = (uInt16)value;         return 0;  /* PC */
+        default: return -1;
+      }
+    }
+    unsigned int romdevGetReg(int regId) const {
+      switch (regId) {
+        case 0:  return (unsigned int)A;
+        case 1:  return (unsigned int)X;
+        case 2:  return (unsigned int)Y;
+        case 3:  return (unsigned int)PS();
+        case 4:  return (unsigned int)SP;
+        case 16: return (unsigned int)PC;
+        default: return 0;
+      }
+    }
+
     /**
       Answer true iff the last memory access was a read.
 
