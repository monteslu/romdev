+    /* rom-dev-mcp: 32-byte snapshot of TIA register state for the
+     * getRenderingContext / inspectSprites / inspectPalette tools.
+     * Layout (mostly mirrors TIA write-register addresses):
+     *   0  VSYNC      1  VBLANK
+     *   2  NUSIZ0     3  NUSIZ1
+     *   4  COLUP0     5  COLUP1     6  COLUPF    7  COLUBK
+     *   8  CTRLPF
+     *   9  REFP0      10 REFP1
+     *   11 PF0        12 PF1        13 PF2
+     *   14 GRP0       15 GRP1
+     *   16 ENAM0      17 ENAM1      18 ENABL
+     *   19 HMP0       20 HMP1       21 HMM0      22 HMM1     23 HMBL
+     *   24 VDELP0     25 VDELP1     26 VDELBL
+     *   27 AUDC0      28 AUDC1      29 AUDF0     30 AUDF1
+     *   31 AUDV0+AUDV1 (high nibble | low nibble — both fit) */
+    void snapshot(uInt8* out) const {
+      out[0]  = myVSYNC;
+      out[1]  = myVBLANK;
+      out[2]  = myNUSIZ0;
+      out[3]  = myNUSIZ1;
+      out[4]  = myColor[0]; /* P0 */
+      out[5]  = myColor[1]; /* P1 */
+      out[6]  = myColor[2]; /* PF */
+      out[7]  = myColor[3]; /* BK */
+      out[8]  = myCTRLPF;
+      out[9]  = myREFP0 ? 1 : 0;
+      out[10] = myREFP1 ? 1 : 0;
+      out[11] = (myPF >> 0)  & 0x0F; /* PF0 (4 bits) */
+      out[12] = (myPF >> 4)  & 0xFF; /* PF1 */
+      out[13] = (myPF >> 12) & 0xFF; /* PF2 */
+      out[14] = myGRP0;
+      out[15] = myGRP1;
+      out[16] = myENAM0 ? 1 : 0;
+      out[17] = myENAM1 ? 1 : 0;
+      out[18] = myENABL ? 1 : 0;
+      out[19] = myHMP0;
+      out[20] = myHMP1;
+      out[21] = myHMM0;
+      out[22] = myHMM1;
+      out[23] = myHMBL;
+      out[24] = myVDELP0 ? 1 : 0;
+      out[25] = myVDELP1 ? 1 : 0;
+      out[26] = myVDELBL ? 1 : 0;
+      out[27] = myAUDC0;
+      out[28] = myAUDC1;
+      out[29] = myAUDF0;
+      out[30] = myAUDF1;
+      out[31] = ((myAUDV0 & 0x0F) << 4) | (myAUDV1 & 0x0F);
+    }
