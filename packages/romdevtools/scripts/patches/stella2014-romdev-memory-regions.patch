 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+/* romdev instruction-level READ watchpoint — records the 6502 PC (this M6502's
+ * member) when a watched address is READ (mirror of the write watch below).
+ * State defined in libretro.cxx; exported via romdev_readwatch_*. */
+extern "C" {
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+/* romdev RE round 2: RANGE watch (read/write log over [lo,hi]) + PC COVERAGE.
+ * State + the ring buffers live in libretro.cxx; the hooks in peek/poke/execute
+ * below call these loggers. mode 1=read 2=write 3=both. The recorded pc is this
+ * M6502's PC (the executing instruction). */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern void          romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val);
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern void          romdev_cov_log(unsigned int pc);
+
+/* romdev at-hit register snapshot (defined in libretro.cxx). Layout = the
+ * romdevGetReg regId order: [0]=A [1]=X [2]=Y [3]=PS [4]=SP [16]=PC of the
+ * EXECUTING instruction's first byte [18]=SP. kind: 1=pc-break/step,
+ * 2=watchdog, 3=write-watch, 4=read-watch. romdev_6507_instr_pc is latched at
+ * dispatch in execute() — PC advances past operands mid-instruction. */
+extern unsigned int  romdev_snap_regs[19];
+extern int           romdev_snap_kind;
+extern unsigned int  romdev_6507_instr_pc;
+}
+#define ROMDEV_6507_SNAP(kind_) do { \
+    int snap_i_; \
+    for (snap_i_ = 0; snap_i_ < 19; snap_i_++) romdev_snap_regs[snap_i_] = 0; \
+    romdev_snap_regs[0]  = (unsigned int)A; \
+    romdev_snap_regs[1]  = (unsigned int)X; \
+    romdev_snap_regs[2]  = (unsigned int)Y; \
+    romdev_snap_regs[3]  = (unsigned int)PS(); \
+    romdev_snap_regs[4]  = (unsigned int)SP; \
+    romdev_snap_regs[16] = romdev_6507_instr_pc; \
+    romdev_snap_regs[18] = (unsigned int)SP; \
+    romdev_snap_kind = (kind_); \
+  } while (0)
+
 inline uInt8 M6502::peek(uInt16 address, uInt8 flags)
 {
   ////////////////////////////////////////////////
@@ -116,14 +159,40 @@ inline uInt8 M6502::peek(uInt16 address, uInt8 flags)
   mySystem->incrementCycles(mySystemCyclesPerProcessorCycle);
 
   uInt8 result = mySystem->peek(address, flags);
+  if (romdev_rd_enabled && (unsigned int)address == romdev_rd_addr) {
+    romdev_rd_last_pc = romdev_6507_instr_pc; romdev_rd_last_val = result; romdev_rd_hits++;
+    ROMDEV_6507_SNAP(4);
+  }
+  if (romdev_range_enabled && (romdev_range_mode & 1)
+      && (unsigned int)address >= romdev_range_lo && (unsigned int)address <= romdev_range_hi) {
+    romdev_range_log(romdev_6507_instr_pc, (unsigned int)address, result);
+  }
   myLastAccessWasRead = true;
   myLastPeekAddress = address;
   return result;
 }
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+/* romdev instruction-level write watchpoint — records the 6502 PC (this M6502's
+ * member) when a watched address is written. State defined in libretro.cxx. */
+extern "C" {
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+}
+
 inline void M6502::poke(uInt16 address, uInt8 value)
 {
+  if (romdev_wp_enabled && (unsigned int)address == romdev_wp_addr) {
+    romdev_wp_last_pc = romdev_6507_instr_pc; romdev_wp_last_val = value; romdev_wp_hits++;
+    ROMDEV_6507_SNAP(3);
+  }
+  if (romdev_range_enabled && (romdev_range_mode & 2)
+      && (unsigned int)address >= romdev_range_lo && (unsigned int)address <= romdev_range_hi) {
+    romdev_range_log(romdev_6507_instr_pc, (unsigned int)address, value);
+  }
   ////////////////////////////////////////////////
   // TODO - move this logic directly into CartAR
   if(address != myLastAddress)
@@ -140,6 +209,27 @@ inline void M6502::poke(uInt16 address, uInt8 value)
 }
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+/* romdev PC BREAKPOINT / single-step (6502 execute hook below). When enabled and
+ * the 6502 PC about to execute equals romdev_pc_addr, the hook records the PC,
+ * sets romdev_pc_hit, and sets StopExecutionBit so M6502::execute returns and the
+ * frame ends EXACTLY at that PC (this is the same mechanism stella's own debugger
+ * uses to break mid-frame — TIA::update leaves myPartialFrameFlag true and
+ * endFrame() runs, so retro_run returns instead of hanging). romdev_pc_step arms
+ * a per-instruction countdown (host arms to 2 = "let ONE instruction execute,
+ * then stop") so single-step ADVANCES the PC. Exported via romdev_pcbreak_*. */
+extern "C" {
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern volatile int  romdev_pc_watchdog;
+}
+
 bool M6502::execute(uInt32 number)
 {
   // Clear all of the execution status bits except for the fatal error bit
@@ -153,6 +243,70 @@ bool M6502::execute(uInt32 number)
       uInt16 operandAddress = 0, intermediateAddress = 0;
       uInt8 operand = 0;
 
+      // romdev instruction WATCHDOG: force-stop a runaway (the callSubroutine
+      // hang). Checked FIRST, BEFORE the opcode fetch, so PC is the address of
+      // the instruction about to execute. On overflow, fire the breakpoint with
+      // the watchdog flag and set StopExecutionBit so the frame ends cleanly
+      // (retro_run returns) instead of hanging.
+      // romdev: once a breakpoint/watchdog hit has frozen this CPU, KEEP it
+      // frozen — the TIA loop re-enters execute() within the frame, which
+      // would resume execution and drift the registers away from the hit.
+      // The host clears the hit to resume.
+      if (romdev_pc_hit)
+      {
+        myExecutionStatus |= StopExecutionBit;
+        break;
+      }
+
+      // romdev: PC right now is the first byte of the instruction about to be
+      // dispatched — latch it for the mid-instruction hooks (peek/poke
+      // watchpoints see an operand-advanced PC).
+      romdev_6507_instr_pc = (unsigned int)PC;
+
+      if (romdev_pc_wd_limit && !romdev_pc_hit)
+      {
+        if (++romdev_pc_wd_count >= romdev_pc_wd_limit)
+        {
+          romdev_pc_last_pc = PC;            // leave PC frozen exactly here
+          ROMDEV_6507_SNAP(2);   // freeze the register file AT the stop
+          romdev_pc_hit = 1;
+          romdev_pc_watchdog = 1;
+          myExecutionStatus |= StopExecutionBit;
+          break;
+        }
+      }
+
+      // romdev PC coverage log (discovery): record each DISTINCT in-window PC
+      // about to execute. Checked here, BEFORE the opcode fetch, so PC is the
+      // address of the instruction about to run. Cheap when disabled.
+      if (romdev_cov_enabled
+          && (unsigned int)PC >= romdev_cov_lo && (unsigned int)PC <= romdev_cov_hi)
+        romdev_cov_log((unsigned int)PC);
+
+      // romdev PC breakpoint / single-step: checked here, BEFORE the opcode
+      // fetch, so PC is the address of the instruction about to execute. On a
+      // hit (or single-step countdown reaching 0) freeze the CPU at this PC:
+      // record it, set the hit flag, set StopExecutionBit so the frame ends
+      // cleanly (retro_run returns; leaving it incomplete = infinite hang), and
+      // break WITHOUT advancing PC. Gated on !romdev_pc_hit so a held breakpoint
+      // doesn't re-fire while the host reads state and disarms.
+      if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit)
+      {
+        int stepFire = 0;
+        if (romdev_pc_step) { if (--romdev_pc_step <= 0) stepFire = 1; }
+        if (stepFire || ((romdev_pc_enabled && !romdev_pc_step)
+                         && (unsigned int)PC == romdev_pc_addr))
+        {
+          romdev_pc_last_pc = PC;            // leave PC frozen exactly here
+          ROMDEV_6507_SNAP(1);   // freeze the register file AT the hit
+          romdev_pc_hit = 1;
+          romdev_pc_hits++;
+          romdev_pc_step = 0;               // one-shot
+          myExecutionStatus |= StopExecutionBit;
+          break;
+        }
+      }
+
       // Reset the peek/poke address pointers
       myLastPeekAddress = myLastPokeAddress = myDataAddressForPoke = 0;
 
