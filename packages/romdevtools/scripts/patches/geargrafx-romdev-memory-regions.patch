diff --git a/src/huc6280_inline.h b/src/huc6280_inline.h
index c2e449d..f9c70fd 100644
--- a/src/huc6280_inline.h
+++ b/src/huc6280_inline.h
@@ -28,8 +28,97 @@
 #include "memory.h"
 #include "trace_logger.h"
 
+/* romdev PC BREAKPOINT / single-step state (defined in libretro.cpp). When
+ * enabled and the HuC6280 PC about to execute (m_PC, BEFORE the opcode fetch)
+ * equals romdev_pc_addr, RunInstruction sets romdev_pc_hit and returns WITHOUT
+ * executing — the CPU is frozen exactly at that PC. The per-frame loop in
+ * geargrafx_core_inline.h breaks on the hit flag so RunToVBlank returns and
+ * retro_run finishes (leaving the frame incomplete = infinite hang). The host
+ * polls romdev_pcbreak_get after each retro_run frame, stops stepping once hit
+ * is set, then reads registers via getCPUState. romdev_pc_step arms a
+ * per-instruction countdown (host arms to 2 = "let ONE instruction execute,
+ * then stop") so single-step ADVANCES the PC. Exported via romdev_pcbreak_*. */
+extern "C" {
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+/* romdev INSTRUCTION WATCHDOG: counts dispatched instructions and force-stops
+ * (sets romdev_pc_hit + romdev_pc_watchdog) when the budget is exceeded so a
+ * runaway routine returns control with the final PC intact instead of hanging
+ * the WASM. romdev_pc_wd_limit 0 = disabled. */
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern volatile int  romdev_pc_watchdog;
+
+/* romdev RE round 2: PC COVERAGE log (distinct in-window PCs). State + the
+ * dedup buffer live in libretro.cpp; the hook below records m_PC before the
+ * opcode fetch when coverage is armed and m_PC is in [lo,hi]. */
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern void          romdev_cov_log(unsigned int pc);
+}
+
 INLINE u32 HuC6280::RunInstruction(bool* instruction_completed)
 {
+    /* romdev PC coverage log (discovery): record each DISTINCT in-window PC about
+     * to execute. Checked BEFORE the opcode fetch, so m_PC is the address of the
+     * instruction about to run. Cheap when disabled (one int test). */
+    if (romdev_cov_enabled)
+    {
+        unsigned int cov_pc = m_PC.GetValue();
+        if (cov_pc >= romdev_cov_lo && cov_pc <= romdev_cov_hi)
+            romdev_cov_log(cov_pc);
+    }
+
