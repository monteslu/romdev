+/* romdev (0.80.0): the pc-break/watchdog/coverage/irqblock machinery lives in the
+ * shared romdev_debug.c. huc6280_inline.h keeps the HuC6280 register-snapshot macro
+ * + the dispatch hook (which calls romdev_on_dispatch). */
+extern "C" {
+#include "romdev_debug.h"
+extern unsigned int  romdev_huc_instr_pc;
+}
+
+#define ROMDEV_HUC_SNAP(kind_) do { \
+    int snap_i_; \
+    for (snap_i_ = 0; snap_i_ < 19; snap_i_++) romdev_snap_regs[snap_i_] = 0; \
+    romdev_snap_regs[0]  = (unsigned int)m_A.GetValue(); \
+    romdev_snap_regs[1]  = (unsigned int)m_X.GetValue(); \
+    romdev_snap_regs[2]  = (unsigned int)m_Y.GetValue(); \
+    romdev_snap_regs[3]  = (unsigned int)m_P.GetValue(); \
+    romdev_snap_regs[4]  = (unsigned int)m_S.GetValue(); \
+    romdev_snap_regs[16] = romdev_huc_instr_pc; \
+    romdev_snap_regs[18] = (unsigned int)m_S.GetValue(); \
+    romdev_snap_kind = (kind_); \
+  } while (0)
+
 INLINE u32 HuC6280::RunInstruction(bool* instruction_completed)
 {
+    /* romdev (0.80.0): keep this CPU frozen across re-entry after a hit. */
+    if (romdev_is_frozen())
+    {
+        if (IsValidPointer(instruction_completed))
+            *instruction_completed = true;
+        return 0;
+    }
+
+    /* m_PC is the first byte of the instruction about to dispatch — latch it for the
+     * Memory::Read/Write watch hooks, then ask the shared lib whether to FREEZE
+     * (coverage + watchdog + pc-break/single-step live in romdev_debug.c). On a
+     * freeze: snapshot (kind 2=watchdog else 1=pc-break/step) + return 0 cycles
+     * WITHOUT executing (the frame loop drains on the hit flag so retro_run returns). */
+    romdev_huc_instr_pc = (unsigned int)m_PC.GetValue();
+
+    if (romdev_on_dispatch((unsigned int)m_PC.GetValue()))
+    {
+        ROMDEV_HUC_SNAP(romdev_pc_hit_kind() == 2 ? 2 : 1);
+        if (IsValidPointer(instruction_completed))
+            *instruction_completed = true;
+        return 0;
+    }
+
+    /* (the watchdog + pc-break/single-step decision is now inside the shared
+     * romdev_on_dispatch call above.) */
+
 #if !defined(GG_DISABLE_DISASSEMBLER)
     m_memory_breakpoint_hit = false;
     m_cpu_breakpoint_hit = false;
@@ -72,7 +119,7 @@ INLINE u32 HuC6280::RunInstruction(bool* instruction_completed)
     }
 #endif
 
-    if((m_irq_pending || IS_SET_BIT(m_interrupt_request_register, 2)) && (m_transfer_state == 0))
+    if((m_irq_pending || IS_SET_BIT(m_interrupt_request_register, 2)) && (m_transfer_state == 0) && !romdev_irq_block)
         HandleIRQ();
 
     DisassembleNextOPCode();
