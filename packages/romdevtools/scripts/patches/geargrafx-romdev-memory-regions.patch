+/* romdev (0.80.0): the watch/readwatch/pcbreak/watchdog/regsnap/range/coverage/
+ * irqblock machinery + exports live in the shared romdev_debug.c. libretro.cpp keeps
+ * the per-CPU instruction-PC latch, the HuC6280 value-based register snapshot, the
+ * VRAM-port watch, the setReg/getReg, and the memory regions (below). */
+extern "C" {
+#include "romdev_debug.h"
+unsigned int romdev_huc_instr_pc = 0xFFFFFFFF;
+
+/* romdev VRAM-port copy trace (hook in huc6270_inline.h's ProcessVramWrite —
+ * the CPU's VWR data-port path). vaddr is the HuC6270 VRAM WORD address.
+ * set(lo,hi,enabled) arms + clears; get drains [vaddr,pc,val] triples,
+ * out2 = [totalSeen, stored]. */
+#define ROMDEV_VW_CAP 1024
+unsigned int romdev_vw_lo      = 0;
+unsigned int romdev_vw_hi      = 0;
+int          romdev_vw_enabled = 0;
+static unsigned int  romdev_vw_addrs[ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_pcs  [ROMDEV_VW_CAP];
+static unsigned char romdev_vw_vals [ROMDEV_VW_CAP];
+static unsigned int  romdev_vw_count  = 0;
+static unsigned int  romdev_vw_stored = 0;
+void romdev_vw_log(unsigned int vaddr, unsigned int pc, unsigned char val)
+{
+    romdev_vw_count++;
+    if (romdev_vw_stored < ROMDEV_VW_CAP) {
+        romdev_vw_addrs[romdev_vw_stored] = vaddr;
+        romdev_vw_pcs  [romdev_vw_stored] = pc;
+        romdev_vw_vals [romdev_vw_stored] = val;
+        romdev_vw_stored++;
+    }
+}
+void romdev_vramwatch_set(unsigned int lo, unsigned int hi, int enabled)
+{
+    romdev_vw_lo = lo; romdev_vw_hi = hi;
+    romdev_vw_enabled = enabled ? 1 : 0;
+    romdev_vw_count = 0; romdev_vw_stored = 0;
+}
+unsigned int romdev_vramwatch_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+    unsigned int i, n = romdev_vw_stored;
+    if (out2) { out2[0] = romdev_vw_count; out2[1] = romdev_vw_stored; }
+    if (!out) return 0;
+    if (n > max) n = max;
+    for (i = 0; i < n; i++) {
+        out[i*3 + 0] = romdev_vw_addrs[i];
+        out[i*3 + 1] = romdev_vw_pcs[i];
+        out[i*3 + 2] = romdev_vw_vals[i];
+    }
+    return n;
+}
+
+void romdev_huc_snap_vals(unsigned int a, unsigned int x, unsigned int y, unsigned int p, unsigned int s, int kind)
+{
+    int i;
+    for (i = 0; i < 19; i++) romdev_snap_regs[i] = 0;
+    romdev_snap_regs[0]  = a;
+    romdev_snap_regs[1]  = x;
+    romdev_snap_regs[2]  = y;
+    romdev_snap_regs[3]  = p;
+    romdev_snap_regs[4]  = s;
+    romdev_snap_regs[16] = romdev_huc_instr_pc;
+    romdev_snap_regs[18] = s;
+    romdev_snap_kind = kind;
+}
+
+int romdev_setreg(int regId, unsigned int value)
+{
+    if (!core) return -1;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    switch (regId) {
+        case 0:  if (st->A)  st->A->SetValue((u8)value);   return 0;  /* A */
+        case 1:  if (st->X)  st->X->SetValue((u8)value);   return 0;  /* X */
+        case 2:  if (st->Y)  st->Y->SetValue((u8)value);   return 0;  /* Y */
+        case 3:  if (st->P)  st->P->SetValue((u8)value);   return 0;  /* P (status) */
+        case 4:  if (st->S)  st->S->SetValue((u8)value);   return 0;  /* SP (= S) */
+        case 16: if (st->PC) st->PC->SetValue((u16)value); return 0;  /* PC */
+        default: return -1;
+    }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+    if (!core) return 0;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    switch (regId) {
+        case 0:  return st->A  ? (unsigned int)st->A->GetValue()  : 0;
+        case 1:  return st->X  ? (unsigned int)st->X->GetValue()  : 0;
+        case 2:  return st->Y  ? (unsigned int)st->Y->GetValue()  : 0;
+        case 3:  return st->P  ? (unsigned int)st->P->GetValue()  : 0;
+        case 4:  return st->S  ? (unsigned int)st->S->GetValue()  : 0;
+        case 16: return st->PC ? (unsigned int)st->PC->GetValue() : 0;
+        default: return 0;
+    }
+}
+
+}
+
+/* ---- romdev memory-region exposure (PC Engine) ----------------------- */
+#define ROMDEV_MEMORY_PCE_VDC_VRAM    0x1A0
+#define ROMDEV_MEMORY_PCE_VDC_SATB    0x1A1
+#define ROMDEV_MEMORY_PCE_VDC_REGS    0x1A2
+#define ROMDEV_MEMORY_PCE_VCE_PALETTE 0x1A3
+#define ROMDEV_MEMORY_PCE_CPU_REGS    0x1A4
+#define ROMDEV_MEMORY_PCE_PSG_REGS    0x1A5
+/* PER-SCANLINE VDC state: 263 lines x 16 bytes, captured at the top of
+ * HuC6270::RenderLine -- the moment the VDC commits to what a line renders
+ * with. pce_vdc_regs (0x1A2) is the LIVE register file at frame end, so a
+ * reconstruction gives EVERY line the LAST scroll value the game wrote.
+ * PC Engine games do mid-frame raster splits constantly: Bonk's Adventure
+ * rewrites BXR/BYR per scanline for parallax, and reconstructing it from the
+ * end-of-frame snapshot scored 31% -- top rows pixel-exact, everything below
+ * the first split wrong by whole tiles. The scroll is not recoverable after
+ * the fact at any price; it has to be recorded as it is used.
+ *
+ * The record is the LATCHED state, not the live registers: the VDC renders
+ * from m_latched_bxr / m_latched_cr / m_latched_mwr / m_latched_hdw (latched
+ * at HSYNC / VSW), and m_bg_offset_y is the effective BYR after the per-line
+ * counter and any mid-frame BYR write. Same reasoning as the NES core's
+ * PALLINES/MASKLINES/NTMAPLINES trio.
+ *
+ * Indexed by m_raster_line (0 at VDW start), NOT by framebuffer row: the
+ * VDC's own vertical pipeline decides the offset between the two and a
+ * consumer applies its own bias. `valid` distinguishes "this line rendered"
+ * from a never-written slot. */
+#define ROMDEV_MEMORY_PCE_REGLINES    0x1A6
+/* PER-SCANLINE VCE PALETTE: 263 lines x 512 entries x u16.
+ *
+ * pce_vce_palette (0x1A3) is m_color_table read at frame end. The CPU writes
+ * that table through VCE ports 4/5 at ANY time, and HuC6260::Clock resolves
+ * every emitted pixel through it LIVE -- so a game that rewrites colours on a
+ * raster interrupt shows several palettes in one frame while the snapshot
+ * catches only the last. Air Zonk's title screen does exactly this and a
+ * reconstruction using the frame-end table scored 43.9%: the geometry was
+ * pixel-perfect and two blues were simply swapped over most of the screen.
+ *
+ * Same class of region as pce_vdc_reglines (0x1A6) and the NES core's
+ * nes_pallines. Recorded at end-of-line, keyed by m_vpos, so a consumer
+ * indexes it with the SAME vpos the regline record carries. */
+#define ROMDEV_MEMORY_PCE_PALLINES    0x1A7
+/* PER-SCANLINE RESOLVED VDC LINE BUFFER: 263 lines x 1024 x u16.
+ *
+ * This is the VDC's OWN m_line_buffer after RenderBackground and the sprite
+ * merge -- the final palette index for every pixel of the line, exactly as
+ * HuC6270::Clock will serve it to the VCE.
+ *
+ * Why it is needed on top of reglines+pallines: the remaining reconstruction
+ * error is mid-frame VRAM mutation. HuC6270::VRAMTransfer runs from Clock(),
+ * i.e. DURING display, so a game DMAing new sprite/tile patterns shows one
+ * pattern on line 40 and another on line 120 -- while pce_vdc_vram is a
+ * single post-frame snapshot holding only the final state. Reconstructing
+ * from that snapshot mis-draws exactly the animated patterns (Cratermaze,
+ * Bomberman '93: the bad pixels cluster on a handful of sprite patterns).
+ *
+ * VRAM cannot be captured per line (263 x 64KB), and it does not need to be:
+ * the resolved line buffer is what the VRAM was FOR. Capturing it follows the
+ * same rule the NES profile settled on with nes_bgpix/nes_linepix -- read the
+ * plane the emulator already resolved instead of re-deriving it. */
+#define ROMDEV_MEMORY_PCE_LINEPIX     0x1A8
+/* PER-SCANLINE HORIZONTAL PLACEMENT: 263 x u16, the framebuffer x at which
+ * the VDC's picture starts on that VCE scanline (0xFFFF = the VDC emitted no
+ * picture on that line).
+ *
+ * The VCE emits k_huc6260_line_width pixels per row by clocking the VDC, and
+ * the VDC only returns picture inside its HDW window; everything else is the
+ * 0x100 idle pixel. WHERE the window lands inside the row is the product of
+ * the VDC's HSW/HDS clock chain and the VCE's m_screen_start_x, which run in
+ * different clock domains. The arithmetic ((HSW+1 + HDS+1)*8 - screen_start_x)
+ * reproduces it for most of the library and is off by exactly 8 for others
+ * (Klax: predicted 0, actual 8, a flat 73% until corrected). Rather than
+ * carry a formula with known exceptions, the VCE records the real value. */
+#define ROMDEV_MEMORY_PCE_XOFFLINES   0x1A9
+/* Companion to XOFFLINES; see romdev_pce_srclines. */
+#define ROMDEV_MEMORY_PCE_SRCLINES    0x1AA
+/* DOT-STAMPED VCE PALETTE WRITE LOG: header {count u16, truncated u8, pad u8}
+ * + entries {vpos u16, hpos u16, dot u16, index u16, oldv u16, newv u16}.
+ *
+ * pce_vce_pallines (0x1A7) is per-LINE: slot [vpos] is the table at the END
+ * of that line. A game that rewrites a colour MID-line (Eaggy) renders the
+ * head of the row through the OLD value and the tail through the new one --
+ * unrecoverable from any per-line snapshot. Same design as the MSX core's
+ * msx_vram_deltas: each entry carries BOTH values, because the consumer must
+ * UNDO this line's entries (restore oldv, reverse order) from pallines[vpos]
+ * to reach the line-START table, then REDO forward at each recorded dot to
+ * split the row. Entries are logged only when the write CHANGES the entry
+ * (LSB/MSB port traffic rewriting identical colours logs nothing), and a
+ * truncated log must be rejected whole -- a partial undo reconstructs a
+ * line-start state that never existed.
+ *
+ * `vpos` matches the key of pallines/xofflines. `dot` is the position within
+ * the emitted row (m_pixel_index reduced modulo the line width -- the cursor
+ * is FRAME-wide, the same trap xofflines hit). `hpos` is the raw VCE clock
+ * within the line, recorded so a consumer can tell an hblank write (whole-
+ * line, apply before the row) from a mid-row one without trusting dot alone. */
+#define ROMDEV_MEMORY_PCE_PALDELTAS   0x1AB
+#define ROMDEV_PCE_XOFFLINES 263
+static uint16_t romdev_pce_xofflines[ROMDEV_PCE_XOFFLINES];
+/* Companion to xofflines: WHICH line-buffer pixel the framebuffer's first
+ * copied pixel came from. Non-zero when the VDC's active width overruns what
+ * the VCE copies, so the picture is CLIPPED on the left rather than shifted --
+ * Legend of Hero Tonma and Ninja Spirit program a 352px window into a 341px
+ * line and lose the first 8 source pixels. xofflines alone records only where
+ * the picture LANDS (0), which cannot express the clip. */
+static uint16_t romdev_pce_srclines[ROMDEV_PCE_XOFFLINES];
+/* One-shot per line: only the FIRST in-HDW pixel of a scanline sets it. */
+static int romdev_pce_xoff_seen[ROMDEV_PCE_XOFFLINES];
+
+/* Set by HuC6270::Clock for the pixel it just produced; read by the VCE on
+ * the very next statement. A plain global, not a call into the VDC, because
+ * this translation unit does not include huc6270.h. */
+extern "C" { int romdev_pce_in_hdw = 0; int romdev_pce_src_index = 0; }
+
+extern "C" void romdev_pce_xoff(int vpos, int x, int line_width, int src)
+{
+    if (vpos < 0 || vpos >= ROMDEV_PCE_XOFFLINES)
+        return;
+    if (romdev_pce_xoff_seen[vpos])
+        return;
+    romdev_pce_xoff_seen[vpos] = 1;
+    /* m_pixel_index is a FRAME-wide write cursor into m_vce_buffer_1, not a
+     * per-line one -- it keeps climbing across scanlines. The x we want is the
+     * offset within the row, so reduce modulo the line width. (Caught by the
+     * recorded values reading 0, 256, 512, 768 ... on successive lines.) */
+    if (line_width > 0)
+        x %= line_width;
+    romdev_pce_xofflines[vpos] = (uint16_t)x;
+    romdev_pce_srclines[vpos] = (uint16_t)(src < 0 ? 0 : src);
+}
+#define ROMDEV_PCE_LINEPIX_LINES 263
+#define ROMDEV_PCE_LINEPIX_WIDTH 1024
+static uint16_t romdev_pce_linepix[ROMDEV_PCE_LINEPIX_LINES][ROMDEV_PCE_LINEPIX_WIDTH];
+
+extern "C" void romdev_pce_linepix_store(int chip, int line,
+                                         const unsigned short* buf, int width)
+{
+    /* VDC 1 only, matching the other single-VDC pce_* regions. */
+    if (chip != 0 || !buf)
+        return;
+    if (line < 0 || line >= ROMDEV_PCE_LINEPIX_LINES)
+        return;
+    if (width < 0)
+        width = 0;
+    if (width > ROMDEV_PCE_LINEPIX_WIDTH)
+        width = ROMDEV_PCE_LINEPIX_WIDTH;
+    memcpy(romdev_pce_linepix[line], buf, (size_t)width * sizeof(uint16_t));
+}
+#define ROMDEV_PCE_PALLINES      263
+#define ROMDEV_PCE_PAL_ENTRIES   512
+static uint16_t romdev_pce_pallines[ROMDEV_PCE_PALLINES][ROMDEV_PCE_PAL_ENTRIES];
+
+extern "C" void romdev_pce_palline(int vpos, const unsigned short* table)
+{
+    if (vpos < 0 || vpos >= ROMDEV_PCE_PALLINES || !table)
+        return;
+    memcpy(romdev_pce_pallines[vpos], table,
+           ROMDEV_PCE_PAL_ENTRIES * sizeof(uint16_t));
+}
+
+#define ROMDEV_PCE_PALDELTA_CAP 8192
+#pragma pack(push, 1)
+struct romdev_pce_paldelta {
+    uint16_t vpos;   /* VCE line the write landed on (pallines key) */
+    uint16_t hpos;   /* raw VCE clock within the line */
+    uint16_t dot;    /* pixel within the emitted row */
+    uint16_t index;  /* colour-table entry (0..511) */
+    uint16_t oldv;   /* entry value BEFORE the write (undo) */
+    uint16_t newv;   /* entry value AFTER the write (redo) */
+};
+struct romdev_pce_paldelta_region {
+    uint16_t count;
+    uint8_t  truncated;
+    uint8_t  pad;
+    struct romdev_pce_paldelta e[ROMDEV_PCE_PALDELTA_CAP];
+};
+#pragma pack(pop)
+/* TWO buffers: the VCE calls the frame-boundary publish from the SAME
+ * end-of-line block that sets frame_ready, so retro_run returns immediately
+ * AFTER the boundary -- a single reset-in-place buffer would always read
+ * count=0 from outside (measured: Eaggy, count 0 at every probe depth). The
+ * accumulator collects the running frame; the boundary copies it into the
+ * exposed region and clears the accumulator, so a consumer always sees the
+ * COMPLETED frame's log, exactly like every other per-frame region here. */
+static struct romdev_pce_paldelta_region romdev_pce_paldeltas;      /* exposed */
+static struct romdev_pce_paldelta_region romdev_pce_paldeltas_acc;  /* running */
+
+extern "C" void romdev_pce_paldeltas_reset(void)
+{
+    size_t n = (size_t)romdev_pce_paldeltas_acc.count;
+    if (n > ROMDEV_PCE_PALDELTA_CAP) n = ROMDEV_PCE_PALDELTA_CAP;
+    memcpy(&romdev_pce_paldeltas, &romdev_pce_paldeltas_acc,
+           4 + n * sizeof(struct romdev_pce_paldelta));
+    romdev_pce_paldeltas_acc.count = 0;
+    romdev_pce_paldeltas_acc.truncated = 0;
+}
+
+extern "C" void romdev_pce_paldelta_log(int vpos, int hpos, int dot,
+                                        int index, unsigned short oldv,
+                                        unsigned short newv)
+{
+    if (oldv == newv)
+        return;
+    if (romdev_pce_paldeltas_acc.count >= ROMDEV_PCE_PALDELTA_CAP) {
+        romdev_pce_paldeltas_acc.truncated = 1;
+        return;
+    }
+    struct romdev_pce_paldelta* d =
+        &romdev_pce_paldeltas_acc.e[romdev_pce_paldeltas_acc.count++];
+    d->vpos = (uint16_t)vpos; d->hpos = (uint16_t)hpos;
+    d->dot = (uint16_t)dot;   d->index = (uint16_t)index;
+    d->oldv = oldv;           d->newv = newv;
+}
+
+/* 263 = HUC6270_LINES, the full NTSC line count -- the display window is
+ * shorter but m_raster_line is only bounded by the programmed VDW, and a game
+ * may program a taller one than the 242-line visible area. */
+#define ROMDEV_PCE_REGLINES 263
+#pragma pack(push, 1)
+struct romdev_pce_regline {
+    uint16_t bxr;      /* m_latched_bxr  -- horizontal scroll for this line */
+    uint16_t bgy;      /* m_bg_offset_y  -- effective BYR for this line */
+    uint16_t cr;       /* m_latched_cr   -- layer enables (bit 7 BG, 6 SPR) */
+    uint16_t mwr;      /* m_latched_mwr  -- BAT size + sprite mode */
+    uint16_t hdw;      /* m_latched_hdw  -- display width in 8px units - 1 */
+    uint16_t raster;   /* m_raster_line, echoed for cheap validation */
+    uint8_t  valid;    /* 0 = this line never rendered in the last frame */
+    uint8_t  burst;    /* m_burst_mode: line is blanked, both layers off */
+    /* m_vpos -- the VCE scanline this VDC raster line was rendered on. The
+     * framebuffer row is vpos-14 (HuC6270 sets m_active_line for vpos in
+     * [14,256), and the VCE copies from that same vpos), so this is the ONLY
+     * exact framebuffer-row <-> raster-line mapping. A consumer used to apply
+     * a constant bias, which is wrong: the offset is (VSW+1)+(VDS+2)-14 only
+     * when the display window fits, and games that program VDW to start after
+     * vpos 14 get their picture CLIPPED rather than shifted, so no single
+     * constant or formula covers the corpus. Measured biases ranged 0..17
+     * across the 80-game library. */
+    uint16_t vpos;
+};
+#pragma pack(pop)
+static struct romdev_pce_regline romdev_pce_reglines[ROMDEV_PCE_REGLINES];
+
+extern "C" void romdev_pce_regline(int chip, int line, unsigned short bxr,
+                                   unsigned short bgy, unsigned short cr,
+                                   unsigned short mwr, unsigned short hdw,
+                                   unsigned char burst, unsigned short vpos)
+{
+    /* SuperGrafx has two VDCs; only VDC 1 is what the single-VDC regions
+     * (0x1A0-0x1A2) expose, so keep the per-line record consistent with them. */
+    if (chip != 0)
+        return;
+    /* Line 0 starts a fresh display window (NextVerticalState resets
+     * m_raster_line at VDW start), so invalidate the tail here rather than in
+     * retro_run -- retro_run can return mid-frame on a romdev breakpoint. */
+    if (line == 0)
+    {
+        memset(romdev_pce_reglines, 0, sizeof(romdev_pce_reglines));
+        /* Same frame boundary invalidates the x-placement record. 0xFFFF is
+         * "no picture on this line", which is distinct from x == 0. */
+        memset(romdev_pce_xoff_seen, 0, sizeof(romdev_pce_xoff_seen));
+        for (int i = 0; i < ROMDEV_PCE_XOFFLINES; i++)
+        {
+            romdev_pce_xofflines[i] = 0xFFFF;
+            romdev_pce_srclines[i]  = 0;
+        }
+    }
+    if (line < 0 || line >= ROMDEV_PCE_REGLINES)
+        return;
+    struct romdev_pce_regline* d = &romdev_pce_reglines[line];
+    d->bxr = bxr; d->bgy = bgy; d->cr = cr; d->mwr = mwr; d->hdw = hdw;
+    d->raster = (uint16_t)line; d->valid = 1; d->burst = burst ? 1 : 0;
+    d->vpos = vpos;
+}
+
+/* HuC6280 PSG snapshot: 6 channels of {enabled, frequency, control, amplitude,
+ * vol_left, vol_right, wave_index, noise_control, noise_enabled, noise_freq}
+ * plus the global main-amplitude + LFO. getAudioState({chip:'pce'}) decodes it.
+ * The core's PSG state is a struct of pointers; we read the channel array via
+ * GetState()->CHANNELS and pack a stable little-endian layout. */
+#pragma pack(push, 1)
+struct romdev_pce_psg_chan {
+    uint8_t  enabled;
+    uint16_t frequency;
+    uint8_t  control;
+    uint8_t  amplitude;
+    uint8_t  vol_left;
+    uint8_t  vol_right;
+    uint8_t  wave_index;
+    uint8_t  noise_control;
+    uint8_t  noise_enabled;
+    uint32_t noise_freq;
+};
+struct romdev_pce_psg_snap {
+    uint8_t  channel_select;
+    uint8_t  main_amplitude;
+    uint16_t lfo_frequency;
+    uint8_t  lfo_control;
+    struct romdev_pce_psg_chan channels[6];
+};
+#pragma pack(pop)
+static struct romdev_pce_psg_snap romdev_pce_psg;
+
+static void* romdev_pce_psg_data(void)
+{
+    if (!core) return NULL;
+    HuC6280PSG::HuC6280PSG_State* st = core->GetAudio()->GetPSG()->GetState();
+    romdev_pce_psg.channel_select = st->CHANNEL_SELECT ? *st->CHANNEL_SELECT : 0;
+    romdev_pce_psg.main_amplitude = st->MAIN_AMPLITUDE ? *st->MAIN_AMPLITUDE : 0;
+    romdev_pce_psg.lfo_frequency  = st->LFO_FREQUENCY ? *st->LFO_FREQUENCY : 0;
+    romdev_pce_psg.lfo_control    = st->LFO_CONTROL ? *st->LFO_CONTROL : 0;
+    for (int i = 0; i < 6; i++) {
+        struct romdev_pce_psg_chan* d = &romdev_pce_psg.channels[i];
+        if (st->CHANNELS) {
+            HuC6280PSG::HuC6280PSG_Channel* c = &st->CHANNELS[i];
+            d->enabled       = c->enabled;
+            d->frequency     = c->frequency;
+            d->control       = c->control;
+            d->amplitude     = c->amplitude;
+            d->vol_left      = c->vol_left;
+            d->vol_right     = c->vol_right;
+            d->wave_index    = c->wave_index;
+            d->noise_control = c->noise_control;
+            d->noise_enabled = c->noise_enabled;
+            d->noise_freq    = c->noise_freq;
+        } else {
+            *d = (struct romdev_pce_psg_chan){0};
+        }
+    }
+    return &romdev_pce_psg;
+}
+
+/* HuC6280 register snapshot. The core's HuC6280_State is a struct of pointers
+ * to scattered registers; pack the values into a flat little-endian buffer so
+ * romdev's getCPUState can decode a stable layout. */
+#pragma pack(push, 1)
+struct romdev_pce_cpu_snap {
