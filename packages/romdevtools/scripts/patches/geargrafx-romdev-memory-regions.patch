+/* ---- romdev execution breakpoint + read watchpoint (HuC6280) ----------
+ * The HuC6280 is a 65C02 superset; these mirror the 6502 impl on the other
+ * romdev cores. State lives here (C linkage); the hooks live in the core:
+ *   - PC break / single-step: HuC6280::RunInstruction (huc6280_inline.h) freezes
+ *     the CPU at the target PC; the per-frame loop in geargrafx_core_inline.h
+ *     drains on romdev_pc_hit so retro_run returns.
+ *   - read watch: Memory::Read (memory_inline.h) records the reading PC.
+ * Exported as romdev_pcbreak_set/get + romdev_readwatch_set/get — these power
+ * runUntilPC / stepInstruction / runUntilRead. (This core has no write watch.) */
+extern "C" {
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+    romdev_rd_addr = addr;
+    romdev_rd_enabled = enabled ? 1 : 0;
+    romdev_rd_last_pc = 0xFFFFFFFF;
+    romdev_rd_last_val = 0;
+    romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+    if (!out5) return;
+    out5[0] = (unsigned int)romdev_rd_enabled;
+    out5[1] = romdev_rd_addr;
+    out5[2] = romdev_rd_last_pc;
+    out5[3] = (unsigned int)romdev_rd_last_val;
+    out5[4] = romdev_rd_hits;
+    if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev WRITE watchpoint (findWriter) — the EXACT instruction PC that WROTE a
+ * watched address. This core has a clean Memory::Write funnel, so findWriter is
+ * supported on PC Engine. Set by the write hook in memory_inline.h. */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+    romdev_wp_addr = addr;
+    romdev_wp_enabled = enabled ? 1 : 0;
+    romdev_wp_last_pc = 0xFFFFFFFF;
+    romdev_wp_last_val = 0;
+    romdev_wp_hits = 0;
+}
+
+/* Fills out6: [enabled, addr, lastPC, lastVal, hits, prgOffset]. prgOffset is
+ * 0xFFFFFFFF (HuC6280 PC is a flat banked CPU address; no separate ROM offset). */
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+    if (!out6) return;
+    out6[0] = (unsigned int)romdev_wp_enabled;
+    out6[1] = romdev_wp_addr;
+    out6[2] = romdev_wp_last_pc;
+    out6[3] = (unsigned int)romdev_wp_last_val;
+    out6[4] = romdev_wp_hits;
+    out6[5] = 0xFFFFFFFF;
+    if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;
+volatile int  romdev_pc_hit     = 0;
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+
+/* romdev INSTRUCTION WATCHDOG (HuC6280): a runaway routine (e.g. a codec fed a
+ * wrong arg that loops forever) can spin entirely inside a single retro_run
+ * frame, so the host's per-FRAME maxFrames never gets a turn and the whole WASM
+ * hangs. The hook in HuC6280::RunInstruction counts dispatched instructions and
+ * force-stops (sets romdev_pc_hit + romdev_pc_watchdog) when the budget is
+ * exceeded — so a runaway returns control with the final PC intact instead of
+ * hanging. romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+    romdev_pc_addr = addr;
+    romdev_pc_enabled = enabled ? 1 : 0;
+    /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+     * before the stop fires (true single-step that advances the PC). */
+    romdev_pc_step = step ? 2 : 0;
+    romdev_pc_hit = 0;
+    romdev_pc_last_pc = 0xFFFFFFFF;
+    romdev_pc_hits = 0;
+    romdev_pc_watchdog = 0;
+    romdev_pc_wd_count = 0;
+}
+
+/* Fills out6: [enabled, addr, hit, lastPC, hits, watchdogTripped]. clearHit re-arms. */
+void romdev_pcbreak_get(unsigned int *out6, int clearHit)
+{
+    if (!out6) return;
+    out6[0] = (unsigned int)romdev_pc_enabled;
+    out6[1] = romdev_pc_addr;
+    out6[2] = (unsigned int)romdev_pc_hit;
+    out6[3] = romdev_pc_last_pc;
+    out6[4] = romdev_pc_hits;
+    out6[5] = (unsigned int)romdev_pc_watchdog;
+    if (clearHit) { romdev_pc_hit = 0; romdev_pc_watchdog = 0; romdev_pc_wd_count = 0; }
+}
+
+/* Arms the instruction watchdog: force-stop after `limit` instructions (limit
+ * 0 = disable). The host sets this before driving callSubroutine so a runaway
+ * codec returns control instead of hanging. */
+void romdev_watchdog_set(unsigned int limit)
+{
+    romdev_pc_wd_limit = limit;
+    romdev_pc_wd_count = 0;
+    romdev_pc_watchdog = 0;
+}
+
+/* ---- romdev RE primitives round 2 (HuC6280 = 65C02 superset) -----------
+ * Register read/write (inverse of getCPUState — powers setRegister /
+ * callSubroutine), a RANGE WATCH logging every {pc,addr,value} touching [lo,hi]
+ * (hooks in Memory::Read AND Memory::Write — unlike round 1, this core HAS a
+ * clean write funnel so range-write IS supported), and a PC COVERAGE log of
+ * distinct in-window PCs (hook in HuC6280::RunInstruction). 6502/65C02 reg-id
+ * convention (STABLE): 0=A 1=X 2=Y 3=P(status) 4=SP(=S) 16=PC. The HuC6280_State
+ * holds pointers to Register objects (Get/SetValue); reg access forwards there. */
+
+int romdev_setreg(int regId, unsigned int value)
+{
+    if (!core) return -1;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    switch (regId) {
+        case 0:  if (st->A)  st->A->SetValue((u8)value);   return 0;  /* A */
+        case 1:  if (st->X)  st->X->SetValue((u8)value);   return 0;  /* X */
+        case 2:  if (st->Y)  st->Y->SetValue((u8)value);   return 0;  /* Y */
+        case 3:  if (st->P)  st->P->SetValue((u8)value);   return 0;  /* P (status) */
+        case 4:  if (st->S)  st->S->SetValue((u8)value);   return 0;  /* SP (= S) */
+        case 16: if (st->PC) st->PC->SetValue((u16)value); return 0;  /* PC */
+        default: return -1;
+    }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+    if (!core) return 0;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    switch (regId) {
+        case 0:  return st->A  ? (unsigned int)st->A->GetValue()  : 0;
+        case 1:  return st->X  ? (unsigned int)st->X->GetValue()  : 0;
+        case 2:  return st->Y  ? (unsigned int)st->Y->GetValue()  : 0;
+        case 3:  return st->P  ? (unsigned int)st->P->GetValue()  : 0;
+        case 4:  return st->S  ? (unsigned int)st->S->GetValue()  : 0;
+        case 16: return st->PC ? (unsigned int)st->PC->GetValue() : 0;
+        default: return 0;
+    }
+}
+
+/* RANGE watch state + ring buffer (CAP 4096). mode 1=read 2=write 3=both.
+ * The hooks in Memory::Read / Memory::Write (memory_inline.h) call
+ * romdev_range_log; the recorded pc is the HuC6280 PC (executing instruction).
+ * Still inside the round-1 extern "C" block; the single closing } follows below. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;
+unsigned int  romdev_range_stored  = 0;
+
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val)
+{
+    romdev_range_count++;
+    if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+        romdev_range_pc  [romdev_range_stored] = pc;
+        romdev_range_addr[romdev_range_stored] = addr;
+        romdev_range_val [romdev_range_stored] = val;
+        romdev_range_stored++;
+    }
+}
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+    romdev_range_lo = lo; romdev_range_hi = hi;
+    romdev_range_mode = mode ? mode : 3;
+    romdev_range_enabled = enabled ? 1 : 0;
+    romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...].
+ * out2 (size 2) gets [totalSeen, stored]. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+    unsigned int i, n = romdev_range_stored;
+    if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+    if (!out) return 0;
+    if (n > max) n = max;
+    for (i = 0; i < n; i++) {
+        out[i*3 + 0] = romdev_range_pc[i];
+        out[i*3 + 1] = romdev_range_addr[i];
+        out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+    }
+    return n;
+}
+
+/* PC COVERAGE state + linear-dedup buffer (CAP 8192). Hook in HuC6280::RunInstruction. */
+#define ROMDEV_COV_CAP 8192
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;
+unsigned int  romdev_cov_total   = 0;
+
+void romdev_cov_log(unsigned int pc)
+{
+    unsigned int i;
+    romdev_cov_total++;
+    for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+    if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+    romdev_cov_lo = lo; romdev_cov_hi = hi;
+    romdev_cov_enabled = enabled ? 1 : 0;
+    romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+    unsigned int i, n = romdev_cov_count;
+    if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+    if (!out) return 0;
+    if (n > max) n = max;
+    for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+    return n;
+}
+}
+
+/* ---- romdev memory-region exposure (PC Engine) ----------------------- */
+#define ROMDEV_MEMORY_PCE_VDC_VRAM    0x1A0
+#define ROMDEV_MEMORY_PCE_VDC_SATB    0x1A1
+#define ROMDEV_MEMORY_PCE_VDC_REGS    0x1A2
+#define ROMDEV_MEMORY_PCE_VCE_PALETTE 0x1A3
+#define ROMDEV_MEMORY_PCE_CPU_REGS    0x1A4
+#define ROMDEV_MEMORY_PCE_PSG_REGS    0x1A5
+
+/* HuC6280 PSG snapshot: 6 channels of {enabled, frequency, control, amplitude,
+ * vol_left, vol_right, wave_index, noise_control, noise_enabled, noise_freq}
+ * plus the global main-amplitude + LFO. getAudioState({chip:'pce'}) decodes it.
+ * The core's PSG state is a struct of pointers; we read the channel array via
+ * GetState()->CHANNELS and pack a stable little-endian layout. */
+#pragma pack(push, 1)
+struct romdev_pce_psg_chan {
+    uint8_t  enabled;
+    uint16_t frequency;
+    uint8_t  control;
+    uint8_t  amplitude;
+    uint8_t  vol_left;
+    uint8_t  vol_right;
+    uint8_t  wave_index;
+    uint8_t  noise_control;
+    uint8_t  noise_enabled;
+    uint32_t noise_freq;
+};
+struct romdev_pce_psg_snap {
+    uint8_t  channel_select;
+    uint8_t  main_amplitude;
+    uint16_t lfo_frequency;
+    uint8_t  lfo_control;
+    struct romdev_pce_psg_chan channels[6];
+};
+#pragma pack(pop)
+static struct romdev_pce_psg_snap romdev_pce_psg;
+
+static void* romdev_pce_psg_data(void)
+{
+    if (!core) return NULL;
+    HuC6280PSG::HuC6280PSG_State* st = core->GetAudio()->GetPSG()->GetState();
+    romdev_pce_psg.channel_select = st->CHANNEL_SELECT ? *st->CHANNEL_SELECT : 0;
+    romdev_pce_psg.main_amplitude = st->MAIN_AMPLITUDE ? *st->MAIN_AMPLITUDE : 0;
+    romdev_pce_psg.lfo_frequency  = st->LFO_FREQUENCY ? *st->LFO_FREQUENCY : 0;
+    romdev_pce_psg.lfo_control    = st->LFO_CONTROL ? *st->LFO_CONTROL : 0;
+    for (int i = 0; i < 6; i++) {
+        struct romdev_pce_psg_chan* d = &romdev_pce_psg.channels[i];
+        if (st->CHANNELS) {
+            HuC6280PSG::HuC6280PSG_Channel* c = &st->CHANNELS[i];
+            d->enabled       = c->enabled;
+            d->frequency     = c->frequency;
+            d->control       = c->control;
+            d->amplitude     = c->amplitude;
+            d->vol_left      = c->vol_left;
+            d->vol_right     = c->vol_right;
+            d->wave_index    = c->wave_index;
+            d->noise_control = c->noise_control;
+            d->noise_enabled = c->noise_enabled;
+            d->noise_freq    = c->noise_freq;
+        } else {
+            *d = (struct romdev_pce_psg_chan){0};
+        }
+    }
+    return &romdev_pce_psg;
+}
+
+/* HuC6280 register snapshot. The core's HuC6280_State is a struct of pointers
+ * to scattered registers; pack the values into a flat little-endian buffer so
+ * romdev's getCPUState can decode a stable layout. */
+#pragma pack(push, 1)
+struct romdev_pce_cpu_snap {
+    uint16_t pc;
+    uint8_t  a, x, y, s, p;
+    int32_t  speed;
+    uint8_t  timer_enabled;
+    uint8_t  timer_counter;
+    uint8_t  timer_reload;
+    uint8_t  idr;
+    uint8_t  irr;
+};
+#pragma pack(pop)
+static struct romdev_pce_cpu_snap romdev_pce_cpu;
+
+static void* romdev_pce_cpu_data(void)
+{
+    if (!core) return NULL;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    romdev_pce_cpu.pc            = st->PC ? st->PC->GetValue() : 0;
+    romdev_pce_cpu.a             = st->A ? st->A->GetValue() : 0;
+    romdev_pce_cpu.x             = st->X ? st->X->GetValue() : 0;
+    romdev_pce_cpu.y             = st->Y ? st->Y->GetValue() : 0;
+    romdev_pce_cpu.s             = st->S ? st->S->GetValue() : 0;
+    romdev_pce_cpu.p             = st->P ? st->P->GetValue() : 0;
+    romdev_pce_cpu.speed         = st->SPEED ? *st->SPEED : 0;
+    romdev_pce_cpu.timer_enabled = (st->TIMER && *st->TIMER) ? 1 : 0;
+    romdev_pce_cpu.timer_counter = st->TIMER_COUNTER ? *st->TIMER_COUNTER : 0;
+    romdev_pce_cpu.timer_reload  = st->TIMER_RELOAD ? *st->TIMER_RELOAD : 0;
+    romdev_pce_cpu.idr           = st->IDR ? *st->IDR : 0;
+    romdev_pce_cpu.irr           = st->IRR ? *st->IRR : 0;
+    return &romdev_pce_cpu;
+}
+
 void *retro_get_memory_data(unsigned id)
 {
     switch (id)
@@ -457,6 +810,18 @@ void *retro_get_memory_data(unsigned id)
             return core->GetMemory()->GetWorkingRAM();
         case RETRO_MEMORY_VIDEO_RAM:
             return (u8*)core->GetHuC6270_1()->GetVRAM();
+        case ROMDEV_MEMORY_PCE_VDC_VRAM:
+            return (u8*)core->GetHuC6270_1()->GetVRAM();
+        case ROMDEV_MEMORY_PCE_VDC_SATB:
