+ * libretro.cpp; the read hook below and the write hook in Memory::Write call
+ * romdev_range_log. mode 1=read 2=write 3=both. The recorded pc is the HuC6280
+ * PC (the executing instruction). */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern void          romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val);
