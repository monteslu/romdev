+    if (romdev_range_enabled && (romdev_range_mode & 1)
+        && (unsigned int)address >= romdev_range_lo && (unsigned int)address <= romdev_range_hi) {
+        romdev_range_log(m_huc6280->GetState()->PC->GetValue(), (unsigned int)address, romdev_rd_value);
+    }
+    return romdev_rd_value;
