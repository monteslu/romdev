 dkwb_cdx_ordinal = dkwb_cdx_globalcolor_ordinal;
 DKWB_CDX_LOG(dkwb_cdx_ordinal, "[CDX] globalcolor proc=%d\n", dkwb_cdx_ordinal);
+dkwb_cdx_dump_symtab(mem, dkwb_cdx_ordinal);
