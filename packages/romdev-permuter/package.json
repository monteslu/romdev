{
  "name": "romdev-permuter",
  "version": "0.1.0",
  "description": "Plain-JS port of decomp-permuter: PERM macros, randomization passes, the objdump-diff scorer and the compile.sh contract, with candidate evaluation in node worker threads and disassembly through WASM binutils.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "romdev-permuter": "bin/permuter.mjs",
    "romdev-permuter-import": "bin/import.mjs",
    "romdev-permuter-remote": "bin/remote.mjs",
    "romdev-permuter-remote-controller": "bin/remote-controller.mjs"
  },
  "files": [
    "src",
    "bin",
    "default_weights.toml",
    "prelude.inc",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "dependencies": {
    "libsodium-wrappers": "0.8.4",
    "romdev-pycparser": "0.1.0",
    "romdev-toolchain-mips-gcc": "0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monteslu/romdev.git",
    "directory": "packages/romdev-permuter"
  },
  "homepage": "https://github.com/monteslu/romdev#readme",
  "bugs": {
    "url": "https://github.com/monteslu/romdev/issues"
  },
  "author": "Luis Montes",
  "scripts": {
    "test": "node --test"
  }
}
