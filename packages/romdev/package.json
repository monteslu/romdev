{
  "name": "romdev",
  "version": "0.1.0",
  "description": "MCP server giving coding agents full control of homebrew ROM development across retro platforms (NES, SNES, GB, Genesis, Atari, C64, ...) via WASM libretro cores.",
  "type": "module",
  "main": "src/mcp/server.js",
  "bin": {
    "romdev": "src/mcp/server.js",
    "romdev-cli": "src/cli/smoke.js"
  },
  "scripts": {
    "smoke": "node --enable-source-maps src/cli/smoke.js",
    "mcp": "node --enable-source-maps src/mcp/server.js",
    "test": "node --test 'src/**/*.test.js' 'test/**/*.test.js'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "libretro",
    "wasm",
    "emulator",
    "homebrew",
    "retro",
    "nes",
    "snes",
    "game-boy",
    "genesis",
    "atari",
    "commodore-64",
    "agent",
    "claude"
  ],
  "author": "monteslu",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@monteslu/chafa-wasm": "^0.4.0",
    "romdev-core-fceumm": "0.1.0",
    "romdev-core-gambatte": "0.1.0",
    "romdev-core-gpgx": "0.1.0",
    "romdev-core-handy": "0.1.0",
    "romdev-core-prosystem": "0.1.0",
    "romdev-core-vice": "0.1.0",
    "romdev-platform-atari2600": "0.1.0",
    "romdev-platform-gba": "0.1.0",
    "romdev-platform-snes": "0.1.0",
    "romdev-toolchain-cc65": "0.1.0",
    "romdev-toolchain-m68k-gcc": "0.1.0",
    "romdev-toolchain-rgbds": "0.1.0",
    "romdev-toolchain-sdcc": "0.1.0",
    "romdev-toolchain-vasm": "0.1.0",
    "ase-parser": "^0.0.18",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.3",
    "yauzl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "examples",
    "AGENTS.md",
    "README.md",
    "PLAN.md",
    "LICENSE",
    "NOTICE"
  ],
  "optionalDependencies": {
    "@kmamal/sdl": "^0.11.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monteslu/romdev.git",
    "directory": "packages/romdev"
  },
  "homepage": "https://github.com/monteslu/romdev#readme",
  "bugs": {
    "url": "https://github.com/monteslu/romdev/issues"
  }
}
