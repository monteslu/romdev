# romdev memory-region exposure for the Geargrafx (PC Engine / TurboGrafx-16)
# libretro core.
#
# Exposes the HuC6270 VDC (VRAM already wired to VIDEO_RAM, plus the sprite
# attribute table SATB and the 20-entry VDC register file), the HuC6260 VCE
# 9-bit-GRB color table (palette), and a HuC6280 CPU register snapshot — all via
# retro_get_memory_data so romdev's inspect*/getCPUState/inspectPalette/
# inspectSprites tools can read them. The core ships clean public accessors
# (GetHuC6270_1()/GetHuC6260()/GetHuC6280()), so VRAM/SATB/regs/palette return
# live pointers; only the CPU state (a struct of scattered pointers) is snapshotted
# into a static buffer, mirroring the gpgx ym2612/z80 precedent.
#
# Region IDs (romdev 0x1A0 block, must match src/host/types.js):
#   PCE_VDC_VRAM   0x1A0   u16[0x8000]  = 64 KB   (also wired to RETRO_MEMORY_VIDEO_RAM)
#   PCE_VDC_SATB   0x1A1   u16[0x100]   = 512 B   sprite attribute table
#   PCE_VDC_REGS   0x1A2   u16[20]      = 40 B    VDC register file
#   PCE_VCE_PALETTE 0x1A3  u16[512]     = 1024 B  color table (9-bit GRB), 256 BG + 256 SPR
#   PCE_CPU_REGS   0x1A4   snapshot     PC/A/X/Y/S/P + timer/irq
#   PCE_PSG_REGS   0x1A5   snapshot     6 PSG channels + main amplitude + LFO
#
diff --git a/platforms/libretro/libretro.cpp b/platforms/libretro/libretro.cpp
index 131c841..72ea007 100644
--- a/platforms/libretro/libretro.cpp
+++ b/platforms/libretro/libretro.cpp
@@ -447,6 +447,107 @@ bool retro_unserialize(const void *data, size_t size)
     return core->LoadState(reinterpret_cast<const u8*>(data), size);
 }
 
+/* ---- romdev memory-region exposure (PC Engine) ----------------------- */
+#define ROMDEV_MEMORY_PCE_VDC_VRAM    0x1A0
+#define ROMDEV_MEMORY_PCE_VDC_SATB    0x1A1
+#define ROMDEV_MEMORY_PCE_VDC_REGS    0x1A2
+#define ROMDEV_MEMORY_PCE_VCE_PALETTE 0x1A3
+#define ROMDEV_MEMORY_PCE_CPU_REGS    0x1A4
+#define ROMDEV_MEMORY_PCE_PSG_REGS    0x1A5
+
+/* HuC6280 PSG snapshot: 6 channels of {enabled, frequency, control, amplitude,
+ * vol_left, vol_right, wave_index, noise_control, noise_enabled, noise_freq}
+ * plus the global main-amplitude + LFO. getAudioState({chip:'pce'}) decodes it.
+ * The core's PSG state is a struct of pointers; we read the channel array via
+ * GetState()->CHANNELS and pack a stable little-endian layout. */
+#pragma pack(push, 1)
+struct romdev_pce_psg_chan {
+    uint8_t  enabled;
+    uint16_t frequency;
+    uint8_t  control;
+    uint8_t  amplitude;
+    uint8_t  vol_left;
+    uint8_t  vol_right;
+    uint8_t  wave_index;
+    uint8_t  noise_control;
+    uint8_t  noise_enabled;
+    uint32_t noise_freq;
+};
+struct romdev_pce_psg_snap {
+    uint8_t  channel_select;
+    uint8_t  main_amplitude;
+    uint16_t lfo_frequency;
+    uint8_t  lfo_control;
+    struct romdev_pce_psg_chan channels[6];
+};
+#pragma pack(pop)
+static struct romdev_pce_psg_snap romdev_pce_psg;
+
+static void* romdev_pce_psg_data(void)
+{
+    if (!core) return NULL;
+    HuC6280PSG::HuC6280PSG_State* st = core->GetAudio()->GetPSG()->GetState();
+    romdev_pce_psg.channel_select = st->CHANNEL_SELECT ? *st->CHANNEL_SELECT : 0;
+    romdev_pce_psg.main_amplitude = st->MAIN_AMPLITUDE ? *st->MAIN_AMPLITUDE : 0;
+    romdev_pce_psg.lfo_frequency  = st->LFO_FREQUENCY ? *st->LFO_FREQUENCY : 0;
+    romdev_pce_psg.lfo_control    = st->LFO_CONTROL ? *st->LFO_CONTROL : 0;
+    for (int i = 0; i < 6; i++) {
+        struct romdev_pce_psg_chan* d = &romdev_pce_psg.channels[i];
+        if (st->CHANNELS) {
+            HuC6280PSG::HuC6280PSG_Channel* c = &st->CHANNELS[i];
+            d->enabled       = c->enabled;
+            d->frequency     = c->frequency;
+            d->control       = c->control;
+            d->amplitude     = c->amplitude;
+            d->vol_left      = c->vol_left;
+            d->vol_right     = c->vol_right;
+            d->wave_index    = c->wave_index;
+            d->noise_control = c->noise_control;
+            d->noise_enabled = c->noise_enabled;
+            d->noise_freq    = c->noise_freq;
+        } else {
+            *d = (struct romdev_pce_psg_chan){0};
+        }
+    }
+    return &romdev_pce_psg;
+}
+
+/* HuC6280 register snapshot. The core's HuC6280_State is a struct of pointers
+ * to scattered registers; pack the values into a flat little-endian buffer so
+ * romdev's getCPUState can decode a stable layout. */
+#pragma pack(push, 1)
+struct romdev_pce_cpu_snap {
+    uint16_t pc;
+    uint8_t  a, x, y, s, p;
+    int32_t  speed;
+    uint8_t  timer_enabled;
+    uint8_t  timer_counter;
+    uint8_t  timer_reload;
+    uint8_t  idr;
+    uint8_t  irr;
+};
+#pragma pack(pop)
+static struct romdev_pce_cpu_snap romdev_pce_cpu;
+
+static void* romdev_pce_cpu_data(void)
+{
+    if (!core) return NULL;
+    HuC6280::HuC6280_State* st = core->GetHuC6280()->GetState();
+    romdev_pce_cpu.pc            = st->PC ? st->PC->GetValue() : 0;
+    romdev_pce_cpu.a             = st->A ? st->A->GetValue() : 0;
+    romdev_pce_cpu.x             = st->X ? st->X->GetValue() : 0;
+    romdev_pce_cpu.y             = st->Y ? st->Y->GetValue() : 0;
+    romdev_pce_cpu.s             = st->S ? st->S->GetValue() : 0;
+    romdev_pce_cpu.p             = st->P ? st->P->GetValue() : 0;
+    romdev_pce_cpu.speed         = st->SPEED ? *st->SPEED : 0;
+    romdev_pce_cpu.timer_enabled = (st->TIMER && *st->TIMER) ? 1 : 0;
+    romdev_pce_cpu.timer_counter = st->TIMER_COUNTER ? *st->TIMER_COUNTER : 0;
+    romdev_pce_cpu.timer_reload  = st->TIMER_RELOAD ? *st->TIMER_RELOAD : 0;
+    romdev_pce_cpu.idr           = st->IDR ? *st->IDR : 0;
+    romdev_pce_cpu.irr           = st->IRR ? *st->IRR : 0;
+    return &romdev_pce_cpu;
+}
+
 void *retro_get_memory_data(unsigned id)
 {
     switch (id)
@@ -457,6 +558,18 @@ void *retro_get_memory_data(unsigned id)
             return core->GetMemory()->GetWorkingRAM();
         case RETRO_MEMORY_VIDEO_RAM:
             return (u8*)core->GetHuC6270_1()->GetVRAM();
+        case ROMDEV_MEMORY_PCE_VDC_VRAM:
+            return (u8*)core->GetHuC6270_1()->GetVRAM();
+        case ROMDEV_MEMORY_PCE_VDC_SATB:
+            return (u8*)core->GetHuC6270_1()->GetSAT();
+        case ROMDEV_MEMORY_PCE_VDC_REGS:
+            return (u8*)core->GetHuC6270_1()->GetState()->R;
+        case ROMDEV_MEMORY_PCE_VCE_PALETTE:
+            return (u8*)core->GetHuC6260()->GetColorTable();
+        case ROMDEV_MEMORY_PCE_CPU_REGS:
+            return romdev_pce_cpu_data();
+        case ROMDEV_MEMORY_PCE_PSG_REGS:
+            return romdev_pce_psg_data();
     }
 
     return NULL;
@@ -472,6 +585,18 @@ size_t retro_get_memory_size(unsigned id)
             return core->GetMemory()->GetWorkingRAMSize();
         case RETRO_MEMORY_VIDEO_RAM:
             return HUC6270_VRAM_SIZE * 2;
+        case ROMDEV_MEMORY_PCE_VDC_VRAM:
+            return HUC6270_VRAM_SIZE * 2;          /* 0x8000 u16 = 64 KB */
+        case ROMDEV_MEMORY_PCE_VDC_SATB:
+            return HUC6270_SAT_SIZE * 2;           /* 0x100 u16  = 512 B */
+        case ROMDEV_MEMORY_PCE_VDC_REGS:
+            return 20 * 2;                          /* m_register[20] u16 = 40 B */
+        case ROMDEV_MEMORY_PCE_VCE_PALETTE:
+            return 512 * 2;                         /* color_table[512] u16 = 1024 B */
+        case ROMDEV_MEMORY_PCE_CPU_REGS:
+            return sizeof(romdev_pce_cpu);
+        case ROMDEV_MEMORY_PCE_PSG_REGS:
+            return sizeof(romdev_pce_psg);
     }
 
     return 0;
