--- a/src/memory_inline.h
+++ b/src/memory_inline.h
@@ -33,7 +33,31 @@
 #include "sf2_mapper.h"
 #include "arcade_card_mapper.h"
 
+/* romdev instruction-level READ watchpoint state (defined in libretro.cpp).
+ * Records the HuC6280 PC of the instruction that READ a watched CPU address.
+ * Read() wraps the real body (ReadInternal) so every CPU/data read funnels
+ * through one capture point regardless of which bank/hardware path serves it.
+ * Exported via romdev_readwatch_* in libretro.cpp. */
+extern "C" {
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+}
+
 INLINE u8 Memory::Read(u16 address, bool block_transfer)
+{
+    u8 romdev_rd_value = ReadInternal(address, block_transfer);
+    if (romdev_rd_enabled && (unsigned int)address == romdev_rd_addr) {
+        romdev_rd_last_pc = m_huc6280->GetState()->PC->GetValue();
+        romdev_rd_last_val = romdev_rd_value;
+        romdev_rd_hits++;
+    }
+    return romdev_rd_value;
+}
+
+INLINE u8 Memory::ReadInternal(u16 address, bool block_transfer)
 {
 #if defined(GG_TESTING)
     return m_test_memory[address];
