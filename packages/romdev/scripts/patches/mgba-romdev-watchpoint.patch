 	struct GBA* gba = (struct GBA*) cpu->master;
+	ROMDEV_WP_GBA(cpu, address, value);
 	struct GBAMemory* memory = &gba->memory;
 	int wait = 0;
 	int16_t oldValue;
@@ -1027,6 +1067,7 @@ void GBAStore16(struct ARMCore* cpu, uint32_t address, int16_t value, int* cycle
 
