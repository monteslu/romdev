# romdev patch for libretro-mgba (GBA) — see README.md in this directory.
#
# SEVEN additions:
# 1) Instruction-level WRITE WATCHPOINT (ARM7TDMI): GBAStore8/16/32 in
#    src/gba/memory.c record cpu->gprs[ARM_PC] when a watched address is written;
#    libretro.c exports romdev_watchpoint_set/get. GBA is a flat 32-bit address
#    space (no banking) so PC alone is unambiguous. The ARM PC reflects pipeline
#    prefetch (exec instr is PC-8 ARM / PC-4 Thumb) — disassemble a couple instrs
#    before the reported PC.
# 2) Instruction-level READ WATCHPOINT (ARM7TDMI): GBALoad8/16/32 in
#    src/gba/memory.c record cpu->gprs[ARM_PC] + the value when a watched address
#    is read by the CPU (gated on cycleCounter != NULL so an internal helper read
#    — GBALoad16 calling GBALoad8 — doesn't double-fire); libretro.c exports
#    romdev_readwatch_set/get for runUntilRead. Same raw-PC convention as (1).
# 3) PC BREAKPOINT / single-step (ARM7TDMI): ARMRunLoop / ARMRun in src/arm/arm.c
#    compare the in-execution RAW gprs[ARM_PC] (= gprs[ARM_PC] + WORD_SIZE at the
#    top of a run-loop iteration, == instr_addr + 2*instrLen, the SAME value the
#    watchpoints report) against romdev_pc_addr. On a hit the CPU freezes EXACTLY
#    at the breakpoint instruction (it is NOT executed — getCPUState reads the
#    breakpoint PC) and romdev_end_frame() consumes a full frame of cycles + runs
#    the event handler once so the libretro frame loop (_GBACoreRunFrame's
#    time/frameCounter guard) COMPLETES instead of re-calling a frozen CPU forever
#    (the infinite-hang trap). romdev_pc_step is a per-instruction COUNTDOWN
#    (armed to 2) so single-step runs exactly one instruction then stops — it
#    ADVANCES the PC rather than re-stopping on the same un-executed instruction.
#    libretro.c exports romdev_pcbreak_set/get for runUntilPC / stepInstruction.
# 4) DEBUG STATE REGIONS via retro_get_memory_data/_size custom IDs (0x180+):
#    - 0x180 gba_cpu_regs: 20 u32 snapshot {gprs[0..15], cpsr, spsr, execMode,
#      privMode} for getCPUState.
#    - 0x10001 gba_io_regs: the 0x400 IO page (io[512]) — carries BOTH the LCD/
#      video registers and the audio registers, so getRenderingContext and
#      getAudioState both read it.
#    - 0x10002 gba_palette: palette[512] (256 BG + 256 OBJ, 15-bit BGR).
#    - 0x10003 gba_oam: oam.raw[512] — 128 sprites x 8 bytes for inspectSprites.
#    All point at contiguous in-struct GBA fields (cpu regs assembled into a
#    static snapshot buffer per call).
#
# ── RE PRIMITIVES ROUND 2 (5/6/7 below) ──────────────────────────────────────
# 5) REGISTER read/write (ARM7TDMI): romdev_arm_setreg/getreg in src/arm/arm.c
#    (the inverse of getCPUState; used by setRegister + callSubroutine). romdev
#    ARM reg-id convention (STABLE): 0..15 = r0..r15 (13=SP, 14=LR, 15=PC), 16 =
#    CPSR → cpu->gprs[n] / cpu->cpsr.packed. Setting r15 (PC) RELOADS the prefetch
#    pipeline via ARMWritePC/ThumbWritePC (the exact mechanism mgba uses on a
#    branch/exception, e.g. ARMRaiseUndefined) so the set PC ACTUALLY EXECUTES —
#    otherwise the two already-prefetched instructions run instead. libretro.c
#    exports romdev_setreg/getreg (guarded on the loaded core being mPLATFORM_GBA,
#    threading core->cpu through).
# 6) RANGE WATCH (discovery): log EVERY {pc,addr,value} reading/writing an address
#    in [lo,hi] over a window (mode 1=read 2=write 3=both) — not stop-on-first.
#    Hooked in the same GBALoad8/16/32 (reads) + GBAStore8/16/32 (writes) paths as
#    the read/write watchpoints, gated on cycleCounter != NULL. Ring buffer CAP
#    4096; pc is the raw gprs[ARM_PC] (consistent with the watchpoints). libretro.c
#    exports romdev_range_set/get (out = packed [pc,addr,val] triples; out2 =
#    [total,stored]) for watchRange.
# 7) PC COVERAGE log (discovery): record DISTINCT PCs executed within [lo,hi] over
#    a run ("what code runs here?"). Hook in the ARMRunLoop/ARMRun execute path
#    (and it gates the breakpoint fast-path bypass so it actually runs); the PC is
#    gprs[ARM_PC] + WORD_SIZE — the SAME value the PC breakpoint uses, so coverage
#    PCs line up with runUntilPC. Ring buffer CAP 8192. libretro.c exports
#    romdev_cov_set/get (out2 = [distinct,total]) for logPCRange.
#
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/src/arm/arm.c b/src/arm/arm.c
index 0b92d7f..550bdd7 100644
--- a/src/arm/arm.c
+++ b/src/arm/arm.c
@@ -9,6 +9,169 @@
 #include <mgba/internal/arm/isa-inlines.h>
 #include <mgba/internal/arm/isa-thumb.h>
 
+/* romdev PC BREAKPOINT / single-step (ARM7TDMI execute hook, in ARMRunLoop /
+ * ARMRun below). State is C globals exported from the libretro layer
+ * (libretro.c declares romdev_pcbreak_set/get). The host arms a breakpoint with
+ * runUntilPC, then after each retro_run frame polls romdev_pcbreak_get; once the
+ * `hit` flag is set it stops stepping, reads the registers (getCPUState), and
+ * disarms. `step` arms a one-instruction single-step (ignores addr).
+ *
+ * PC convention: we compare against the RAW gprs[ARM_PC] *as the executing
+ * instruction sees it* (= instr_addr + 2*instrLen — the classic ARM pipeline
+ * PC+8 / PC+4), which is the EXACT value the write watchpoint reports for
+ * gprs[ARM_PC]. So an address found via findWriter feeds straight into
+ * runUntilPC. At the top of an ARMRunLoop iteration (before the step advances
+ * the PC), gprs[ARM_PC] already points one word ahead of the prefetched
+ * instruction, so that "in-execution" PC == gprs[ARM_PC] + WORD_SIZE.
+ *
+ * On a hit we DO NOT execute the instruction (PC frozen exactly at the
+ * breakpoint), but we must still let the libretro frame loop COMPLETE or it
+ * re-calls the CPU forever (frozen CPU → no frame → infinite hang). See
+ * romdev_end_frame() below: it consumes a whole frame's worth of cycles and
+ * runs the timing/event handler once, which trips _GBACoreRunFrame's time guard
+ * (and fires the VBlank that bumps the frame counter) so retro_run returns. */
+unsigned int      romdev_pc_addr     = 0;
+int               romdev_pc_enabled  = 0;
+volatile int      romdev_pc_step     = 0;        /* per-instruction countdown; 2 = run one instr then stop */
+volatile int      romdev_pc_hit      = 0;        /* set by the hook, cleared by the host */
+unsigned int      romdev_pc_last_pc  = 0xFFFFFFFF;
+unsigned int      romdev_pc_hits     = 0;
+
+/* One GBA video frame is VIDEO_TOTAL_LENGTH (280896) master cycles; we don't
+ * include the GBA headers here (arm.c is the generic ARM core), so use a value
+ * comfortably larger so _GBACoreRunFrame's "currentTime - startCycle < frame"
+ * guard is guaranteed to trip after a single end-frame. */
+#define ROMDEV_FRAME_CYCLES 300000
+
+/* End the current frame after a breakpoint hit WITHOUT executing anything AND
+ * WITHOUT moving the CPU's PC.
+ *
+ * mTimingCurrentTime() == masterCycles + cpu->cycles, and _GBACoreRunFrame's
+ * outer loop exits when (currentTime - startCycle) >= one frame. So bumping
+ * cpu->cycles by a full frame makes that time guard trip the instant ARMRunLoop
+ * returns — the frame loop ends and retro_run returns.
+ *
+ * CRITICAL: we deliberately DO NOT call cpu->irqh.processEvents() here. That
+ * handler flushes pending timing events, and the GBA VBlank that fires raises an
+ * IRQ (ARMRaiseIRQ) which REWRITES gprs[ARM_PC] to the IRQ vector (0x18) — i.e.
+ * it would un-freeze the breakpoint PC. By only advancing the relative cycle
+ * counter we leave the entire CPU state (PC, mode, banked regs) untouched at the
+ * breakpoint, so gba_cpu_regs / getCPUState read the exact frozen PC. The
+ * inflated cycle count is harmless: the next _GBACoreRunFrame reads its own
+ * startCycle from the same (advanced) clock, and the host disarms immediately
+ * after the hit. */
+static void romdev_end_frame(struct ARMCore* cpu) {
+	cpu->cycles += ROMDEV_FRAME_CYCLES;
+}
+
+/* Returns nonzero if a breakpoint/single-step fired for the instruction about
+ * to execute at raw PC `pcRaw`. On a hit it records the PC and arms the hit
+ * flag. The single-step countdown is decremented here once per dispatched
+ * instruction so that arming step=2 lets EXACTLY ONE instruction run before the
+ * stop fires (true single-step that ADVANCES the PC — not a re-stop on the same
+ * un-executed instruction). Gated on !romdev_pc_hit so it fires once. */
+static inline int romdev_pcbreak_check(unsigned int pcRaw) {
+	if (romdev_pc_hit) {
+		return 0;
+	}
+	if (!romdev_pc_enabled && !romdev_pc_step) {
+		return 0;
+	}
+	int stepFire = 0;
+	if (romdev_pc_step) {
+		if (--romdev_pc_step <= 0) {
+			stepFire = 1;
+		}
+	}
+	if (stepFire || ((romdev_pc_enabled && !romdev_pc_step) && pcRaw == romdev_pc_addr)) {
+		romdev_pc_last_pc = pcRaw;
+		romdev_pc_hit = 1;
+		romdev_pc_hits++;
+		romdev_pc_step = 0; /* one-shot */
+		return 1;
+	}
+	return 0;
+}
+
+/* romdev PC COVERAGE log (discovery, ARM7TDMI): record DISTINCT PCs executed
+ * within an address window [lo,hi] over a run — "what code runs here?". The
+ * execute-loop hook (in ARMRunLoop / ARMRun below) calls romdev_cov_check with
+ * the in-execution raw PC == gprs[ARM_PC] + WORD_SIZE — the SAME value the PC
+ * breakpoint uses, so coverage PCs line up with runUntilPC. Linear de-dup
+ * against the stored set (cheap for the small windows this targets). State is C
+ * globals exported from the libretro layer (romdev_cov_set/get). */
+#define ROMDEV_COV_CAP 8192
+int           romdev_cov_enabled = 0;
+unsigned int  romdev_cov_lo      = 0;
+unsigned int  romdev_cov_hi      = 0;
+unsigned int  romdev_cov_pcs[ROMDEV_COV_CAP];
+unsigned int  romdev_cov_count   = 0;       /* distinct PCs stored (<= CAP) */
+unsigned int  romdev_cov_total   = 0;       /* total in-range dispatches seen */
+
+/* Record a distinct in-window PC for the coverage log. */
+void romdev_cov_log(unsigned int pc) {
+	unsigned int i;
+	romdev_cov_total++;
+	for (i = 0; i < romdev_cov_count; i++) if (romdev_cov_pcs[i] == pc) return;
+	if (romdev_cov_count < ROMDEV_COV_CAP) romdev_cov_pcs[romdev_cov_count++] = pc;
+}
+
+/* Coverage hook for the run loops: if armed and the about-to-execute PC is in
+ * [lo,hi], log it. Cheap when disabled (one int test). */
+static inline void romdev_cov_check(unsigned int pcRaw) {
+	if (romdev_cov_enabled && pcRaw >= romdev_cov_lo && pcRaw <= romdev_cov_hi) {
+		romdev_cov_log(pcRaw);
+	}
+}
+
+/* romdev register read/write (ARM7TDMI) — the inverse of getCPUState, used by the
+ * host's setRegister / callSubroutine. romdev ARM reg-id convention (STABLE):
+ * 0..15 = r0..r15 (so 13=SP/r13, 14=LR/r14, 15=PC/r15), 16 = CPSR. Maps onto
+ * mgba's cpu->gprs[n] and cpu->cpsr.packed. Defined here (not libretro.c) so the
+ * pipeline-reload inlines (ARMWritePC/ThumbWritePC) and ARM_PC/executionMode are
+ * in scope; libretro.c calls these passing (struct ARMCore*)core->cpu.
+ *
+ * Setting r15 (PC) is special: the ARM7 prefetches two instructions, so just
+ * stomping gprs[ARM_PC] would NOT change what executes (the already-fetched
+ * prefetch[0]/[1] would run, then PC would diverge). We replicate EXACTLY what
+ * mgba itself does on any PC redirect (see ARMRaiseUndefined / BX): write the
+ * TARGET instruction address into gprs[ARM_PC], then call ARMWritePC (ARM) /
+ * ThumbWritePC (Thumb) for the CURRENT execution mode, which reloads
+ * prefetch[0]/[1] from that address and advances gprs[ARM_PC] one word so the
+ * next step's prefetch[0] holds the instruction AT the requested address. So the
+ * caller passes the real instruction address it wants to run; execution
+ * continues from there. Returns 0 on success, -1 on an unknown id. */
+int romdev_arm_setreg(struct ARMCore* cpu, int regId, unsigned int value) {
+	if (regId >= 0 && regId <= 14) {
+		cpu->gprs[regId] = (int32_t) value;
+		return 0;
+	}
+	if (regId == 15) {            /* r15 / PC — reload the pipeline so it executes */
+		cpu->gprs[ARM_PC] = (int32_t) value;
+		if (cpu->executionMode == MODE_THUMB) {
+			cpu->cycles += ThumbWritePC(cpu);
+		} else {
+			cpu->cycles += ARMWritePC(cpu);
+		}
+		return 0;
+	}
+	if (regId == 16) {            /* CPSR */
+		cpu->cpsr.packed = value;
+		return 0;
+	}
+	return -1;
+}
+
+unsigned int romdev_arm_getreg(struct ARMCore* cpu, int regId) {
+	if (regId >= 0 && regId <= 15) {
+		return (unsigned int) cpu->gprs[regId];
+	}
+	if (regId == 16) {
+		return (unsigned int) cpu->cpsr.packed;
+	}
+	return 0;
+}
+
 void ARMSetPrivilegeMode(struct ARMCore* cpu, enum PrivilegeMode mode) {
 	if (mode == cpu->privilegeMode) {
 		// Not switching modes after all
@@ -230,6 +393,23 @@ void ARMRun(struct ARMCore* cpu) {
 	while (cpu->cycles >= cpu->nextEvent) {
 		cpu->irqh.processEvents(cpu);
 	}
+	/* romdev coverage + breakpoint hook (single-step path). Same convention as
+	 * ARMRunLoop: compare the in-execution raw PC (gprs[ARM_PC] + WORD_SIZE). On a
+	 * breakpoint hit freeze the PC and end the frame instead of stepping. */
+	{
+		unsigned int width = (cpu->executionMode == MODE_THUMB) ? WORD_SIZE_THUMB : WORD_SIZE_ARM;
+		romdev_cov_check(cpu->gprs[ARM_PC] + width);
+	}
+	if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit) {
+		unsigned int width = (cpu->executionMode == MODE_THUMB) ? WORD_SIZE_THUMB : WORD_SIZE_ARM;
+		if (romdev_pcbreak_check(cpu->gprs[ARM_PC] + width)) {
+			romdev_end_frame(cpu);
+			return;
+		}
+	} else if (romdev_pc_hit) {
+		romdev_end_frame(cpu);
+		return;
+	}
 	if (cpu->executionMode == MODE_THUMB) {
 		ThumbStep(cpu);
 	} else {
@@ -241,12 +421,62 @@ void ARMRun(struct ARMCore* cpu) {
 }
 
 void ARMRunLoop(struct ARMCore* cpu) {
+	/* romdev breakpoint/coverage fast-path bypass: when nothing is armed (no PC
+	 * breakpoint, no single-step, no coverage log), run the stock tight loops
+	 * untouched (zero overhead on the hot path). Coverage gates the fast path too
+	 * so its per-instruction hook below actually runs when armed. */
+	if (!romdev_pc_enabled && !romdev_pc_step && !romdev_pc_hit && !romdev_cov_enabled) {
+		if (cpu->executionMode == MODE_THUMB) {
+			while (cpu->cycles < cpu->nextEvent) {
+				ThumbStep(cpu);
+			}
+		} else {
+			while (cpu->cycles < cpu->nextEvent) {
+				ARMStep(cpu);
+			}
+		}
+		cpu->irqh.processEvents(cpu);
+		return;
+	}
+
+	/* romdev breakpoint-armed path. Before each step, `gprs[ARM_PC]` points one
+	 * instruction-word ahead of the prefetched (about-to-execute) instruction,
+	 * so the in-execution raw PC == gprs[ARM_PC] + WORD_SIZE — the same value the
+	 * write watchpoint reports. On a hit we DO NOT step (PC frozen at the
+	 * breakpoint) and end the frame so retro_run returns; the host then disarms.
+	 * If a hit was already latched (host hasn't disarmed yet), end the frame
+	 * immediately so we never spin. */
+	if (romdev_pc_hit) {
+		romdev_end_frame(cpu);
+		return;
+	}
+	/* A prior breakpoint's romdev_end_frame() inflated cpu->cycles past
+	 * cpu->nextEvent to trip the frame loop's time guard without firing events
+	 * (so the frozen PC wasn't clobbered by a VBlank IRQ). We're now starting a
+	 * FRESH armed run (e.g. single-step right after a hit), so flush those
+	 * pending events first — exactly like ARMRun/ARMRunLoop's normal tail — so
+	 * the step loop's `cpu->cycles < cpu->nextEvent` precondition holds and the
+	 * step countdown actually advances. We are NOT at a breakpoint here, so an
+	 * IRQ raised during the flush is normal, expected CPU behavior. */
+	while (cpu->cycles >= cpu->nextEvent) {
+		cpu->irqh.processEvents(cpu);
+	}
 	if (cpu->executionMode == MODE_THUMB) {
 		while (cpu->cycles < cpu->nextEvent) {
+			romdev_cov_check(cpu->gprs[ARM_PC] + WORD_SIZE_THUMB);
+			if (romdev_pcbreak_check(cpu->gprs[ARM_PC] + WORD_SIZE_THUMB)) {
+				romdev_end_frame(cpu);
+				return;
+			}
 			ThumbStep(cpu);
 		}
 	} else {
 		while (cpu->cycles < cpu->nextEvent) {
+			romdev_cov_check(cpu->gprs[ARM_PC] + WORD_SIZE_ARM);
+			if (romdev_pcbreak_check(cpu->gprs[ARM_PC] + WORD_SIZE_ARM)) {
+				romdev_end_frame(cpu);
+				return;
+			}
 			ARMStep(cpu);
 		}
 	}
diff --git a/src/gba/memory.c b/src/gba/memory.c
index 27e289c..15f3b3c 100644
--- a/src/gba/memory.c
+++ b/src/gba/memory.c
@@ -18,6 +18,85 @@
 #include <mgba-util/memory.h>
 #include <mgba-util/vfs.h>
 
+/* romdev instruction-level write watchpoint (GBA, ARM7TDMI). The GBAStore8/16/32
+ * functions are the CPU write path; cpu->gprs[ARM_PC] is the program counter.
+ * Records the writing PC when a watched address is written. C globals; exported
+ * from the libretro layer. NOTE: the ARM PC reflects pipeline prefetch (the
+ * executing instruction is PC-8 in ARM / PC-4 in Thumb) — the watchpoint reports
+ * the raw gprs[ARM_PC]; disassemble a couple instructions before it. GBA is a
+ * flat 32-bit address space, so no bank field. */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+#define ROMDEV_WP_GBA(cpu, addr, val) do { \
+		if (romdev_wp_enabled && (unsigned int)(addr) == romdev_wp_addr) { \
+			romdev_wp_last_pc = (cpu)->gprs[ARM_PC]; romdev_wp_last_val = (unsigned char)(val); romdev_wp_hits++; \
+		} \
+	} while (0)
+
+/* romdev instruction-level READ watchpoint (GBA, ARM7TDMI) — mirror of the write
+ * watch above. The GBALoad8/16/32 functions are the CPU data-read path; this
+ * records the reading instruction's PC (raw gprs[ARM_PC], same pipeline-prefetch
+ * convention as the write watch) and the value read. Gated on a real CPU access
+ * (cycleCounter != NULL) so an internal helper read — e.g. GBALoad16 calling
+ * GBALoad8 with cycleCounter==0 for SRAM mirroring — does not double-fire. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+#define ROMDEV_RD_GBA(cpu, addr, val, cc) do { \
+		if (romdev_rd_enabled && (cc) && (unsigned int)(addr) == romdev_rd_addr) { \
+			romdev_rd_last_pc = (cpu)->gprs[ARM_PC]; romdev_rd_last_val = (unsigned char)(val); romdev_rd_hits++; \
+		} \
+	} while (0)
+
+/* romdev RANGE watch (discovery, GBA ARM7TDMI): log EVERY {pc,addr,value} that
+ * reads or writes an address in [lo,hi] over a window — not stop-on-first.
+ * Hooked into the same CPU data paths as the single-address read/write watches
+ * (GBALoad8/16/32 for reads w=0, GBAStore8/16/32 for writes w=1). Ring buffer;
+ * the host drains it via romdev_range_get. The pc recorded is the raw
+ * cpu->gprs[ARM_PC] — the SAME pipeline-prefetched value the read/write
+ * watchpoints report, so range PCs are consistent with findWriter/runUntilRead.
+ * Gated on a real CPU access (cycleCounter != NULL) like the read watch so an
+ * internal helper read doesn't double-fire. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* Append one range-watch event (called from the load/store hooks via the macro
+ * ROMDEV_RANGE_GBA below). */
+void romdev_range_log(unsigned int pc, unsigned int addr, unsigned char val) {
+	romdev_range_count++;
+	if (romdev_range_stored < ROMDEV_RANGE_CAP) {
+		romdev_range_pc  [romdev_range_stored] = pc;
+		romdev_range_addr[romdev_range_stored] = addr;
+		romdev_range_val [romdev_range_stored] = val;
+		romdev_range_stored++;
+	}
+}
+
+/* romdev RANGE watch hook macro for the GBA load/store paths. `w` is 1 for a
+ * write, 0 for a read; romdev_range_mode 1=read 2=write 3=both. `cc` is the
+ * cycleCounter (NULL for internal helper accesses — skipped). pc is the raw
+ * gprs[ARM_PC], the same value the single-address watches report. Cheap when
+ * disabled (one int test). */
+#define ROMDEV_RANGE_GBA(cpu, a, v, w, cc) do { \
+		if (romdev_range_enabled && (cc) && (romdev_range_mode & ((w) ? 2 : 1)) \
+		    && (unsigned int)(a) >= romdev_range_lo && (unsigned int)(a) <= romdev_range_hi) { \
+			romdev_range_log((cpu)->gprs[ARM_PC], (unsigned int)(a), (unsigned char)(v)); \
+		} \
+	} while (0)
+
 #define IDLE_LOOP_THRESHOLD 10000
 
 mLOG_DEFINE_CATEGORY(GBA_MEM, "GBA Memory", "gba.memory");
