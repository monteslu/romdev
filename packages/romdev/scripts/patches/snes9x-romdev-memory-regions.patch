+			 * arms to 2 = "let ONE instruction execute, then stop" — so the step
+			 * ADVANCES the PC instead of re-stopping on the current (un-executed)
+			 * instruction. A plain breakpoint (step==0) matches the bank+addr. */
+			int stepFire = 0;
+			if (romdev_pc_step) { if (--romdev_pc_step <= 0) stepFire = 1; }
+			if (stepFire || ((romdev_pc_enabled && !romdev_pc_step)
