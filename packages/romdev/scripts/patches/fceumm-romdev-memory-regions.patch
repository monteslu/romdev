+/* romdev instruction-level write watchpoint. Set an address to watch; the next
+ * CPU write to it records the WRITING instruction's PC (not a frame-boundary
+ * sample), the value, and a hit count. romdev_watchpoint_get fills a small
+ * uint32 array [enabled, addr, lastPC, lastVal, hits]; pass clearHits!=0 to
+ * reset the hit counter + lastPC after reading. Defined in x6502.c. */
+extern uint32_t romdev_wp_addr;
+extern int      romdev_wp_enabled;
+extern uint32_t romdev_wp_last_pc;
+extern uint8_t  romdev_wp_last_val;
+extern uint32_t romdev_wp_hits;
+
+void romdev_watchpoint_set(uint32_t addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+extern uint8_t *romdev_wp_last_pc_ptr; /* host ptr of the writing PC (x6502.c) */
+
+/* Fills out6: [enabled, addr, lastPC, lastVal, hits, prgOffset]. prgOffset is the
+ * ABSOLUTE PRG-ROM file offset of the writing instruction (0xFFFFFFFF if the PC
+ * was in RAM or unmapped) — it disambiguates the BANK for a $8000-$BFFF PC on a
+ * banked mapper. Derived from the page pointer captured live at the write. */
+void romdev_watchpoint_get(uint32_t *out6, int clearHits)
+{
+   uint32_t prgOff = 0xFFFFFFFF;
+   if (!out6) return;
+   if (romdev_wp_last_pc_ptr) {
+      int c;
+      for (c = 0; c < 16; c++) {
+         if (PRGptr[c] && PRGsize[c]) {
+            ptrdiff_t d = romdev_wp_last_pc_ptr - PRGptr[c];
+            if (d >= 0 && (uint32_t)d < PRGsize[c]) { prgOff = (uint32_t)d; break; }
+         }
+      }
+   }
+   out6[0] = (uint32_t)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (uint32_t)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = prgOff;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; romdev_wp_last_pc_ptr = 0; }
+}
+
+/* romdev READ watchpoint (6502) — symmetric to the write watch above. Records
+ * the 6502 PC of the instruction that READ a watched address (hooked in
+ * RdMemNorm / RdRAMFast in x6502.c, the mirror of the write hook). */
+extern uint32_t romdev_rd_addr;
+extern int      romdev_rd_enabled;
+extern uint32_t romdev_rd_last_pc;
+extern uint8_t  romdev_rd_last_val;
+extern uint32_t romdev_rd_hits;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (6502 execute hook in x6502.c:X6502_Run). The core
+ * freezes the CPU exactly at the breakpoint PC (BEFORE that instruction
+ * executes) by draining the cycle budget; the host polls romdev_pcbreak_get
+ * after each retro_run frame, stops stepping once hit is set, then reads the
+ * registers via getCPUState. `step` arms a one-instruction single-step (ignores
+ * addr). NOTE: the 6502 PC is the raw 16-bit address — a $8000-$BFFF target is
+ * BANK-AMBIGUOUS on banked mappers (the break fires whichever bank is paged in
+ * with that PC). The host's 5-word out array has no prgOffset slot (that's the
+ * core-agnostic contract); combine with the write-watchpoint prgOffset to
+ * disambiguate the bank if needed. */
+extern uint32_t romdev_pc_addr;
+extern int      romdev_pc_enabled;
+extern int      romdev_pc_step;
+extern volatile int romdev_pc_hit;
+extern uint32_t romdev_pc_last_pc;
+extern uint32_t romdev_pc_hits;
+
+extern unsigned int  romdev_pc_wd_limit;
+extern unsigned int  romdev_pc_wd_count;
+extern int           romdev_pc_watchdog;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+   romdev_pc_watchdog = 0;
+   romdev_pc_wd_count = 0;
+}
+
+/* Fills out6: [enabled, addr, hit, lastPC, hits, watchdogTripped]. clearHit re-arms. */
+void romdev_pcbreak_get(unsigned int *out6, int clearHit)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_pc_enabled;
+   out6[1] = romdev_pc_addr;
+   out6[2] = (unsigned int)romdev_pc_hit;
+   out6[3] = romdev_pc_last_pc;
+   out6[4] = romdev_pc_hits;
+   out6[5] = (unsigned int)romdev_pc_watchdog;
+   if (clearHit) { romdev_pc_hit = 0; romdev_pc_watchdog = 0; romdev_pc_wd_count = 0; }
+}
+
+/* Arm the instruction watchdog (force-stop a runaway after `limit` instructions;
+ * 0 = disable). The host sets this before driving callSubroutine so a runaway
+ * routine returns control instead of hanging. */
+void romdev_watchdog_set(unsigned int limit)
+{
+   romdev_pc_wd_limit = limit;
+   romdev_pc_wd_count = 0;
+   romdev_pc_watchdog = 0;
+}
+
+/* romdev register read/write — the inverse of getCPUState, used by the host's
+ * callSubroutine / setRegister (set A/X/Y/PC, push a sentinel return, run to it,
+ * capture the output). romdev 6502 reg-id convention (STABLE across all cores so
+ * the host passes the same ids): 0=A, 1=X, 2=Y, 3=P(status), 4=SP, 16=PC. Maps
+ * onto fceumm's X6502 struct (X.A/X.X/X.Y/X.P/X.S/X.PC). Returns 0 on success,
+ * -1 on an unknown id from setreg; getreg returns the value (0 for unknown). The
+ * NES PC is a flat 16-bit address (no bank arg) — fine for RE; the write-watch
+ * reports prgOffset separately if the bank matters. */
+int romdev_setreg(int regId, unsigned int value)
+{
+   switch (regId) {
+      case 0:  X.A  = (uint8_t)value;  return 0;  /* A */
+      case 1:  X.X  = (uint8_t)value;  return 0;  /* X */
+      case 2:  X.Y  = (uint8_t)value;  return 0;  /* Y */
+      case 3:  X.P  = (uint8_t)value;  return 0;  /* P (status) */
+      case 4:  X.S  = (uint8_t)value;  return 0;  /* SP */
+      case 16: X.PC = (uint16_t)value; return 0;  /* PC */
+      default: return -1;
+   }
+}
+
+unsigned int romdev_getreg(int regId)
+{
+   switch (regId) {
+      case 0:  return (unsigned int)X.A;
+      case 1:  return (unsigned int)X.X;
+      case 2:  return (unsigned int)X.Y;
+      case 3:  return (unsigned int)X.P;
+      case 4:  return (unsigned int)X.S;
+      case 16: return (unsigned int)X.PC;
+      default: return 0;
+   }
+}
+
+/* romdev RANGE watch (discovery) — log every read/write in [lo,hi]. mode: 1=read
+ * 2=write 3=both. Arm clears the buffer. State + the read/write hooks live in
+ * x6502.c (ROMDEV_RANGE_6502). */
+extern unsigned int  romdev_range_lo, romdev_range_hi;
+extern int           romdev_range_enabled, romdev_range_mode;
+extern unsigned int  romdev_range_pc[], romdev_range_addr[];
+extern unsigned char romdev_range_val[];
+extern unsigned int  romdev_range_count, romdev_range_stored;
+
+void romdev_range_set(unsigned int lo, unsigned int hi, int mode, int enabled)
+{
+   romdev_range_lo = lo; romdev_range_hi = hi;
+   romdev_range_mode = mode ? mode : 3;
+   romdev_range_enabled = enabled ? 1 : 0;
+   romdev_range_count = 0; romdev_range_stored = 0;
+}
+
+/* Drain up to `max` events into out[] as packed triples [pc,addr,val,...]
+ * (val in the low byte of its uint32 slot). Returns events written. out2 (size 2)
+ * gets [totalSeen, stored] so the caller knows if the ring overflowed. */
+unsigned int romdev_range_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_range_stored;
+   if (out2) { out2[0] = romdev_range_count; out2[1] = romdev_range_stored; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) {
+      out[i*3 + 0] = romdev_range_pc[i];
+      out[i*3 + 1] = romdev_range_addr[i];
+      out[i*3 + 2] = (unsigned int)romdev_range_val[i];
+   }
+   return n;
+}
+
+/* romdev PC COVERAGE log (discovery) — distinct in-window PCs over a run. State +
+ * the execute-loop hook live in x6502.c. */
+extern int           romdev_cov_enabled;
+extern unsigned int  romdev_cov_lo, romdev_cov_hi;
+extern unsigned int  romdev_cov_pcs[], romdev_cov_count, romdev_cov_total;
+
+void romdev_cov_set(unsigned int lo, unsigned int hi, int enabled)
+{
+   romdev_cov_lo = lo; romdev_cov_hi = hi;
+   romdev_cov_enabled = enabled ? 1 : 0;
+   romdev_cov_count = 0; romdev_cov_total = 0;
+}
+
+/* Copy up to `max` distinct PCs into out[]. out2 (size 2) gets [distinct,total]. */
+unsigned int romdev_cov_get(unsigned int *out, unsigned int max, unsigned int *out2)
+{
+   unsigned int i, n = romdev_cov_count;
+   if (out2) { out2[0] = romdev_cov_count; out2[1] = romdev_cov_total; }
+   if (!out) return 0;
+   if (n > max) n = max;
+   for (i = 0; i < n; i++) out[i] = romdev_cov_pcs[i];
+   return n;
+}
+
+/* rom-dev-mcp extension: custom memory region IDs above libretro standard.
+ * Lets the host inspect NES PPU + APU state for agent-driven dev workflows.
+ * IDs mirror those used by snes9x/gpgx patches (same project). */
+#define ROMDEV_MEMORY_NES_NAMETABLES 0x100  /* 2KB NTARAM (CIRAM) */
+#define ROMDEV_MEMORY_NES_PALETTE    0x101  /* 32B PALRAM */
+#define ROMDEV_MEMORY_NES_OAM        0x102  /* 256B SPRAM */
+#define ROMDEV_MEMORY_NES_CHR        0x103  /* 8KB CHR via VPage[0..7] */
+#define ROMDEV_MEMORY_NES_APU_REGS   0x104  /* 24B synthesized APU register snapshot ($4000-$4017) */
+#define ROMDEV_MEMORY_NES_CPU_REGS   0x105  /* sizeof(X6502) — live 6502 CPU struct snapshot */
+#define ROMDEV_MEMORY_NES_PPU_REGS   0x106  /* 4B PPU latch — PPUCTRL/PPUMASK/PPUSTATUS/OAMADDR */
+
+static uint8_t romdev_chr_buf[8192];
+static uint8_t romdev_apu_buf[24];
+static uint8_t romdev_cpu_buf[sizeof(X6502)];
+
+/* Synthesize the 24-byte APU register file from fceumm's scattered
+ * register-holder vars. Layout matches the NES APU register map at
+ * CPU $4000-$4017. */
+static void romdev_apu_snapshot(uint8_t *buf) {
+   int i;
+   for (i = 0; i < 16; i++) buf[i] = PSG[i];
+   buf[0x10] = DMCFormat;
+   buf[0x11] = RawDALatch;
+   buf[0x12] = DMCAddressLatch;
+   buf[0x13] = DMCSizeLatch;
+   buf[0x14] = 0;
+   buf[0x15] = EnabledChannels;
+   buf[0x16] = 0;
+   buf[0x17] = IRQFrameMode;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
    uint8_t* data;
@@ -3965,6 +4235,56 @@ void *retro_get_memory_data(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          data = RAM;
          break;
+      case ROMDEV_MEMORY_NES_NAMETABLES:
+         data = NTARAM;
+         break;
+      case ROMDEV_MEMORY_NES_PALETTE:
+         data = PALRAM;
+         break;
+      case ROMDEV_MEMORY_NES_OAM:
+         data = SPRAM;
+         break;
+      case ROMDEV_MEMORY_NES_CHR:
+         {
+            int i;
+            /* R61: VPage[i] is the PPU's lookup pointer for the i-th
+             * 1KB slot of pattern memory ($0000-$1FFF). To get the
+             * actual bytes at PPU address `i*$400 .. i*$400+$3FF`,
+             * you index it AS the PPU does: VPage[i] + (i * $400).
+             *
+             * Why: fceumm stores VPage[i] differently depending on the
+             * mapper. setchr8 (NROM, full 8KB single bank): all eight
+             * VPage[i] point to the same 8KB base — reading `VPage[i]+0`
+             * gives the first 1KB regardless of i. setchr1 (per-1KB
+             * mappers like MMC3): VPage[i] = `bank_start - i*$400` so
+             * that PPU reads `VPage[i][ppu_addr]` resolve correctly,
+             * but reading `VPage[i]+0` is a pointer BEFORE valid
+             * memory. Either way, `VPage[i] + i*$400` is what the PPU
+             * itself dereferences for that slot's pattern data.
+             *
+             * R59 attempted to "fix" this by removing the `+ i*$400`,
+             * which collapsed NROM's 8KB readback into 8 copies of the
+             * first 1KB (so `readMemory(nes_chr, $1010)` returned the
+             * same bytes as `$0010`) and read garbage from setchr1
+             * mappers. R61 restores the original PPU-index math. */
+            for (i = 0; i < 8; i++) {
+               if (VPage[i]) memcpy(romdev_chr_buf + i * 1024, VPage[i] + i * 1024, 1024);
+               else memset(romdev_chr_buf + i * 1024, 0, 1024);
+            }
+            data = romdev_chr_buf;
+         }
+         break;
+      case ROMDEV_MEMORY_NES_APU_REGS:
+         romdev_apu_snapshot(romdev_apu_buf);
+         data = romdev_apu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_CPU_REGS:
+         memcpy(romdev_cpu_buf, &X, sizeof(X6502));
+         data = romdev_cpu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_PPU_REGS:
+         data = PPU;
+         break;
       default:
          data = NULL;
          break;
@@ -3992,6 +4312,13 @@ size_t retro_get_memory_size(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          size = 0x800;
          break;
+      case ROMDEV_MEMORY_NES_NAMETABLES: size = 0x800; break;
+      case ROMDEV_MEMORY_NES_PALETTE:    size = 0x20;  break;
+      case ROMDEV_MEMORY_NES_OAM:        size = 0x100; break;
+      case ROMDEV_MEMORY_NES_CHR:        size = 8192;  break;
+      case ROMDEV_MEMORY_NES_APU_REGS:   size = 24;    break;
+      case ROMDEV_MEMORY_NES_CPU_REGS:   size = sizeof(X6502); break;
+      case ROMDEV_MEMORY_NES_PPU_REGS:   size = 4;     break;
       default:
          size = 0;
          break;
