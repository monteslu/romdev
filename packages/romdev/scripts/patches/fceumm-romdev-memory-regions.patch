+/* romdev watchpoint: instruction-level write watch. When enabled, any CPU write
+ * to romdev_wp_addr records the WRITING instruction's PC (X.PC is synced to the
+ * current opcode before its memory writes execute), the value, and a hit count.
+ * Exposed to the host via romdev_watchpoint_* in libretro.c. */
+uint32_t romdev_wp_addr     = 0;
+int      romdev_wp_enabled  = 0;
+uint32_t romdev_wp_last_pc  = 0xFFFFFFFF;
+uint8_t  romdev_wp_last_val = 0;
+uint32_t romdev_wp_hits     = 0;
+/* The host pointer of the PC's 2KB page at write time. Page[A>>11] is
+ * (host_ptr - A_base), so Page[PC>>11] + PC is the live host address of the
+ * writing instruction — libretro.c converts it to an absolute PRG-ROM offset
+ * (hence the active BANK) so a $8000-$BFFF PC isn't bank-ambiguous on a banked
+ * mapper. Captured here because X.PC reflects the bank live at the write. */
+extern uint8_t *Page[32];
+uint8_t *romdev_wp_last_pc_ptr = 0;
+
+/* romdev instruction-level READ watchpoint (mirror of the write watch above).
+ * When enabled, any CPU data read of romdev_rd_addr records the READING
+ * instruction's PC (X.PC, synced to the current opcode before its memory reads
+ * execute), the value read, and a hit count. Hooked into the two data-read
+ * paths (RdMemNorm / RdRAMFast) — the exact mirror of the write hook in
+ * WrMemNorm / WrRAMFast. Exported via romdev_readwatch_* in libretro.c. */
+uint32_t romdev_rd_addr     = 0;
+int      romdev_rd_enabled  = 0;
+uint32_t romdev_rd_last_pc  = 0xFFFFFFFF;
+uint8_t  romdev_rd_last_val = 0;
+uint32_t romdev_rd_hits     = 0;
+
+/* romdev PC BREAKPOINT (6502 execute hook in X6502_Run below). When enabled and
+ * the 6502 PC about to execute equals romdev_pc_addr, romdev_pc_hit is set and
+ * X6502_Run consumes the remaining cycle budget and breaks out of its loop so
+ * the CPU freezes EXACTLY at that PC (X.PC is synced first). The host polls
+ * romdev_pcbreak_get after each retro_run frame, stops stepping once hit is
+ * set, then reads the full register file via getCPUState. romdev_pc_step forces
+ * a one-instruction stop regardless of address (single-step). */
+uint32_t      romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;        /* 1 = stop after exactly one instruction */
+volatile int  romdev_pc_hit     = 0;        /* set by the execute hook, cleared by the host */
+uint32_t      romdev_pc_last_pc = 0xFFFFFFFF;
+uint32_t      romdev_pc_hits    = 0;
+
+/* romdev INSTRUCTION WATCHDOG — the fix for "callSubroutine hung". A standalone-
+ * driven routine (e.g. a decompressor fed a slightly-wrong pointer) can loop
+ * FOREVER inside a single X6502_Run / retro_run frame, so the host's per-FRAME
+ * maxFrames never gets a turn and the whole WASM hangs. This counts dispatched
+ * instructions and force-stops (sets romdev_pc_hit + romdev_pc_watchdog) when the
+ * budget is exceeded — so a runaway returns control with the final PC intact
+ * instead of hanging. romdev_pc_wd_limit 0 = disabled. */
+unsigned int  romdev_pc_wd_limit = 0;       /* max instructions before force-stop (0 = off) */
+unsigned int  romdev_pc_wd_count = 0;       /* instructions executed since arm */
+volatile int  romdev_pc_watchdog = 0;       /* set when the watchdog tripped */
+
+/* romdev RANGE watch (discovery): log EVERY {pc,addr,value} that reads or writes
+ * an address in [lo,hi] over a window — not stop-on-first. Hooked into the same
+ * read/write paths (RdMemNorm/RdRAMFast + WrMemNorm/WrRAMFast) as the single-
+ * address watch above. Ring buffer; the host drains it via romdev_range_get. The
+ * pc recorded is X.PC, the executing instruction. */
+#define ROMDEV_RANGE_CAP 4096
+unsigned int  romdev_range_lo      = 0;
+unsigned int  romdev_range_hi      = 0;
+int           romdev_range_enabled = 0;
+int           romdev_range_mode    = 0;     /* 1=read, 2=write, 3=both */
+unsigned int  romdev_range_pc  [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_addr[ROMDEV_RANGE_CAP];
+unsigned char romdev_range_val [ROMDEV_RANGE_CAP];
+unsigned int  romdev_range_count   = 0;     /* total events seen (may exceed CAP) */
+unsigned int  romdev_range_stored  = 0;     /* events actually stored (<= CAP) */
+
+/* romdev PC COVERAGE log (discovery): record DISTINCT PCs executed within an
+ * address window [lo,hi] over a run — "what code runs here?". Linear de-dup
+ * against the stored set (cheap for the small windows this targets). */
