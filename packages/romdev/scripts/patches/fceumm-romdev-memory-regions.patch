 void *retro_get_memory_data(unsigned type)
 {
    uint8_t* data;
@@ -3965,6 +4126,56 @@ void *retro_get_memory_data(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          data = RAM;
          break;
+      case ROMDEV_MEMORY_NES_NAMETABLES:
+         data = NTARAM;
+         break;
+      case ROMDEV_MEMORY_NES_PALETTE:
+         data = PALRAM;
+         break;
+      case ROMDEV_MEMORY_NES_OAM:
+         data = SPRAM;
+         break;
+      case ROMDEV_MEMORY_NES_CHR:
+         {
+            int i;
+            /* R61: VPage[i] is the PPU's lookup pointer for the i-th
+             * 1KB slot of pattern memory ($0000-$1FFF). To get the
+             * actual bytes at PPU address `i*$400 .. i*$400+$3FF`,
+             * you index it AS the PPU does: VPage[i] + (i * $400).
+             *
+             * Why: fceumm stores VPage[i] differently depending on the
+             * mapper. setchr8 (NROM, full 8KB single bank): all eight
+             * VPage[i] point to the same 8KB base — reading `VPage[i]+0`
+             * gives the first 1KB regardless of i. setchr1 (per-1KB
+             * mappers like MMC3): VPage[i] = `bank_start - i*$400` so
+             * that PPU reads `VPage[i][ppu_addr]` resolve correctly,
+             * but reading `VPage[i]+0` is a pointer BEFORE valid
+             * memory. Either way, `VPage[i] + i*$400` is what the PPU
+             * itself dereferences for that slot's pattern data.
+             *
+             * R59 attempted to "fix" this by removing the `+ i*$400`,
+             * which collapsed NROM's 8KB readback into 8 copies of the
+             * first 1KB (so `readMemory(nes_chr, $1010)` returned the
+             * same bytes as `$0010`) and read garbage from setchr1
+             * mappers. R61 restores the original PPU-index math. */
+            for (i = 0; i < 8; i++) {
+               if (VPage[i]) memcpy(romdev_chr_buf + i * 1024, VPage[i] + i * 1024, 1024);
+               else memset(romdev_chr_buf + i * 1024, 0, 1024);
+            }
+            data = romdev_chr_buf;
+         }
+         break;
+      case ROMDEV_MEMORY_NES_APU_REGS:
+         romdev_apu_snapshot(romdev_apu_buf);
+         data = romdev_apu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_CPU_REGS:
+         memcpy(romdev_cpu_buf, &X, sizeof(X6502));
+         data = romdev_cpu_buf;
+         break;
+      case ROMDEV_MEMORY_NES_PPU_REGS:
+         data = PPU;
+         break;
       default:
          data = NULL;
          break;
@@ -3992,6 +4203,13 @@ size_t retro_get_memory_size(unsigned type)
       case RETRO_MEMORY_SYSTEM_RAM:
          size = 0x800;
          break;
+      case ROMDEV_MEMORY_NES_NAMETABLES: size = 0x800; break;
+      case ROMDEV_MEMORY_NES_PALETTE:    size = 0x20;  break;
+      case ROMDEV_MEMORY_NES_OAM:        size = 0x100; break;
+      case ROMDEV_MEMORY_NES_CHR:        size = 8192;  break;
+      case ROMDEV_MEMORY_NES_APU_REGS:   size = 24;    break;
+      case ROMDEV_MEMORY_NES_CPU_REGS:   size = sizeof(X6502); break;
+      case ROMDEV_MEMORY_NES_PPU_REGS:   size = 4;     break;
       default:
          size = 0;
          break;
