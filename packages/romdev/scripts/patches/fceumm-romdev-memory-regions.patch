 static INLINE uint8_t RdMemNorm(uint32_t A) {
-	return(_DB = ARead[A](A));
+	uint8_t v = ARead[A](A);
+	if (romdev_rd_enabled && A == romdev_rd_addr) {
+		romdev_rd_last_pc = X.PC; romdev_rd_last_val = v; romdev_rd_hits++;
+	}
+	return(_DB = v);
 }
 
 static INLINE void WrMemNorm(uint32_t A, uint8_t V) {
+	if (romdev_wp_enabled && A == romdev_wp_addr) {
+		romdev_wp_last_pc = X.PC; romdev_wp_last_val = V; romdev_wp_hits++;
+		romdev_wp_last_pc_ptr = (X.PC >= 0x8000) ? Page[(X.PC >> 11) & 31] + X.PC : 0;
+	}
 	BWrite[A](A, V);
 }
 
 static INLINE uint8_t RdRAMFast(uint32_t A) {
+	if (romdev_rd_enabled && A == romdev_rd_addr) {
+		romdev_rd_last_pc = X.PC; romdev_rd_last_val = RAM[A]; romdev_rd_hits++;
+	}
 	return(_DB = RAM[A]);
 }
 
 static INLINE void WrRAMFast(uint32_t A, uint8_t V) {
+	if (romdev_wp_enabled && A == romdev_wp_addr) {
+		romdev_wp_last_pc = X.PC; romdev_wp_last_val = V; romdev_wp_hits++;
+		romdev_wp_last_pc_ptr = (X.PC >= 0x8000) ? Page[(X.PC >> 11) & 31] + X.PC : 0;
+	}
 	RAM[A] = V;
 }
 
