+/* romdev instruction-level write watchpoint (6502) — records sally_pc when a
+ * watched address is written (hook in core/Memory.c). State defined there. */
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+    romdev_wp_addr = addr;
+    romdev_wp_enabled = enabled ? 1 : 0;
+    romdev_wp_last_pc = 0xFFFFFFFF;
+    romdev_wp_last_val = 0;
+    romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out5, int clearHits)
+{
+    if (!out5) return;
+    out5[0] = (unsigned int)romdev_wp_enabled;
+    out5[1] = romdev_wp_addr;
+    out5[2] = romdev_wp_last_pc;
+    out5[3] = (unsigned int)romdev_wp_last_val;
+    out5[4] = romdev_wp_hits;
+    if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev READ watchpoint (6502) — symmetric to the write watch above. Records
+ * the 6502 PC of the instruction that READ a watched address (hooked in
+ * core/Memory.c:memory_Read, the mirror of the write hook). State defined there. */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+    romdev_rd_addr = addr;
+    romdev_rd_enabled = enabled ? 1 : 0;
+    romdev_rd_last_pc = 0xFFFFFFFF;
+    romdev_rd_last_val = 0;
+    romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+    if (!out5) return;
+    out5[0] = (unsigned int)romdev_rd_enabled;
+    out5[1] = romdev_rd_addr;
+    out5[2] = romdev_rd_last_pc;
+    out5[3] = (unsigned int)romdev_rd_last_val;
+    out5[4] = romdev_rd_hits;
+    if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (6502 execute hook in core/Sally.c:sally_ExecuteInstruction).
+ * Freezes the CPU exactly at the breakpoint PC; the host polls romdev_pcbreak_get
+ * after each retro_run frame, stops stepping once hit is set, then reads registers
+ * via getCPUState. `step` arms a one-instruction single-step (ignores addr). */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+    romdev_pc_addr = addr;
+    romdev_pc_enabled = enabled ? 1 : 0;
+    /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+     * before the stop fires (true single-step that advances the PC). */
+    romdev_pc_step = step ? 2 : 0;
+    romdev_pc_hit = 0;
+    romdev_pc_last_pc = 0xFFFFFFFF;
+    romdev_pc_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, hit, lastPC, hits]. Pass clearHit to re-arm. */
+void romdev_pcbreak_get(unsigned int *out5, int clearHit)
+{
+    if (!out5) return;
+    out5[0] = (unsigned int)romdev_pc_enabled;
+    out5[1] = romdev_pc_addr;
+    out5[2] = (unsigned int)romdev_pc_hit;
+    out5[3] = romdev_pc_last_pc;
+    out5[4] = romdev_pc_hits;
+    if (clearHit) { romdev_pc_hit = 0; }
+}
+
 unsigned retro_api_version(void)
 {
     return RETRO_API_VERSION;
 }
 
+/* rom-dev-mcp extension: custom region IDs above libretro standard.
+ * Lets the host inspect 7800 CPU state for the getCPUState tool.
+ * MARIA / TIA / ROM are all reachable via system_ram (memory_ram is the
+ * full 64KB 6502 address space — MARIA at $20-$3F, TIA audio at $15-$1A,
+ * RIOT-side at $280-$2FF, RAM at $1800-$27FF, ROM at $4000-$FFFF). */
+#define ROMDEV_MEMORY_A78_CPU_REGS 0x150  /* 7-byte 6502 snapshot */
+
+static unsigned char romdev_a78_cpu_buf[7];
+
 void *retro_get_memory_data(unsigned id)
 {
     if ( id == RETRO_MEMORY_SYSTEM_RAM )
         return memory_ram;
+    if ( id == ROMDEV_MEMORY_A78_CPU_REGS ) {
+        /* Layout: pc_lo, pc_hi, a, x, y, p, s */
+        romdev_a78_cpu_buf[0] = sally_pc.b.l;
+        romdev_a78_cpu_buf[1] = sally_pc.b.h;
+        romdev_a78_cpu_buf[2] = sally_a;
+        romdev_a78_cpu_buf[3] = sally_x;
+        romdev_a78_cpu_buf[4] = sally_y;
+        romdev_a78_cpu_buf[5] = sally_p;
+        romdev_a78_cpu_buf[6] = sally_s;
+        return romdev_a78_cpu_buf;
+    }
     return NULL;
 }
 
@@ -630,6 +744,8 @@ size_t retro_get_memory_size(unsigned id)
 {
     if ( id == RETRO_MEMORY_SYSTEM_RAM )
         return MEMORY_SIZE;
+    if ( id == ROMDEV_MEMORY_A78_CPU_REGS )
+        return sizeof(romdev_a78_cpu_buf);
     return 0;
 }
 
