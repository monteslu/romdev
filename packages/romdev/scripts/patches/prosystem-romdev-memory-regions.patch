# romdev patch — see README.md in this directory for full justification.
# Exposes this core's internal memory regions (VRAM/OAM/palette/registers/etc.)
# via retro_get_memory_data so romdev's inspect*/getCPUState/etc. tools can read
# them. Upstream exposes only SAVE_RAM/SYSTEM_RAM. WITHOUT this patch the build
# still succeeds but those tools return empty data (silent runtime failure).
# git apply ignores everything above the first 'diff --git' line.
#
# Also adds an instruction-level WRITE WATCHPOINT (6502): memory_Write in
# core/Memory.c records sally_pc when a watched address is written; libretro.c
# exports romdev_watchpoint_set/get.
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/core/Memory.c b/core/Memory.c
index cb12bd3..d72f295 100644
--- a/core/Memory.c
+++ b/core/Memory.c
@@ -30,6 +30,14 @@
 #include "Cartridge.h"
 #include "Tia.h"
 #include "Riot.h"
+#include "Sally.h"   /* for sally_pc (the 6502 PC) — romdev watchpoint */
+
+/* romdev instruction-level write watchpoint state (hook in memory_Write). */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
 
 uint8_t memory_ram[MEMORY_SIZE] = {0};
 uint8_t memory_rom[MEMORY_SIZE] = {0};
@@ -83,6 +91,9 @@ uint8_t memory_Read(uint16_t address)
 
 void memory_Write(uint16_t address, uint8_t data)
 {
+   if (romdev_wp_enabled && (unsigned int)address == romdev_wp_addr) {
+      romdev_wp_last_pc = sally_pc.w; romdev_wp_last_val = data; romdev_wp_hits++;
+   }
    if(!memory_rom[address])
    {
       switch(address)
diff --git a/core/libretro.c b/core/libretro.c
index 3e4dbdb..58d2d94 100644
--- a/core/libretro.c
+++ b/core/libretro.c
@@ -28,6 +28,7 @@
 #include "Tia.h"
 #include "Memory.h"
 #include "BupChip.h"
+#include "Sally.h"
 
 #ifdef _3DS
 extern void* linearMemAlign(size_t size, size_t alignment);
@@ -614,15 +615,63 @@ unsigned retro_get_region(void)
     return cartridge_region == REGION_NTSC ? RETRO_REGION_NTSC : RETRO_REGION_PAL;
 }
 
+/* romdev instruction-level write watchpoint (6502) — records sally_pc when a
+ * watched address is written (hook in core/Memory.c). State defined there. */
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+    romdev_wp_addr = addr;
+    romdev_wp_enabled = enabled ? 1 : 0;
+    romdev_wp_last_pc = 0xFFFFFFFF;
+    romdev_wp_last_val = 0;
+    romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out5, int clearHits)
+{
+    if (!out5) return;
+    out5[0] = (unsigned int)romdev_wp_enabled;
+    out5[1] = romdev_wp_addr;
+    out5[2] = romdev_wp_last_pc;
+    out5[3] = (unsigned int)romdev_wp_last_val;
+    out5[4] = romdev_wp_hits;
+    if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
 unsigned retro_api_version(void)
 {
     return RETRO_API_VERSION;
 }
 
+/* rom-dev-mcp extension: custom region IDs above libretro standard.
+ * Lets the host inspect 7800 CPU state for the getCPUState tool.
+ * MARIA / TIA / ROM are all reachable via system_ram (memory_ram is the
+ * full 64KB 6502 address space — MARIA at $20-$3F, TIA audio at $15-$1A,
+ * RIOT-side at $280-$2FF, RAM at $1800-$27FF, ROM at $4000-$FFFF). */
+#define ROMDEV_MEMORY_A78_CPU_REGS 0x150  /* 7-byte 6502 snapshot */
+
+static unsigned char romdev_a78_cpu_buf[7];
+
 void *retro_get_memory_data(unsigned id)
 {
     if ( id == RETRO_MEMORY_SYSTEM_RAM )
         return memory_ram;
+    if ( id == ROMDEV_MEMORY_A78_CPU_REGS ) {
+        /* Layout: pc_lo, pc_hi, a, x, y, p, s */
+        romdev_a78_cpu_buf[0] = sally_pc.b.l;
+        romdev_a78_cpu_buf[1] = sally_pc.b.h;
+        romdev_a78_cpu_buf[2] = sally_a;
+        romdev_a78_cpu_buf[3] = sally_x;
+        romdev_a78_cpu_buf[4] = sally_y;
+        romdev_a78_cpu_buf[5] = sally_p;
+        romdev_a78_cpu_buf[6] = sally_s;
+        return romdev_a78_cpu_buf;
+    }
     return NULL;
 }
 
@@ -630,6 +679,8 @@ size_t retro_get_memory_size(unsigned id)
 {
     if ( id == RETRO_MEMORY_SYSTEM_RAM )
         return MEMORY_SIZE;
+    if ( id == ROMDEV_MEMORY_A78_CPU_REGS )
+        return sizeof(romdev_a78_cpu_buf);
     return 0;
 }
 
