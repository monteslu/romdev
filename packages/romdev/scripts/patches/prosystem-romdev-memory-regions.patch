diff --git a/core/Sally.c b/core/Sally.c
index dede0ca..1f7944b 100644
--- a/core/Sally.c
+++ b/core/Sally.c
@@ -34,6 +34,25 @@ uint8_t sally_p = 0;
 uint8_t sally_s = 0;
 pair sally_pc = {0};
 
+/* romdev PC BREAKPOINT / single-step (6502 execute hook in
+ * sally_ExecuteInstruction below). When enabled and the 6502 PC about to
+ * execute (sally_pc.w, BEFORE the opcode fetch) equals romdev_pc_addr, the hook
+ * sets romdev_pc_hit and returns WITHOUT executing — the CPU is frozen exactly
+ * at that PC. prosystem_ExecuteFrame (core/ProSystem.c) sees the hit flag after
+ * each instruction and drains the remaining per-frame cycle budget so retro_run
+ * finishes (leaving the frame incomplete = infinite hang). The host polls
+ * romdev_pcbreak_get after each retro_run frame, stops stepping once hit is set,
+ * then reads the register file via getCPUState. romdev_pc_step arms a
+ * per-instruction countdown (host arms to 2 = "let ONE instruction execute,
+ * then stop") so single-step ADVANCES the PC instead of re-stopping on the
+ * current un-executed instruction. Exported via romdev_pcbreak_* in libretro.c. */
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;
+volatile int  romdev_pc_hit     = 0;
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+
 static uint8_t sally_opcode;
 static pair sally_address;
 static uint32_t sally_cycles;
@@ -754,6 +773,28 @@ void sally_Reset(void)
 
 uint32_t sally_ExecuteInstruction(void)
 {
+   /* romdev PC breakpoint / single-step: checked here, BEFORE the opcode fetch,
+    * so sally_pc.w is the address of the instruction about to execute. On a hit
+    * (or single-step countdown reaching 0) freeze the CPU at this PC: record it,
+    * set the hit flag, return WITHOUT executing or advancing PC, and report 0
+    * cycles. The frame loop drains the remaining cycle budget on the hit flag so
+    * retro_run still returns. Gated on !romdev_pc_hit so a held breakpoint
+    * doesn't re-fire while the host reads state and disarms. */
+   if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit)
+   {
+      int stepFire = 0;
+      if (romdev_pc_step) { if (--romdev_pc_step <= 0) stepFire = 1; }
+      if (stepFire || ((romdev_pc_enabled && !romdev_pc_step)
+                       && (unsigned int)sally_pc.w == romdev_pc_addr))
+      {
+         romdev_pc_last_pc = sally_pc.w;   /* leave PC frozen exactly here */
+         romdev_pc_hit = 1;
+         romdev_pc_hits++;
+         romdev_pc_step = 0;               /* one-shot */
+         return 0;
+      }
+   }
+
    sally_opcode = memory_Read(sally_pc.w++);
    sally_cycles = SALLY_CYCLES[sally_opcode];
 
