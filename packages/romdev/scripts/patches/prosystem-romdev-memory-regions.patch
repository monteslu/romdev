# romdev patch — see README.md in this directory for full justification.
# Exposes this core's internal memory regions (VRAM/OAM/palette/registers/etc.)
# via retro_get_memory_data so romdev's inspect*/getCPUState/etc. tools can read
# them. Upstream exposes only SAVE_RAM/SYSTEM_RAM. WITHOUT this patch the build
# still succeeds but those tools return empty data (silent runtime failure).
# git apply ignores everything above the first 'diff --git' line.
#
# Also adds an instruction-level WRITE WATCHPOINT (6502): memory_Write in
# core/Memory.c records sally_pc when a watched address is written; libretro.c
# exports romdev_watchpoint_set/get.
#
# Also adds an instruction-level READ WATCHPOINT (memory_Read in core/Memory.c)
# and an execution-level PC BREAKPOINT / single-step (the hook in
# core/Sally.c:sally_ExecuteInstruction freezes the CPU at a target PC; the
# per-frame loop in core/ProSystem.c drains the cycle budget on a hit so
# retro_run still returns). libretro.c exports romdev_readwatch_set/get and
# romdev_pcbreak_set/get — these power runUntilRead / runUntilPC / stepInstruction.
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/core/Memory.c b/core/Memory.c
index cb12bd3..198f8ff 100644
--- a/core/Memory.c
+++ b/core/Memory.c
@@ -30,6 +30,24 @@
 #include "Cartridge.h"
 #include "Tia.h"
 #include "Riot.h"
+#include "Sally.h"   /* for sally_pc (the 6502 PC) — romdev watchpoint */
+
+/* romdev instruction-level write watchpoint state (hook in memory_Write). */
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+/* romdev instruction-level READ watchpoint state (mirror of the write watch;
+ * hook at the tail of memory_Read). Records the 6502 PC (sally_pc.w) of the
+ * instruction that READ a watched address, the value read, and a hit count.
+ * Exported via romdev_readwatch_* in libretro.c. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
 
 uint8_t memory_ram[MEMORY_SIZE] = {0};
 uint8_t memory_rom[MEMORY_SIZE] = {0};
@@ -62,27 +80,42 @@ uint16_t memory_souper_GetRamAddress(uint16_t address)
 
 uint8_t memory_Read(uint16_t address)
 {
+   uint8_t romdev_rd_value;
    switch ( address )
    {
       case INTIM:
       case INTIM | 0x2:
          memory_ram[INTFLG] &= 0x7f;
-         return memory_ram[INTIM];
+         romdev_rd_value = memory_ram[INTIM];
+         goto romdev_rd_done;
       case INTFLG:
       case INTFLG | 0x2:
          memory_ram[INTFLG] &= 0x7f;
-         return memory_ram[INTFLG];
+         romdev_rd_value = memory_ram[INTFLG];
+         goto romdev_rd_done;
       default:
          if(cartridge_type == CARTRIDGE_TYPE_SOUPER && address >= 0x4000 && address < 0x8000)
-            return memory_souper_ram[memory_souper_GetRamAddress(address)];
+         {
+            romdev_rd_value = memory_souper_ram[memory_souper_GetRamAddress(address)];
+            goto romdev_rd_done;
+         }
          break;
    }
 
-   return memory_ram[address];
+   romdev_rd_value = memory_ram[address];
+
+romdev_rd_done:
+   if (romdev_rd_enabled && (unsigned int)address == romdev_rd_addr) {
+      romdev_rd_last_pc = sally_pc.w; romdev_rd_last_val = romdev_rd_value; romdev_rd_hits++;
+   }
+   return romdev_rd_value;
 }
 
 void memory_Write(uint16_t address, uint8_t data)
 {
+   if (romdev_wp_enabled && (unsigned int)address == romdev_wp_addr) {
+      romdev_wp_last_pc = sally_pc.w; romdev_wp_last_val = data; romdev_wp_hits++;
+   }
    if(!memory_rom[address])
    {
       switch(address)
