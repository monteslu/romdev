+   /* rom-dev-mcp: extra state accessors for inspectSprites/Palette/etc. */
+   void *iohram_ptr() const { return mem_.iohram_ptr(); }
+   void *bgpdata_ptr() const { return mem_.bgpdata_ptr(); }
+   void *objpdata_ptr() const { return mem_.objpdata_ptr(); }
+
+   /* rom-dev-mcp: 18-byte snapshot of the SM83 CPU state.
+    * Layout (little-endian):
+    *   0-1: pc
+    *   2-3: sp
+    *   4:   a
+    *   5:   f  (synthesized: Z N H C in bits 7..4, low nybble zero)
+    *   6:   b   7:   c
+    *   8:   d   9:   e
+    *  10:   h  11:   l
+    *  12:   ime    (0/1)
+    *  13:   halt   (0/1)
+    *  14-17: reserved (zero)
+    * gambatte stores flags split across hf1/hf2/zf/cf — synthesize the
+    * standard SM83 F register from them. zf is INVERTED: zf=0 means
+    * Z bit is set. */
+   void cpu_snapshot(unsigned char *out) const {
+      unsigned f = 0;
+      if (zf == 0)              f |= 0x80;            /* Z */
+      if ((hf2 ^ hf1) & 0x10)   f |= 0x20;            /* H */
+      if (cf & 0x100)           f |= 0x10;            /* C */
+      /* N flag isn't stored separately by gambatte; default 0. */
+      out[0] = pc_ & 0xFF; out[1] = (pc_ >> 8) & 0xFF;
+      out[2] = sp & 0xFF;  out[3] = (sp >> 8) & 0xFF;
+      out[4] = a_; out[5] = (unsigned char)f;
+      out[6] = b;  out[7] = c;
+      out[8] = d;  out[9] = e;
+      out[10] = h; out[11] = l;
+      out[12] = mem_.ime() ? 1 : 0;
+      out[13] = mem_.halted() ? 1 : 0;
+      out[14] = 0; out[15] = 0; out[16] = 0; out[17] = 0;
+   }
 #endif
 
