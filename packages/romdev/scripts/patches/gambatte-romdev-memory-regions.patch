 unsigned retro_get_region() { return RETRO_REGION_NTSC; }
 
+/* romdev instruction-level write watchpoint — records the WRITING instruction's
+ * PC for a watched CPU address (the sm83 `pc` is live in the WRITE macros in
+ * cpu.cpp). State lives in cpu.cpp; exported here for the host. */
+extern "C" {
+extern unsigned long  romdev_wp_addr;
+extern int            romdev_wp_enabled;
+extern unsigned long  romdev_wp_last_pc;
+extern unsigned char  romdev_wp_last_val;
+extern unsigned long  romdev_wp_hits;
+
+void romdev_watchpoint_set(unsigned addr, int enabled) {
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned *out5, int clearHits) {
+   if (!out5) return;
+   out5[0] = (unsigned)romdev_wp_enabled;
+   out5[1] = (unsigned)romdev_wp_addr;
+   out5[2] = (unsigned)romdev_wp_last_pc;
+   out5[3] = (unsigned)romdev_wp_last_val;
+   out5[4] = (unsigned)romdev_wp_hits;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+}
+
+/* rom-dev-mcp extension: custom memory region IDs above libretro standard.
+ * Lets the host inspect GB/GBC PPU state for inspectSprites / inspectPalette
+ * / getCPUState. Mirrors fceumm/snes9x/gpgx patches. */
+#define ROMDEV_MEMORY_GB_VRAM     0x140  /* 8KB DMG / 16KB GBC */
+#define ROMDEV_MEMORY_GB_OAM      0x141  /* 160B sprite OAM */
+#define ROMDEV_MEMORY_GB_IO       0x142  /* 128B IO regs $FF00-$FF7F */
+#define ROMDEV_MEMORY_GB_HRAM     0x143  /* 128B high RAM $FF80-$FFFE + IE */
+#define ROMDEV_MEMORY_GB_BGPDATA  0x144  /* 64B GBC BG palette RAM */
+#define ROMDEV_MEMORY_GB_OBJPDATA 0x145  /* 64B GBC sprite palette RAM */
+#define ROMDEV_MEMORY_GB_CPU_REGS 0x146  /* 18B SM83 CPU snapshot */
+
+static unsigned char romdev_gb_cpu_buf[18];
+
 void *retro_get_memory_data(unsigned id)
 {
    if (rom_loaded) switch (id)
@@ -2883,11 +2925,20 @@ void *retro_get_memory_data(unsigned id)
       case RETRO_MEMORY_RTC:
          return gb.rtcdata_ptr();
       case RETRO_MEMORY_SYSTEM_RAM:
-         /* Really ugly hack here, relies upon 
+         /* Really ugly hack here, relies upon
           * libgambatte/src/memory/memptrs.cpp MemPtrs::reset not
-          * realizing that that memchunk hack is ugly, or 
+          * realizing that that memchunk hack is ugly, or
           * otherwise getting rearranged. */
          return gb.rambank0_ptr();
+      case ROMDEV_MEMORY_GB_VRAM:     return gb.vram_ptr();
+      case ROMDEV_MEMORY_GB_OAM:      return gb.oamram_ptr();
+      case ROMDEV_MEMORY_GB_IO:       return gb.iohram_ptr();
+      case ROMDEV_MEMORY_GB_HRAM:     return gb.zeropage_ptr();
+      case ROMDEV_MEMORY_GB_BGPDATA:  return gb.bgpdata_ptr();
+      case ROMDEV_MEMORY_GB_OBJPDATA: return gb.objpdata_ptr();
+      case ROMDEV_MEMORY_GB_CPU_REGS:
+         gb.cpu_snapshot(romdev_gb_cpu_buf);
+         return romdev_gb_cpu_buf;
    }
 
    return 0;
@@ -2902,14 +2953,21 @@ size_t retro_get_memory_size(unsigned id)
       case RETRO_MEMORY_RTC:
          return gb.rtcdata_size();
       case RETRO_MEMORY_SYSTEM_RAM:
-         /* This is rather hacky too... it relies upon 
+         /* This is rather hacky too... it relies upon
           * libgambatte/src/memory/cartridge.cpp not changing
-          * the call to memptrs.reset, but this is 
+          * the call to memptrs.reset, but this is
           * probably mostly safe.
           *
           * GBC will probably not get a
           * hardware upgrade anytime soon. */
          return (gb.isCgb() ? 8 : 2) * 0x1000ul;
+      case ROMDEV_MEMORY_GB_VRAM:     return gb.isCgbMode() ? 0x4000 : 0x2000;
+      case ROMDEV_MEMORY_GB_OAM:      return 0xA0;
+      case ROMDEV_MEMORY_GB_IO:       return 0x80;
+      case ROMDEV_MEMORY_GB_HRAM:     return 0x80;
+      case ROMDEV_MEMORY_GB_BGPDATA:  return 0x40;
+      case ROMDEV_MEMORY_GB_OBJPDATA: return 0x40;
+      case ROMDEV_MEMORY_GB_CPU_REGS: return sizeof(romdev_gb_cpu_buf);
    }
 
    return 0;
diff --git a/libgambatte/src/cpu.cpp b/libgambatte/src/cpu.cpp
index 0fb6199..43e32ad 100644
--- a/libgambatte/src/cpu.cpp
+++ b/libgambatte/src/cpu.cpp
@@ -20,6 +20,19 @@
 #include "gambatte-memory.h"
 #include "savestate.h"
 
+/* romdev instruction-level write watchpoint (see the fceumm patch for the NES
+ * equivalent). The WRITE macros below stamp the live `pc` (the address of the
+ * currently-executing instruction) when a watched address is written, so the
+ * captured PC is the true writer — correct even for interrupt-driven writes.
+ * C linkage so the libretro layer can extern + export these. */
+extern "C" {
+unsigned long romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned long romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned long romdev_wp_hits     = 0;
+}
+
 namespace gambatte {
 
 CPU::CPU()
@@ -143,8 +156,13 @@ void CPU::loadState(SaveState const &state) {
 #define PC_READ(dest) do { (dest) = mem_.read(pc, cycleCounter); pc = (pc + 1) & 0xFFFF; cycleCounter += 4; } while (0)
 #define FF_READ(dest, addr) do { (dest) = mem_.ff_read(addr, cycleCounter); cycleCounter += 4; } while (0)
 
-#define WRITE(addr, data) do { mem_.write(addr, data, cycleCounter); cycleCounter += 4; } while (0)
-#define FF_WRITE(addr, data) do { mem_.ff_write(addr, data, cycleCounter); cycleCounter += 4; } while (0)
+#define ROMDEV_WP_CHECK(a, d) do { \
+		if (romdev_wp_enabled && (unsigned long)(a) == romdev_wp_addr) { \
+			romdev_wp_last_pc = pc; romdev_wp_last_val = (unsigned char)(d); romdev_wp_hits++; \
+		} \
+	} while (0)
+#define WRITE(addr, data) do { ROMDEV_WP_CHECK((addr), (data)); mem_.write(addr, data, cycleCounter); cycleCounter += 4; } while (0)
+#define FF_WRITE(addr, data) do { ROMDEV_WP_CHECK(0xFF00 | ((addr) & 0xFF), (data)); mem_.ff_write(addr, data, cycleCounter); cycleCounter += 4; } while (0)
 
 #define PC_MOD(data) do { pc = data; cycleCounter += 4; } while (0)
 
diff --git a/libgambatte/src/cpu.h b/libgambatte/src/cpu.h
index 76c29de..f7bc078 100644
--- a/libgambatte/src/cpu.h
+++ b/libgambatte/src/cpu.h
@@ -56,6 +56,42 @@ public:
    void *rombank1_ptr() const { return mem_.rombank1_ptr(); }
    void *zeropage_ptr() const { return mem_.zeropage_ptr(); }
    void *oamram_ptr() const { return mem_.oamram_ptr(); }
+   /* rom-dev-mcp: extra state accessors for inspectSprites/Palette/etc. */
+   void *iohram_ptr() const { return mem_.iohram_ptr(); }
+   void *bgpdata_ptr() const { return mem_.bgpdata_ptr(); }
+   void *objpdata_ptr() const { return mem_.objpdata_ptr(); }
+
+   /* rom-dev-mcp: 18-byte snapshot of the SM83 CPU state.
+    * Layout (little-endian):
+    *   0-1: pc
+    *   2-3: sp
+    *   4:   a
+    *   5:   f  (synthesized: Z N H C in bits 7..4, low nybble zero)
+    *   6:   b   7:   c
+    *   8:   d   9:   e
+    *  10:   h  11:   l
+    *  12:   ime    (0/1)
+    *  13:   halt   (0/1)
+    *  14-17: reserved (zero)
+    * gambatte stores flags split across hf1/hf2/zf/cf — synthesize the
+    * standard SM83 F register from them. zf is INVERTED: zf=0 means
+    * Z bit is set. */
+   void cpu_snapshot(unsigned char *out) const {
+      unsigned f = 0;
+      if (zf == 0)              f |= 0x80;            /* Z */
+      if ((hf2 ^ hf1) & 0x10)   f |= 0x20;            /* H */
+      if (cf & 0x100)           f |= 0x10;            /* C */
+      /* N flag isn't stored separately by gambatte; default 0. */
+      out[0] = pc_ & 0xFF; out[1] = (pc_ >> 8) & 0xFF;
+      out[2] = sp & 0xFF;  out[3] = (sp >> 8) & 0xFF;
+      out[4] = a_; out[5] = (unsigned char)f;
+      out[6] = b;  out[7] = c;
+      out[8] = d;  out[9] = e;
+      out[10] = h; out[11] = l;
+      out[12] = mem_.ime() ? 1 : 0;
+      out[13] = mem_.halted() ? 1 : 0;
+      out[14] = 0; out[15] = 0; out[16] = 0; out[17] = 0;
+   }
 #endif
 
