+	/* romdev watchpoint: absolute ROM-file offset of a CPU address using the
+	 * CURRENTLY-mapped bank (rmem(area) is host_ptr - area_base, like NES Page[]),
+	 * so a $4000-$7FFF PC resolves to the live switchable bank. Returns
+	 * 0xFFFFFFFF when the address isn't in mapped ROM. */
+	unsigned long romdev_romOffset(unsigned pc) const {
+		const unsigned char *rm = cart_.rmem(pc >> 12);
+		const unsigned char *base = cart_.romdata(0);
+		if (!rm || !base) return 0xFFFFFFFFul;
+		const unsigned char *p = rm + pc;
+		long off = (long)(p - base);
+		if (off < 0) return 0xFFFFFFFFul;
+		return (unsigned long)off;
+	}
