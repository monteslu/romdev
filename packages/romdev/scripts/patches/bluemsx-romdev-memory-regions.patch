diff --git a/libretro.c b/libretro.c
index f583a99..2edaf66 100644
--- a/libretro.c
+++ b/libretro.c
@@ -1838,16 +1838,83 @@ unsigned retro_get_region(void)
          return RETRO_REGION_NTSC;
    }
 }
+/* ---- romdev memory-region exposure (MSX / MSX2) --------------------- */
+#include "VDP.h"
+#include "AY8910.h"
+#define ROMDEV_MEMORY_MSX_VRAM       0x1C0
+#define ROMDEV_MEMORY_MSX_VDP_REGS   0x1C1
+#define ROMDEV_MEMORY_MSX_VDP_STATUS 0x1C2
+#define ROMDEV_MEMORY_MSX_PALETTE    0x1C3
+#define ROMDEV_MEMORY_MSX_CPU_REGS   0x1C4
+#define ROMDEV_MEMORY_MSX_PSG_REGS   0x1C5
+
+/* Z80/R800 register snapshot. R800's active bank `regs` holds RegisterPair
+ * unions (.W = UInt16); pack into a flat little-endian struct so getCPUState
+ * decodes a stable layout regardless of the core's internal union endianness. */
+#pragma pack(push, 1)
+struct romdev_msx_cpu_snap {
+    unsigned short af, bc, de, hl, ix, iy, pc, sp;
+    unsigned short af1, bc1, de1, hl1;
+    unsigned char  i, r, iff1, iff2, im, halt;
+};
+#pragma pack(pop)
+static struct romdev_msx_cpu_snap romdev_msx_cpu;
+
+static void* romdev_msx_cpu_data(void)
+{
+    R800* cpu = (R800*)boardInfo.cpuRef;
+    if (!cpu) return (void*)0;
+    romdev_msx_cpu.af  = cpu->regs.AF.W;
+    romdev_msx_cpu.bc  = cpu->regs.BC.W;
+    romdev_msx_cpu.de  = cpu->regs.DE.W;
+    romdev_msx_cpu.hl  = cpu->regs.HL.W;
+    romdev_msx_cpu.ix  = cpu->regs.IX.W;
+    romdev_msx_cpu.iy  = cpu->regs.IY.W;
+    romdev_msx_cpu.pc  = cpu->regs.PC.W;
+    romdev_msx_cpu.sp  = cpu->regs.SP.W;
+    romdev_msx_cpu.af1 = cpu->regs.AF1.W;
+    romdev_msx_cpu.bc1 = cpu->regs.BC1.W;
+    romdev_msx_cpu.de1 = cpu->regs.DE1.W;
+    romdev_msx_cpu.hl1 = cpu->regs.HL1.W;
+    romdev_msx_cpu.i    = cpu->regs.I;
+    romdev_msx_cpu.r    = cpu->regs.R;
+    romdev_msx_cpu.iff1 = cpu->regs.iff1;
+    romdev_msx_cpu.iff2 = cpu->regs.iff2;
+    romdev_msx_cpu.im   = cpu->regs.im;
+    romdev_msx_cpu.halt = cpu->regs.halt;
+    return &romdev_msx_cpu;
+}
+
 void *retro_get_memory_data(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRam;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVram();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return vdpRomdevGetRegs();
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return vdpRomdevGetStatus();
+      case ROMDEV_MEMORY_MSX_PALETTE:    return vdpRomdevGetPalette();
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return romdev_msx_cpu_data();
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return ay8910RomdevGetRegs();
+      default: break;
+   }
    return NULL;
 }
 size_t retro_get_memory_size(unsigned id)
 {
    if ( id == RETRO_MEMORY_SYSTEM_RAM )
       return g_mainRamSize;
+   switch (id) {
+      case RETRO_MEMORY_VIDEO_RAM:
+      case ROMDEV_MEMORY_MSX_VRAM:       return vdpRomdevGetVramSize();
+      case ROMDEV_MEMORY_MSX_VDP_REGS:   return 64;
+      case ROMDEV_MEMORY_MSX_VDP_STATUS: return 16;
+      case ROMDEV_MEMORY_MSX_PALETTE:    return 16 * 2;   /* paletteReg[16] UInt16 */
+      case ROMDEV_MEMORY_MSX_CPU_REGS:   return sizeof(romdev_msx_cpu);
+      case ROMDEV_MEMORY_MSX_PSG_REGS:   return 16; /* AY8910 regs[16] */
+      default: break;
+   }
    return 0;
 }
 unsigned retro_api_version(void){return RETRO_API_VERSION;}
