 {
     DebugCallbacks dbgCallbacks = { getDebugInfo, NULL, dbgWriteRegister, NULL };
     AY8910* ay8910 = (AY8910*)calloc(1, sizeof(AY8910));
     int i;
 
+    if (!romdev_the_ay8910) romdev_the_ay8910 = ay8910;
+
     DoubleT v = 0x26a9;
     for (i = 15; i >= 0; i--) {
         voltTable[i] = (Int16)v;
@@ -300,6 +309,7 @@ void ay8910Reset(AY8910* ay8910)
 
 void ay8910Destroy(AY8910* ay8910)
 {
+    if (romdev_the_ay8910 == ay8910) romdev_the_ay8910 = NULL; /* romdev: avoid dangling */
     debugDeviceUnregister(ay8910->debugHandle);
 
     switch (ay8910->connector) {
