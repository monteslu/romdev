   myLastAccessWasRead = true;
   myLastPeekAddress = address;
   return result;
 }
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+/* romdev instruction-level write watchpoint — records the 6502 PC (this M6502's
+ * member) when a watched address is written. State defined in libretro.cxx. */
+extern "C" {
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+}
+
 inline void M6502::poke(uInt16 address, uInt8 value)
 {
+  if (romdev_wp_enabled && (unsigned int)address == romdev_wp_addr) {
+    romdev_wp_last_pc = PC; romdev_wp_last_val = value; romdev_wp_hits++;
+  }
   ////////////////////////////////////////////////
   // TODO - move this logic directly into CartAR
   if(address != myLastAddress)
@@ -140,6 +167,23 @@ inline void M6502::poke(uInt16 address, uInt8 value)
 }
 
 // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
+/* romdev PC BREAKPOINT / single-step (6502 execute hook below). When enabled and
+ * the 6502 PC about to execute equals romdev_pc_addr, the hook records the PC,
+ * sets romdev_pc_hit, and sets StopExecutionBit so M6502::execute returns and the
+ * frame ends EXACTLY at that PC (this is the same mechanism stella's own debugger
+ * uses to break mid-frame — TIA::update leaves myPartialFrameFlag true and
+ * endFrame() runs, so retro_run returns instead of hanging). romdev_pc_step arms
+ * a per-instruction countdown (host arms to 2 = "let ONE instruction execute,
+ * then stop") so single-step ADVANCES the PC. Exported via romdev_pcbreak_*. */
+extern "C" {
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+}
+
 bool M6502::execute(uInt32 number)
 {
   // Clear all of the execution status bits except for the fatal error bit
@@ -153,6 +197,29 @@ bool M6502::execute(uInt32 number)
       uInt16 operandAddress = 0, intermediateAddress = 0;
       uInt8 operand = 0;
 
+      // romdev PC breakpoint / single-step: checked here, BEFORE the opcode
+      // fetch, so PC is the address of the instruction about to execute. On a
+      // hit (or single-step countdown reaching 0) freeze the CPU at this PC:
+      // record it, set the hit flag, set StopExecutionBit so the frame ends
+      // cleanly (retro_run returns; leaving it incomplete = infinite hang), and
+      // break WITHOUT advancing PC. Gated on !romdev_pc_hit so a held breakpoint
+      // doesn't re-fire while the host reads state and disarms.
+      if ((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit)
+      {
+        int stepFire = 0;
+        if (romdev_pc_step) { if (--romdev_pc_step <= 0) stepFire = 1; }
+        if (stepFire || ((romdev_pc_enabled && !romdev_pc_step)
+                         && (unsigned int)PC == romdev_pc_addr))
+        {
+          romdev_pc_last_pc = PC;            // leave PC frozen exactly here
+          romdev_pc_hit = 1;
+          romdev_pc_hits++;
+          romdev_pc_step = 0;               // one-shot
+          myExecutionStatus |= StopExecutionBit;
+          break;
+        }
+      }
+
       // Reset the peek/poke address pointers
       myLastPeekAddress = myLastPokeAddress = myDataAddressForPoke = 0;
 
diff --git a/stella/src/emucore/M6502.hxx b/stella/src/emucore/M6502.hxx
