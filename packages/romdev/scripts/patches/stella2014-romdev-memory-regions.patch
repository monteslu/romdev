# romdev patch — see README.md in this directory for full justification.
# Exposes this core's internal memory regions (VRAM/OAM/palette/registers/etc.)
# via retro_get_memory_data so romdev's inspect*/getCPUState/etc. tools can read
# them. Upstream exposes only SAVE_RAM/SYSTEM_RAM. WITHOUT this patch the build
# still succeeds but those tools return empty data (silent runtime failure).
# git apply ignores everything above the first 'diff --git' line.
#
# Also adds an instruction-level WRITE WATCHPOINT (6502): M6502::poke records the
# CPU PC when a watched address is written; libretro.cxx exports
# romdev_watchpoint_set/get.
#
# Also adds an instruction-level READ WATCHPOINT (M6502::peek) and an
# execution-level PC BREAKPOINT / single-step (the hook in M6502::execute sets
# StopExecutionBit on a hit — the same path stella's debugger uses to break
# mid-frame, so TIA::update's endFrame() runs and retro_run returns instead of
# hanging). libretro.cxx exports romdev_readwatch_set/get and
# romdev_pcbreak_set/get — these power runUntilRead / runUntilPC / stepInstruction.
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/libretro.cxx b/libretro.cxx
index 15c6d12..1ec0e20 100644
--- a/libretro.cxx
+++ b/libretro.cxx
@@ -28,6 +28,7 @@
 #include "Paddles.hxx"
 #include "Sound.hxx"
 #include "M6532.hxx"
+#include "M6502.hxx"
 #include "Version.hxx"
 
 #include "Stubs.hxx"
@@ -1248,16 +1249,127 @@ unsigned retro_get_region(void)
    return RETRO_REGION_NTSC;
 }
 
+/* romdev instruction-level write watchpoint (6502) — state defined here; the
+ * hook in M6502::poke records the CPU PC when a watched address is written. */
+extern "C" {
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_wp_enabled;
+   out5[1] = romdev_wp_addr;
+   out5[2] = romdev_wp_last_pc;
+   out5[3] = (unsigned int)romdev_wp_last_val;
+   out5[4] = romdev_wp_hits;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev READ watchpoint (6502) — state defined here; the hook in M6502::peek
+ * records the CPU PC when a watched address is READ. Symmetric to the write
+ * watch above. Exported as romdev_readwatch_set/get. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (6502 execute hook in M6502::execute) — state defined
+ * here. Freezes the CPU exactly at the breakpoint PC via StopExecutionBit (the
+ * same path stella's debugger uses); the host polls romdev_pcbreak_get after each
+ * retro_run frame, stops stepping once hit is set, then reads registers via
+ * getCPUState. `step` arms a one-instruction single-step (ignores addr). */
+unsigned int  romdev_pc_addr    = 0;
+int           romdev_pc_enabled = 0;
+int           romdev_pc_step    = 0;
+volatile int  romdev_pc_hit     = 0;
+unsigned int  romdev_pc_last_pc = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits    = 0;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, hit, lastPC, hits]. Pass clearHit to re-arm. */
+void romdev_pcbreak_get(unsigned int *out5, int clearHit)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_pc_enabled;
+   out5[1] = romdev_pc_addr;
+   out5[2] = (unsigned int)romdev_pc_hit;
+   out5[3] = romdev_pc_last_pc;
+   out5[4] = romdev_pc_hits;
+   if (clearHit) { romdev_pc_hit = 0; }
+}
+}
+
 unsigned retro_api_version(void)
 {
    return RETRO_API_VERSION;
 }
 
+/* rom-dev-mcp extension: 2600-specific region IDs above libretro standard.
+ * Exposes TIA + 6502 state for inspectSprites/Palette/getCPUState/etc.
+ * The 128B RIOT RAM already comes through RETRO_MEMORY_SYSTEM_RAM. */
+#define ROMDEV_MEMORY_A26_TIA_REGS  0x160  /* 32B TIA snapshot — see TIA::snapshot */
+#define ROMDEV_MEMORY_A26_CPU_REGS  0x161  /* 7B 6502 snapshot */
+
+static uInt8 romdev_a26_tia_buf[32];
+static uInt8 romdev_a26_cpu_buf[7];
+
 void *retro_get_memory_data(unsigned id)
 {
    switch (id)
    {
       case RETRO_MEMORY_SYSTEM_RAM: return console->system().m6532().getRAM();
+      case ROMDEV_MEMORY_A26_TIA_REGS:
+         console->system().tia().snapshot(romdev_a26_tia_buf);
+         return romdev_a26_tia_buf;
+      case ROMDEV_MEMORY_A26_CPU_REGS:
+         console->system().m6502().snapshot(romdev_a26_cpu_buf);
+         return romdev_a26_cpu_buf;
       default: return NULL;
    }
 }
@@ -1267,6 +1379,8 @@ size_t retro_get_memory_size(unsigned id)
    switch (id)
    {
       case RETRO_MEMORY_SYSTEM_RAM: return 128;
+      case ROMDEV_MEMORY_A26_TIA_REGS: return sizeof(romdev_a26_tia_buf);
+      case ROMDEV_MEMORY_A26_CPU_REGS: return sizeof(romdev_a26_cpu_buf);
       default: return 0;
    }
 }
