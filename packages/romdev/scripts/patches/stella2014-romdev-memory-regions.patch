+/* romdev instruction-level READ watchpoint — records the 6502 PC (this M6502's
+ * member) when a watched address is READ (mirror of the write watch below).
+ * State defined in libretro.cxx; exported via romdev_readwatch_*. */
+extern "C" {
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+}
