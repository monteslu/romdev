# romdev patch for handy (Atari Lynx) libretro core — see README.md here.
#
# TWO additions:
# 1) Instruction-level WRITE WATCHPOINT (65C02): the CPU_POKE macro in
#    lynx/c65c02.h records mPC when a watched address is written; libretro.cpp
#    exports romdev_watchpoint_set/get. The Lynx 65C02 is a flat 64KB space
#    (no ROM banking) so PC alone is unambiguous; no bank field.
# 2) DEBUG STATE REGIONS via retro_get_memory_data/_size custom IDs:
#    - 0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
#      from the public CSystem::GetRegs(C6502_REGS&), for getCPUState.
#    - 0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes)
#      read through the public Peek_CPU memory path — Suzy sprite regs ($FCxx) +
#      Mikey LCD control / audio ($FD20-$FD3F) / palette ($FDA0-$FDBF). Used by
#      getAudioState (Mikey) and inspectPalette/getRenderingContext (Lynx).
#    Both synthesized into static buffers per call (the chip fields are private;
#    Peek/GetRegs are the sanctioned public reads, side-effect-free here).
#    Lynx sprites are SCB linked lists (no fixed OAM) so there is no sprite
#    region — inspectSprites walks SCBs over the exported SYSTEM_RAM instead.
#
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index ad4efd7..41fc8dd 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -1292,16 +1292,93 @@ unsigned retro_get_region(void)
    return RETRO_REGION_NTSC;
 }
 
+/* romdev instruction-level write watchpoint (Lynx 65C02). State defined here
+ * with C linkage; the CPU_POKE hook in lynx/c65c02.h records mPC when a watched
+ * address is written. Exported for the host. */
+extern "C" {
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (unsigned int)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = 0xFFFFFFFF; /* Lynx 65C02 is flat 64KB — no ROM bank to report */
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+}
+
+/* romdev debug state regions (Lynx). High IDs so they never collide with the
+ * libretro RETRO_MEMORY_* enum; honored only by this patched core.
+ *   0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
+ *          assembled from the public CSystem::GetRegs(C6502_REGS&).
+ *   0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes),
+ *          read through the public Peek_CPU memory-map path. This is Suzy
+ *          ($FC00-$FCFF: sprite engine regs) + Mikey ($FD00-$FDFF: LCD control,
+ *          audio at $FD20-$FD3F, palette at $FDA0-$FDBF). The CPU registers and
+ *          this HW window are SYNTHESIZED into static buffers per call because
+ *          the chips' fields are private — Peek is the sanctioned public read
+ *          path and is side-effect-free for these register addresses.
+ * Lynx sprites have NO fixed OAM — they are SCB linked lists walked from a RAM
+ * address — so there is no sprite region; inspectSprites must walk SCBs over the
+ * already-exported SYSTEM_RAM. */
+#define ROMDEV_REGION_LYNX_CPU_REGS 0x190u
+#define ROMDEV_REGION_LYNX_HW_REGS  0x191u
+
+static unsigned char romdev_lynx_cpu_buf[8];
+static unsigned char romdev_lynx_hw_buf[0x200]; /* $FC00-$FDFF */
+
+static void *romdev_lynx_fill_cpu(void)
+{
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   romdev_lynx_cpu_buf[0] = (unsigned char)(r.PC & 0xff);
+   romdev_lynx_cpu_buf[1] = (unsigned char)((r.PC >> 8) & 0xff);
+   romdev_lynx_cpu_buf[2] = (unsigned char)(r.A & 0xff);
+   romdev_lynx_cpu_buf[3] = (unsigned char)(r.X & 0xff);
+   romdev_lynx_cpu_buf[4] = (unsigned char)(r.Y & 0xff);
+   romdev_lynx_cpu_buf[5] = (unsigned char)(r.SP & 0xff);
+   romdev_lynx_cpu_buf[6] = (unsigned char)(r.PS & 0xff);
+   romdev_lynx_cpu_buf[7] = (unsigned char)((r.NMI ? 0x80 : 0) | (r.IRQ ? 0x40 : 0) | (r.WAIT ? 0x20 : 0));
+   return romdev_lynx_cpu_buf;
+}
+
+static void *romdev_lynx_fill_hw(void)
+{
+   for (unsigned i = 0; i < 0x200; ++i)
+      romdev_lynx_hw_buf[i] = lynx->Peek_CPU(0xFC00 + i);
+   return romdev_lynx_hw_buf;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
-   if (lynx && type == RETRO_MEMORY_SYSTEM_RAM)
-      return lynx->GetRamPointer();
+   if (!lynx) return NULL;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return lynx->GetRamPointer();
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return romdev_lynx_fill_cpu();
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return romdev_lynx_fill_hw();
    return NULL;
 }
 
 size_t retro_get_memory_size(unsigned type)
 {
-   if (type == RETRO_MEMORY_SYSTEM_RAM)
-      return 1024 * 64;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return 1024 * 64;
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return sizeof(romdev_lynx_cpu_buf);
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return sizeof(romdev_lynx_hw_buf);
    return 0;
 }
diff --git a/lynx/c65c02.h b/lynx/c65c02.h
index 0fdea74..a0f86dd 100644
--- a/lynx/c65c02.h
+++ b/lynx/c65c02.h
@@ -65,9 +65,26 @@
 //#define CPU_PEEKW(m)			(mSystem.PeekW_CPU(m))
 //#define CPU_POKE(m1,m2)			(mSystem.Poke_CPU(m1,m2))
 
+/* romdev instruction-level write watchpoint (Lynx 65C02). The CPU_POKE macro is
+ * the central write path; mPC is the live program counter. Records the writing
+ * PC when a watched address is written. State has C linkage so libretro.cpp can
+ * extern + export it. (The 65C02 addresses a flat 64KB space — no ROM banking
+ * to disambiguate — so PC alone is unambiguous; no bank field.) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+#ifdef __cplusplus
+}
+#endif
+
 #define CPU_PEEK(m)				(((m<0xfc00)?mRamPointer[m]:mSystem.Peek_CPU(m)))
 #define CPU_PEEKW(m)			(((m<0xfc00)?(mRamPointer[m]+(mRamPointer[m+1]<<8)):mSystem.PeekW_CPU(m)))
-#define CPU_POKE(m1,m2)			{if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
+#define CPU_POKE(m1,m2)			{ if(romdev_wp_enabled && (unsigned int)(m1)==romdev_wp_addr){ romdev_wp_last_pc=mPC; romdev_wp_last_val=(unsigned char)(m2); romdev_wp_hits++; } if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
 
 
 enum
