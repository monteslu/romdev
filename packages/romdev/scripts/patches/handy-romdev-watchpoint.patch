index 0fdea74..b9e195b 100644
--- a/lynx/c65c02.h
+++ b/lynx/c65c02.h
@@ -65,9 +65,57 @@
 //#define CPU_PEEKW(m)			(mSystem.PeekW_CPU(m))
 //#define CPU_POKE(m1,m2)			(mSystem.Poke_CPU(m1,m2))
 
-#define CPU_PEEK(m)				(((m<0xfc00)?mRamPointer[m]:mSystem.Peek_CPU(m)))
+/* romdev instruction-level write watchpoint (Lynx 65C02). The CPU_POKE macro is
+ * the central write path; mPC is the live program counter. Records the writing
+ * PC when a watched address is written. State has C linkage so libretro.cpp can
+ * extern + export it. (The 65C02 addresses a flat 64KB space — no ROM banking
+ * to disambiguate — so PC alone is unambiguous; no bank field.) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+/* romdev instruction-level READ watchpoint (Lynx 65C02) — mirror of the write
+ * watch above. The CPU_PEEK macro is the central read path (used for both
+ * operand/data reads and the opcode fetch). When enabled, any read of a watched
+ * address records the reading PC (mPC), the value, and a hit count. State has C
+ * linkage so libretro.cpp can extern + export it via romdev_readwatch_*. */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+/* romdev PC BREAKPOINT (Lynx 65C02). Compared in C65C02::Update() just before
+ * the opcode fetch, where mPC == the address of the instruction about to
+ * execute. On a hit (or single-step countdown), romdev_pc_hit is set and mPC is
+ * left un-incremented so the CPU is frozen exactly at the breakpoint; the
+ * libretro frame loop sees the flag and consumes the rest of the frame budget
+ * so retro_run still returns. romdev_pc_step is a per-instruction countdown the
+ * host arms to 2 ("let ONE instruction execute, then stop") so single-step
+ * actually advances the PC. Flat 64KB space — no banking, PC is unambiguous. */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+#ifdef __cplusplus
+}
+#endif
+
+/* romdev read-watch helper: records a read of romdev_rd_addr, then yields v.
+ * Written as an expression (comma operator) because CPU_PEEK is used in
+ * expression context (e.g. mOperand=CPU_PEEK(...)). */
+#define ROMDEV_RD_HOOK(m,v)		((romdev_rd_enabled && (unsigned int)(m)==romdev_rd_addr) ? (romdev_rd_last_pc=mPC, romdev_rd_last_val=(unsigned char)(v), romdev_rd_hits++, (v)) : (v))
+
+#define CPU_PEEK(m)				ROMDEV_RD_HOOK((m), (((m<0xfc00)?mRamPointer[m]:mSystem.Peek_CPU(m))))
 #define CPU_PEEKW(m)			(((m<0xfc00)?(mRamPointer[m]+(mRamPointer[m+1]<<8)):mSystem.PeekW_CPU(m)))
-#define CPU_POKE(m1,m2)			{if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
+#define CPU_POKE(m1,m2)			{ if(romdev_wp_enabled && (unsigned int)(m1)==romdev_wp_addr){ romdev_wp_last_pc=mPC; romdev_wp_last_val=(unsigned char)(m2); romdev_wp_hits++; } if(m1<0xfc00) mRamPointer[m1]=m2; else mSystem.Poke_CPU(m1,m2);}
 
 
 enum
@@ -248,6 +296,30 @@ class C65C02
          //
          if(gSystemCPUSleep) return;
 
+         /* romdev PC breakpoint / single-step: checked HERE, before the opcode
+          * fetch, so mPC is the address of the instruction about to execute. On
+          * a hit we set romdev_pc_hit and RETURN WITHOUT executing (mPC left
+          * un-incremented) so the CPU is frozen exactly at the breakpoint. The
+          * libretro frame loop checks romdev_pc_hit after lynx->Update() and
+          * consumes the remaining frame-cycle budget so retro_run still returns
+          * (otherwise the while loop would spin forever). romdev_pc_step is a
+          * per-instruction countdown the host arms to 2: it lets ONE instruction
+          * execute, then stops, so single-step ADVANCES the PC. */
+         if((romdev_pc_enabled || romdev_pc_step) && !romdev_pc_hit)
+         {
+            int stepFire = 0;
+            if(romdev_pc_step) { if(--romdev_pc_step <= 0) stepFire = 1; }
+            if(stepFire || ((romdev_pc_enabled && !romdev_pc_step)
+                            && (unsigned int)mPC == romdev_pc_addr))
+            {
+               romdev_pc_last_pc = (unsigned int)mPC;  /* frozen here, un-executed */
+               romdev_pc_hit = 1;
+               romdev_pc_hits++;
+               romdev_pc_step = 0;                     /* one-shot */
+               return;                                 /* do NOT fetch/execute */
+            }
+         }
+
          // Fetch opcode
          mOpcode=CPU_PEEK(mPC);
          mPC++;
