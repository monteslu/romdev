# romdev patch for handy (Atari Lynx) libretro core — see README.md here.
#
# FOUR additions (all 65C02, flat 64KB space — PC is unambiguous, no banking):
# 1) Instruction-level WRITE WATCHPOINT: the CPU_POKE macro in lynx/c65c02.h
#    records mPC when a watched address is written; libretro.cpp exports
#    romdev_watchpoint_set/get (findWriter).
# 2) Instruction-level READ WATCHPOINT: the CPU_PEEK macro records mPC + the
#    value when a watched address is read; libretro.cpp exports
#    romdev_readwatch_set/get (runUntilRead). Mirror of the write watch.
# 3) EXECUTION (PC) BREAKPOINT + SINGLE-STEP: C65C02::Update() compares mPC to
#    the armed address just before the opcode fetch and, on a hit, freezes the
#    CPU at that instruction (returns un-executed) so the host can read live
#    regs; retro_run's frame loop then consumes the remaining cycle budget so
#    the frame still completes (otherwise the loop spins forever). Single-step
#    uses a per-instruction countdown so the PC actually advances. libretro.cpp
#    exports romdev_pcbreak_set/get (runUntilPC / stepInstruction).
# 4) DEBUG STATE REGIONS via retro_get_memory_data/_size custom IDs:
#    - 0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
#      from the public CSystem::GetRegs(C6502_REGS&), for getCPUState.
#    - 0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes)
#      read through the public Peek_CPU memory path — Suzy sprite regs ($FCxx) +
#      Mikey LCD control / audio ($FD20-$FD3F) / palette ($FDA0-$FDBF). Used by
#      getAudioState (Mikey) and inspectPalette/getRenderingContext (Lynx).
#    Both synthesized into static buffers per call (the chip fields are private;
#    Peek/GetRegs are the sanctioned public reads, side-effect-free here).
#    Lynx sprites are SCB linked lists (no fixed OAM) so there is no sprite
#    region — inspectSprites walks SCBs over the exported SYSTEM_RAM instead.
#
# git apply ignores everything above the first 'diff --git' line.
#
diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index ad4efd7..feb823b 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -995,6 +995,10 @@ void retro_get_system_av_info(struct retro_system_av_info *info)
    info->geometry.aspect_ratio = (float)lynx_width / (float)lynx_height;
 }
 
+/* romdev PC breakpoint hit flag (defined with C linkage further below). Forward-
+ * declared here so retro_run's frame loop can end the frame on a hit. */
+extern "C" volatile int romdev_pc_hit;
+
 void retro_run(void)
 {
    unsigned i, res = 0;
@@ -1083,6 +1087,17 @@ void retro_run(void)
    while (gSystemCycleCount - gLastRunCycleCount < retro_cycles_per_frame) {
       lynx->Update();
 
+      /* romdev PC breakpoint hit: the CPU is frozen at the breakpoint (its
+       * Update() returned WITHOUT executing/advancing). We must still END this
+       * frame or the while loop spins forever (the CPU no longer advances
+       * cycles). Consume the remaining frame-cycle budget and break so
+       * retro_run returns; the host then polls romdev_pcbreak_get, disarms, and
+       * reads the live registers. */
+      if (romdev_pc_hit) {
+         gSystemCycleCount = gLastRunCycleCount + retro_cycles_per_frame;
+         break;
+      }
+
       for (int lcv = 1; lcv < retro_overclock; lcv++)
          lynx->Overclock();
    }
@@ -1292,16 +1307,160 @@ unsigned retro_get_region(void)
    return RETRO_REGION_NTSC;
 }
 
+/* romdev instruction-level write watchpoint (Lynx 65C02). State defined here
+ * with C linkage; the CPU_POKE hook in lynx/c65c02.h records mPC when a watched
+ * address is written. Exported for the host. */
+extern "C" {
+unsigned int  romdev_wp_addr     = 0;
+int           romdev_wp_enabled  = 0;
+unsigned int  romdev_wp_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_wp_last_val = 0;
+unsigned int  romdev_wp_hits     = 0;
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+}
+
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+   if (!out6) return;
+   out6[0] = (unsigned int)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (unsigned int)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = 0xFFFFFFFF; /* Lynx 65C02 is flat 64KB — no ROM bank to report */
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev instruction-level READ watchpoint (Lynx 65C02) — symmetric to the
+ * write watch above. The CPU_PEEK hook in lynx/c65c02.h records mPC + the value
+ * when a watched address is READ. Exported via romdev_readwatch_* for the host
+ * runUntilRead tool. */
+unsigned int  romdev_rd_addr     = 0;
+int           romdev_rd_enabled  = 0;
+unsigned int  romdev_rd_last_pc  = 0xFFFFFFFF;
+unsigned char romdev_rd_last_val = 0;
+unsigned int  romdev_rd_hits     = 0;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (Lynx 65C02). The compare lives in C65C02::Update()
+ * (lynx/c65c02.h) just before the opcode fetch, freezing mPC at the breakpoint.
+ * The host polls romdev_pcbreak_get after each retro_run frame, stops stepping
+ * once hit is set, then reads the registers via getCPUState. `step` arms a
+ * one-instruction single-step (ignores addr). Flat 64KB — PC is unambiguous. */
+unsigned int  romdev_pc_addr     = 0;
+int           romdev_pc_enabled  = 0;
+int           romdev_pc_step     = 0;        /* per-instruction countdown when single-stepping */
+volatile int  romdev_pc_hit      = 0;        /* set by the execute hook, cleared by the host */
+unsigned int  romdev_pc_last_pc  = 0xFFFFFFFF;
+unsigned int  romdev_pc_hits     = 0;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   /* step is a per-instruction countdown; arm to 2 so ONE instruction executes
+    * before the stop fires (true single-step that advances the PC). */
+   romdev_pc_step = step ? 2 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, hit, lastPC, hits]. Pass clearHit to re-arm. */
+void romdev_pcbreak_get(unsigned int *out5, int clearHit)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_pc_enabled;
+   out5[1] = romdev_pc_addr;
+   out5[2] = (unsigned int)romdev_pc_hit;
+   out5[3] = romdev_pc_last_pc;
+   out5[4] = romdev_pc_hits;
+   if (clearHit) { romdev_pc_hit = 0; }
+}
+}
+
+/* romdev debug state regions (Lynx). High IDs so they never collide with the
+ * libretro RETRO_MEMORY_* enum; honored only by this patched core.
+ *   0x190 lynx_cpu_regs: 8-byte 65C02 snapshot {PClo,PChi,A,X,Y,SP,P,flags}
+ *          assembled from the public CSystem::GetRegs(C6502_REGS&).
+ *   0x191 lynx_hw_regs: the $FC00-$FDFF hardware-register window (512 bytes),
+ *          read through the public Peek_CPU memory-map path. This is Suzy
+ *          ($FC00-$FCFF: sprite engine regs) + Mikey ($FD00-$FDFF: LCD control,
+ *          audio at $FD20-$FD3F, palette at $FDA0-$FDBF). The CPU registers and
+ *          this HW window are SYNTHESIZED into static buffers per call because
+ *          the chips' fields are private — Peek is the sanctioned public read
+ *          path and is side-effect-free for these register addresses.
+ * Lynx sprites have NO fixed OAM — they are SCB linked lists walked from a RAM
+ * address — so there is no sprite region; inspectSprites must walk SCBs over the
+ * already-exported SYSTEM_RAM. */
+#define ROMDEV_REGION_LYNX_CPU_REGS 0x190u
+#define ROMDEV_REGION_LYNX_HW_REGS  0x191u
+
+static unsigned char romdev_lynx_cpu_buf[8];
+static unsigned char romdev_lynx_hw_buf[0x200]; /* $FC00-$FDFF */
+
+static void *romdev_lynx_fill_cpu(void)
+{
+   C6502_REGS r;
+   lynx->GetRegs(r);
+   romdev_lynx_cpu_buf[0] = (unsigned char)(r.PC & 0xff);
+   romdev_lynx_cpu_buf[1] = (unsigned char)((r.PC >> 8) & 0xff);
+   romdev_lynx_cpu_buf[2] = (unsigned char)(r.A & 0xff);
+   romdev_lynx_cpu_buf[3] = (unsigned char)(r.X & 0xff);
+   romdev_lynx_cpu_buf[4] = (unsigned char)(r.Y & 0xff);
+   romdev_lynx_cpu_buf[5] = (unsigned char)(r.SP & 0xff);
+   romdev_lynx_cpu_buf[6] = (unsigned char)(r.PS & 0xff);
+   romdev_lynx_cpu_buf[7] = (unsigned char)((r.NMI ? 0x80 : 0) | (r.IRQ ? 0x40 : 0) | (r.WAIT ? 0x20 : 0));
+   return romdev_lynx_cpu_buf;
+}
+
+static void *romdev_lynx_fill_hw(void)
+{
+   for (unsigned i = 0; i < 0x200; ++i)
+      romdev_lynx_hw_buf[i] = lynx->Peek_CPU(0xFC00 + i);
+   return romdev_lynx_hw_buf;
+}
+
 void *retro_get_memory_data(unsigned type)
 {
-   if (lynx && type == RETRO_MEMORY_SYSTEM_RAM)
-      return lynx->GetRamPointer();
+   if (!lynx) return NULL;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return lynx->GetRamPointer();
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return romdev_lynx_fill_cpu();
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return romdev_lynx_fill_hw();
    return NULL;
 }
 
 size_t retro_get_memory_size(unsigned type)
 {
-   if (type == RETRO_MEMORY_SYSTEM_RAM)
-      return 1024 * 64;
+   if (type == RETRO_MEMORY_SYSTEM_RAM) return 1024 * 64;
+   if (type == ROMDEV_REGION_LYNX_CPU_REGS) return sizeof(romdev_lynx_cpu_buf);
+   if (type == ROMDEV_REGION_LYNX_HW_REGS)  return sizeof(romdev_lynx_hw_buf);
    return 0;
 }
