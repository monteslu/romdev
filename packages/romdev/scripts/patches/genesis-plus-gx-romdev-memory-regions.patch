+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+extern unsigned char *romdev_wp_last_pc_ptr; /* live host ptr of the SMS/GG Z80 PC's page (for bank → ROM offset, resolved in libretro.c) */
+#define WM(addr,value) do { \
+    if (romdev_wp_enabled && (unsigned int)(addr) == romdev_wp_addr) { \
+      romdev_wp_last_pc = PC; romdev_wp_last_val = (unsigned char)(value); romdev_wp_hits++; \
+      romdev_wp_last_pc_ptr = z80_readmap[(PC) >> 10] ? z80_readmap[(PC) >> 10] + (PC) : 0; \
+    } \
+    z80_writemem((addr),(value)); \
