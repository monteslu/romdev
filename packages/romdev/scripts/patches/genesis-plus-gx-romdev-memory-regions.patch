diff --git a/libretro/libretro.c b/libretro/libretro.c
index 798c6cc..b6461fb 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -3743,6 +3743,153 @@ void retro_unload_game(void)
 
 unsigned retro_get_region(void) { return vdp_pal ? RETRO_REGION_PAL : RETRO_REGION_NTSC; }
 
+/* romdev instruction-level write watchpoint — records the m68k REG_PC for a
+ * watched address (hook in core/m68k/m68kcpu.h). Genesis only for now (the
+ * shared Z80 is a separate write path, not yet hooked). */
+extern unsigned int  romdev_wp_addr;
+extern int           romdev_wp_enabled;
+extern unsigned int  romdev_wp_last_pc;
+extern unsigned char romdev_wp_last_val;
+extern unsigned int  romdev_wp_hits;
+
+extern unsigned char *romdev_wp_last_pc_ptr; /* SMS/GG Z80 PC page ptr (m68kcpu.c) */
+
+void romdev_watchpoint_set(unsigned int addr, int enabled)
+{
+   romdev_wp_addr = addr;
+   romdev_wp_enabled = enabled ? 1 : 0;
+   romdev_wp_last_pc = 0xFFFFFFFF;
+   romdev_wp_last_val = 0;
+   romdev_wp_hits = 0;
+   romdev_wp_last_pc_ptr = 0;
+}
+
+/* Fills out6: [enabled, addr, lastPC, lastVal, hits, prgOffset]. prgOffset is the
+ * absolute ROM-file offset of the SMS/GG writing instruction (disambiguates the
+ * sega-mapper bank for a 16-bit Z80 PC); 0xFFFFFFFF when not in mapped ROM or on
+ * Genesis (m68k PC is already a flat ROM address — no bank to resolve). */
+void romdev_watchpoint_get(unsigned int *out6, int clearHits)
+{
+   unsigned int prgOff = 0xFFFFFFFF;
+   if (!out6) return;
+   if (romdev_wp_last_pc_ptr && cart.rom) {
+      ptrdiff_t d = romdev_wp_last_pc_ptr - cart.rom;
+      if (d >= 0 && (unsigned int)d < cart.romsize) prgOff = (unsigned int)d;
+   }
+   out6[0] = (unsigned int)romdev_wp_enabled;
+   out6[1] = romdev_wp_addr;
+   out6[2] = romdev_wp_last_pc;
+   out6[3] = (unsigned int)romdev_wp_last_val;
+   out6[4] = romdev_wp_hits;
+   out6[5] = prgOff;
+   if (clearHits) { romdev_wp_hits = 0; romdev_wp_last_pc = 0xFFFFFFFF; romdev_wp_last_pc_ptr = 0; }
+}
+
+/* romdev READ watchpoint (m68k) — symmetric to the write watch above. Records
+ * the m68k REG_PC of the instruction that READ a watched address. Genesis only
+ * (the shared Z80 read path is not hooked). */
+extern unsigned int  romdev_rd_addr;
+extern int           romdev_rd_enabled;
+extern unsigned int  romdev_rd_last_pc;
+extern unsigned char romdev_rd_last_val;
+extern unsigned int  romdev_rd_hits;
+
+void romdev_readwatch_set(unsigned int addr, int enabled)
+{
+   romdev_rd_addr = addr;
+   romdev_rd_enabled = enabled ? 1 : 0;
+   romdev_rd_last_pc = 0xFFFFFFFF;
+   romdev_rd_last_val = 0;
+   romdev_rd_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, lastPC, lastVal, hits]. */
+void romdev_readwatch_get(unsigned int *out5, int clearHits)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_rd_enabled;
+   out5[1] = romdev_rd_addr;
+   out5[2] = romdev_rd_last_pc;
+   out5[3] = (unsigned int)romdev_rd_last_val;
+   out5[4] = romdev_rd_hits;
+   if (clearHits) { romdev_rd_hits = 0; romdev_rd_last_pc = 0xFFFFFFFF; }
+}
+
+/* romdev PC BREAKPOINT (m68k execute hook in m68kcpu.c:m68k_run). The core
+ * freezes at the breakpoint PC; the host polls romdev_pcbreak_get after each
+ * retro_run frame and stops stepping once hit is set, then reads the registers
+ * via getCPUState. `step` arms a one-instruction single-step (ignores addr). */
+extern unsigned int  romdev_pc_addr;
+extern int           romdev_pc_enabled;
+extern int           romdev_pc_step;
+extern volatile int  romdev_pc_hit;
+extern unsigned int  romdev_pc_last_pc;
+extern unsigned int  romdev_pc_hits;
+
+void romdev_pcbreak_set(unsigned int addr, int enabled, int step)
+{
+   romdev_pc_addr = addr;
+   romdev_pc_enabled = enabled ? 1 : 0;
+   romdev_pc_step = step ? 1 : 0;
+   romdev_pc_hit = 0;
+   romdev_pc_last_pc = 0xFFFFFFFF;
+   romdev_pc_hits = 0;
+}
+
+/* Fills out5: [enabled, addr, hit, lastPC, hits]. Pass clearHit to re-arm. */
+void romdev_pcbreak_get(unsigned int *out5, int clearHit)
+{
+   if (!out5) return;
+   out5[0] = (unsigned int)romdev_pc_enabled;
+   out5[1] = romdev_pc_addr;
+   out5[2] = (unsigned int)romdev_pc_hit;
+   out5[3] = romdev_pc_last_pc;
+   out5[4] = romdev_pc_hits;
+   if (clearHit) { romdev_pc_hit = 0; }
+}
+
+/* rom-dev-mcp extension: custom memory region IDs above libretro standard.
+ * Mirrors fceumm + snes9x patches. Exposes Genesis sound/video chip state
+ * so inspectSprites / inspectPalette / getCPUState / etc. can read live
+ * data instead of parsing the savestate blob.
+ *
+ * Sound chip state (YM2612, PSG) is `static` in gpgx; we expose binary
+ * snapshots via psg_context_save / YM2612SaveContext into a per-process
+ * scratch buffer that callers read on demand. Decoders parse the known
+ * format on the JS side. */
+#define ROMDEV_MEMORY_GENESIS_CRAM     0x120
+#define ROMDEV_MEMORY_GENESIS_VSRAM    0x121
+#define ROMDEV_MEMORY_GENESIS_VDP_REGS 0x122
+#define ROMDEV_MEMORY_GENESIS_Z80_RAM  0x123
+#define ROMDEV_MEMORY_GENESIS_M68K     0x124
+#define ROMDEV_MEMORY_GENESIS_YM2612   0x125
+#define ROMDEV_MEMORY_GENESIS_PSG      0x126
+
+/* SMS / Game Gear region IDs. Same gpgx globals (vram/cram/reg) are
+ * shared across all systems gpgx emulates, but with different sizes:
+ *   SMS:  VRAM 16KB, CRAM 32B (16 entries × 6-bit BGR), VDP regs 11
+ *   GG:   VRAM 16KB, CRAM 64B (32 entries × 12-bit BGR), VDP regs 11
+ * Expose with SMS-correct sizes so callers don't need to know the
+ * Genesis-shaped backing buffer is 64KB / 128B / 32B. */
+#define ROMDEV_MEMORY_SMS_VRAM     0x130
+#define ROMDEV_MEMORY_SMS_CRAM     0x131
+#define ROMDEV_MEMORY_SMS_VDP_REGS 0x132
+#define ROMDEV_MEMORY_SMS_Z80_REGS 0x133
+#define ROMDEV_MEMORY_GG_VRAM      0x134
+#define ROMDEV_MEMORY_GG_CRAM      0x135
+
+/* shared.h already brings in genesis.h / vdp_ctrl.h / m68k.h. Sound
+ * headers aren't in shared.h; add them. Header paths are relative to
+ * the core/ include dir (Makefile.libretro adds it with -I). */
+#include "sound/ym2612.h"
+#include "sound/psg.h"
+#include "z80/z80.h"
+
+static unsigned char romdev_ym2612_snap[4096];
+static unsigned char romdev_psg_snap[1024];
+static unsigned char romdev_z80_snap[sizeof(Z80_Regs)];
+
+
 void *retro_get_memory_data(unsigned id)
 {
    switch (id)
@@ -3751,6 +3898,35 @@ void *retro_get_memory_data(unsigned id)
          return sram.on ? sram.sram : NULL;
       case RETRO_MEMORY_SYSTEM_RAM:
          return work_ram;
+      case RETRO_MEMORY_VIDEO_RAM:
+         return vram;
+      case ROMDEV_MEMORY_GENESIS_CRAM:
+         return cram;
+      case ROMDEV_MEMORY_GENESIS_VSRAM:
+         return vsram;
+      case ROMDEV_MEMORY_GENESIS_VDP_REGS:
+         return reg;
+      case ROMDEV_MEMORY_GENESIS_Z80_RAM:
+         return zram;
+      case ROMDEV_MEMORY_GENESIS_M68K:
+         return &m68k;
+      case ROMDEV_MEMORY_GENESIS_YM2612:
+         YM2612SaveContext(romdev_ym2612_snap);
+         return romdev_ym2612_snap;
+      case ROMDEV_MEMORY_GENESIS_PSG:
+         psg_context_save(romdev_psg_snap);
+         return romdev_psg_snap;
+      case ROMDEV_MEMORY_SMS_VRAM:
+      case ROMDEV_MEMORY_GG_VRAM:
+         return vram;
+      case ROMDEV_MEMORY_SMS_CRAM:
+      case ROMDEV_MEMORY_GG_CRAM:
+         return cram;
+      case ROMDEV_MEMORY_SMS_VDP_REGS:
+         return reg;
+      case ROMDEV_MEMORY_SMS_Z80_REGS:
+         memcpy(romdev_z80_snap, &Z80, sizeof(Z80_Regs));
+         return romdev_z80_snap;
       default:
          return NULL;
    }
@@ -3802,6 +3978,21 @@ size_t retro_get_memory_size(unsigned id)
             return 0x2000; /* 8KB internal RAM */
       }
 
+      case RETRO_MEMORY_VIDEO_RAM:        return 0x10000;
+      case ROMDEV_MEMORY_GENESIS_CRAM:     return 0x80;
+      case ROMDEV_MEMORY_GENESIS_VSRAM:    return 0x80;
+      case ROMDEV_MEMORY_GENESIS_VDP_REGS: return 0x20;
+      case ROMDEV_MEMORY_GENESIS_Z80_RAM:  return 0x2000;
+      case ROMDEV_MEMORY_GENESIS_M68K:     return sizeof(m68ki_cpu_core);
+      case ROMDEV_MEMORY_GENESIS_YM2612:   return sizeof(romdev_ym2612_snap);
+      case ROMDEV_MEMORY_GENESIS_PSG:      return sizeof(romdev_psg_snap);
+      case ROMDEV_MEMORY_SMS_VRAM:         return 0x4000;   /* SMS VRAM = 16 KB */
+      case ROMDEV_MEMORY_GG_VRAM:          return 0x4000;   /* GG VRAM  = 16 KB */
+      case ROMDEV_MEMORY_SMS_CRAM:         return 0x20;     /* SMS CRAM = 32 B  */
+      case ROMDEV_MEMORY_GG_CRAM:          return 0x40;     /* GG CRAM  = 64 B  */
+      case ROMDEV_MEMORY_SMS_VDP_REGS:     return 0x10;     /* SMS uses lower 16 of the 32-byte reg file */
+      case ROMDEV_MEMORY_SMS_Z80_REGS:     return sizeof(romdev_z80_snap);
+
       default:
         return 0;
    }
