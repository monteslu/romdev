{
  "name": "romdev-core-flycast",
  "version": "0.3.0",
  "description": "Flycast libretro core (Sega Dreamcast, reios HLE BIOS) for romdev, bundled as WASM — single-threaded build with the WASM SH-4 recompiler; boots homebrew ELFs and commercial GD-ROM images.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./wasm/*": "./wasm/*"
  },
  "files": [
    "index.js",
    "wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monteslu/romdev.git",
    "directory": "packages/romdev-core-flycast"
  },
  "homepage": "https://github.com/monteslu/romdev#readme",
  "bugs": {
    "url": "https://github.com/monteslu/romdev/issues"
  },
  "author": "Luis Montes",
  "scripts": {
    "prepublishOnly": "node ../../scripts/verify-wasm.mjs"
  }
}
